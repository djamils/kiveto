# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# No test hits Gotenberg: the renderer is unit-tested against MockHttpClient.
GOTENBERG_URL=http://gotenberg:3000

# Tests never reach the network: fixture adapters, and a contact so that the
# API adapters can still be built by the adapter-selection test.
CLIENT_COMPANY_REGISTRY=fixture
CLIENT_VAT_VERIFIER=fixture
EXTERNAL_API_USER_AGENT="Kiveto-test (+tests@kiveto.invalid)"
ELECTRONIC_INVOICING_PLATFORM=simulator
