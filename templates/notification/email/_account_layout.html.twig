{# Account e-mails sent by Kiveto itself: « Kiveto » card and footer. #}
{% import 'notification/email/_macros.html.twig' as ui %}
{% apply inline_css(source('notification/email/_styles.css')) %}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ block('subject')|trim }}</title>
</head>
<body>
<table role="presentation" class="wrapper" width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td align="center">
      <table role="presentation" class="card" width="600" cellpadding="0" cellspacing="0">
        <tr><td class="card-header">{{ ui.brand('K', null, 'Kiveto', null) }}</td></tr>
        <tr><td class="card-body">{% block body %}{% endblock %}</td></tr>
        <tr>
          <td class="card-footer">
            {%- set note = block('footer_note') is defined ? block('footer_note')|trim : '' %}
            {%- if note %}<p>{{ note }}</p>{% endif %}
            <p>Kiveto · logiciel de gestion vétérinaire</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
{% endapply %}
