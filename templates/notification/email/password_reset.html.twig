{% extends 'notification/email/_account_layout.html.twig' %}
{% import 'notification/email/_macros.html.twig' as ui %}

{% block subject %}Réinitialisation de votre mot de passe Kiveto{% endblock %}

{% block body %}
<p>Bonjour,</p>
<p>Une demande de réinitialisation du mot de passe a été faite pour le compte <strong>{{ accountEmail }}</strong>.</p>
{{ ui.button('Choisir un nouveau mot de passe', resetUrl, '#4338CA') }}
<p class="muted">Ce lien ne fonctionne qu'une fois et expire dans 30 minutes.</p>
<div class="note">Vous n'êtes pas à l'origine de cette demande ? Ignorez ce message : votre mot de passe reste inchangé.</div>
{% endblock %}

{% block footer_note %}Demande reçue le {{ requestedAtLabel }}.{% endblock %}
