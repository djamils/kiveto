{% extends 'notification/email/_layout.html.twig' %}
{% import 'notification/email/_macros.html.twig' as ui %}

{% block subject %}Rendez-vous déplacé — {{ animalName }}, {{ subjectDateLabel }}{% endblock %}

{% block body %}
<p>Bonjour {{ addressee }},</p>
<p>Le rendez-vous de <strong>{{ animalName }}</strong> a été déplacé.</p>
<table role="presentation" class="slots" cellpadding="0" cellspacing="0">
  <tr>
    <td class="slot"><div class="slot-label">Ancien créneau</div><div class="slot-old">{{ previousSlotLabel }}</div></td>
    <td style="width: 12px;"></td>
    <td class="slot slot-new"><div class="slot-label">Nouveau créneau</div><div class="slot-value">{{ newSlotLabel }}</div></td>
  </tr>
</table>
{{ ui.details([
    {label: 'Motif', value: reason},
]|merge(practitionerName ? [{label: 'Vétérinaire', value: practitionerName}] : [])|merge(clinic.addressLine ? [{label: 'Adresse', value: clinic.addressLine}] : [])) }}
<p class="muted">L'invitation jointe à ce message met à jour votre agenda.</p>
<p>Ce créneau ne vous convient pas ? Appelez-nous au {{ clinic.phone }}.</p>
{% endblock %}

{% block footer_note %}Vous recevez ce message suite à la modification de votre rendez-vous.{% endblock %}
