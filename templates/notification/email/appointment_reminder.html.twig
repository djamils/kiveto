{% extends 'notification/email/_layout.html.twig' %}

{% block subject %}Rappel : rendez-vous de {{ animalName }} {{ whenLabel }}{% endblock %}

{% block body %}
<p>Bonjour {{ addressee }},</p>
<p>Rappel du rendez-vous de <strong>{{ animalName }}</strong> {{ whenLabel }}{% if practitionerName %} avec {{ practitionerName starts with 'Dr ' or practitionerName starts with 'Pr ' ? 'le ' : '' }}{{ practitionerName }}{% endif %}.</p>
<p>En cas d'absence, merci de nous prévenir au {{ clinic.phone }}.</p>
{% endblock %}

{% block footer_note %}Vous recevez ce message car vous avez accepté les rappels de rendez-vous.{% endblock %}
