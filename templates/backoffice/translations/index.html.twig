{# Backoffice — Translations management page #}
{% extends 'backoffice/base.html.twig' %}

{% block page_title %}Traductions{% endblock %}

{% block content %}
  {# Filters #}
  <div class="widget widget-pad" style="margin-bottom:var(--space-4);">
    <h3 style="font-size:var(--text-base);font-weight:var(--weight-semibold);color:var(--text-primary);margin-bottom:var(--space-3);">
      Filtrer
    </h3>
    <form method="get" action="{{ path('backoffice_translations') }}" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:var(--space-3);align-items:end;">
      <div class="field">
        <label class="field-label">Scope</label>
        {# Custom select component for scope filter #}
        {{ include('components/ui/select.html.twig', {
          name: 'scope',
          id: 'scope-filter',
          placeholder: '(tous)',
          value: filters.scope,
          options: [
            { value: 'clinic', label: 'clinic' },
            { value: 'portal', label: 'portal' },
            { value: 'backoffice', label: 'backoffice' },
            { value: 'shared', label: 'shared' },
          ],
          clearable: true,
        }) }}
      </div>
      <div class="field">
        <label class="field-label">Locale</label>
        <input name="locale" class="form-input" value="{{ filters.locale }}">
      </div>
      <div class="field">
        <label class="field-label">Domain</label>
        <input name="domain" class="form-input" value="{{ filters.domain }}">
      </div>
      <div class="field">
        <label class="field-label">Key contains</label>
        <input name="key" class="form-input" value="{{ filters.key }}">
      </div>
      <div class="field">
        <label class="field-label">Value contains</label>
        <input name="value" class="form-input" value="{{ filters.value }}">
      </div>
      <div>
        <button type="submit" class="btn btn-primary">Rechercher</button>
      </div>
    </form>
  </div>

  {# Upsert form #}
  <div class="widget widget-pad" style="margin-bottom:var(--space-4);">
    <h3 style="font-size:var(--text-base);font-weight:var(--weight-semibold);color:var(--text-primary);margin-bottom:var(--space-3);">
      Creer / Mettre a jour
    </h3>
    <form method="post" action="{{ path('backoffice_translations_upsert') }}" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:var(--space-3);align-items:end;">
      <input type="hidden" name="_token" value="{{ csrf_token }}">
      <div class="field">
        <label class="field-label">Scope *</label>
        {# Custom select component for scope in upsert form #}
        {{ include('components/ui/select.html.twig', {
          name: 'scope',
          id: 'scope-upsert',
          value: filters.scope,
          options: [
            { value: 'clinic', label: 'clinic' },
            { value: 'portal', label: 'portal' },
            { value: 'backoffice', label: 'backoffice' },
            { value: 'shared', label: 'shared' },
          ],
          required: true,
        }) }}
      </div>
      <div class="field">
        <label class="field-label">Locale *</label>
        <input name="locale" class="form-input" value="{{ filters.locale ?: 'fr-FR' }}" required>
      </div>
      <div class="field">
        <label class="field-label">Domain *</label>
        <input name="domain" class="form-input" value="{{ filters.domain ?: 'messages' }}" required>
      </div>
      <div class="field">
        <label class="field-label">Key *</label>
        <input name="key" class="form-input" required>
      </div>
      <div class="field" style="grid-column:1/-1;">
        <label class="field-label">Value * (ICU autorise)</label>
        <textarea name="value" class="form-input" rows="2" required></textarea>
      </div>
      <div class="field" style="grid-column:1/-1;">
        <label class="field-label">Description (optionnel)</label>
        <textarea name="description" class="form-input" rows="2"></textarea>
      </div>
      <div>
        <button type="submit" class="btn btn-success">Upsert</button>
      </div>
    </form>
  </div>

  {# Results table #}
  <div class="widget">
    <div class="widget-pad" style="border-bottom:1px solid var(--border-default);">
      <h3 style="font-size:var(--text-base);font-weight:var(--weight-semibold);color:var(--text-primary);">
        Resultats ({{ result.total }})
      </h3>
    </div>
    <div style="overflow-x:auto;">
      <table class="data-table">
        <thead class="dt-head">
          <tr>
            <th>Scope</th>
            <th>Locale</th>
            <th>Domain</th>
            <th>Key</th>
            <th>Value</th>
            <th>Description</th>
            <th>Created at</th>
            <th>Created by</th>
            <th>Updated at</th>
            <th>Updated by</th>
            <th style="width:100px;">Actions</th>
          </tr>
        </thead>
        <tbody class="dt-body">
          {% for item in result.items %}
            <tr class="dt-row">
              <td>{{ item.scope }}</td>
              <td>{{ item.locale }}</td>
              <td>{{ item.domain }}</td>
              <td><code>{{ item.key }}</code></td>
              <td style="max-width:320px;white-space:pre-wrap;">{{ item.value }}</td>
              <td style="max-width:220px;white-space:pre-wrap;">{{ item.description ?: '&mdash;' }}</td>
              <td>{{ item.createdAt|date('Y-m-d H:i:s') }}</td>
              <td>{{ item.createdBy ?: '&mdash;' }}</td>
              <td>{{ item.updatedAt|date('Y-m-d H:i:s') }}</td>
              <td>{{ item.updatedBy ?: '&mdash;' }}</td>
              <td>
                <form method="post" action="{{ path('backoffice_translations_delete') }}" onsubmit="return confirm('Supprimer cette traduction ?');">
                  <input type="hidden" name="_token" value="{{ csrf_token }}">
                  <input type="hidden" name="scope" value="{{ item.scope }}">
                  <input type="hidden" name="locale" value="{{ item.locale }}">
                  <input type="hidden" name="domain" value="{{ item.domain }}">
                  <input type="hidden" name="key" value="{{ item.key }}">
                  <button class="btn btn-sm btn-danger" type="submit">Supprimer</button>
                </form>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="11" style="text-align:center;padding:var(--space-4);color:var(--text-subtle);">
                Aucun resultat
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {# Pagination #}
    {% set page = filters.page|default(1) %}
    {% set prev = page > 1 ? page - 1 : 1 %}
    {% set next = page + 1 %}
    <div class="widget-pad" style="display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--border-default);">
      <div style="display:flex;gap:var(--space-2);">
        <a class="btn btn-sm btn-secondary{% if page == 1 %} disabled{% endif %}" href="{{ path('backoffice_translations', filters|merge({'page': prev})) }}">Precedent</a>
        <a class="btn btn-sm btn-secondary" href="{{ path('backoffice_translations', filters|merge({'page': next})) }}">Suivant</a>
      </div>
      <div style="font-size:var(--text-sm);color:var(--text-subtle);">Page {{ page }}</div>
    </div>
  </div>
{% endblock %}
