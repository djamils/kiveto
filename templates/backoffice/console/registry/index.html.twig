{% extends 'backoffice/console/base.html.twig' %}
{% import 'backoffice/console/_macros.html.twig' as co %}

{% block page_title %}Registre ANMV{% endblock %}

{% macro result(entry) %}
  {%- if entry.applied -%}<span class="co-badge is-green">Réussi</span>
  {%- elseif entry.failed -%}<span class="co-badge is-red">Échec</span>
  {%- else -%}<span class="co-badge is-indigo">En cours</span>{%- endif -%}
{% endmacro %}

{% macro diff(entry) %}
  {%- if entry.failed -%}Annulé, aucune écriture
  {%- elseif entry.running -%}Import en cours…
  {%- else -%}+{{ entry.created }} · {{ entry.updated }} modifiée{{ entry.updated > 1 ? 's' }} · {{ entry.withdrawn }} retirée{{ entry.withdrawn > 1 ? 's' }}{%- endif -%}
{% endmacro %}

{% block content %}
  {% import _self as reg %}
  <header class="co-head">
    <div class="co-head-title">
      <h1 class="co-title">Registre ANMV</h1>
      <span class="co-sub">Base des médicaments vétérinaires · publiée chaque mardi</span>
    </div>
    <form class="co-head-actions" method="post" action="{{ path('backoffice_registry_import_launch') }}">
      <input type="hidden" name="_token" value="{{ csrf_token('backoffice_registry') }}">
      <button class="co-btn is-primary" type="submit"{% if latest and latest.running %} disabled{% endif %}>{{ co.icon('refresh', 13) }} Lancer l'import</button>
    </form>
  </header>

  {% if latest and latest.running %}
    <div class="co-banner is-info co-registry-running" role="status">{{ co.icon('clock', 14) }} <span><b>Import en cours</b> depuis {{ latest.downloadedAt|co_time }} : le registre en service reste celui {{ inService ? 'du ' ~ inService.downloadedAt|co_date : 'd’avant' }} jusqu'à la fin.</span></div>
  {% elseif latest and latest.failed %}
    <div class="co-banner is-danger co-registry-failed" role="alert">{{ co.icon('warning', 14) }} <span><b>Le dernier import a échoué</b> ({{ latest.downloadedAt|co_day_time }}) : aucune écriture, le registre en service n'a pas changé.{% if latest.errorMessage %} <code>{{ latest.errorMessage|length > 160 ? latest.errorMessage|slice(0, 157) ~ '…' : latest.errorMessage }}</code>{% endif %}</span></div>
  {% else %}
    <div class="co-banner is-info" role="note">{{ co.icon('info', 14) }} <span>Prochain fichier attendu {{ nextFile|co_long_date }}. Dépose-le dans <code>storage/pharma-registry/ANMV/current/</code>, puis lance l'import.</span></div>
  {% endif %}

  <div class="co-grid">
    <div class="co-col">
      <section class="co-card" aria-labelledby="registry-last">
        <div class="co-card-body">
          <div class="co-card-head-inline">
            <h2 class="co-label" id="registry-last">Dernier import</h2>
            {% if latest %}{{ reg.result(latest) }}{% endif %}
          </div>
          {% if latest %}
            <p class="co-registry-when">{{ latest.downloadedAt|co_long_date|capitalize }}, {{ latest.downloadedAt|co_time }}</p>
            <p class="co-sub">Source ANMV{% if latest.seconds is not null %} · {{ latest.seconds }} s{% endif %}</p>
            <div class="co-registry-stats">
              <div class="co-tile"><span>AMM au registre</span><b>{{ status.authorizations|number_format(0, ',', ' ') }}</b></div>
              <div class="co-tile"><span>Ajoutées</span><b class="is-green">+{{ latest.created }}</b></div>
              <div class="co-tile"><span>Modifiées</span><b class="is-blue">{{ latest.updated }}</b></div>
              <div class="co-tile"><span>Retirées</span><b class="is-orange">{{ latest.withdrawn }}</b></div>
            </div>
            {% if latest.changes > 0 %}<a class="co-btn is-white" href="{{ path('backoffice_registry_import', {id: latest.id}) }}">Voir le différentiel {{ co.icon('chevron-right', 12) }}</a>{% endif %}
          {% else %}
            <div class="co-empty"><b>Aucun import pour l'instant</b>Le registre en service vient de l'amorçage initial. Les imports hebdomadaires apparaîtront ici.</div>
          {% endif %}
        </div>
      </section>

      <section class="co-card" aria-labelledby="registry-history">
        <div class="co-card-head"><h2 class="co-label" id="registry-history">Historique</h2></div>
        <div class="co-table-wrap">
          <table class="co-table co-registry-history">
            <thead><tr><th>Date</th><th>Différentiel</th><th>Résultat</th><th class="is-actions"><span class="co-sr">Ouvrir</span></th></tr></thead>
            <tbody>
              {% for run in status.imports %}
                <tr>
                  <td>{{ run.downloadedAt|co_day_time }}</td>
                  <td>{{ reg.diff(run) }}</td>
                  <td>{{ reg.result(run) }}</td>
                  <td class="is-actions">{% if run.changes > 0 %}<a class="co-row-link" href="{{ path('backoffice_registry_import', {id: run.id}) }}" aria-label="Différentiel du {{ run.downloadedAt|co_date }}">{{ co.icon('arrow-right', 14) }}</a>{% endif %}</td>
                </tr>
              {% else %}
                <tr><td colspan="4"><div class="co-empty"><b>Aucun import</b>Rien n'a encore été importé depuis l'amorçage.</div></td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {{ co.count_foot(status.imports|length, 'import', 'imports') }}
      </section>
    </div>

    <div class="co-col">
      <section class="co-card" aria-labelledby="registry-source">
        <div class="co-card-head"><h2 class="co-label" id="registry-source">Source</h2></div>
        <dl class="co-dl">
          <div><dt>Fournisseur</dt><dd>ANMV · data.gouv.fr</dd></div>
          <div><dt>Publication</dt><dd>Chaque mardi</dd></div>
          <div><dt>Mode</dt><dd>Manuel (fichier déposé)</dd></div>
          <div><dt>Registre en service</dt><dd>{{ inService ? inService.downloadedAt|co_date(true) : 'Amorçage initial' }}</dd></div>
          <div><dt>Fichier en attente</dt><dd>{{ status.filesReady ? 'Oui · ' ~ status.filesModifiedAt|co_date : 'Non' }}</dd></div>
          <div><dt>Prochain fichier</dt><dd>{{ nextFile|co_day_date }}</dd></div>
        </dl>
        <p class="co-card-foot">Import par différentiel (empreinte de contenu) : les identifiants des AMM déjà référencées par les catalogues des cliniques ne changent jamais.</p>
      </section>
    </div>
  </div>
{% endblock %}
