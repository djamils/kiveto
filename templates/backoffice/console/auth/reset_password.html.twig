{% extends 'backoffice/console/auth/_layout.html.twig' %}

{% block auth_title %}Nouveau mot de passe{% endblock %}

{% block card %}
  {% if state == 'invalid' %}
    <h1 class="co-auth-title">Ce lien n’est plus valide</h1>
    <p class="co-auth-sub">Il a déjà servi ou a expiré (30 minutes). Demande un nouveau lien.</p>
    <a class="co-btn is-primary co-auth-submit" href="{{ path('backoffice_forgot_password') }}">Demander un nouveau lien</a>
  {% else %}
    <h1 class="co-auth-title">Nouveau mot de passe</h1>
    <p class="co-auth-sub">Pour le compte {{ email }}.</p>

    {% if error %}
      <div class="co-error-box" role="alert">{{ error }}</div>
    {% endif %}

    <form class="co-auth-form" method="post" action="{{ path('backoffice_reset_password') }}">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('backoffice_reset_password') }}">
      <div class="co-field">
        <label for="reset-password">Nouveau mot de passe</label>
        <input class="co-input" id="reset-password" type="password" name="password" autocomplete="new-password" minlength="8" required autofocus>
      </div>
      <div class="co-field">
        <label for="reset-confirmation">Confirmation</label>
        <input class="co-input" id="reset-confirmation" type="password" name="confirmation" autocomplete="new-password" minlength="8" required>
      </div>
      <button class="co-btn is-primary co-auth-submit" type="submit">Enregistrer</button>
    </form>
  {% endif %}
{% endblock %}
