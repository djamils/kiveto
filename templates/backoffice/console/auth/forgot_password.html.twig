{% extends 'backoffice/console/auth/_layout.html.twig' %}

{% block auth_title %}Mot de passe oublié{% endblock %}

{% block card %}
  <h1 class="co-auth-title">Mot de passe oublié</h1>

  {% if sent %}
    <div class="co-banner is-info info" role="status">Si un compte existe pour cette adresse, un e-mail vient d’être envoyé.</div>
    <p class="co-auth-sub">Le lien est valable 30 minutes. La double authentification te sera demandée ensuite.</p>
  {% else %}
    <p class="co-auth-sub">Saisis l'adresse de ton compte : tu recevras un lien pour choisir un nouveau mot de passe.</p>
  {% endif %}

  {% if error %}
    <div class="co-error-box" role="alert">{{ error }}</div>
  {% endif %}

  <form class="co-auth-form" method="post" action="{{ path('backoffice_forgot_password') }}">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('backoffice_forgot_password') }}">
    <div class="co-field">
      <label for="forgot-email">Adresse e-mail</label>
      <input class="co-input" id="forgot-email" type="email" name="email" autocomplete="username" required autofocus>
    </div>
    <button class="co-btn is-primary co-auth-submit" type="submit">Envoyer le lien</button>
  </form>

  <p class="co-auth-alt"><a href="{{ path('backoffice_login') }}">Retour à la connexion</a></p>
{% endblock %}
