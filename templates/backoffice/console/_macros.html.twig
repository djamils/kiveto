{#
 # Kiveto Console — shared macros: icons, pager, status badges.
 #   {% import 'backoffice/console/_macros.html.twig' as co %}
 #}

{% macro icon(name, size = 14) -%}
  {%- set s = size -%}
  {%- if name == 'search' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 10.5l2.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- elseif name == 'bell' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5a4 4 0 00-4 4v2.5L2.5 11h11L12 9V6.5a4 4 0 00-4-4z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M6.5 13a1.5 1.5 0 003 0" stroke="currentColor" stroke-width="1.3"/></svg>
  {%- elseif name == 'download' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v9M4 8l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 13h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- elseif name == 'chevron-down' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {%- elseif name == 'chevron-right' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 3l3 3-3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {%- elseif name == 'chevron-left' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 12 12" aria-hidden="true"><path d="M7.5 3l-3 3 3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {%- elseif name == 'arrow-right' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- elseif name == 'login' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path d="M9.5 3H12a1 1 0 011 1v8a1 1 0 01-1 1H9.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M3 8h7M7.5 5.5L10 8l-2.5 2.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- elseif name == 'logout' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 3H4a1 1 0 00-1 1v8a1 1 0 001 1h2.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M7 8h6M10.5 5.5L13 8l-2.5 2.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- elseif name == 'plus' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- elseif name == 'pencil' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path d="M10.5 2.5l3 3L6 13H3v-3l7.5-7.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
  {%- elseif name == 'x' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- elseif name == 'check' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- elseif name == 'check-circle' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4"/><path d="M5.5 8.2l1.8 1.8 3.2-3.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- elseif name == 'info' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4"/><path d="M8 7.2v3.6M8 5.2v.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- elseif name == 'warning' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5l6 10.5H2L8 2.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M8 6.5v3M8 11.2v.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- elseif name == 'clock' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4"/><path d="M8 4.8V8l2 1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- elseif name == 'refresh' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8a5 5 0 11-1.6-3.7M13 3v2.5h-2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- elseif name == 'mail' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3.5" width="12" height="9" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M2.5 4.5L8 9l5.5-4.5" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
  {%- elseif name == 'eye' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 8S4 3.5 8 3.5 14.5 8 14.5 8 12 12.5 8 12.5 1.5 8 1.5 8z" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="8" r="2" stroke="currentColor" stroke-width="1.4"/></svg>
  {%- elseif name == 'lock' -%}
    <svg width="{{ s }}" height="{{ s }}" fill="none" viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="7" width="9" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M5.5 7V5a2.5 2.5 0 015 0v2" stroke="currentColor" stroke-width="1.4"/></svg>
  {%- endif -%}
{%- endmacro %}

{#
 # Pager « 1–12 sur 318  ‹ 1 2 … 27 › ».
 #   route / params: the page's route and its current query (page excluded).
 #}
{% macro pager(page, pageCount, total, perPage, route, params = {}) %}
  {% import _self as co %}
  {% set first = total == 0 ? 0 : (page - 1) * perPage + 1 %}
  {% set last = min(page * perPage, total) %}
  <nav class="co-pager" aria-label="Pagination">
    <span>{{ first }}–{{ last }} sur {{ total }}</span>
    <span class="co-pager-pages">
      <a class="co-page-btn{{ page <= 1 ? ' is-off' }}" href="{{ path(route, params|merge({page: page - 1})) }}" aria-label="Page précédente">{{ co.icon('chevron-left', 12) }}</a>
      {% set shown = [] %}
      {% for p in 1..pageCount %}
        {% if p == 1 or p == pageCount or (p >= page - 1 and p <= page + 1) %}
          {% if shown|length > 0 and p - shown|last > 1 %}<span class="co-page-gap">…</span>{% endif %}
          <a class="co-page-btn{{ p == page ? ' is-current' }}" href="{{ path(route, params|merge({page: p})) }}"{% if p == page %} aria-current="page"{% endif %}>{{ p }}</a>
          {% set shown = shown|merge([p]) %}
        {% endif %}
      {% endfor %}
      <a class="co-page-btn{{ page >= pageCount ? ' is-off' }}" href="{{ path(route, params|merge({page: page + 1})) }}" aria-label="Page suivante">{{ co.icon('chevron-right', 12) }}</a>
    </span>
  </nav>
{% endmacro %}

{# The flash messages of the console, as banners. #}
{% macro flashes() %}
  {% import _self as co %}
  {% set messages = app.flashes %}
  {% if messages|length > 0 %}
    <div class="co-flashes">
      {% for type, list in messages %}
        {% for message in list %}
          {% set kind = type == 'error' ? 'danger' : (type == 'success' ? 'success' : (type == 'warning' ? 'warning' : 'info')) %}
          <div class="co-banner is-{{ kind }}" role="status">
            {{ co.icon(kind == 'success' ? 'check-circle' : (kind == 'info' ? 'info' : 'warning'), 14) }}
            <span>{{ message }}</span>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  {% endif %}
{% endmacro %}
