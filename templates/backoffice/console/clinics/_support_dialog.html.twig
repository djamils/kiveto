{# D1 — « Démarrer une session support ». #}
{% import 'backoffice/console/_macros.html.twig' as co %}
<dialog class="co-modal" id="dialog-support" aria-labelledby="dialog-support-title" data-action="click->co-dialog#backdrop">
  <form method="post" action="{{ sheet.support_url }}">
    <input type="hidden" name="_token" value="{{ csrf_token('backoffice_clinic') }}">
    <header class="co-dialog-head">
      <div><h2 id="dialog-support-title">Démarrer une session support</h2><span>{{ sheet.clinic.name }}</span></div>
      <button class="co-btn is-white is-icon" type="button" data-action="co-dialog#close" aria-label="Fermer">{{ co.icon('x', 14) }}</button>
    </header>
    <div class="co-dialog-body">
      {% if support_error|default(null) %}<div class="co-error-box" role="alert">{{ support_error }}</div>{% endif %}
      {% if sheet.support.members|length == 0 %}
        <div class="co-banner is-warning">{{ co.icon('warning', 14) }} <span>Personne n'a encore activé son compte dans cette clinique : il n'y a personne en tant que qui se connecter.</span></div>
      {% else %}
        <fieldset class="co-field co-people">
          <legend class="co-field-label">Se connecter en tant que</legend>
          {% for person in sheet.support.members %}
            <label class="co-person">
              <input type="radio" name="user" value="{{ person.userId }}"{% if loop.first %} checked{% endif %}>
              <span class="co-initials">{{ person.name|co_initials }}</span>
              <span><b>{{ person.name }}</b><small>{{ person.role }}</small></span>
            </label>
          {% endfor %}
        </fieldset>
      {% endif %}
      <div class="co-field">
        <label for="support-reason">Motif (obligatoire, journalisé)</label>
        <textarea class="co-textarea" id="support-reason" name="reason" rows="2" maxlength="500" required></textarea>
      </div>
      <div class="co-row2">
        <div class="co-field">
          <label for="support-minutes">Durée</label>
          <select class="co-select" id="support-minutes" name="minutes">
            <option value="15">15 minutes</option>
            <option value="30" selected>30 minutes</option>
            <option value="60">1 heure</option>
          </select>
        </div>
        <div class="co-field">
          <label for="support-mode">Mode</label>
          <select class="co-select" id="support-mode" name="mode">
            <option value="read" selected>Lecture seule</option>
            <option value="write"{% if not sheet.support.can_write %} disabled{% endif %}>Lecture et écriture{% if not sheet.support.can_write %} (non activée){% endif %}</option>
          </select>
        </div>
      </div>
      <div class="co-banner is-warning">{{ co.icon('warning', 14) }} <span>La session apparaît dans le journal d'audit de la clinique, visible par ses administrateurs.</span></div>
    </div>
    <footer class="co-dialog-foot">
      <button class="co-btn is-white" type="button" data-action="co-dialog#close">Annuler</button>
      <button class="co-btn is-primary" type="submit"{% if sheet.support.members|length == 0 %} disabled{% endif %}>Démarrer la session</button>
    </footer>
  </form>
</dialog>
