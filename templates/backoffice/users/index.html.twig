{# Backoffice — Users listing page #}
{% extends 'backoffice/base.html.twig' %}

{% block page_title %}Utilisateurs{% endblock %}

{% block content %}
  {# Filters #}
  <div class="widget widget-pad" style="margin-bottom:var(--space-4);">
    <h3 style="font-size:var(--text-base);font-weight:var(--weight-semibold);color:var(--text-primary);margin-bottom:var(--space-3);">
      Filtrer
    </h3>
    <form method="get" action="{{ path('backoffice_users') }}" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:var(--space-3);align-items:end;">
      <div class="field">
        <label class="field-label">Recherche (email)</label>
        <input name="search" class="form-input" value="{{ filters.search }}" placeholder="user@example.com">
      </div>
      <div class="field">
        <label class="field-label">Type</label>
        {# Custom select component for type filter #}
        {{ include('components/ui/select.html.twig', {
          name: 'type',
          id: 'type',
          placeholder: '(tous)',
          value: filters.type,
          options: [
            { value: 'CLINIC_MEMBER', label: 'Clinic Member' },
            { value: 'CLINIC_ADMIN', label: 'Clinic Admin' },
            { value: 'PLATFORM_ADMIN', label: 'Platform Admin' },
          ],
          clearable: true,
        }) }}
      </div>
      <div class="field">
        <label class="field-label">Statut</label>
        {# Custom select component for status filter #}
        {{ include('components/ui/select.html.twig', {
          name: 'status',
          id: 'status',
          placeholder: '(tous)',
          value: filters.status,
          options: [
            { value: 'ACTIVE', label: 'Active' },
            { value: 'SUSPENDED', label: 'Suspended' },
            { value: 'PENDING', label: 'Pending' },
          ],
          clearable: true,
        }) }}
      </div>
      <div>
        <button type="submit" class="btn btn-primary">Rechercher</button>
      </div>
    </form>
  </div>

  {# Results table #}
  <div class="widget" style="margin-bottom:var(--space-4);">
    <div class="widget-pad" style="border-bottom:1px solid var(--border-default);">
      <h3 style="font-size:var(--text-base);font-weight:var(--weight-semibold);color:var(--text-primary);">
        Resultats ({{ collection.total }})
      </h3>
    </div>
    <div style="overflow-x:auto;">
      <table class="data-table">
        <thead class="dt-head">
          <tr>
            <th>ID (UUID)</th>
            <th>Email</th>
            <th>Type</th>
            <th>Statut</th>
            <th>Email verifie</th>
            <th>Cree le</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody class="dt-body">
          {% for user in collection.users %}
            <tr class="dt-row">
              <td>
                <code style="font-size:var(--text-xs);display:inline-block;max-width:200px;overflow:hidden;text-overflow:ellipsis;">{{ user.id }}</code>
                <button
                  onclick="navigator.clipboard.writeText('{{ user.id }}');this.textContent='OK'"
                  class="btn btn-sm btn-ghost"
                  style="font-size:var(--text-xs);padding:2px 6px;"
                >
                  copier
                </button>
              </td>
              <td>{{ user.email }}</td>
              <td>
                {% if user.type == 'PLATFORM_ADMIN' %}
                  <span class="badge b-fail">{{ user.type }}</span>
                {% elseif user.type == 'CLINIC_ADMIN' %}
                  <span class="badge b-wait">{{ user.type }}</span>
                {% else %}
                  <span class="badge b-muted">{{ user.type }}</span>
                {% endif %}
              </td>
              <td>
                {% if user.status == 'ACTIVE' %}
                  <span class="badge b-ok">{{ user.status }}</span>
                {% elseif user.status == 'SUSPENDED' %}
                  <span class="badge b-fail">{{ user.status }}</span>
                {% else %}
                  <span class="badge b-muted">{{ user.status }}</span>
                {% endif %}
              </td>
              <td>
                {% if user.emailVerifiedAt %}
                  <span style="color:var(--color-green-600);">{{ user.emailVerifiedAt|date('Y-m-d H:i') }}</span>
                {% else %}
                  <span style="color:var(--color-red-600);">Non verifie</span>
                {% endif %}
              </td>
              <td>{{ user.createdAt|date('Y-m-d H:i') }}</td>
              <td>
                <a href="{{ path('backoffice_clinic_memberships_new') }}?user_id={{ user.id }}" class="btn btn-sm btn-primary">
                  Ajouter a une clinique
                </a>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="7" style="text-align:center;padding:var(--space-4);color:var(--text-subtle);">
                Aucun utilisateur trouve
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  {# Info note #}
  <div class="widget widget-pad">
    <h3 style="font-size:var(--text-base);font-weight:var(--weight-semibold);color:var(--text-primary);margin-bottom:var(--space-2);">
      Info
    </h3>
    <p style="color:var(--text-subtle);margin:0;">
      Pour creer des utilisateurs, utilisez l'interface Portal (inscription) ou creez-les via fixture/migration.
      Cette page permet de voir les UUIDs des utilisateurs pour les assigner aux cliniques.
    </p>
  </div>
{% endblock %}
