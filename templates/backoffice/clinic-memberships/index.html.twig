{# Backoffice — Clinic memberships listing page #}
{% extends 'backoffice/base.html.twig' %}

{% block page_title %}Membres cliniques{% endblock %}

{% block content %}
  {# Action bar #}
  <div style="margin-bottom:var(--space-4);">
    <a href="{{ path('backoffice_clinic_memberships_new') }}" class="btn btn-primary">
      Creer une membership
    </a>
  </div>

  {# Filters #}
  <div class="widget widget-pad" style="margin-bottom:var(--space-4);">
    <h3 style="font-size:var(--text-base);font-weight:var(--weight-semibold);color:var(--text-primary);margin-bottom:var(--space-3);">
      Filtrer
    </h3>
    <form method="get" action="{{ path('backoffice_clinic_memberships') }}" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:var(--space-3);align-items:end;">
      <div class="field">
        <label class="field-label">Statut</label>
        <select name="status" class="form-input">
          <option value="">(tous)</option>
          <option value="ACTIVE" {{ filters.status == 'ACTIVE' ? 'selected' : '' }}>Active</option>
          <option value="DISABLED" {{ filters.status == 'DISABLED' ? 'selected' : '' }}>Disabled</option>
        </select>
      </div>
      <div class="field">
        <label class="field-label">Role</label>
        <select name="role" class="form-input">
          <option value="">(tous)</option>
          <option value="CLINIC_ADMIN" {{ filters.role == 'CLINIC_ADMIN' ? 'selected' : '' }}>Clinic Admin</option>
          <option value="VETERINARY" {{ filters.role == 'VETERINARY' ? 'selected' : '' }}>Veterinary</option>
          <option value="ASSISTANT_VETERINARY" {{ filters.role == 'ASSISTANT_VETERINARY' ? 'selected' : '' }}>Assistant Veterinary</option>
        </select>
      </div>
      <div class="field">
        <label class="field-label">Engagement</label>
        <select name="engagement" class="form-input">
          <option value="">(tous)</option>
          <option value="EMPLOYEE" {{ filters.engagement == 'EMPLOYEE' ? 'selected' : '' }}>Employee</option>
          <option value="CONTRACTOR" {{ filters.engagement == 'CONTRACTOR' ? 'selected' : '' }}>Contractor</option>
        </select>
      </div>
      <div class="field">
        <label class="field-label">Clinic ID</label>
        <input name="clinic_id" class="form-input" value="{{ filters.clinic_id }}">
      </div>
      <div class="field">
        <label class="field-label">User ID</label>
        <input name="user_id" class="form-input" value="{{ filters.user_id }}">
      </div>
      <div>
        <button type="submit" class="btn btn-primary">Rechercher</button>
      </div>
    </form>
  </div>

  {# Results table #}
  <div class="widget">
    <div class="widget-pad" style="border-bottom:1px solid var(--border-default);">
      <h3 style="font-size:var(--text-base);font-weight:var(--weight-semibold);color:var(--text-primary);">
        Resultats ({{ collection.total }})
      </h3>
    </div>
    <div style="overflow-x:auto;">
      <table class="data-table">
        <thead class="dt-head">
          <tr>
            <th>ID</th>
            <th>Clinic</th>
            <th>User</th>
            <th>Role</th>
            <th>Engagement</th>
            <th>Status</th>
            <th>Valid From</th>
            <th>Valid Until</th>
            <th style="width:200px;">Actions</th>
          </tr>
        </thead>
        <tbody class="dt-body">
          {% for membership in collection.memberships %}
            <tr class="dt-row">
              <td><small><code>{{ membership.membershipId|slice(0, 8) }}</code></small></td>
              <td>
                {{ membership.clinicName }}<br>
                <small style="color:var(--text-subtle);"><code>{{ membership.clinicId|slice(0, 8) }}</code></small>
              </td>
              <td>
                {{ membership.userEmail }}<br>
                <small style="color:var(--text-subtle);"><code>{{ membership.userId|slice(0, 8) }}</code></small>
              </td>
              <td>
                <span class="badge b-info">{{ membership.role.value }}</span>
              </td>
              <td>
                <span class="badge b-muted">{{ membership.engagement.value }}</span>
              </td>
              <td>
                {% if membership.status.value == 'ACTIVE' %}
                  <span class="badge b-ok">{{ membership.status.value }}</span>
                {% else %}
                  <span class="badge b-fail">{{ membership.status.value }}</span>
                {% endif %}
              </td>
              <td><small>{{ membership.validFrom|date('Y-m-d H:i') }}</small></td>
              <td>
                {% if membership.validUntil %}
                  <small>{{ membership.validUntil|date('Y-m-d H:i') }}</small>
                {% else %}
                  <small style="color:var(--text-subtle);">&infin;</small>
                {% endif %}
              </td>
              <td>
                {% if membership.status.value == 'ACTIVE' %}
                  <form method="post" action="{{ path('backoffice_clinic_memberships_disable', {id: membership.membershipId}) }}" style="display:inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                    <button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('Desactiver cette membership ?')">Disable</button>
                  </form>
                {% else %}
                  <form method="post" action="{{ path('backoffice_clinic_memberships_enable', {id: membership.membershipId}) }}" style="display:inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                    <button type="submit" class="btn btn-sm btn-success">Enable</button>
                  </form>
                {% endif %}
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="9" style="text-align:center;padding:var(--space-4);color:var(--text-subtle);">
                Aucun resultat
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% endblock %}
