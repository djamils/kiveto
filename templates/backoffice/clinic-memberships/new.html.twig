{# Backoffice — Create new clinic membership form #}
{% extends 'backoffice/base.html.twig' %}

{% block page_title %}Creer une Clinic Membership{% endblock %}

{% block content %}
  <div class="widget widget-pad" style="max-width:640px;">
    <form method="post" action="{{ path('backoffice_clinic_memberships_create') }}" style="display:flex;flex-direction:column;gap:var(--space-3);">
      <input type="hidden" name="_token" value="{{ csrf_token }}">

      <div class="field">
        <label class="field-label">Clinic *</label>
        <select name="clinic_id" class="form-input" required>
          <option value="">-- Selectionner une clinique --</option>
          {% for clinic in clinics.clinics %}
            <option value="{{ clinic.id }}">{{ clinic.name }} ({{ clinic.slug }})</option>
          {% endfor %}
        </select>
      </div>

      <div class="field">
        <label class="field-label">
          User ID (UUID) *
          <a href="{{ path('backoffice_users') }}" target="_blank" style="color:var(--brand-600);text-decoration:none;font-size:var(--text-xs);margin-left:var(--space-1);">
            Voir la liste des users
          </a>
        </label>
        <input type="text" name="user_id" class="form-input" style="font-family:monospace;"
               required placeholder="ex: 01234567-89ab-cdef-0123-456789abcdef"
               value="{{ app.request.query.get('user_id', '') }}">
        <small style="color:var(--text-subtle);">Saisissez l'UUID de l'utilisateur ou utilisez le bouton "Ajouter a une clinique" depuis la liste des users</small>
      </div>

      <div class="field">
        <label class="field-label">Role *</label>
        <select name="role" class="form-input" required>
          <option value="">-- Selectionner un role --</option>
          <option value="CLINIC_ADMIN">Clinic Admin</option>
          <option value="VETERINARY">Veterinary</option>
          <option value="ASSISTANT_VETERINARY">Assistant Veterinary</option>
        </select>
      </div>

      <div class="field">
        <label class="field-label">Engagement *</label>
        <select name="engagement" class="form-input" required>
          <option value="">-- Selectionner un engagement --</option>
          <option value="EMPLOYEE">Employee</option>
          <option value="CONTRACTOR">Contractor (freelance)</option>
        </select>
      </div>

      <div class="field">
        <label class="field-label">Valid From (UTC)</label>
        <input type="datetime-local" name="valid_from" class="form-input">
        <small style="color:var(--text-subtle);">Laisser vide pour utiliser la date actuelle</small>
      </div>

      <div class="field">
        <label class="field-label">Valid Until (UTC)</label>
        <input type="datetime-local" name="valid_until" class="form-input">
        <small style="color:var(--text-subtle);">Optionnel. Laisser vide pour pas de limite (recommande pour EMPLOYEE)</small>
      </div>

      <div style="display:flex;gap:var(--space-2);margin-top:var(--space-2);">
        <button type="submit" class="btn btn-primary">Creer</button>
        <a href="{{ path('backoffice_clinic_memberships') }}" class="btn btn-secondary">Annuler</a>
      </div>
    </form>
  </div>
{% endblock %}
