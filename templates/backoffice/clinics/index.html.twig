{# Backoffice — Clinics listing page #}
{% extends 'backoffice/base.html.twig' %}

{% block page_title %}Cliniques{% endblock %}

{% block content %}
  {# Action bar #}
  <div style="display:flex;gap:var(--space-2);margin-bottom:var(--space-4);">
    <a href="{{ path('backoffice_clinics_new') }}" class="btn btn-primary">
      Creer une clinique
    </a>
    <a href="{{ path('backoffice_clinic_groups') }}" class="btn btn-secondary">
      Gerer les groupes
    </a>
  </div>

  {# Filters #}
  <div class="widget widget-pad" style="margin-bottom:var(--space-4);">
    <h3 style="font-size:var(--text-base);font-weight:var(--weight-semibold);color:var(--text-primary);margin-bottom:var(--space-3);">
      Filtrer
    </h3>
    <form method="get" action="{{ path('backoffice_clinics') }}" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:var(--space-3);align-items:end;">
      <div class="field">
        <label class="field-label">Statut</label>
        {# Custom select component for status filter #}
        {{ include('components/ui/select.html.twig', {
          name: 'status',
          id: 'status',
          placeholder: '(tous)',
          value: filters.status,
          options: [
            { value: 'active', label: 'Active' },
            { value: 'suspended', label: 'Suspended' },
            { value: 'closed', label: 'Closed' },
          ],
          clearable: true,
        }) }}
      </div>
      <div class="field">
        <label class="field-label">Groupe</label>
        {# Custom select component for group filter — options built from dynamic list #}
        {% set group_options = [] %}
        {% for group in groups.clinicGroups %}
          {% set group_options = group_options|merge([{ value: group.id, label: group.name }]) %}
        {% endfor %}
        {{ include('components/ui/select.html.twig', {
          name: 'group_id',
          id: 'group_id',
          placeholder: '(tous)',
          value: filters.group_id,
          options: group_options,
          clearable: true,
          searchable: true,
        }) }}
      </div>
      <div class="field" style="grid-column:span 2;">
        <label class="field-label">Recherche (nom ou slug)</label>
        <input name="search" class="form-input" value="{{ filters.search }}">
      </div>
      <div>
        <button type="submit" class="btn btn-primary">Rechercher</button>
      </div>
    </form>
  </div>

  {# Results table #}
  <div class="widget">
    <div class="widget-pad" style="border-bottom:1px solid var(--border-default);">
      <h3 style="font-size:var(--text-base);font-weight:var(--weight-semibold);color:var(--text-primary);">
        Resultats ({{ collection.total }})
      </h3>
    </div>
    <div style="overflow-x:auto;">
      <table class="data-table">
        <thead class="dt-head">
          <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Slug</th>
            <th>Timezone</th>
            <th>Locale</th>
            <th>Statut</th>
            <th>Groupe</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody class="dt-body">
          {% for clinic in collection.clinics %}
            <tr class="dt-row">
              <td><small><code>{{ clinic.id|slice(0, 8) }}</code></small></td>
              <td>{{ clinic.name }}</td>
              <td><code>{{ clinic.slug }}</code></td>
              <td>{{ clinic.timeZone }}</td>
              <td>{{ clinic.locale }}</td>
              <td>
                {% if clinic.status.value == 'active' %}
                  <span class="badge b-ok">{{ clinic.status.value }}</span>
                {% elseif clinic.status.value == 'suspended' %}
                  <span class="badge b-wait">{{ clinic.status.value }}</span>
                {% else %}
                  <span class="badge b-fail">{{ clinic.status.value }}</span>
                {% endif %}
              </td>
              <td>
                {% if clinic.clinicGroupId %}
                  <small><code>{{ clinic.clinicGroupId|slice(0, 8) }}</code></small>
                {% else %}
                  &mdash;
                {% endif %}
              </td>
              <td>
                <a href="{{ path('backoffice_clinics_edit', {id: clinic.id}) }}" class="btn btn-sm btn-secondary">
                  Editer
                </a>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="8" style="text-align:center;padding:var(--space-4);color:var(--text-subtle);">
                Aucun resultat
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% endblock %}
