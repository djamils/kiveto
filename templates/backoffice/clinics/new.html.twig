{# Backoffice — Create new clinic form #}
{% extends 'backoffice/base.html.twig' %}

{% block page_title %}Creer une Clinique{% endblock %}

{% block content %}
  <div class="widget widget-pad" style="max-width:640px;">
    <form method="post" action="{{ path('backoffice_clinics_create') }}">
      <input type="hidden" name="_token" value="{{ csrf_token }}">

      <div class="field" style="margin-bottom:var(--space-3);">
        <label class="field-label">Nom *</label>
        <input name="name" class="form-input" required>
      </div>

      <div class="field" style="margin-bottom:var(--space-3);">
        <label class="field-label">Slug * <small style="color:var(--text-subtle);">(format: a-z, 0-9, -)</small></label>
        <input name="slug" class="form-input" pattern="[a-z0-9-]+" required>
      </div>

      <div class="field" style="margin-bottom:var(--space-3);">
        <label class="field-label">Timezone * <small style="color:var(--text-subtle);">(IANA format)</small></label>
        <input name="time_zone" class="form-input" value="Europe/Paris" required>
        <small style="color:var(--text-subtle);">Ex: Europe/Paris, America/New_York, UTC</small>
      </div>

      <div class="field" style="margin-bottom:var(--space-3);">
        <label class="field-label">Locale * <small style="color:var(--text-subtle);">(format: fr-FR, en-US)</small></label>
        <input name="locale" class="form-input" value="fr-FR" pattern="[a-z]{2}-[A-Z]{2}" required>
      </div>

      <div class="field" style="margin-bottom:var(--space-4);">
        <label class="field-label">Groupe (optionnel)</label>
        <select name="clinic_group_id" class="form-input">
          <option value="">(aucun)</option>
          {% for group in groups.clinicGroups %}
            {% if group.status.value == 'active' %}
              <option value="{{ group.id }}">{{ group.name }}</option>
            {% endif %}
          {% endfor %}
        </select>
      </div>

      <div style="display:flex;gap:var(--space-2);">
        <button type="submit" class="btn btn-primary">Creer la clinique</button>
        <a href="{{ path('backoffice_clinics') }}" class="btn btn-secondary">Annuler</a>
      </div>
    </form>
  </div>
{% endblock %}
