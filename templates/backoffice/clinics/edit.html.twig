{# Backoffice — Edit clinic form #}
{% extends 'backoffice/base.html.twig' %}

{% block page_title %}Editer la Clinique{% endblock %}

{% block content %}
  <div class="widget widget-pad" style="max-width:640px;">
    <form method="post" action="{{ path('backoffice_clinics_update', {id: clinic.id}) }}">
      <input type="hidden" name="_token" value="{{ csrf_token }}">

      <div class="field" style="margin-bottom:var(--space-3);">
        <label class="field-label">ID</label>
        <input class="form-input" value="{{ clinic.id }}" disabled>
      </div>

      <div class="field" style="margin-bottom:var(--space-3);">
        <label class="field-label">Nom *</label>
        <input name="name" class="form-input" value="{{ clinic.name }}" required>
      </div>

      <div class="field" style="margin-bottom:var(--space-3);">
        <label class="field-label">Slug * <small style="color:var(--text-subtle);">(format: a-z, 0-9, -)</small></label>
        <input name="slug" class="form-input" value="{{ clinic.slug }}" pattern="[a-z0-9-]+" required>
      </div>

      <div class="field" style="margin-bottom:var(--space-3);">
        <label class="field-label">Timezone * <small style="color:var(--text-subtle);">(IANA format)</small></label>
        <input name="time_zone" class="form-input" value="{{ clinic.timeZone }}" required>
      </div>

      <div class="field" style="margin-bottom:var(--space-3);">
        <label class="field-label">Locale * <small style="color:var(--text-subtle);">(format: fr-FR, en-US)</small></label>
        <input name="locale" class="form-input" value="{{ clinic.locale }}" pattern="[a-z]{2}-[A-Z]{2}" required>
      </div>

      <div class="field" style="margin-bottom:var(--space-3);">
        <label class="field-label">Statut *</label>
        <select name="status" class="form-input" required>
          <option value="active" {{ clinic.status.value == 'active' ? 'selected' : '' }}>Active</option>
          <option value="suspended" {{ clinic.status.value == 'suspended' ? 'selected' : '' }}>Suspended</option>
          <option value="closed" {{ clinic.status.value == 'closed' ? 'selected' : '' }}>Closed</option>
        </select>
      </div>

      <div class="field" style="margin-bottom:var(--space-3);">
        <label class="field-label">Groupe</label>
        <select name="clinic_group_id" class="form-input" disabled>
          <option value="">(aucun)</option>
          {% for group in groups.clinicGroups %}
            <option value="{{ group.id }}" {{ clinic.clinicGroupId == group.id ? 'selected' : '' }}>{{ group.name }}</option>
          {% endfor %}
        </select>
        <small style="color:var(--text-subtle);">Note: Le groupe ne peut etre modifie apres creation</small>
      </div>

      <div class="field" style="margin-bottom:var(--space-3);">
        <label class="field-label">Creee le (UTC)</label>
        <input class="form-input" value="{{ clinic.createdAt }}" disabled>
      </div>

      <div class="field" style="margin-bottom:var(--space-4);">
        <label class="field-label">Mise a jour le (UTC)</label>
        <input class="form-input" value="{{ clinic.updatedAt }}" disabled>
      </div>

      <div style="display:flex;gap:var(--space-2);">
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a href="{{ path('backoffice_clinics') }}" class="btn btn-secondary">Annuler</a>
      </div>
    </form>
  </div>
{% endblock %}
