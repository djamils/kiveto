{#
 # Kiveto -- templates/security/forgot_password.html.twig
 # « Mot de passe oublié » on the clinic host (public). Always the same
 # answer, whether an account exists for the address or not.
 #
 # Variables from controller:
 #   sent   bool         a request was just made (shows the answer)
 #   email  string|null  the address typed (after a refusal)
 #   error  string|null  why the form was refused
 #}
{% extends 'security/_auth_layout.html.twig' %}
{% import 'security/_account_macros.html.twig' as account %}

{% block title %}Mot de passe oublié — Kiveto{% endblock %}

{% block screens %}
  <section class="ecran on" id="e-oubli" aria-labelledby="t-oubli">
    <h1 class="titre" id="t-oubli">Mot de passe oublié</h1>
    {% if sent %}
      {{ account.info('Si un compte existe pour cette adresse, un e-mail vient d’être envoyé.') }}
      <p class="sous">Le lien qu’il contient est valable 30 minutes. Pensez à regarder dans les indésirables.</p>
      <a class="btn s" href="{{ path('clinic_login') }}"><span class="lb">Retour à la connexion</span></a>
    {% else %}
      <p class="sous">Saisissez l’adresse e-mail de votre compte : nous vous enverrons un lien pour choisir un nouveau mot de passe.</p>
      <form id="fOubli" action="{{ path('clinic_forgot_password_submit') }}" method="post" data-turbo="false" novalidate>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">
        <div class="champ"><label class="lbl" for="mail">E-mail</label><div class="inp{{ error|default(null) ? ' ko' : '' }}" id="iMail"><input id="mail" name="email" type="email" autocomplete="username" placeholder="prenom@clinique.fr" spellcheck="false" value="{{ email|default('') }}" required></div>
          <span class="aide{{ error|default(null) ? ' ko' : '' }}" id="mdpAide" aria-live="polite">{{ error|default('') }}</span></div>
        <button class="btn p" id="bOubli" type="submit"><span class="lb">Envoyer le lien</span><span class="spin"></span></button>
      </form>
      <p class="sous"><a class="lien" href="{{ path('clinic_login') }}">Retour à la connexion</a></p>
    {% endif %}
  </section>
{% endblock %}
