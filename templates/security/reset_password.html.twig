{#
 # Kiveto -- templates/security/reset_password.html.twig
 # The reset link of the e-mail (public); the secret is in the session.
 #
 # Variables from controller:
 #   state  'form' | 'invalid'
 #   email  string|null  the account (form)
 #   error  string|null  why the form was refused
 #}
{% extends 'security/_auth_layout.html.twig' %}
{% import 'security/_account_macros.html.twig' as account %}

{% block title %}Nouveau mot de passe — Kiveto{% endblock %}

{% block screens %}
  <section class="ecran on" id="e-reinit" aria-labelledby="t-reinit">
    {% if state == 'invalid' %}
      <h1 class="titre" id="t-reinit">Ce lien n’est plus valide</h1>
      <p class="sous">Il a déjà servi, a été remplacé par un plus récent ou a expiré (30 minutes).</p>
      <a class="btn p" href="{{ path('clinic_forgot_password') }}"><span class="lb">Demander un nouveau lien</span></a>
      <p class="sous"><a class="lien" href="{{ path('clinic_login') }}">Retour à la connexion</a></p>
    {% else %}
      <h1 class="titre" id="t-reinit">Nouveau mot de passe</h1>
      <p class="sous">{% if email|default(null) %}Pour le compte <b>{{ email }}</b>. {% endif %}Toutes les sessions ouvertes seront déconnectées.</p>
      <form id="fNouveau" action="{{ path('clinic_reset_password_submit') }}" method="post" data-turbo="false" novalidate>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">
        {{ account.new_password(error|default(null)) }}
        <button class="btn p" id="bNouveau" type="submit"><span class="lb">Enregistrer le mot de passe</span><span class="spin"></span></button>
      </form>
    {% endif %}
  </section>
{% endblock %}
