{#
 # Kiveto — templates/security/lock.html.twig
 # ───────────────────────────────────────────
 # Screen lock page — standalone, no sidebar.
 # Shows clock, user info, and password form.
 #
 # Variables:
 #   clinicName  string|null   Active clinic name (from session)
 #}
{% extends 'base.html.twig' %}

{% block title %}Verrouillé{% endblock %}

{% block stylesheets %}
<style>
  /* Dark background matching login page */
  html { height: 100%; }
  body {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--brand-950);
    background-image:
      radial-gradient(ellipse 60% 55% at 20% 25%, rgba(67,56,202,.22) 0%, transparent 60%),
      radial-gradient(ellipse 50% 50% at 80% 75%, rgba(139,92,246,.12) 0%, transparent 55%);
    background-attachment: fixed;
    overflow-x: hidden;
    overflow-y: auto;
    padding: var(--space-6) var(--space-4);
  }

  /* Grid overlay */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      repeating-linear-gradient(0deg, transparent, transparent 47px, rgba(255,255,255,.016) 47px, rgba(255,255,255,.016) 48px),
      repeating-linear-gradient(90deg, transparent, transparent 47px, rgba(255,255,255,.016) 47px, rgba(255,255,255,.016) 48px);
    pointer-events: none;
    z-index: 0;
  }

  .lock-shell {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 360px;
    margin: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  /* Clock */
  .clock-block { text-align: center; user-select: none; }
  .lock-clock {
    font-size: clamp(56px, 12vw, 80px);
    font-weight: var(--weight-medium);
    color: #fff;
    letter-spacing: -3px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .lock-datestr {
    font-size: var(--text-base);
    color: rgba(255,255,255,.4);
    font-weight: var(--weight-normal);
    margin-top: var(--space-1);
  }

  /* User block */
  .lock-user-block {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .lock-user-avatar {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: rgba(255,255,255,.1);
    border: 1px solid rgba(255,255,255,.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    color: #fff;
    flex-shrink: 0;
  }
  .lock-user-name {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: #fff;
    line-height: var(--lh-tight);
  }
  .lock-user-clinic {
    font-size: var(--text-sm);
    color: rgba(255,255,255,.4);
    margin-top: 2px;
  }

  /* Unlock form */
  .lock-form {
    width: 100%;
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.1);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }
  .lock-form-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: rgba(255,255,255,.4);
    text-transform: uppercase;
    letter-spacing: .07em;
    text-align: center;
    margin-bottom: var(--space-3);
    display: block;
  }
  .lock-pwd-field { position: relative; margin-bottom: var(--space-3); }
  .lock-pwd-input {
    width: 100%;
    height: 40px;
    font-size: var(--text-base);
    font-family: inherit;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: var(--radius-md);
    padding: 0 40px 0 var(--space-3);
    outline: none;
    color: #fff;
    letter-spacing: .15em;
    transition: border-color .15s, background .15s, box-shadow .15s;
  }
  .lock-pwd-input::placeholder { color: rgba(255,255,255,.25); letter-spacing: normal; }
  .lock-pwd-input:hover { border-color: rgba(255,255,255,.2); background: rgba(255,255,255,.1); }
  .lock-pwd-input:focus { border-color: rgba(99,102,241,.7); background: rgba(255,255,255,.1); box-shadow: 0 0 0 3px rgba(99,102,241,.15); }

  .lock-btn-unlock {
    width: 100%;
    height: 40px;
    border-radius: var(--radius-md);
    border: none;
    background: var(--brand-600);
    color: #fff;
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    font-family: inherit;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    transition: background .16s;
  }
  .lock-btn-unlock:hover { background: var(--brand-700); }

  .lock-btn-switch {
    font-size: var(--text-sm);
    color: rgba(255,255,255,.3);
    background: none;
    border: none;
    font-family: inherit;
    cursor: pointer;
    transition: color .15s;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    text-decoration: none;
  }
  .lock-btn-switch:hover { color: rgba(255,255,255,.65); }

  /* Responsive */
  @media (max-width: 480px) {
    body { padding: var(--space-4); }
    .lock-shell { gap: var(--space-5); }
    .lock-pwd-input, .lock-btn-unlock { height: 44px; }
    .lock-form { padding: var(--space-4); }
  }
  @media (max-height: 560px) {
    body { padding: var(--space-3) var(--space-4); justify-content: flex-start; }
    .lock-shell { gap: var(--space-4); margin: var(--space-4) auto; }
    .lock-clock { font-size: 48px; }
    .lock-datestr { display: none; }
  }
</style>
{% endblock %}

{% block body %}
<div class="lock-shell">

  {# Clock #}
  <div class="clock-block" aria-live="polite" aria-label="Heure actuelle">
    <div class="lock-clock" id="lock-clock" aria-hidden="true"></div>
    <div class="lock-datestr" id="lock-datestr"></div>
  </div>

  {# Logged-in user #}
  <div class="lock-user-block">
    <div class="lock-user-avatar" aria-hidden="true">
      {{ app.user.email|default('U')|first|upper }}
    </div>
    <div>
      <div class="lock-user-name">{{ app.user.email|default('Utilisateur') }}</div>
      <div class="lock-user-clinic">{{ clinicName|default('') }}</div>
    </div>
  </div>

  {# Unlock form — stub UI, redirects to dashboard #}
  <form class="lock-form" method="post" action="{{ path('clinic_dashboard') }}">
    <label class="lock-form-label" for="lock-pwd">Mot de passe</label>
    <div class="lock-pwd-field">
      <input
        class="lock-pwd-input"
        id="lock-pwd"
        type="password"
        placeholder="Entrez votre mot de passe"
        autocomplete="current-password"
        aria-label="Mot de passe"
      />
    </div>
    <button class="lock-btn-unlock" type="submit">
      <svg width="13" height="13" fill="none" viewBox="0 0 14 14" aria-hidden="true">
        <rect x="2" y="6" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
        <path d="M4 6V4a3 3 0 016 0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
      </svg>
      Déverrouiller
    </button>
  </form>

  {# Link to login page #}
  <a class="lock-btn-switch" href="{{ path('clinic_login') }}">
    Se connecter avec un autre compte
  </a>

</div>
{% endblock %}

{% block javascripts %}
<script type="module">
  function tick() {
    const now = new Date();
    const hh = String(now.getHours()).padStart(2, '0');
    const mm = String(now.getMinutes()).padStart(2, '0');
    const clockEl = document.getElementById('lock-clock');
    const dateEl = document.getElementById('lock-datestr');
    if (clockEl) clockEl.textContent = `${hh}:${mm}`;
    if (dateEl) dateEl.textContent = now.toLocaleDateString('fr-FR', {
      weekday: 'long', day: 'numeric', month: 'long'
    });
  }
  tick();
  setInterval(tick, 10000);
</script>
{% endblock %}
