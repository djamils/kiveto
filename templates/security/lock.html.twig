{#
 # Kiveto -- templates/security/lock.html.twig
 # Locked session, on the sign-in stage of connexion_3.html (the identity block
 # of the PIN screen above the password field of the sign-in screen). The
 # member, initials and clinic come from clinic_shell().
 #
 # Unlocking keeps its previous behaviour: the password is asked for, then the
 # dashboard is reopened (no server-side check yet). The PIN code has no
 # backend, so the password field stands in for it.
 #}
{% extends 'security/_auth_layout.html.twig' %}

{% block title %}Session verrouillée — Kiveto{% endblock %}

{% block screens %}
  {% set _shell = clinic_shell() %}
  <section class="ecran centre on" id="e-verrou" aria-labelledby="t-verrou">
    <a class="retourb" href="{{ path('_logout_clinic') }}" data-turbo="false"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg>Changer de compte</a>
    <div class="qui"><span class="av" style="background:var(--pin)">{{ _shell.user.initials }}</span><h1 class="titre" id="t-verrou">{{ _shell.user.name }}</h1></div>
    <p class="sous">Session verrouillée{% if _shell.currentClinic %} · <b>{{ _shell.currentClinic.name }}</b>{% endif %}. Saisissez votre mot de passe.</p>
    <form id="fVerrou" action="{{ path('clinic_dashboard') }}" method="get" novalidate style="width:100%;text-align:left">
      <div class="champ"><label class="lbl" for="mdp">Mot de passe</label>
        <div class="inp" id="iMdp"><input id="mdp" class="avec-oeil" type="password" autocomplete="current-password"><button type="button" class="oeil" id="oeil" aria-label="Afficher le mot de passe" aria-pressed="false"></button></div>
        <span class="aide" id="mdpAide" aria-live="polite"></span></div>
      <button class="btn p" id="bVerrou" type="submit"><span class="lb">Déverrouiller</span><span class="spin"></span></button>
    </form>
  </section>
{% endblock %}
