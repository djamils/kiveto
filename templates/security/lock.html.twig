{#
 # Kiveto -- templates/security/lock.html.twig
 # Screen lock page -- standalone, no sidebar.
 # Shows clock, user info, and password form.
 #
 # Variables:
 #   clinicName  string|null   Active clinic name (from session)
 #}
{% extends 'base.html.twig' %}

{% block title %}Verrouillé{% endblock %}

{% block stylesheets %}
<style>

    /* ─────────────────────────────────────────
       BASE -- dark background matching login
    ───────────────────────────────────────── */
    html { height: 100%; }

    body {
      min-height: 100%;
      height: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background-color: var(--brand-950);
      background-image:
        radial-gradient(ellipse 60% 55% at 20% 25%, rgba(67,56,202,.22) 0%, transparent 60%),
        radial-gradient(ellipse 50% 50% at 80% 75%, rgba(139,92,246,.12) 0%, transparent 55%);
      background-attachment: fixed;
      overflow-x: hidden;
      overflow-y: auto;
      padding: var(--space-6) var(--space-4);
    }

    /* Grid background (identical to login) */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        repeating-linear-gradient(0deg,  transparent, transparent 47px, rgba(255,255,255,.016) 47px, rgba(255,255,255,.016) 48px),
        repeating-linear-gradient(90deg, transparent, transparent 47px, rgba(255,255,255,.016) 47px, rgba(255,255,255,.016) 48px);
      pointer-events: none;
      z-index: 0;
    }

    /* ─────────────────────────────────────────
       MAIN SHELL
    ───────────────────────────────────────── */
    .lock-shell {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 360px;
      margin: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-6);
    }

    /* ─────────────────────────────────────────
       CLOCK
    ───────────────────────────────────────── */
    .clock-block {
      text-align: center;
      user-select: none;
    }

    .clock {
      /* 72px -- between --text-xl (20) and the original 80px
         Intentionally outside the type system for the clock --
         it is a decorative display element, not body text */
      font-size: clamp(56px, 12vw, 80px);
      font-weight: var(--weight-medium);  /* 500 instead of 700 -- more elegant */
      color: #fff;
      letter-spacing: -3px;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }

    .datestr {
      font-size: var(--text-base);   /* 14px -- in the system */
      color: rgba(255,255,255,.4);
      font-weight: var(--weight-normal);
      margin-top: var(--space-1);
    }

    /* ─────────────────────────────────────────
       USER BLOCK
    ───────────────────────────────────────── */
    .user-block {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .user-avatar {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-full);
      background: rgba(255,255,255,.1);
      border: 1px solid rgba(255,255,255,.15);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: var(--text-md);    /* 13px -- in the system */
      font-weight: var(--weight-medium);
      color: #fff;
      flex-shrink: 0;
    }

    .user-name {
      font-size: var(--text-base);  /* 14px -- in the system */
      font-weight: var(--weight-medium);
      color: #fff;
      line-height: var(--lh-tight);
    }

    .user-clinic {
      font-size: var(--text-sm);    /* 12px -- in the system */
      color: rgba(255,255,255,.4);
      font-weight: var(--weight-normal);
      margin-top: 2px;
    }

    /* ─────────────────────────────────────────
       UNLOCK FORM
    ───────────────────────────────────────── */
    .lock-form {
      width: 100%;
      background: rgba(255,255,255,.05);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: var(--radius-lg);    /* 12px -- in the system */
      padding: var(--space-5) var(--space-5);
      /* backdrop-filter removed -- poorly supported and causes glitches
         on some Android tablets */
    }

    .form-label {
      font-size: var(--text-xs);          /* 11px -- in the system */
      font-weight: var(--weight-medium);
      color: rgba(255,255,255,.4);
      text-transform: uppercase;
      letter-spacing: .07em;
      text-align: center;
      margin-bottom: var(--space-3);
      display: block;
    }

    /* Input + eye button wrapper */
    .pwd-field {
      position: relative;
      margin-bottom: var(--space-3);
    }

    .pwd-input {
      width: 100%;
      height: 40px;                       /* same height as login inputs */
      font-size: var(--text-base);
      font-family: inherit;
      background: rgba(255,255,255,.08);
      border: 1px solid rgba(255,255,255,.12);
      border-radius: var(--radius-md);
      padding: 0 40px 0 var(--space-3);
      outline: none;
      color: #fff;
      letter-spacing: .15em;
      transition: border-color .15s, background .15s, box-shadow .15s;
    }

    .pwd-input::placeholder {
      color: rgba(255,255,255,.25);
      letter-spacing: normal;
    }

    .pwd-input:hover {
      border-color: rgba(255,255,255,.2);
      background: rgba(255,255,255,.1);
    }

    .pwd-input:focus {
      border-color: rgba(99,102,241,.7);
      background: rgba(255,255,255,.1);
      box-shadow: 0 0 0 3px rgba(99,102,241,.15);
    }

    .pwd-input.is-error {
      border-color: rgba(239,68,68,.7);
    }

    /* Eye button */
    .eye-btn {
      position: absolute;
      right: var(--space-2);
      top: 50%;
      transform: translateY(-50%);
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: rgba(255,255,255,.3);
      background: none;
      border: none;
      border-radius: var(--radius-sm);
      transition: var(--transition-fast);
    }

    .eye-btn:hover { color: rgba(255,255,255,.7); }
    .eye-btn:active { transform: translateY(-50%) scale(.92); }

    /* Error message */
    .form-error {
      font-size: var(--text-sm);     /* 12px -- in the system */
      color: #f87171;
      text-align: center;
      min-height: 18px;
      margin-top: calc(-1 * var(--space-2));
      margin-bottom: var(--space-3);
    }

    /* Unlock button */
    .btn-unlock {
      width: 100%;
      height: 40px;
      border-radius: var(--radius-md);
      border: none;
      background: var(--brand-600);
      color: #fff;
      font-size: var(--text-base);
      font-weight: var(--weight-medium);
      font-family: inherit;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      transition: var(--transition-normal);
    }

    .btn-unlock:hover { background: var(--brand-700); }
    .btn-unlock:active { transform: translateY(1px); }
    .btn-unlock:disabled { opacity: .5; cursor: not-allowed; }
    .btn-unlock.is-loading { opacity: .7; pointer-events: none; }

    /* ─────────────────────────────────────────
       LOGOUT LINK
    ───────────────────────────────────────── */
    .btn-switch {
      font-size: var(--text-sm);      /* 12px -- in the system */
      color: rgba(255,255,255,.3);
      background: none;
      border: none;
      font-family: inherit;
      cursor: pointer;
      transition: color .15s;
      padding: var(--space-1) var(--space-2);
      border-radius: var(--radius-sm);
    }

    .btn-switch:hover { color: rgba(255,255,255,.65); }

    /* ─────────────────────────────────────────
       SHAKE ANIMATION (password error)
    ───────────────────────────────────────── */
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20%, 60%  { transform: translateX(-5px); }
      40%, 80%  { transform: translateX(5px); }
    }

    .shake { animation: shake .3s ease; }

    /* ─────────────────────────────────────────
       RESPONSIVE
    ───────────────────────────────────────── */

    /* Tablet portrait / landscape -- not much to do,
       the shell is already max-width 360px and centered.
       Mostly adjusting clock and input sizes */
    @media (max-width: 480px) {
      body {
        padding: var(--space-4) var(--space-4);
      }

      .lock-shell {
        gap: var(--space-5);
      }

      /* Larger inputs for touch */
      .pwd-input,
      .btn-unlock {
        height: 44px;
      }

      .lock-form {
        padding: var(--space-4) var(--space-4);
      }
    }

    /* Mobile landscape (reduced height) */
    @media (max-height: 560px) {
      body {
        padding: var(--space-3) var(--space-4);
        justify-content: flex-start;
      }

      .lock-shell {
        gap: var(--space-4);
        margin: var(--space-4) auto;
      }

      .clock {
        font-size: 48px;
      }

      .datestr {
        display: none;  /* sacrificed in compact mode */
      }
    }

    /* Very small mobiles */
    @media (max-width: 340px) {
      body {
        padding: var(--space-3) var(--space-3);
      }

      .lock-form {
        padding: var(--space-4) var(--space-3);
      }
    }

</style>
{% endblock %}

{% block body %}

<div class="lock-shell">

  {# Clock #}
  <div class="clock-block" aria-live="polite" aria-label="Heure actuelle">
    <div class="clock" id="clock" aria-hidden="true"></div>
    <div class="datestr" id="datestr"></div>
  </div>

  {# Logged-in user #}
  <div class="user-block">
    <div class="user-avatar" aria-hidden="true">{{ app.user.email|default('U')|first|upper }}{{ app.user.email|default('U')|slice(1,1)|upper }}</div>
    <div>
      <div class="user-name">{{ app.user.email|default('Utilisateur') }}</div>
      <div class="user-clinic" id="clinic-name">{{ clinicName|default('') }}</div>
    </div>
  </div>

  {# Unlock form #}
  <form class="lock-form" id="lock-form" method="post" action="{{ path('clinic_dashboard') }}">
    <label class="form-label" for="pwd">Mot de passe</label>

    <div class="pwd-field">
      <input
        class="pwd-input"
        id="pwd"
        name="_password"
        type="password"
        placeholder="Entrez votre mot de passe"
        autocomplete="current-password"
        aria-label="Mot de passe"
        aria-describedby="form-error"
        onkeydown="if(event.key==='Enter') doUnlock()"
      />
      <button
        class="eye-btn"
        id="eye-btn"
        onclick="togglePwd()"
        type="button"
        aria-label="Afficher le mot de passe"
        tabindex="-1"
      >
        <svg id="eye-icon" width="15" height="15" fill="none" viewBox="0 0 16 16">
          <ellipse cx="8" cy="8" rx="7" ry="4.5" stroke="currentColor" stroke-width="1.3"/>
          <circle cx="8" cy="8" r="2" fill="currentColor"/>
        </svg>
      </button>
    </div>

    <p class="form-error" id="form-error" role="alert" aria-live="polite"></p>

    <button
      class="btn-unlock"
      id="unlock-btn"
      onclick="doUnlock()"
      type="button"
      aria-label="Déverrouiller l'application"
    >
      <svg width="13" height="13" fill="none" viewBox="0 0 14 14" aria-hidden="true">
        <rect x="2" y="6" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
        <path d="M4 6V4a3 3 0 016 0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
      </svg>
      Déverrouiller
    </button>
  </form>

  {# Link to login page #}
  <button
    class="btn-switch"
    onclick="window.location.href='{{ path('clinic_login') }}'"
    type="button"
  >
    Se connecter avec un autre compte
  </button>

</div>

<div id="toast" role="status" aria-live="polite"></div>

{% endblock %}

{% block javascripts %}
<script>
  /* -- Clock -- */
  function tick() {
    const now = new Date();
    const hh  = String(now.getHours()).padStart(2, '0');
    const mm  = String(now.getMinutes()).padStart(2, '0');
    document.getElementById('clock').textContent = `${hh}:${mm}`;
    document.getElementById('datestr').textContent = now.toLocaleDateString('fr-FR', {
      weekday: 'long', day: 'numeric', month: 'long'
    });
  }
  tick();
  setInterval(tick, 10000);

  /* -- Toast -- */
  function toast(msg, color = '#16a34a', icon = '\u2713') {
    const t = document.getElementById('toast');
    if (!t) return;
    t.innerHTML = `<span aria-hidden="true">${icon}</span><span>${msg}</span>`;
    t.style.background = color;
    t.style.opacity = '1';
    t.style.transform = 'translateX(-50%) translateY(0)';
    clearTimeout(t._t);
    t._t = setTimeout(() => {
      t.style.opacity = '0';
      t.style.transform = 'translateX(-50%) translateY(8px)';
    }, 2500);
  }

  /* -- Toggle password visibility -- */
  let visible = false;
  function togglePwd() {
    visible = !visible;
    const input = document.getElementById('pwd');
    const icon  = document.getElementById('eye-icon');
    const btn   = document.getElementById('eye-btn');
    input.type = visible ? 'text' : 'password';
    btn.setAttribute('aria-label', visible ? 'Masquer le mot de passe' : 'Afficher le mot de passe');
    icon.innerHTML = visible
      ? `<ellipse cx="8" cy="8" rx="7" ry="4.5" stroke="currentColor" stroke-width="1.3"/>
         <line x1="3" y1="3" x2="13" y2="13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>`
      : `<ellipse cx="8" cy="8" rx="7" ry="4.5" stroke="currentColor" stroke-width="1.3"/>
         <circle cx="8" cy="8" r="2" fill="currentColor"/>`;
  }

  /* -- Unlock -- */
  function doUnlock() {
    const input   = document.getElementById('pwd');
    const errEl   = document.getElementById('form-error');
    const btn     = document.getElementById('unlock-btn');
    const form    = document.getElementById('lock-form');
    const val     = input.value;

    errEl.textContent = '';
    input.classList.remove('is-error');

    if (!val) {
      errEl.textContent = 'Entrez votre mot de passe.';
      input.focus();
      return;
    }

    /* Submit the form to the server */
    btn.disabled = true;
    btn.classList.add('is-loading');
    btn.innerHTML = `
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none"
        style="animation:spin .7s linear infinite;flex-shrink:0;" aria-hidden="true">
        <circle cx="7" cy="7" r="5" stroke="rgba(255,255,255,.3)" stroke-width="2"/>
        <path d="M7 2a5 5 0 015 5" stroke="white" stroke-width="2" stroke-linecap="round"/>
      </svg>
      Déverrouillage\u2026`;
    toast('Déverrouillé', '#16a34a', '\u2713');
    setTimeout(() => { window.location.href = '{{ path('clinic_dashboard') }}'; }, 600);
  }
</script>
{% endblock %}
