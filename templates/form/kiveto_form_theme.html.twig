{#
 # VetSaaS — templates/form/vetsaas_form_theme.html.twig
 # ───────────────────────────────────────────────────────
 # Symfony form theme that automatically applies the design system
 # to all form_widget() / form_row() / form_errors().
 #
 # Activation in config/packages/twig.yaml:
 #   twig:
 #     form_themes:
 #       - 'form/vetsaas_form_theme.html.twig'
 #
 # Or on a specific form:
 #   {% form_theme form 'form/vetsaas_form_theme.html.twig' %}
 #}

{# ── ROW (label + widget + errors + help) ── #}
{% block form_row %}
  <div class="field{% if not valid %} has-error{% endif %}{{ row_attr.class is defined ? ' ' ~ row_attr.class : '' }}">
    {% if label is not same as(false) %}
      {{ form_label(form) }}
    {% endif %}
    {{ form_widget(form) }}
    {{ form_errors(form) }}
    {{ form_help(form) }}
  </div>
{% endblock %}

{# ── LABEL ── #}
{% block form_label %}
  {% if label is not same as(false) %}
    {% set label_attr = label_attr|merge({ class: 'field-label ' ~ (label_attr.class|default('')) }) %}
    <label
      {% if id is defined %}for="{{ id }}"{% endif %}
      {% for attrname, attrvalue in label_attr %}{{ attrname }}="{{ attrvalue }}"{% endfor %}
    >
      {{ label|default(name|humanize)|trans({}, translation_domain) }}
      {% if required %}<span aria-hidden="true" style="color:var(--color-danger-600);">*</span>{% endif %}
    </label>
  {% endif %}
{% endblock %}

{# ── ERRORS ── #}
{% block form_errors %}
  {% if errors|length > 0 %}
    {% for error in errors %}
      <span class="field-error show" role="alert">
        <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <circle cx="12" cy="12" r="10"/><path stroke-linecap="round" d="M12 8v4m0 4h.01"/>
        </svg>
        {{ error.message }}
      </span>
    {% endfor %}
  {% endif %}
{% endblock %}

{# ── HELP ── #}
{% block form_help %}
  {% if help %}
    <p class="field-hint">{{ help|trans({}, translation_domain) }}</p>
  {% endif %}
{% endblock %}

{# ── INPUT WIDGET BASE ── #}
{% block form_widget_simple %}
  {% set attr = attr|merge({
    class: 'form-input ' ~ (not valid ? 'is-error' : '') ~ ' ' ~ (attr.class|default(''))
  }) %}
  <input
    type="{{ type|default('text') }}"
    id="{{ id }}"
    name="{{ full_name }}"
    value="{{ value }}"
    {% if required %}required{% endif %}
    {% if disabled %}disabled{% endif %}
    {% if read_only %}readonly{% endif %}
    {% for attrname, attrvalue in attr %}{{ attrname }}="{{ attrvalue }}"{% endfor %}
  />
{% endblock %}

{# ── TEXTAREA ── #}
{% block textarea_widget %}
  {% set attr = attr|merge({
    class: 'form-input ' ~ (not valid ? 'is-error' : '') ~ ' ' ~ (attr.class|default(''))
  }) %}
  <textarea
    id="{{ id }}"
    name="{{ full_name }}"
    {% if required %}required{% endif %}
    {% if disabled %}disabled{% endif %}
    {% if read_only %}readonly{% endif %}
    {% for attrname, attrvalue in attr %}{{ attrname }}="{{ attrvalue }}"{% endfor %}
  >{{ value }}</textarea>
{% endblock %}

{# ── SELECT ── #}
{% block choice_widget_collapsed %}
  {% set attr = attr|merge({
    class: 'form-input ' ~ (not valid ? 'is-error' : '') ~ ' ' ~ (attr.class|default(''))
  }) %}
  <select
    id="{{ id }}"
    name="{{ full_name }}{{ multiple ? '[]' : '' }}"
    {% if required and placeholder is none and not placeholder_in_choices and not multiple %}required{% endif %}
    {% if multiple %}multiple{% endif %}
    {% if disabled %}disabled{% endif %}
    {% for attrname, attrvalue in attr %}{{ attrname }}="{{ attrvalue }}"{% endfor %}
  >
    {% if placeholder is not none %}
      <option value=""{% if required and value is empty %} selected{% endif %}>
        {{ placeholder|trans({}, translation_domain) }}
      </option>
    {% endif %}
    {% for group_label, choice in choices %}
      {% if choice is iterable %}
        <optgroup label="{{ group_label|trans({}, translation_domain) }}">
          {% for choice in choice %}
            <option value="{{ choice.value }}"{% if choice.value in value %} selected{% endif %}>
              {{ choice.label|trans({}, translation_domain) }}
            </option>
          {% endfor %}
        </optgroup>
      {% else %}
        <option value="{{ choice.value }}"{% if choice.value in value %} selected{% endif %}>
          {{ choice.label|trans({}, translation_domain) }}
        </option>
      {% endif %}
    {% endfor %}
  </select>
{% endblock %}

{# ── CHECKBOX ── #}
{% block checkbox_widget %}
  <label class="check-wrap">
    <input
      type="checkbox"
      id="{{ id }}"
      name="{{ full_name }}"
      value="{{ value }}"
      {% if checked %}checked{% endif %}
      {% if required %}required{% endif %}
      {% if disabled %}disabled{% endif %}
      {% for attrname, attrvalue in attr %}{{ attrname }}="{{ attrvalue }}"{% endfor %}
    />
    <span class="check-label">
      {% if label is not same as(false) %}
        {{ label|default(name|humanize)|trans({}, translation_domain) }}
      {% endif %}
    </span>
  </label>
{% endblock %}

{# ── RADIO ── #}
{% block radio_widget %}
  <label class="check-wrap">
    <input
      type="radio"
      id="{{ id }}"
      name="{{ full_name }}"
      value="{{ value }}"
      {% if checked %}checked{% endif %}
      {% if required %}required{% endif %}
      {% if disabled %}disabled{% endif %}
      {% for attrname, attrvalue in attr %}{{ attrname }}="{{ attrvalue }}"{% endfor %}
    />
    <span class="check-label">
      {% if label is not same as(false) %}
        {{ label|default(name|humanize)|trans({}, translation_domain) }}
      {% endif %}
    </span>
  </label>
{% endblock %}

{# ── SUBMIT ── #}
{% block submit_widget %}
  {% set attr = attr|merge({ class: 'btn btn-primary ' ~ (attr.class|default('')) }) %}
  <button
    type="submit"
    {% if disabled %}disabled{% endif %}
    {% for attrname, attrvalue in attr %}{{ attrname }}="{{ attrvalue }}"{% endfor %}
  >
    {{ label|default('Enregistrer')|trans({}, translation_domain) }}
  </button>
{% endblock %}

{# ── BUTTON ── #}
{% block button_widget %}
  {% set attr = attr|merge({ class: 'btn btn-secondary ' ~ (attr.class|default('')) }) %}
  <button
    type="button"
    {% if disabled %}disabled{% endif %}
    {% for attrname, attrvalue in attr %}{{ attrname }}="{{ attrvalue }}"{% endfor %}
  >
    {{ label|default('')|trans({}, translation_domain) }}
  </button>
{% endblock %}
