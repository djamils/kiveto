{#
 # Kiveto — templates/components/ui/select.html.twig
 # ──────────────────────────────────────────────────
 # Custom animated select dropdown (Stimulus controller).
 # First full-Tailwind component — uses utility classes only.
 #
 # Parameters:
 #   name         string   Form field name (required)
 #   options      array    [ { value: string, label: string } ]  (required)
 #   value        string   Pre-selected value (default: '')
 #   placeholder  string   Placeholder text (default: 'Sélectionner...')
 #   searchable   bool     Show search input (default: false)
 #   clearable    bool     Show clear button when value is set (default: false)
 #   id           string   Custom id (default: auto from name)
 #   disabled     bool     (default: false)
 #   extra_class  string   Additional classes on the wrapper
 #
 # Usage:
 #   {{ include('components/ui/select.html.twig', {
 #     name: 'status',
 #     placeholder: 'Choisir un statut',
 #     options: [
 #       { value: 'active', label: 'Actif' },
 #       { value: 'inactive', label: 'Inactif' },
 #     ],
 #     value: 'active',
 #     searchable: true,
 #     clearable: true,
 #   }) }}
 #}

{% set _id = id|default('select-' ~ name) %}
{% set _value = value|default('') %}
{% set _placeholder = placeholder|default('Sélectionner...') %}
{% set _searchable = searchable|default(false) %}
{% set _clearable = clearable|default(false) %}
{% set _disabled = disabled|default(false) %}
{% set _selected_label = '' %}

{# Find pre-selected label #}
{% for opt in options %}
  {% if opt.value is same as(_value) %}
    {% set _selected_label = opt.label %}
  {% endif %}
{% endfor %}

<div
  class="relative{{ extra_class is defined ? ' ' ~ extra_class : '' }}"
  data-controller="select"
  data-select-placeholder-value="{{ _placeholder }}"
  data-action="keydown->select#onKeydown"
>
  {# Hidden input for form submission #}
  <input
    type="hidden"
    name="{{ name }}"
    value="{{ _value }}"
    id="{{ _id }}"
    data-select-target="hidden"
  />

  {# Trigger button #}
  <button
    type="button"
    class="flex w-full items-center justify-between rounded-md border border-border-medium bg-surface-subtle px-3 py-2 text-base text-text-primary transition-all duration-150 ease-DEFAULT hover:border-border-strong focus:border-brand-500 focus:shadow-focus focus:outline-none{{ _disabled ? ' cursor-not-allowed opacity-50' : ' cursor-pointer' }}"
    data-select-target="trigger"
    data-action="click->select#toggle"
    role="combobox"
    aria-expanded="false"
    aria-haspopup="listbox"
    aria-controls="{{ _id }}-listbox"
    {{ _disabled ? 'disabled' : '' }}
  >
    <span
      data-select-target="label"
      class="truncate{{ _selected_label ? '' : ' text-subtle' }}"
    >{{ _selected_label ? _selected_label : _placeholder }}</span>

    <span class="flex items-center gap-1 shrink-0 ml-2">
      {# Clear button #}
      {% if _clearable %}
        <button
          type="button"
          class="flex items-center justify-center w-4 h-4 rounded-full border-0 bg-transparent hover:bg-slate-200 text-text-muted p-0 cursor-pointer{{ _value ? '' : ' hidden' }}"
          data-select-target="clear"
          data-action="click->select#clear"
          aria-label="Effacer"
        >
          <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      {% endif %}

      {# Chevron #}
      <svg class="w-4 h-4 text-text-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </span>
  </button>

  {# Dropdown panel #}
  <div
    class="hidden absolute left-0 right-0 z-popover mt-1 rounded-lg border border-border-light bg-surface-card shadow-lg overflow-hidden"
    data-select-target="dropdown"
    role="listbox"
    id="{{ _id }}-listbox"
    aria-label="{{ _placeholder }}"
  >
    {# Search input #}
    {% if _searchable %}
      <div class="p-2 border-b border-border-light">
        <input
          type="text"
          class="w-full rounded-md border border-border-medium bg-surface-subtle px-3 py-1.5 text-sm text-text-primary placeholder:text-text-subtle focus:border-brand-500 focus:shadow-focus focus:outline-none"
          placeholder="Rechercher..."
          data-select-target="search"
          data-action="input->select#filter"
          autocomplete="off"
        />
      </div>
    {% endif %}

    {# Options list #}
    <div class="max-h-60 overflow-y-auto py-1">
      {% for opt in options %}
        <button
          type="button"
          class="flex w-full items-center gap-2 px-3 py-2 text-base text-text-secondary cursor-pointer rounded-sm mx-1 transition-colors duration-100 hover:bg-surface-hover hover:text-text-primary"
          style="width: calc(100% - 8px);"
          data-select-target="option"
          data-action="click->select#select"
          data-value="{{ opt.value }}"
          data-label="{{ opt.label }}"
          role="option"
          aria-selected="{{ opt.value is same as(_value) ? 'true' : 'false' }}"
        >
          {# Check icon for selected state #}
          <svg
            class="w-4 h-4 shrink-0 text-brand-600{{ opt.value is same as(_value) ? '' : ' invisible' }}"
            fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
          <span class="truncate">{{ opt.label }}</span>
        </button>
      {% endfor %}
    </div>
  </div>
</div>
