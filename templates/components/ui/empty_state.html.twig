{#
 # VetSaaS — templates/components/ui/empty_state.html.twig
 # ──────────────────────────────────────────────────────────
 # Empty state for tables, lists, and sections with no data.
 #
 # Parameters:
 #   title       string   Title (required)
 #   subtitle    string   Optional description
 #   icon        string   SVG string  (default: inbox icon)
 #   action      object   { label, variant, attrs }  — optional action button
 #   extra_class string
 #
 # Examples:
 #   {{ include('components/ui/empty_state.html.twig', {
 #       title: 'Aucun rendez-vous',
 #       subtitle: 'Planifiez le premier rendez-vous de la journée.',
 #       action: { label: 'Nouveau RDV', variant: 'primary', attrs: 'data-action="click->rdv#openDrawer"' },
 #   }) }}
 #}

{% set _default_icon %}
  <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0H4m4-4h8"/>
  </svg>
{% endset %}

<div class="empty-state{% if extra_class is defined %} {{ extra_class }}{% endif %}">
  <div class="empty-state-icon">
    {{ (icon is defined and icon) ? icon|raw : _default_icon|raw }}
  </div>
  <p class="empty-state-title">{{ title }}</p>
  {% if subtitle is defined and subtitle %}
    <p class="empty-state-sub">{{ subtitle }}</p>
  {% endif %}
  {% if action is defined and action %}
    <div class="empty-state-action">
      {{ include('components/ui/button.html.twig', {
        label: action.label,
        variant: action.variant|default('primary'),
        size: action.size|default('sm'),
        attrs: action.attrs|default(''),
        icon_left: action.icon_left|default(null),
        href: action.href|default(null),
      }) }}
    </div>
  {% endif %}
</div>
