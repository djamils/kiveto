{#
 # Kiveto — templates/components/layout/sidebar.html.twig
 # ──────────────────────────────────────────────────────
 # v-topbar sidebar (`nav.sbar`): logo + collapse, clinic switcher with its
 # popover, grouped navigation, footer drop-ups « Quoi de neuf » / « Aide ».
 # Markup ported from docs/frontend-theme/kiveto-theme/*-v-topbar*.html.
 #
 # Parameters:
 #   shell        ShellView  clinic_shell()
 #   active_route string     current Symfony route (drives aria-current)
 #
 # Behaviour lives in assets/js/shell/shell.js (delegated, Turbo-safe).
 #}

{% set _route = active_route|default('') %}

{# ── Navigation (labels and icons as in the mock-up; routes are the real ones).
   `prefixes`: routes starting with one of them light the item up. #}
{% set _nav = [
  { label: 'Tableau de bord', route: 'clinic_dashboard', prefixes: ['clinic_dashboard', 'clinic_home'],
    icon: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h14V10"/>' },
  { group: 'Clinique' },
  { label: 'Flux ambulatoire', route: 'clinic_admission_queue', prefixes: ['clinic_admission_'],
    icon: '<path d="M2 12h4l2-7 4 14 2-7h4"/><circle cx="20.5" cy="12" r="1.5"/>' },
  { label: 'Agenda', route: 'clinic_scheduling_agenda', prefixes: ['clinic_scheduling_agenda', 'clinic_scheduling_appointment_'],
    icon: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/>', round: true },
  { label: 'Planning', route: 'clinic_scheduling_planning', prefixes: ['clinic_scheduling_planning', 'clinic_planning_'],
    icon: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 13h3v3H8z"/>' },
  { group: 'Médical' },
  { label: 'Répertoire', route: 'clinic_clients_list', prefixes: ['clinic_clients_', 'clinic_animals_'],
    icon: '<circle cx="11" cy="6" r="2.4"/><circle cx="5.5" cy="10" r="2"/><circle cx="16.5" cy="10" r="2"/><path d="M11 11c-3.6 0-6 2.6-6 5.2 0 1.6 1.3 2.8 3 2.8h6c1.7 0 3-1.2 3-2.8 0-2.6-2.4-5.2-6-5.2Z"/>', round: true },
  { label: 'Consultations', route: 'clinic_consultations', prefixes: ['clinic_consultation'],
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h4"/>' },
  { label: 'Ordonnances', route: 'clinic_prescriptions', prefixes: ['clinic_prescription'],
    icon: '<path d="M9 11H5a2 2 0 0 0-2 2v7c0 1.1.9 2 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2h-4"/><path d="M9 11V5a3 3 0 0 1 6 0v6"/>' },
  { group: 'Gestion' },
  { label: 'Facturation', route: 'clinic_invoices', prefixes: ['clinic_invoice', 'clinic_credit_note', 'clinic_checkout', 'clinic_counter', 'clinic_cheque', 'clinic_cash'],
    icon: '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2Z"/><path d="M9 8h6M9 12h6"/>' },
  { label: 'Catalogue', route: 'clinic_catalogue', prefixes: ['clinic_catalogue'],
    icon: '<path d="M6 3h9l4 4v14H6Z"/><path d="M9 12h6M9 16h4"/>' },
  { label: 'Stocks', route: 'clinic_stock', prefixes: ['clinic_stock'], badge: shell.stockAlertCount,
    icon: '<path d="M21 8 12 3 3 8v8l9 5 9-5Z"/><path d="M3 8l9 5 9-5M12 13v8"/>' },
  { label: 'Rapports', route: 'clinic_reporting', prefixes: ['clinic_reporting'],
    icon: '<path d="M4 20V10M10 20V4M16 20v-7M21 20H3"/>', round: true },
] %}

{# ── « Quoi de neuf » — product news, app copy (newest first) #}
{% set _news = [
  { version: 'v0.8',   title: 'Prise de rendez-vous',  date: '10 octobre 2026', tag: 'nouveau',  tagLabel: 'Nouveau' },
  { version: 'v0.7.2', title: 'Bons de commande stock', date: '6 octobre 2026',  tag: 'ameliore', tagLabel: 'Amélioré' },
  { version: 'v0.7.1', title: "Salle d'attente",        date: '2 octobre 2026',  tag: 'corrige',  tagLabel: 'Corrigé' },
] %}

{% set _star_on %}<svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 3l2.7 5.5 6.1.9-4.4 4.3 1 6-5.4-2.8L6.6 19.7l1-6L3.2 9.4l6.1-.9Z"/></svg>{% endset %}
{% set _star_off %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 3l2.7 5.5 6.1.9-4.4 4.3 1 6-5.4-2.8L6.6 19.7l1-6L3.2 9.4l6.1-.9Z"/></svg>{% endset %}

{% macro star(clinic, on_svg, off_svg) %}
  <span class="cs-star{{ clinic.isDefault ? ' on' }}" data-default-form="csDef-{{ clinic.id }}" role="button" tabindex="0"
        title="{{ clinic.isDefault ? 'Clinique par défaut à la connexion' : 'Définir comme clinique par défaut' }}">{{ (clinic.isDefault ? on_svg : off_svg)|raw }}</span>
{% endmacro %}

{% set _current = shell.currentClinic %}
{% set _others = shell.otherClinics %}

<nav class="sbar" aria-label="Navigation principale">
  <div class="sb-logo"><span class="k">K</span><b>Kiveto</b>
    <button type="button" class="sb-collapse" id="sbCollapse" title="Replier la barre ( [ )" aria-label="Replier la navigation">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/><path d="m14 10-2 2 2 2"/></svg>
    </button>
  </div>

  {# Clinic switcher (multi-clinic member) #}
  <div class="sb-clinique" id="sbClinique">
    <button type="button" class="sb-clin-btn" id="clinBtn" aria-haspopup="listbox" data-tip="Changer de clinique" data-tip-pos="right">
      <span class="scb-sq" id="clinSq" style="background:{{ _current.color|default('var(--pin)') }}">{{ _current.initial|default('K') }}</span>
      <span class="scb-txt">
        <b id="clinNom">{{ _current.name|default('—') }}</b>
        <span class="scb-pulse" id="clinPulse">
          {%- if shell.isOpenNow is not null -%}
            <span class="pv{{ shell.isOpenNow ? '' : ' off' }}"></span>{{ shell.isOpenNow ? 'ouverte' : 'fermée' }} ·&nbsp;
          {%- endif -%}
          <b>{{ shell.practitionerCount }}</b>&nbsp;{{ shell.practitionerCount > 1 ? 'praticiens' : 'praticien' }}
        </span>
      </span>
      <svg class="scb-chev" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </button>
    <div class="clin-pop" id="clinPop" role="listbox">
      {% if _current %}
        <div class="cs-cur" id="csCur">
          <div class="cc-top">
            <span class="cs-sq" style="background:{{ _current.color }}">{{ _current.initial }}</span>
            <span class="cc-id"><b>{{ _current.name }}</b><span>{{ shell.address ?? _current.subtitle }}</span></span>
            {{ _self.star(_current, _star_on, _star_off) }}
          </div>
          <div class="cc-stats">
            {% if shell.appointmentsToday is not null %}
              <span class="cc-stat"><b>{{ shell.appointmentsToday }}</b> RDV aujourd'hui</span>
            {% endif %}
            <span class="cc-stat"><b>{{ shell.practitionerCount }}</b> {{ shell.practitionerCount > 1 ? 'praticiens' : 'praticien' }}</span>
          </div>
          {% if clinic_can('manage_staff') %}
            <div class="cc-acts">
              <a class="cc-act" href="{{ path('clinic_settings') }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.1-1.2l2-1.6-2-3.4-2.4 1a7 7 0 0 0-2-1.2L14 3h-4l-.5 2.6a7 7 0 0 0-2 1.2l-2.4-1-2 3.4 2 1.6A7 7 0 0 0 5 12c0 .4 0 .8.1 1.2l-2 1.6 2 3.4 2.4-1a7 7 0 0 0 2 1.2L10 21h4l.5-2.6a7 7 0 0 0 2-1.2l2.4 1 2-3.4-2-1.6c.1-.4.1-.8.1-1.2Z"/></svg>
                Paramètres
              </a>
              <a class="cc-act" href="{{ path('clinic_settings_team') }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.4 3.4-5.5 6.5-5.5s5.7 2.1 6.5 5.5"/><circle cx="17.5" cy="9" r="2.6"/><path d="M15.7 14.7c2.7.3 4.9 2.1 5.6 5.1"/></svg>
                Équipe
              </a>
            </div>
          {% endif %}
        </div>
        <div class="cp-sep"></div>
      {% endif %}

      {% if _others is not empty %}
        <div class="cs-head">Basculer vers</div>
        <div id="csListe">
          {% for c in shell.clinics %}
            {% if c.isCurrent %}
              <span hidden data-clinic-current="{{ loop.index0 }}"></span>
            {% else %}
              <form method="post" action="{{ path('clinic_select_clinic_post') }}" style="display:contents" data-clinic-index="{{ loop.index0 }}">
                <input type="hidden" name="_token" value="{{ csrf_token('clinic_select_clinic') }}">
                <input type="hidden" name="clinic_id" value="{{ c.id }}">
                <input type="hidden" name="_switch" value="1">
                <button type="submit" class="cs-item" role="option" title="{{ c.name }} — {{ c.subtitle }}">
                  <span class="cs-sq" style="background:{{ c.color }}">{{ c.initial }}</span>
                  <span class="ci-txt"><b>{{ c.name }}</b><span>{{ c.subtitle }}</span></span>
                  {{ _self.star(c, _star_on, _star_off) }}
                </button>
              </form>
            {% endif %}
          {% endfor %}
        </div>
        <div class="cp-sep"></div>
        <button type="button" class="cs-ligne" aria-disabled="true" data-toast="Vue groupe — CA, stocks et équipe consolidés : bientôt disponible">
          <span class="cs-lic">∑</span>
          <span class="cs-ltxt"><b>Vue groupe</b><span>CA, stocks et équipe des {{ shell.clinics|length }} cliniques</span></span>
        </button>
      {% endif %}
      <button type="button" class="cs-ligne" aria-disabled="true" data-toast="Création d'une clinique — passe par l'administration Kiveto pour le moment">
        <span class="cs-lic ghost">＋</span>
        <span class="cs-ltxt"><b>Ajouter une clinique</b></span>
      </button>
    </div>
    {# The star of each clinic posts its own form (a form cannot sit in the switch button). #}
    {% for c in shell.clinics %}
      <form id="csDef-{{ c.id }}" method="post" action="{{ path('clinic_select_clinic_default') }}" hidden>
        <input type="hidden" name="_token" value="{{ csrf_token('clinic_select_clinic') }}">
        <input type="hidden" name="clinic_id" value="{{ c.id }}">
      </form>
    {% endfor %}
  </div>

  <div class="sb-nav">
    {% for item in _nav %}
      {% if item.group is defined %}
        <div class="sb-grp">{{ item.group }}</div>
      {% else %}
        {% set _active = false %}
        {% for p in item.prefixes %}{% if _route starts with p %}{% set _active = true %}{% endif %}{% endfor %}
        <a class="sb-it" href="{{ path(item.route) }}"{% if _active %} aria-current="page"{% endif %} data-tip="{{ item.label }}" data-tip-pos="right">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"{% if item.round is not defined %} stroke-linejoin="round"{% endif %}>{{ item.icon|raw }}</svg>
          {{ item.label }}{% if item.badge is defined and item.badge > 0 %}<span class="badge">{{ item.badge }}</span>{% endif %}
        </a>
      {% endif %}
    {% endfor %}
  </div>

  <div class="sb-foot sb-foot-row">

    {# Drop-up « Quoi de neuf » #}
    <div class="foot-pop" id="popQdn" style="width:310px">
      <div class="fp-head">Quoi de neuf</div>
      {% for n in _news %}
        <button type="button" class="qdn-item" data-toast="Notes de version {{ n.version|trim('v', 'left') }} — bientôt en ligne">
          <span class="qdn-txt"><b><span class="t">{{ n.version }} — {{ n.title }}</span><span class="qdn-tag {{ n.tag }}">{{ n.tagLabel }}</span></b><span>{{ n.date }}</span></span>
        </button>
      {% endfor %}
      <div class="fp-sep"></div>
      <button type="button" class="qdn-tout" data-toast="Historique complet des versions (page à venir)">Voir tout l'historique</button>
    </div>

    {# Drop-up « Aide » #}
    <div class="foot-pop" id="popAide" style="width:250px">
      <a class="fp-item" href="#" data-toast="Documentation Kiveto — bientôt en ligne">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
        <span class="noms"><b>Documentation</b><span>Guides par écran, pas à pas</span></span>
        <span class="ext">↗</span>
      </a>
      <button type="button" class="fp-item" data-toast="Support — la messagerie intégrée arrive bientôt">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/></svg>
        <span class="noms"><b>Contacter le support</b><span>Réponse médiane : 2 h ouvrées</span></span>
      </button>
      <button type="button" class="fp-item" id="btnRacc">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 8h.01M12 12h.01M14 8h.01M16 12h.01M18 8h.01M6 8h.01M7 16h10M8 12h.01"/><rect width="20" height="16" x="2" y="4" rx="2"/></svg>
        <span class="noms"><b>Raccourcis clavier</b></span>
        <kbd class="aide-kbd">?</kbd>
      </button>
      <div class="fp-sep"></div>
      <div class="aide-statut">
        <span class="pt-ok"></span>{{ _news[0].version }} · connecté à {{ _current.name|default('Kiveto') }}
      </div>
    </div>

    <button type="button" class="sb-foot-btn" id="btnQdn" aria-label="Quoi de neuf" aria-haspopup="true" data-tip="Quoi de neuf" data-tip-pos="right">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/><path d="M20 2v4M22 4h-4"/><circle cx="4" cy="20" r="2"/></svg>
      <span>Quoi de neuf</span><span class="qdn-dot" id="qdnDot" data-version="{{ _news[0].version }}"></span>
    </button>
    <div class="sb-foot-sep" aria-hidden="true"></div>
    <button type="button" class="sb-foot-btn" id="btnAide" aria-label="Aide" aria-haspopup="true" data-tip="Aide" data-tip-pos="right">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
      <span>Aide</span>
    </button>
  </div>
</nav>
