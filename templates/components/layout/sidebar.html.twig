{#
 # Kiveto — templates/components/layout/sidebar.html.twig
 # ──────────────────────────────────────────────────────────
 # Full navigation sidebar.
 #
 # Parameters:
 #   clinic      object   { name, type }  — active clinic
 #   user        object   — logged-in user (app.user)
 #   active_item string   Active Symfony route (e.g. 'clinic_dashboard')
 #}

{# ── Inline SVG icons (Lucide) ── #}
{% set icon_calendar %}
  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
  </svg>
{% endset %}
{% set icon_users %}
  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <path stroke-linecap="round" d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
  </svg>
{% endset %}
{% set icon_stethoscope %}
  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 6.375a4.125 4.125 0 008.25 0v3.75a4.125 4.125 0 01-8.25 0v-3.75zM14.25 8.625c0 4.14-3.36 7.5-7.5 7.5S-.75 12.765-.75 8.625"/>
    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3.5 3.5 0 107 0 3.5 3.5 0 00-7 0z"/>
  </svg>
{% endset %}
{% set icon_bed %}
  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M3 9V4m0 16v-4m18 4V9M3 9h18M3 20h18M7 9V4m4 5V4m4 5V4"/>
  </svg>
{% endset %}
{% set icon_clock %}
  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <circle cx="12" cy="12" r="10"/><path stroke-linecap="round" d="M12 6v6l4 2"/>
  </svg>
{% endset %}
{% set icon_grid %}
  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
  </svg>
{% endset %}
{% set icon_package %}
  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10"/>
  </svg>
{% endset %}
{% set icon_chart %}
  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
  </svg>
{% endset %}
{% set icon_settings %}
  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
    <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
    <circle cx="12" cy="12" r="3"/>
  </svg>
{% endset %}
{% set icon_chevron_down %}
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-subtle" aria-hidden="true">
    <path d="m6 9 6 6 6-6"/>
  </svg>
{% endset %}

{% set icon_check %}
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600 ml-auto shrink-0" aria-hidden="true">
    <path d="M20 6 9 17l-5-5"/>
  </svg>
{% endset %}

{% set icon_plus %}
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 5v14M5 12h14"/>
  </svg>
{% endset %}

{# Real clinic data from backend (user's accessible clinics + active clinic ID) #}
{% set _sidebar_data = clinic_sidebar_data() %}
{% set _user_clinics = _sidebar_data.clinics %}
{% set _active_clinic_id = _sidebar_data.activeClinicId %}

{# Color palette for clinic logos #}
{% set _clinic_colors = ['bg-brand-600', 'bg-success-600', 'bg-warning-600', 'bg-danger-600', 'bg-purple-600', 'bg-sky-600', 'bg-orange-600', 'bg-emerald-600'] %}

{# ── Navigation structure (BC-aligned) ── #}
{% set nav_items = [
  { key: 'clinic_dashboard',              label: 'Tableau de bord',    icon: icon_grid,        route: 'clinic_dashboard' },

  { section: 'Clinique' },
  { key: 'clinic_scheduling_agenda',   label: 'Agenda',             icon: icon_calendar,    route: 'clinic_scheduling_agenda' },
  { key: 'clinic_scheduling_planning',     label: 'Planning',           icon: icon_clock,       route: 'clinic_scheduling_planning' },
  { key: 'clinic_admission_queue', label: 'Salle d\'attente',  icon: icon_clock,       route: 'clinic_admission_queue' },

  { section: 'Médical' },
  { key: 'clinic_clients_list',           label: 'Clients & Patients', icon: icon_users,       route: 'clinic_clients_list' },
  { key: 'clinic_consultations',           label: 'Consultations',      icon: icon_stethoscope, route: 'clinic_consultations' },
  { key: 'clinic_hospitalisations',       label: 'Hospitalisations',   icon: icon_bed,         route: 'clinic_hospitalisations' },

  { section: 'Gestion' },
  { key: 'clinic_catalogue',              label: 'Catalogue',          icon: icon_package,     route: 'clinic_catalogue' },
  { key: 'clinic_reporting',              label: 'Rapports',           icon: icon_chart,       route: 'clinic_reporting' },
] %}

{# ── Flag SVGs (used in clinic switcher language section) ── #}
{% set icon_fr_flag %}
  <svg width="18" height="13" viewBox="0 0 18 13" aria-hidden="true" style="border-radius:2px;display:block;">
    <rect width="6" height="13" fill="#002395"/>
    <rect x="6" width="6" height="13" fill="#fff"/>
    <rect x="12" width="6" height="13" fill="#ED2939"/>
  </svg>
{% endset %}
{% set icon_en_flag %}
  <svg width="18" height="13" viewBox="0 0 18 13" aria-hidden="true" style="border-radius:2px;display:block;">
    <rect width="18" height="13" fill="#012169"/>
    <path d="M0 0l18 13M18 0L0 13" stroke="#fff" stroke-width="2.6"/>
    <path d="M0 0l18 13M18 0L0 13" stroke="#C8102E" stroke-width="1.4"/>
    <path d="M9 0v13M0 6.5h18" stroke="#fff" stroke-width="4"/>
    <path d="M9 0v13M0 6.5h18" stroke="#C8102E" stroke-width="2.4"/>
  </svg>
{% endset %}

{# Compact icon-rail mode on pages that need maximum horizontal space (e.g. scheduling). #}
{% set _route = app.request.attributes.get('_route') %}
{% set _rail = _route in ['clinic_scheduling_agenda', 'clinic_scheduling_planning'] %}

<aside class="sidebar{% if _rail %} sidebar--rail{% endif %}" id="appSidebar" data-controller="sidebar">

  {# ── Header: clinic switcher ── #}
  <div class="sb-top">
    {% set _active_clinic_name = clinic.name|default('Ma clinique') %}
    {% for c in _user_clinics %}
      {% if c.clinicId == _active_clinic_id %}
        {% set _active_clinic_name = c.clinicName %}
      {% endif %}
    {% endfor %}
    <button
      class="sb-clinic-btn{% if _rail %} ki-tooltip{% endif %}"
      {% if _rail %}data-tooltip="{{ _active_clinic_name }}" data-tooltip-pos="right"{% endif %}
      type="button"
      aria-label="Changer de clinique"
      title="{{ _active_clinic_name }}"
      data-popover-anchor="clinic-switcher-popover"
      data-popover-align="left"
    >
      <span class="avatar avatar-sm" style="background:var(--brand-100);color:var(--brand-700);border-radius:var(--radius-sm);">
        {{ _active_clinic_name|first|upper }}
      </span>
      <span class="truncate flex-1 min-w-0 text-left">
        {{ _active_clinic_name }}
      </span>
      {{ icon_chevron_down|raw }}
    </button>
  </div>

  {# Clinic switcher popover (opened by sb-clinic-btn, managed by popover.js) #}
  <div class="popover clinic-switcher-popover hidden" id="clinic-switcher-popover" style="width: 256px;">
    {# Section 1: clinic list #}
    <div class="clinic-switcher-section">
      <p class="popover-head">Cliniques</p>
      {% for c in _user_clinics %}
        {% set _is_active_clinic = c.clinicId == _active_clinic_id %}
        {% set _color = _clinic_colors[loop.index0 % _clinic_colors|length] %}
        <form method="post" action="{{ path('clinic_select_clinic_post') }}" style="display:contents;">
          <input type="hidden" name="_token" value="{{ csrf_token('clinic_select_clinic') }}"/>
          <input type="hidden" name="clinic_id" value="{{ c.clinicId }}"/>
          <button type="submit" class="nav-item" title="{{ c.clinicName }}">
            <span class="rounded-md text-white text-xs uppercase shrink-0 flex items-center justify-center {{ _color }}" style="width:20px;height:20px;">{{ c.clinicName|first|upper }}</span>
            <span class="truncate flex-1 min-w-0 text-left">{{ c.clinicName }}</span>
            {% if _is_active_clinic %}{{ icon_check|raw }}{% endif %}
          </button>
        </form>
      {% endfor %}
    </div>

    <div class="popover-divider"></div>

    {# Section 2: clinic settings #}
    <div class="clinic-switcher-section">
      <p class="popover-head">Gestion</p>
      <a href="#" class="nav-item">
        {{ icon_settings|raw }}
        <span>Paramètres de la clinique</span>
      </a>
      <a href="#" class="nav-item">
        {{ icon_users|raw }}
        <span>Membres &amp; rôles</span>
      </a>
    </div>

    <div class="popover-divider"></div>

    {# Section 3: language #}
    <div class="clinic-switcher-section">
      <p class="popover-head">Langue</p>
      <button type="button" class="nav-item">
        {{ icon_fr_flag|raw }}
        <span class="flex-1 text-left">Français</span>
        <i data-lucide="check" class="text-brand-600 shrink-0"></i>
      </button>
      <button type="button" class="nav-item">
        {{ icon_en_flag|raw }}
        <span class="flex-1 text-left">English</span>
      </button>
    </div>
  </div>

  {# ── Changelog popover (opened from sidebar footer) ── #}
  <div class="popover hidden" id="app-changelog-popover" style="width: 280px;">
    <p class="popover-head">Quoi de neuf</p>
    <a href="#" class="nav-item">
      <span class="flex-1 min-w-0">
        <span class="block text-sm font-medium text-text-primary">v0.5.0 — Sélecteur de cliniques</span>
        <span class="block text-xs text-text-subtle">5 avril 2026</span>
      </span>
    </a>
    <a href="#" class="nav-item">
      <span class="flex-1 min-w-0">
        <span class="block text-sm font-medium text-text-primary">v0.4.0 — Animations UI</span>
        <span class="block text-xs text-text-subtle">3 avril 2026</span>
      </span>
    </a>
    <div class="popover-divider"></div>
    <a href="#" class="nav-item text-center justify-center text-sm text-brand-600">
      Voir tout l'historique
    </a>
  </div>

  {# ── Help popover (opened from sidebar footer) ── #}
  <div class="popover hidden" id="app-help-popover" style="width: 220px;">
    <a href="#" class="nav-item">
      <i data-lucide="book-open"></i>
      <span>Documentation</span>
    </a>
    <a href="#" class="nav-item">
      <i data-lucide="message-circle"></i>
      <span>Contacter le support</span>
    </a>
    <a href="#" class="nav-item">
      <i data-lucide="keyboard"></i>
      <span>Raccourcis clavier</span>
    </a>
  </div>

  {# ── Search field (between clinic switcher and navigation) ── #}
  <div class="sb-search">
    <button
      type="button"
      class="sb-search-trigger"
      aria-label="Ouvrir la recherche"
      data-modal-open="search-modal"
    >
      <i data-lucide="search" class="sb-search-icon"></i>
      <span class="sb-search-placeholder">Rechercher…</span>
    </button>
  </div>

  {# ── Main navigation ── #}
  <nav class="nav" aria-label="Navigation principale">
    {% for item in nav_items %}
      {% if item.section is defined %}
        <p class="nav-section">{{ item.section }}</p>
      {% else %}
        {% set _is_active = active_item is defined and (active_item == item.key or active_item starts with item.key) %}
        <a
          href="{{ item.route ? path(item.route) : '#' }}"
          class="nav-item{% if _is_active %} active{% endif %}{% if _rail %} ki-tooltip{% endif %}"
          {% if _rail %}data-tooltip="{{ item.label }}" data-tooltip-pos="right"{% endif %}
          {% if _is_active %}aria-current="page"{% endif %}
          {% if item.new_tab is defined and item.new_tab %}target="_blank" rel="noopener"{% endif %}
        >
          {{ item.icon|raw }}
          <span>{{ item.label }}</span>
          {% if item.badge is defined %}
            <span class="nav-badge">{{ item.badge }}</span>
          {% endif %}
        </a>
      {% endif %}
    {% endfor %}
  </nav>

  {# ── Sidebar footer: changelog + help ── #}
  <div class="sb-foot">
    <button
      type="button"
      class="sb-foot-btn{% if _rail %} ki-tooltip{% endif %}"
      {% if _rail %}data-tooltip="Quoi de neuf" data-tooltip-pos="right"{% endif %}
      aria-label="Quoi de neuf"
      data-popover-anchor="app-changelog-popover"
    >
      <i data-lucide="sparkles"></i>
      <span>Quoi de neuf</span>
    </button>

    <div class="sb-foot-sep" aria-hidden="true"></div>

    <button
      type="button"
      class="sb-foot-btn{% if _rail %} ki-tooltip{% endif %}"
      {% if _rail %}data-tooltip="Aide" data-tooltip-pos="right"{% endif %}
      aria-label="Aide"
      data-popover-anchor="app-help-popover"
    >
      <i data-lucide="circle-help"></i>
      <span>Aide</span>
    </button>
  </div>

</aside>
