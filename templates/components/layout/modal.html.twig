{#
 # VetSaaS — templates/components/layout/modal.html.twig
 # ──────────────────────────────────────────────────────
 # Generic modal wrapper.
 #
 # Parameters:
 #   id           string   Unique ID (required)
 #   title        string   Header title
 #   size         string   narrow | md | wide | full  (default: md = 480px)
 #   show_footer  bool     (default: false)
 #   cancel_label string   (default: 'Annuler')
 #   submit_label string   (default: 'Confirmer')
 #   submit_variant string (default: 'primary')
 #   submit_attrs string
 #   form_id      string
 #   extra_class  string
 #
 # Usage via embed:
 #   embed 'components/layout/modal.html.twig' with { id: 'deleteModal', ... }
 #     block modal_body → modal content
 #   endembed
 #
 # Programmatic opening:
 #   import { modal } from 'vs/modal'; modal.open('deleteModal');
 #
 # Declarative opening:
 #   <button data-action="click->modal#open" data-modal-id-param="deleteModal">Supprimer</button>
 #}

{% set icon_close %}
  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
  </svg>
{% endset %}

{% set _modal_size_class = '' %}
{% if size is defined %}
  {% if size == 'narrow' %}{% set _modal_size_class = 'modal-narrow' %}
  {% elseif size == 'wide' %}{% set _modal_size_class = 'modal-wide' %}
  {% elseif size == 'full' %}{% set _modal_size_class = 'modal-full' %}
  {% endif %}
{% endif %}

<div
  class="modal-overlay hidden{% if extra_class is defined %} {{ extra_class }}{% endif %}"
  id="{{ id }}"
  role="dialog"
  aria-modal="true"
  aria-labelledby="{{ id }}-title"
  data-controller="modal"
  data-modal-id-value="{{ id }}"
>
  <div class="modal {{ _modal_size_class }}">

    <div class="modal-head">
      <span class="modal-title" id="{{ id }}-title">{{ title|default('') }}</span>
      <button
        class="btn btn-ghost btn-icon btn-sm"
        type="button"
        aria-label="Fermer"
        data-modal-close
      >
        {{ icon_close|raw }}
      </button>
    </div>

    <div class="modal-body">
      {% block modal_body %}{% endblock %}
    </div>

    {% if show_footer is defined and show_footer %}
      <div class="modal-foot">
        <button
          class="btn btn-secondary btn-sm"
          type="button"
          data-modal-close
        >
          {{ cancel_label|default('Annuler') }}
        </button>
        <button
          class="btn btn-{{ submit_variant|default('primary') }} btn-sm"
          type="{% if form_id is defined and form_id %}submit{% else %}button{% endif %}"
          {% if form_id is defined and form_id %}form="{{ form_id }}"{% endif %}
          {{ submit_attrs|default('')|raw }}
        >
          {{ submit_label|default('Confirmer') }}
        </button>
      </div>
    {% endif %}

  </div>
</div>
