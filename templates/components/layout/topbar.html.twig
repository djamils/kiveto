{#
 # Kiveto — templates/components/layout/topbar.html.twig
 # ─────────────────────────────────────────────────────────
 # Common page topbar with 3 slots: left (icon + title),
 # center (search), right (actions/badges).
 #
 # All slots are optional. Pages fill them via Twig blocks
 # on the parent `clinic/base.html.twig`:
 #
 #   {% block page_icon %}<svg .../>{% endblock %}
 #   {% block page_title %}Clients & Patients{% endblock %}
 #   {% block topbar_search %}<input .../>{% endblock %}
 #   {% block topbar_actions %}<button .../>{% endblock %}
 #
 # Parameters (passed by the base template):
 #   burger         bool   Show burger button (mobile) (default: true)
 #   page_icon      string Raw HTML (usually an <svg>) — left of the title
 #   page_title     string Page title (required)
 #   topbar_search  string Raw HTML — rendered in the center
 #   topbar_actions string Raw HTML — rendered on the right
 #}

{% set _burger = burger|default(true) %}
{% set _icon = page_icon|default('')|trim %}
{% set _title = page_title|default('')|trim %}
{% set _search = topbar_search|default('')|trim %}
{% set _actions = topbar_actions|default('')|trim %}

{% set icon_burger %}
  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
  </svg>
{% endset %}

<header class="topbar">

  {# ── Left: burger + icon + title ── #}
  <div class="topbar-left">
    {% if _burger %}
      <button
        class="btn btn-ghost btn-icon btn-sm show-mobile"
        type="button"
        aria-label="Menu"
        data-action="click->sidebar#toggle"
      >
        {{ icon_burger|raw }}
      </button>
    {% endif %}

    {% if _icon %}
      <span class="topbar-icon" aria-hidden="true">{{ _icon|raw }}</span>
    {% endif %}

    <h1 class="topbar-title">{{ _title }}</h1>
  </div>

  {# ── Center: optional search ── #}
  {% if _search %}
    <div class="topbar-center hide-mobile">
      {{ _search|raw }}
    </div>
  {% endif %}

  {# ── Right: optional actions ── #}
  {% if _actions %}
    <div class="topbar-right">
      {{ _actions|raw }}
    </div>
  {% endif %}

</header>
