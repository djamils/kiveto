{#
 # Kiveto — templates/components/layout/topbar.html.twig
 # ─────────────────────────────────────────────────────
 # v-topbar `header.topbar` and its drop-downs (notifications, profile).
 # Identical on every page of the mock-ups: the clinic, today, the member and
 # the practitioners; the search palette trigger; bell, lock and avatar.
 #
 # Parameters:
 #   shell   ShellView  clinic_shell()
 #   brand   bool       show the « K » home square (pages without sidebar)
 #   extra   string     raw HTML put in the topbar's `.right` slot (optional)
 #}

{% set _current = shell.currentClinic %}
{% set _user = shell.user %}

<header class="topbar">
  {% if brand|default(false) %}
    <a class="tb-brand" href="{{ path('clinic_dashboard') }}" data-tip="Tableau de bord">K</a>
  {% endif %}
  <h1>{{ _current.name|default('Kiveto') }}<small>{{ shell.todayLabel }} · {{ _user.name }} · {{ shell.practitionerCount }} {{ shell.practitionerCount > 1 ? 'praticiens' : 'praticien' }}</small></h1>
  <button type="button" class="search" id="openPalette" aria-haspopup="dialog">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    Rechercher un patient, un client, un acte…
  </button>
  <div class="right">
    {{ extra|default('')|raw }}
  </div>
    <button type="button" class="tb-ic" id="btnNotif" aria-label="Notifications{{ shell.unreadNotifications > 0 ? ' — ' ~ shell.unreadNotifications ~ ' non lue' ~ (shell.unreadNotifications > 1 ? 's') }}" aria-haspopup="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
      {# Shown while an entry is unread; refreshed every minute by shell.js. #}
      <span class="tb-dot"{% if shell.unreadNotifications == 0 %} style="display:none"{% endif %}></span>
    </button>
    <div class="tb-sep"></div>
    <a class="tb-ic" id="btnLock" href="{{ path('clinic_lock') }}" data-turbo="false" aria-label="Verrouiller la session" title="Verrouiller la session">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    </a>
    <button type="button" class="tb-av" id="btnProfil" aria-label="Profil" aria-haspopup="true">{{ _user.initials }}</button>
</header>

{# ── Drop-downs ── #}
{# Bell (D13): entries loaded when it opens; only the filters that can hold
   entries (no « Tâches » until tasks exist). #}
<div class="tb-pop" id="popNotif" style="width:350px"
  {% if _current %}
  data-list-url="{{ path('clinic_notifications_list') }}"
  data-read-url="{{ path('clinic_notifications_read', { id: '00000000-0000-7000-8000-000000000000' }) }}"
  data-read-all-url="{{ path('clinic_notifications_read_all') }}"
  data-token="{{ csrf_token('clinic_notifications') }}"
  {% endif %}>
  <div class="nf-head">
    <div class="r1">
      <b>Notifications</b>
      <button type="button" class="tout" id="nfToutLu" data-nf-all>Tout marquer lu</button>
    </div>
    <span class="nf-filtre" role="tablist">
      <button type="button" class="on" data-f="tout">Tout</button>
      <button type="button" data-f="activite">Activité</button>
    </span>
  </div>
  <div id="nfListe"><div class="nf-vide">Chargement…</div></div>
  <div class="fp-sep"></div>
  {% if _current %}
    <a class="nf-histo" href="{{ path('clinic_notifications_history') }}" style="display:block">Voir tout l'historique</a>
  {% endif %}
</div>

<div class="tb-pop" id="popProfil" style="width:250px">
  <div class="fp-profil-head">
    <span class="av">{{ _user.initials }}</span>
    <span><b>{{ _user.name }}</b><span>{{ _user.email }}</span>{% if _user.roleLabel %}<span>{{ _user.roleLabel }}</span>{% endif %}</span>
  </div>
  <div class="fp-sep"></div>
  <button type="button" class="fp-item" data-toast="Mon profil — coordonnées, n° Ordre, signature, couleur d'agenda (écran à venir)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c.9-3.6 3.8-6 8-6s7.1 2.4 8 6"/></svg>
    <span class="noms"><b>Mon profil</b></span>
  </button>
  {# « Paramètres » opens the member's own preferences, which every member may set (mock-up: ?s=moi) #}
  <a class="fp-item" href="{{ path('clinic_settings_preferences') }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.1-1.2l2-1.6-2-3.4-2.4 1a7 7 0 0 0-2-1.2L14 3h-4l-.5 2.6a7 7 0 0 0-2 1.2l-2.4-1-2 3.4 2 1.6A7 7 0 0 0 5 12c0 .4 0 .8.1 1.2l-2 1.6 2 3.4 2.4-1a7 7 0 0 0 2 1.2L10 21h4l.5-2.6a7 7 0 0 0 2-1.2l2.4 1 2-3.4-2-1.6c.1-.4.1-.8.1-1.2Z"/></svg>
    <span class="noms"><b>Paramètres</b></span>
  </a>
  <div class="fp-sep"></div>
  {% set _fr_flag = '<svg width="16" height="11" viewBox="0 0 18 13"><rect width="6" height="13" fill="#002395"/><rect x="6" width="6" height="13" fill="#fff"/><rect x="12" width="6" height="13" fill="#ED2939"/></svg>' %}
  <button type="button" class="fp-row-lang" id="langRow" aria-expanded="false">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>
    <span class="l">Langue</span>
    <span class="lang-val" id="langVal">{{ _fr_flag|raw }}<span>Français</span></span>
    <svg class="lang-chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
  </button>
  {# Only the languages the interface is translated into. #}
  <div class="lang-liste" id="langListe">
    <button type="button" class="lang-item on" data-lang="fr" data-label="Français">{{ _fr_flag|raw }}<span>Français</span>
      <span class="cc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg></span>
    </button>
  </div>
  <a class="fp-item" id="fpVerrouiller" href="{{ path('clinic_lock') }}" data-turbo="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    <span class="noms"><b>Verrouiller la session</b></span>
  </a>
  <a class="fp-item rouge" href="{{ logout_path('clinic') }}" data-turbo="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5M21 12H9"/></svg>
    <span class="noms"><b>Se déconnecter</b></span>
  </a>
</div>
