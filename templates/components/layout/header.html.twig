{#
 # Kiveto — templates/components/layout/header.html.twig
 # ─────────────────────────────────────────────────────
 # v-topbar page header (`.pagehead`), the band every mock-up page opens
 # with under the topbar: title + subtitle, optional tabs (`.ctabs`), and the
 # page actions on the right (`.right`, holding kit `.btn` / `.btn.primaire`).
 #
 #   {{ include('components/layout/header.html.twig', {
 #     title: 'Stocks', subtitle: '128 articles suivis',
 #     tabs: '<div class="ctabs">…</div>', actions: '<button class="btn primaire">…</button>',
 #   }) }}
 #
 # Parameters (all optional but the title):
 #   title     string  page title (h1)
 #   subtitle  string  line under the title (h1 > small)
 #   tabs      string  raw HTML placed after the title (usually a .ctabs)
 #   actions   string  raw HTML placed in .right
 #   class     string  extra classes on .pagehead
 #}

<div class="pagehead{{ class is defined and class ? ' ' ~ class }}">
  <h1>{{ title }}{% if subtitle is defined and subtitle|trim %}<small>{{ subtitle }}</small>{% endif %}</h1>
  {{ tabs|default('')|raw }}
  {% if actions is defined and actions|trim %}
    <div class="right">{{ actions|raw }}</div>
  {% endif %}
</div>
