{#
 # One bell entry (dropdown and history page). A click marks it read and
 # opens its screen (shell.js, `.nf[data-nf]`).
 #
 # Parameters:
 #   item   NotificationItem
 #   when   string  the time shown on the right (item.ago by default)
 #}
{% set _icons = {
  NEW_APPOINTMENT: ['vert', '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4"/></svg>'],
  CRITICAL_STOCK: ['rouge', '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="m3 8 9 5 9-5M12 13v8"/></svg>'],
  EXPIRING_LOTS: ['ambre', '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>'],
  SMS_QUOTA: ['indigo', '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>'],
} %}
{% set _icon = _icons[item.kind] ?? _icons.SMS_QUOTA %}
<button type="button" class="nf{{ item.read ? ' lu' }}" data-nf="{{ item.id }}" data-k="{{ item.filter }}"{% if item.url %} data-href="{{ item.url }}"{% endif %}>
  <span class="pt-lu" aria-hidden="true"></span>
  <span class="ic {{ _icon[0] }}">{{ _icon[1]|raw }}</span>
  <span class="tx"><b>{{ item.title }}</b><span>{{ item.detail }}</span></span>
  <span class="temps">{{ when|default(item.ago) }}</span>
  {% if not item.read %}<span class="sr-only">Non lue</span>{% endif %}
</button>
