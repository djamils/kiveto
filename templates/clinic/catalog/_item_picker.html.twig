{#
 # Kiveto — templates/clinic/catalog/_item_picker.html.twig
 # ───────────────────────────────────────────────────────
 # Picks an act or an article out of the catalogue. The page module fills the
 # results from /catalogue/recherche and writes the choice into the hidden
 # inputs the form posts.
 #
 # Variables:
 #   pickerId  string  Prefix of the ids, so two pickers can live on one page
 #}
<div class="item-picker" data-item-picker="{{ pickerId }}">
  <div class="field">
    <label class="field-label" for="{{ pickerId }}-search">Prestation</label>
    <input class="form-input" id="{{ pickerId }}-search" type="text" autocomplete="off"
           placeholder="Rechercher un acte ou un article…" data-picker-search>
  </div>

  <div class="item-picker-chosen" data-picker-chosen>
    <i data-lucide="check"></i>
    <span data-picker-chosen-label></span>
    <button class="ipc-clear" type="button" data-picker-clear aria-label="Changer">
      <i data-lucide="x"></i>
    </button>
  </div>

  <div class="item-picker-results" data-picker-results></div>

  <input type="hidden" name="item_type" value="ACT" data-picker-type>
  <input type="hidden" name="item_id" value="" data-picker-id>
</div>
