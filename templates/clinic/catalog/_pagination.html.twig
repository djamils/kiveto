{#
 # Kiveto — templates/clinic/catalog/_pagination.html.twig
 # ──────────────────────────────────────────────────────
 # The pager the three listing tabs share.
 #
 # Variables:
 #   page        CatalogPage
 #   route       string   The route to link back to
 #   queryState  array    The filters to carry over
 #   pageSizes   list<int>
 #}
<footer class="pagination">
  <span class="pag-info">
    {% if page.total == 0 %}
      Aucun résultat
    {% else %}
      {{ page.firstItem }}–{{ page.lastItem }} sur {{ page.total }}
    {% endif %}
  </span>
  <div class="pag-spacer"></div>
  <form class="pag-size" method="GET" action="{{ path(route) }}">
    <span>Par page :</span>
    <select name="per_page" data-auto-submit>
      {% for size in pageSizes %}
        <option value="{{ size }}"{{ size == page.perPage ? ' selected' : '' }}>{{ size }}</option>
      {% endfor %}
    </select>
    {% for key, value in queryState %}
      {% if key != 'per_page' %}
        {% if value is iterable %}
          {% for item in value %}<input type="hidden" name="{{ key }}[]" value="{{ item }}">{% endfor %}
        {% else %}
          <input type="hidden" name="{{ key }}" value="{{ value }}">
        {% endif %}
      {% endif %}
    {% endfor %}
  </form>
  <div class="pag-controls">
    {% if page.page > 1 %}
      <a class="pag-btn" href="{{ path(route, queryState|merge({ page: page.page - 1 })) }}" aria-label="Précédent">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
      </a>
    {% else %}
      <button class="pag-btn" type="button" disabled aria-label="Précédent">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
    {% endif %}

    {# First, last and the current page's neighbours, with gaps collapsed to an ellipsis #}
    {% set shown = [1, page.pageCount, page.page, page.page - 1, page.page + 1]|filter(p => p >= 1 and p <= page.pageCount)|sort %}
    {% for p in shown %}
      {% set previous = loop.first ? 0 : shown[loop.index0 - 1] %}
      {% if p != previous %}
        {% if p - previous > 1 and not loop.first %}<span class="pag-ellipsis">…</span>{% endif %}
        {% if p == page.page %}
          <span class="pag-btn is-active">{{ p }}</span>
        {% else %}
          <a class="pag-btn" href="{{ path(route, queryState|merge({ page: p })) }}">{{ p }}</a>
        {% endif %}
      {% endif %}
    {% endfor %}

    {% if page.page < page.pageCount %}
      <a class="pag-btn" href="{{ path(route, queryState|merge({ page: page.page + 1 })) }}" aria-label="Suivant">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    {% else %}
      <button class="pag-btn" type="button" disabled aria-label="Suivant">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    {% endif %}
  </div>
</footer>
