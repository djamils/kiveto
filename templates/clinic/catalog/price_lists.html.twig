{#
 # Kiveto — templates/clinic/catalog/price_lists.html.twig
 # ──────────────────────────────────────────────────────
 # The price lists of the clinic: what a given agreement charges instead of the
 # catalogue's own price.
 #
 # Variables:
 #   priceLists     list<PriceListSummary>
 #   selected       PriceListSummary|null
 #   entries        list<PriceListEntryRow>
 #   rules          list<{id, ruleType, condition, adjustment}>
 #   counters       CatalogCounters
 #   taxCategories  list<{code, label}>
 #}
{% extends 'clinic/catalog/_shell.html.twig' %}

{% set RULE_LABELS = {
  'SPECIES_ADJUSTMENT': 'Espèce', 'SIZE_ADJUSTMENT': 'Gabarit',
  'URGENCY_COEFFICIENT': 'Urgence', 'DISCOUNT': 'Remise'
} %}

{% block catalogue_title %}Catalogue{% endblock %}
{% block catalogue_count %}{{ priceLists|length }} grille{{ priceLists|length > 1 ? 's' : '' }}{% endblock %}

{% block catalogue_actions %}
  {% if selected %}
    <button class="btn btn-primary btn-sm" type="button" data-modal-open="price-item-modal" data-price-item-new>
      <i data-lucide="plus"></i>
      Tarifer une prestation
    </button>
  {% endif %}
{% endblock %}

{% block catalogue_body %}

  {% if priceLists is empty %}
    <section class="table-wrapper">
      <div class="empty">
        <div class="empty-icon"><i data-lucide="tags"></i></div>
        <div class="empty-title">Aucune grille tarifaire</div>
        <div class="empty-sub">
          Une grille applique des tarifs particuliers à certaines prestations — convention refuge,
          accord partenaire, tarif interne.
        </div>
      </div>
    </section>
  {% else %}
    <div class="price-body">

      <aside class="price-aside">
        {% for priceList in priceLists %}
          <a class="price-list-link{{ selected and selected.id == priceList.id ? ' is-active' : '' }}"
             href="{{ path('clinic_catalogue_price_lists', { list: priceList.id }) }}">
            <span class="plink-name">{{ priceList.name }}</span>
            {% if priceList.isDefault %}<span class="tag is-default">Par défaut</span>{% endif %}
          </a>
        {% endfor %}
      </aside>

      <section class="price-main">
        {% if selected %}
          <header class="price-head">
            <span class="price-head-title">{{ selected.name }}</span>
            {% if selected.isDefault %}
              <span class="tag is-default">Grille par défaut</span>
            {% endif %}
            <span class="price-head-spacer"></span>
            <span class="pag-info">
              {{ entries|length }} tarif{{ entries|length > 1 ? 's' : '' }} particulier{{ entries|length > 1 ? 's' : '' }}
            </span>
          </header>

          <div class="table-wrapper">
            {% if entries is not empty %}
              <table class="cat-table">
                <thead>
                  <tr>
                    <th class="col-code">Code</th>
                    <th class="col-name">Prestation</th>
                    <th class="col-kind">Type</th>
                    <th class="col-price">Tarif de base</th>
                    <th class="col-price">Tarif de la grille</th>
                    <th class="col-price">Écart</th>
                    <th class="col-actions"></th>
                  </tr>
                </thead>
                <tbody>
                  {% for entry in entries %}
                    {% set delta = entry.differenceMinorUnits %}
                    <tr data-entry-id="{{ entry.id }}"
                        data-price="{{ (entry.netPriceMinorUnits / 100)|number_format(2, ',', '') }}"
                        data-label="{{ entry.itemName ?? 'Prestation supprimée' }}"
                        data-tax="{{ entry.taxCategoryOverride ?? '' }}">
                      <td class="col-code"><span class="cell-code">{{ entry.itemCode ?? '—' }}</span></td>
                      <td class="col-name">
                        {% if entry.isDangling %}
                          <span class="cell-name" style="color:var(--color-danger-text,#b91c1c)">
                            Prestation supprimée du catalogue
                          </span>
                          <span class="cell-sub">Ce tarif ne s’applique plus à rien.</span>
                        {% else %}
                          <span class="cell-name">{{ entry.itemName }}</span>
                          {% if entry.taxCategoryOverride %}
                            <span class="cell-sub">TVA forcée : {{ entry.taxCategoryOverride }}</span>
                          {% endif %}
                        {% endif %}
                      </td>
                      <td class="col-kind">
                        <span class="tag">{{ entry.itemType == 'ACT' ? 'Acte' : 'Article' }}</span>
                      </td>
                      <td class="col-price">
                        <span class="cell-price is-muted">
                          {{ entry.basePriceMinorUnits is not null
                            ? entry.basePriceMinorUnits|money(entry.currency)
                            : '—' }}
                        </span>
                      </td>
                      <td class="col-price">
                        <span class="cell-price">{{ entry.netPriceMinorUnits|money(entry.currency) }}</span>
                      </td>
                      <td class="col-price">
                        {% if delta is null %}
                          <span class="cell-delta">—</span>
                        {% elseif delta == 0 %}
                          <span class="cell-delta">=</span>
                        {% else %}
                          <span class="cell-delta {{ delta < 0 ? 'is-down' : 'is-up' }}">
                            {{ delta > 0 ? '+' : '−' }}{{ (delta > 0 ? delta : -delta)|money(entry.currency) }}
                          </span>
                        {% endif %}
                      </td>
                      <td class="col-actions" style="position:relative">
                        <button class="row-actions-btn" type="button" data-row-menu-toggle title="Actions" aria-label="Actions">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                        </button>
                        <div class="row-menu" data-row-menu>
                          <button class="row-menu-item" type="button" data-edit-entry="{{ entry.id }}">
                            <i data-lucide="pencil"></i> Modifier le tarif
                          </button>
                          <div class="row-menu-sep"></div>
                          <form method="POST"
                                action="{{ path('clinic_catalogue_price_item_remove', { priceListId: selected.id, entryId: entry.id }) }}">
                            <button class="row-menu-item is-danger" type="submit">
                              <i data-lucide="trash-2"></i> Retirer de la grille
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            {% else %}
              <div class="empty">
                <div class="empty-icon"><i data-lucide="tags"></i></div>
                <div class="empty-title">Aucun tarif particulier</div>
                <div class="empty-sub">
                  Cette grille ne surcharge encore rien : tout est facturé au tarif du catalogue.
                </div>
                <button class="btn btn-primary btn-sm" type="button"
                        data-modal-open="price-item-modal" data-price-item-new style="margin-top:12px">
                  <i data-lucide="plus"></i> Tarifer une prestation
                </button>
              </div>
            {% endif %}
          </div>

          <div class="rules">
            <div class="rules-title">Règles de la grille</div>
            {% if rules is not empty %}
              <ul class="rules-list">
                {% for rule in rules %}
                  <li class="rule-chip">
                    <b>{{ RULE_LABELS[rule.ruleType]|default(rule.ruleType) }}</b>
                    {% for key, value in rule.condition %}
                      <span>{{ key }} : {{ value is iterable ? value|join(', ') : value }}</span>
                    {% endfor %}
                    {% for key, value in rule.adjustment %}
                      <span>{{ key }} {{ value is iterable ? value|join(', ') : value }}</span>
                    {% endfor %}
                  </li>
                {% endfor %}
              </ul>
            {% else %}
              <p class="rules-empty">
                Aucune règle conditionnelle. Les coefficients d’urgence, de gabarit et d’espèce se
                configurent hors de cet écran.
              </p>
            {% endif %}
          </div>
        {% endif %}
      </section>

    </div>
  {% endif %}

{% endblock %}

{% block catalogue_modals %}
  {% if selected %}
    <div class="modal-overlay hidden" id="price-item-modal">
      <div class="modal">
        <form method="POST" action="{{ path('clinic_catalogue_price_item_save', { priceListId: selected.id }) }}">
          <div class="modal-head">
            <h2 class="modal-title" data-price-item-title>Tarifer une prestation</h2>
            <button class="btn btn-ghost btn-icon btn-sm" type="button" data-modal-close aria-label="Fermer">
              <i data-lucide="x"></i>
            </button>
          </div>
          <div class="modal-body">
            <input type="hidden" name="entry_id" value="" data-price-entry-id>

            <div data-price-item-picker>
              {{ include('clinic/catalog/_item_picker.html.twig', { pickerId: 'price' }) }}
            </div>

            <p class="cat-form-hint" data-price-item-label hidden></p>

            <div class="field" style="margin-top:var(--space-4)">
              <label class="field-label" for="price-net">Tarif de la grille TTC</label>
              <input class="form-input" id="price-net" name="net_price" required inputmode="decimal" placeholder="39,00">
            </div>
            <div class="field" style="margin-top:var(--space-4)">
              <label class="field-label" for="price-tax">
                TVA forcée <span class="field-optional">(facultatif)</span>
              </label>
              <select class="form-input" id="price-tax" name="tax_category_override">
                <option value="">Garder la TVA de la prestation</option>
                {% for category in taxCategories %}
                  <option value="{{ category.code }}">{{ category.label }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="modal-foot">
            <button class="btn btn-ghost" type="button" data-modal-close>Annuler</button>
            <button class="btn btn-primary" type="submit">Enregistrer</button>
          </div>
        </form>
      </div>
    </div>
  {% endif %}
{% endblock %}
