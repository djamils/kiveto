{#
 # Kiveto — templates/clinic/clients/form.html.twig
 # ─────────────────────────────────────────────────
 # Client create / edit form using Kiveto form components.
 #
 # Variables:
 #   client       ClientDto or null (null = create mode)
 #   csrf_token   string  CSRF token value
 #   currentClinicName  string
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}{{ client ? 'Modifier ' ~ client.firstName : 'Nouveau client' }} - {{ currentClinicName }}{% endblock %}

{% block page_title %}{{ client ? 'Modifier ' ~ client.firstName : 'Nouveau client' }}{% endblock %}

{% block topbar_actions %}
  <a href="{{ client ? path('clinic_clients_view', {id: client.id}) : path('clinic_clients_list') }}"
     class="btn btn-secondary btn-sm">Annuler</a>
  <button type="submit" form="clientForm" class="btn btn-primary btn-sm">
    {{ client ? 'Sauvegarder' : 'Creer' }}
  </button>
{% endblock %}

{% block content %}
  {# Breadcrumb navigation #}
  <nav style="margin-bottom:var(--space-4);font-size:var(--text-sm);color:var(--text-muted);">
    <a href="{{ path('clinic_clients_list') }}" style="color:var(--brand-600);">Clients</a>
    <span style="margin:0 var(--space-1);">/</span>
    {% if client %}
      <a href="{{ path('clinic_clients_view', {id: client.id}) }}" style="color:var(--brand-600);">{{ client.firstName }} {{ client.lastName }}</a>
      <span style="margin:0 var(--space-1);">/</span>
      <span style="color:var(--text-primary);">Modifier</span>
    {% else %}
      <span style="color:var(--text-primary);">Nouveau client</span>
    {% endif %}
  </nav>

  <form method="post"
        action="{{ client ? path('clinic_clients_update', {id: client.id}) : path('clinic_clients_create') }}"
        id="clientForm">
    <input type="hidden" name="_token" value="{{ csrf_token }}">

    {# Identity fields #}
    <div class="widget" style="margin-bottom:var(--space-4);">
      <div class="widget-head">
        <span class="widget-title">Identite</span>
      </div>
      <div class="widget-body">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4);">
          <div class="field">
            <label class="field-label" for="first_name">Prenom *</label>
            <input type="text"
                   class="form-input"
                   id="first_name"
                   name="first_name"
                   required
                   value="{{ client ? client.firstName : '' }}"
                   placeholder="Prenom du client">
          </div>
          <div class="field">
            <label class="field-label" for="last_name">Nom *</label>
            <input type="text"
                   class="form-input"
                   id="last_name"
                   name="last_name"
                   required
                   value="{{ client ? client.lastName : '' }}"
                   placeholder="Nom du client">
          </div>
        </div>
      </div>
    </div>

    {# Contact fields (simplified: primary email + phone) #}
    <div class="widget" style="margin-bottom:var(--space-4);">
      <div class="widget-head">
        <span class="widget-title">Contact</span>
      </div>
      <div class="widget-body">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4);">
          <div class="field">
            <label class="field-label" for="email">Email</label>
            <input type="email"
                   class="form-input"
                   id="email"
                   name="email"
                   value="{{ client and client.primaryEmail ? client.primaryEmail : '' }}"
                   placeholder="adresse@email.com">
          </div>
          <div class="field">
            <label class="field-label" for="phone">Telephone</label>
            <input type="tel"
                   class="form-input"
                   id="phone"
                   name="phone"
                   value="{{ client and client.primaryPhone ? client.primaryPhone : '' }}"
                   placeholder="06 12 34 56 78">
          </div>
        </div>
      </div>
    </div>

    {# Form actions #}
    <div style="display:flex;justify-content:flex-end;gap:var(--space-2);margin-top:var(--space-4);">
      <a href="{{ client ? path('clinic_clients_view', {id: client.id}) : path('clinic_clients_list') }}"
         class="btn btn-secondary">Annuler</a>
      <button type="submit" class="btn btn-primary">
        {{ client ? 'Sauvegarder les modifications' : 'Creer le client' }}
      </button>
    </div>
  </form>
{% endblock %}
