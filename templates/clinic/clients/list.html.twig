{#
 # Kiveto -- templates/clinic/clients/list.html.twig
 # ─────────────────────────────────────────────────
 # Client & animal list page -- pixel-perfect reproduction of vetos-clients.html mockup.
 # This page has its own topbar inside the content area.
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}Clients & Animaux{% endblock %}
{% block page_title %}Clients & Animaux{% endblock %}
{% block show_topbar %}false{% endblock %}

{% block stylesheets %}
<script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
<style>
  /* Full-height overrides — unbroken flex chain from shell to table body */
  .app-main-wrap{flex:1;overflow:hidden !important;min-height:0;}
  .app-scroll{flex:1;overflow:hidden !important;min-height:0;}
  .app-body{padding:0 !important;display:flex;flex-direction:column;flex:1;overflow:hidden;min-height:0;height:100%;}

  *{scrollbar-width:thin;scrollbar-color:#cbd5e1 transparent;}
  ::-webkit-scrollbar{width:2px;height:2px;}
  ::-webkit-scrollbar-track{background:transparent;}
  ::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:2px;}
  ::-webkit-scrollbar-button{display:none;}

  /* Topbar */
  .topbar{height:52px;flex-shrink:0;background:var(--surface-card);border-bottom:1px solid var(--border-light);display:flex;align-items:center;padding:0 var(--space-4);gap:var(--space-3);}
  .btn-burger{display:none;width:36px;height:36px;border-radius:var(--radius-md);border:none;background:transparent;cursor:pointer;align-items:center;justify-content:center;color:var(--text-muted);flex-shrink:0;}

  /* Search */
  .search-wrap{flex:1;max-width:480px;position:relative;}
  .search-input{width:100%;font-size:var(--text-md);font-family:inherit;background:var(--surface-subtle);border:1px solid var(--border-medium);border-radius:var(--radius-md);padding:7px var(--space-8) 7px var(--space-8);outline:none;color:var(--text-primary);transition:var(--transition-normal);}
  .search-input:focus{border-color:var(--brand-400);background:var(--surface-card);box-shadow:var(--shadow-focus);}
  .search-icon{position:absolute;left:var(--space-3);top:50%;transform:translateY(-50%);pointer-events:none;color:var(--text-subtle);}
  .search-kbd{position:absolute;right:var(--space-2);top:50%;transform:translateY(-50%);font-size:10px;color:var(--text-subtle);background:var(--surface-hover);border:1px solid var(--border-medium);border-radius:var(--radius-sm);padding:1px var(--space-1);pointer-events:none;}
  .search-clear{position:absolute;right:var(--space-2);top:50%;transform:translateY(-50%);width:18px;height:18px;border-radius:50%;background:var(--text-subtle);border:none;cursor:pointer;display:none;align-items:center;justify-content:center;}
  .search-clear:hover{background:var(--text-muted);}

  /* Filter pills */
  .fp{display:inline-flex;align-items:center;gap:var(--space-1);padding:4px var(--space-3);border-radius:var(--radius-full);font-size:var(--text-sm);font-weight:var(--weight-medium);border:1px solid var(--border-medium);background:var(--surface-card);color:var(--text-muted);cursor:pointer;transition:var(--transition-fast);white-space:nowrap;font-family:inherit;}
  .fp:hover{border-color:#c7d2fe;color:var(--brand-600);}
  .fp.active{border-color:var(--brand-500);background:var(--brand-50);color:var(--brand-600);}
  .fp .cnt{background:var(--surface-hover);color:var(--text-muted);border-radius:var(--radius-full);padding:0 var(--space-1);font-size:10px;font-weight:var(--weight-medium);}
  .fp.active .cnt{background:#c7d2fe;color:var(--brand-600);}

  /* Main area */
  .main-area{flex:1;display:flex;overflow:hidden;position:relative;min-height:0;}
  .table-wrap{flex:1;overflow:hidden;display:flex;flex-direction:column;min-width:0;background:var(--surface-card);border:none;border-radius:0;}

  /* Table header */
  .tbl-header{flex-shrink:0;background:var(--surface-card);border-bottom:1px solid var(--border-light);}
  .tbl-filter-bar{display:flex;align-items:center;gap:var(--space-2);padding:var(--space-2) var(--space-4);border-bottom:1px solid var(--border-light);overflow-x:visible;flex-wrap:nowrap;}
  .tbl-col-head{display:grid;grid-template-columns:var(--grid);padding:0 var(--space-4);background:var(--surface-subtle);}
  .col-th{padding:var(--space-2) 0;font-size:var(--text-xs);font-weight:var(--weight-medium);color:var(--text-subtle);text-transform:uppercase;letter-spacing:.07em;display:flex;align-items:center;gap:var(--space-1);cursor:pointer;user-select:none;white-space:nowrap;}
  .col-th:hover{color:var(--text-muted);}
  .col-th.sorted{color:var(--brand-600);}

  /* Table body */
  .tbl-body{flex:1;overflow-y:auto;}

  /* Client rows */
  .client-row-wrap{border-bottom:1px solid var(--border-light);transition:background var(--transition-fast);cursor:pointer;}
  .client-row-wrap:hover{background:var(--surface-subtle);}
  .client-row-wrap.active{background:var(--brand-50);border-left:2px solid var(--brand-500);}
  .client-row-wrap:last-child{border-bottom:none;}
  .client-row{display:grid;grid-template-columns:var(--grid);padding:0 var(--space-4);align-items:center;min-height:52px;}
  .client-row-wrap:hover .row-actions{opacity:1;}
  .row-actions{opacity:0;transition:opacity var(--transition-fast);display:flex;gap:var(--space-1);}
  .animal-section{background:var(--surface-subtle);border-top:1px solid var(--border-light);padding:var(--space-2) var(--space-4) var(--space-2) 52px;}
  .animal-row{display:grid;grid-template-columns:var(--grid);align-items:center;min-height:38px;border-radius:var(--radius-md);cursor:pointer;transition:background var(--transition-fast);}
  .animal-row+.animal-row{border-top:1px solid var(--border-light);}
  .animal-row:hover{background:var(--brand-50);}
  .animal-row.sel{background:var(--brand-50);}

  /* Pagination */
  .pagination{display:flex;align-items:center;gap:var(--space-1);padding:var(--space-2) var(--space-4);border-top:1px solid var(--border-light);background:var(--surface-card);flex-shrink:0;justify-content:space-between;}
  .pg-btn{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:var(--radius-md);border:1px solid var(--border-medium);background:var(--surface-card);color:var(--text-muted);font-size:var(--text-sm);font-weight:var(--weight-medium);cursor:pointer;font-family:inherit;transition:var(--transition-fast);}
  .pg-btn:hover:not(:disabled){background:var(--surface-subtle);}
  .pg-btn.active{background:var(--brand-600);color:#fff;border-color:var(--brand-600);}
  .pg-btn:disabled{opacity:.35;cursor:not-allowed;}

  /* Badges */
  .badge{font-size:var(--text-xs);font-weight:var(--weight-medium);padding:2px var(--space-2);border-radius:var(--radius-full);white-space:nowrap;display:inline-block;}
  .b-cat{background:#f5f3ff;color:#7c3aed;}
  .b-dog{background:#eff6ff;color:#1d4ed8;}
  .b-other{background:#f0fdf4;color:#15803d;}
  .b-ok{background:#f0fdf4;color:#15803d;}
  .b-warn{background:#fff7ed;color:#c2410c;}
  .b-alert{background:#fef2f2;color:#b91c1c;}
  .b-grey{background:var(--surface-subtle);color:var(--text-muted);border:1px solid var(--border-medium);}

  /* Buttons */
  .btn{display:inline-flex;align-items:center;gap:var(--space-1);padding:6px var(--space-3);border-radius:var(--radius-md);font-size:var(--text-sm);font-weight:var(--weight-medium);font-family:inherit;cursor:pointer;border:none;transition:var(--transition-fast);white-space:nowrap;}
  .btn:active{transform:scale(.98);}
  .btn-primary{background:var(--brand-600);color:#fff;}
  .btn-primary:hover{background:var(--brand-700);}
  .btn-secondary{background:var(--surface-subtle);color:var(--text-secondary);border:1px solid var(--border-medium);}
  .btn-secondary:hover{background:var(--surface-hover);}
  .btn-xs{padding:4px var(--space-2);font-size:var(--text-sm);}
  .btn-icon{width:28px;height:28px;padding:0;justify-content:center;border-radius:var(--radius-md);}
  .btn-close{width:28px;height:28px;border-radius:var(--radius-md);border:none;background:var(--surface-hover);cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text-muted);transition:var(--transition-fast);}
  .btn-close:hover{background:var(--surface-subtle);}

  /* Detail panel */
  .detail-panel{width:480px;flex-shrink:0;background:var(--surface-card);border-left:1px solid var(--border-light);display:flex;flex-direction:column;overflow:hidden;}
  .dp-header{padding:var(--space-4) var(--space-5) var(--space-3);border-bottom:1px solid var(--border-light);flex-shrink:0;}
  .dp-scroll{flex:1;overflow-y:auto;padding:0 var(--space-5) var(--space-4);}
  .dp-section{margin-bottom:var(--space-5);}
  .dp-section-title{font-size:var(--text-xs);font-weight:var(--weight-medium);color:var(--text-subtle);text-transform:uppercase;letter-spacing:.08em;margin-bottom:var(--space-2);}
  .info-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-2);}
  .info-cell{background:var(--surface-subtle);border-radius:var(--radius-md);padding:var(--space-2) var(--space-3);}
  .info-label{font-size:var(--text-xs);color:var(--text-subtle);margin-bottom:2px;}
  .info-value{font-size:var(--text-md);font-weight:var(--weight-medium);color:var(--text-primary);}
  .consult-row{display:flex;align-items:flex-start;gap:var(--space-3);padding:var(--space-2) 0;border-bottom:1px solid var(--border-light);}
  .consult-row:last-child{border-bottom:none;}
  .dp-animal-tabs{display:flex;gap:var(--space-1);flex-wrap:wrap;margin-bottom:var(--space-4);}
  .dp-animal-tab{display:inline-flex;align-items:center;gap:var(--space-1);padding:4px var(--space-3);border-radius:var(--radius-md);font-size:var(--text-sm);font-weight:var(--weight-medium);border:1px solid var(--border-medium);background:var(--surface-subtle);color:var(--text-muted);cursor:pointer;transition:var(--transition-fast);}
  .dp-animal-tab:hover{border-color:#c7d2fe;color:var(--brand-600);}
  .dp-animal-tab.active{border-color:var(--brand-500);background:var(--brand-50);color:var(--brand-600);}

  /* Slide overlay -- tablet */
  .detail-slide{position:absolute;right:0;top:0;bottom:0;width:480px;background:var(--surface-card);border-left:1px solid var(--border-light);display:flex;flex-direction:column;transform:translateX(100%);transition:transform .25s ease;z-index:20;}
  .detail-slide.open{transform:translateX(0);}
  .slide-backdrop{position:absolute;inset:0;background:rgba(15,23,42,.15);z-index:19;display:none;}
  .slide-backdrop.open{display:block;}

  /* Bottom sheet -- portrait */
  #bso{display:none;position:fixed;inset:0;background:rgba(15,23,42,.3);z-index:100;backdrop-filter:blur(2px);}
  #bs{display:none;position:fixed;left:0;right:0;bottom:0;background:var(--surface-card);border-radius:var(--radius-lg) var(--radius-lg) 0 0;box-shadow:var(--shadow-lg);z-index:101;max-height:85vh;overflow:hidden;flex-direction:column;transform:translateY(100%);transition:transform .3s ease;}
  #bs-scroll{flex:1;overflow-y:auto;}

  /* Toast */
  #toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(8px);padding:var(--space-2) var(--space-4);border-radius:var(--radius-md);font-size:var(--text-md);font-weight:var(--weight-medium);color:#fff;opacity:0;transition:all .25s;pointer-events:none;z-index:999;}

  /* Responsive */
  @media(max-width:1280px){
    .detail-panel{display:none;}
  }
  /* Column picker */
  .col-picker-wrap{position:relative;}
  .col-picker-btn{display:inline-flex;align-items:center;gap:var(--space-1);padding:4px var(--space-2);border-radius:var(--radius-md);font-size:var(--text-sm);font-weight:var(--weight-medium);border:1px solid var(--border-medium);background:var(--surface-card);color:var(--text-muted);cursor:pointer;font-family:inherit;transition:var(--transition-fast);}
  .col-picker-btn:hover{background:var(--surface-subtle);}
  .col-picker-btn.active{border-color:var(--brand-500);color:var(--brand-600);background:var(--brand-50);}
  .col-picker-popover{position:fixed;background:var(--surface-card);border:1px solid var(--border-medium);border-radius:var(--radius-lg);box-shadow:var(--shadow-md);padding:var(--space-2);min-width:180px;z-index:200;display:none;}
  .col-picker-popover.open{display:block;}
  .col-picker-item{display:flex;align-items:center;gap:var(--space-2);padding:var(--space-1) var(--space-2);border-radius:var(--radius-md);cursor:pointer;font-size:var(--text-md);color:var(--text-secondary);transition:var(--transition-fast);}
  .col-picker-item:hover{background:var(--surface-subtle);}
  .col-picker-item input[type=checkbox]{cursor:pointer;accent-color:var(--brand-600);}
  .col-picker-divider{height:1px;background:var(--border-light);margin:var(--space-1) 0;}

  @media(max-width:1280px){
    .col-phone,.col-email{display:none !important;}
  }
  @media(max-width:1024px){
    .col-nextrdv{display:none !important;}
  }
  /* Mobile card layout */
  .card-row{display:none;}
  @media(max-width:640px){
    .tbl-col-head{display:none !important;}
    .fp-label{display:none;}
    .grid-row{display:none !important;}
    .card-row{display:flex;align-items:center;gap:var(--space-3);padding:var(--space-3) var(--space-4);}
    .card-row-info{flex:1;min-width:0;}
    .card-row-right{display:flex;flex-direction:column;align-items:flex-end;gap:var(--space-1);flex-shrink:0;}
    .animal-section{padding-left:var(--space-3) !important;}
  }
  @media(max-width:1024px){
    .sidebar{display:none;}
    .btn-burger{display:flex;}
    .search-wrap{max-width:none;}
    .topbar-actions .btn span{display:none;}
    .col-nextrdv{display:none !important;}
  }
  @media(max-width:768px){
    .col-lastrdv{display:none !important;}
  }
  @media(max-width:640px){
    .tbl-col-head{display:none;}
    .fp-label{display:none;}
    .col-animals{display:none !important;}
  }
</style>
{% endblock %}

{% block content %}
  <div class="topbar">
    <button class="btn-burger" onclick="showToast('Menu','#4338ca')"><i data-lucide="menu" style="width:18px;height:18px;"></i></button>
    <div>
      <p style="font-size:var(--text-lg);font-weight:var(--weight-medium);color:var(--text-primary);line-height:1.2;">Clients &amp; Animaux</p>
      <p style="font-size:var(--text-sm);color:var(--text-subtle);" id="subtitle">24 clients · 38 animaux</p>
    </div>
    <div class="search-wrap">
      <i data-lucide="search" class="search-icon" style="width:14px;height:14px;"></i>
      <input class="search-input" id="search-input" type="text" placeholder="Nom, animal, téléphone, race…" oninput="onSearch(this.value)" autocomplete="off"/>
      <span class="search-kbd" id="search-kbd">⌘K</span>
      <button class="search-clear" id="search-clear" onclick="clearSearch()">
        <svg width="8" height="8" fill="none" viewBox="0 0 8 8"><path d="M1 1l6 6M7 1L1 7" stroke="#fff" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div style="margin-left:auto;display:flex;gap:var(--space-2);" class="topbar-actions">
      <button class="btn btn-secondary btn-xs" onclick="showToast('Export CSV…','#4338ca')">
        <i data-lucide="download" style="width:11px;height:11px;"></i><span>Exporter</span>
      </button>
      <a href="{{ path('clinic_clients_new') }}" class="btn btn-primary btn-xs">
        <i data-lucide="plus" style="width:11px;height:11px;"></i><span>Nouveau client</span>
      </a>
    </div>
  </div>

  <div class="main-area">
    <div class="table-wrap">
      <div class="tbl-header">
        <div class="tbl-filter-bar">
          <button class="fp active" id="filter-all" onclick="setFilter('all')">Tous <span class="cnt" id="cnt-all">0</span></button>
          <button class="fp" id="filter-recent" onclick="setFilter('recent')"><i data-lucide="clock" style="width:11px;height:11px;"></i><span class="fp-label">Récents</span></button>
          <button class="fp" id="filter-cat" onclick="setFilter('cat')">🐱 <span class="fp-label">Chats</span> <span class="cnt" id="cnt-cat">0</span></button>
          <button class="fp" id="filter-dog" onclick="setFilter('dog')">🐶 <span class="fp-label">Chiens</span> <span class="cnt" id="cnt-dog">0</span></button>
          <button class="fp" id="filter-other" onclick="setFilter('other')">🐾 <span class="fp-label">Autres</span> <span class="cnt" id="cnt-other">0</span></button>
          <button class="fp" id="filter-alert" onclick="setFilter('alert')" style="color:var(--color-danger-600);"><i data-lucide="alert-triangle" style="width:11px;height:11px;"></i><span class="fp-label">Alertes</span> <span class="cnt" id="cnt-alert">0</span></button>
          <div style="margin-left:auto;display:flex;align-items:center;gap:var(--space-2);">
            <span style="font-size:var(--text-sm);color:var(--text-subtle);">Trier</span>
            <select id="sort-select" onchange="renderTable()" style="font-size:var(--text-sm);border:1px solid var(--border-medium);border-radius:var(--radius-md);padding:4px var(--space-2);background:var(--surface-card);color:var(--text-secondary);font-family:inherit;outline:none;cursor:pointer;">
              <option value="name">Nom</option>
              <option value="recent">Dernier RDV</option>
              <option value="animals">Nb animaux</option>
            </select>
          </div>
          <!-- Column picker -->
          <div class="col-picker-wrap" id="col-picker-wrap">
            <button class="col-picker-btn" id="col-picker-btn" onclick="toggleColPicker()">
              <i data-lucide="columns" style="width:12px;height:12px;"></i>Colonnes
            </button>
            <div class="col-picker-popover" id="col-picker-popover">
              <p style="font-size:var(--text-xs);font-weight:var(--weight-medium);color:var(--text-subtle);text-transform:uppercase;letter-spacing:.07em;padding:var(--space-1) var(--space-2) var(--space-1);">Afficher</p>
              <label class="col-picker-item"><input type="checkbox" id="col-cb-phone" checked onchange="toggleCol('phone',this.checked)"> Téléphone</label>
              <label class="col-picker-item"><input type="checkbox" id="col-cb-email" checked onchange="toggleCol('email',this.checked)"> Email</label>
              <label class="col-picker-item"><input type="checkbox" id="col-cb-lastrdv" checked onchange="toggleCol('lastrdv',this.checked)"> Dernier RDV</label>
              <label class="col-picker-item"><input type="checkbox" id="col-cb-nextrdv" checked onchange="toggleCol('nextrdv',this.checked)"> Prochain RDV</label>
              <div class="col-picker-divider"></div>
              <button onclick="resetCols()" style="width:100%;padding:var(--space-1) var(--space-2);text-align:left;font-size:var(--text-sm);color:var(--text-muted);background:none;border:none;cursor:pointer;font-family:inherit;border-radius:var(--radius-md);" onmouseenter="this.style.background='var(--surface-subtle)'" onmouseleave="this.style.background='none'">Réinitialiser</button>
            </div>
          </div>
        </div>
        <div class="tbl-col-head" id="tbl-col-head" style="--grid:28px 1fr 130px 160px 100px 100px 60px 52px;">
          <div></div>
          <div class="col-th">Client / Animaux <i data-lucide="chevrons-up-down" style="width:10px;height:10px;opacity:.5;"></i></div>
          <div class="col-th col-phone">Téléphone</div>
          <div class="col-th col-email">Email</div>
          <div class="col-th col-lastrdv" onclick="setSort('recent')">Dernier RDV</div>
          <div class="col-th col-nextrdv">Prochain RDV</div>
          <div class="col-th">Statut</div>
          <div></div>
        </div>
      </div>
      <div class="tbl-body" id="tbl-body"></div>
      <div class="pagination" id="pagination"></div>
    </div>

    <!-- Desktop detail panel -->
    <div class="detail-panel" id="detail-panel">
      <div id="dp-content" style="display:flex;flex-direction:column;flex:1;overflow:hidden;">
        <div id="dp-header"></div>
        <div class="dp-scroll" id="dp-scroll">
          <div id="dp-empty" style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:40px 24px;text-align:center;">
            <div style="width:56px;height:56px;border-radius:var(--radius-lg);background:var(--surface-subtle);display:flex;align-items:center;justify-content:center;margin-bottom:var(--space-4);">
              <i data-lucide="users" style="width:24px;height:24px;color:var(--border-medium);"></i>
            </div>
            <p style="font-size:var(--text-base);font-weight:var(--weight-medium);color:var(--text-secondary);margin-bottom:var(--space-1);">Sélectionnez un client</p>
            <p style="font-size:var(--text-md);color:var(--text-subtle);line-height:1.5;max-width:200px;">Cliquez sur une ligne pour voir la fiche et les animaux</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Slide detail -- tablet -->
    <div class="slide-backdrop" id="slide-backdrop" onclick="closeSlide()"></div>
    <div class="detail-slide" id="detail-slide">
      <div id="slide-header"></div>
      <div class="dp-scroll" id="slide-scroll"></div>
    </div>

  </div>

  <!-- Bottom sheet -- portrait -->
  <div id="bso" onclick="closeBottomSheet()"></div>
  <div id="bs">
    <div style="padding:var(--space-2);display:flex;justify-content:center;flex-shrink:0;">
      <div style="width:40px;height:4px;border-radius:2px;background:var(--border-medium);"></div>
    </div>
    <div id="bs-scroll" style="flex:1;overflow-y:auto;"></div>
  </div>

  <div id="toast"></div>
{% endblock %}

{% block javascripts %}
<script>window.ROUTES = { clientsNew: '{{ path("clinic_clients_new") }}', clientsList: '{{ path("clinic_clients_list") }}' };</script>
{% endblock %}
