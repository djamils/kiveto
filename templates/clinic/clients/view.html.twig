{#
 # Kiveto — templates/clinic/clients/view.html.twig
 # ─────────────────────────────────────────────────
 # Client detail page with contact methods, postal address, and actions.
 #
 # Variables:
 #   client           ClientDto { id, firstName, lastName, status, createdAt,
 #                    updatedAt, contactMethods[], postalAddress }
 #   currentClinicName  string
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}{{ client.firstName }} {{ client.lastName }} - {{ currentClinicName }}{% endblock %}

{% block page_title %}{{ client.firstName }} {{ client.lastName }}{% endblock %}

{% block breadcrumb %}
  [{"label":"Clients","href":"{{ path('clinic_clients_list') }}"},{"label":"{{ client.firstName }} {{ client.lastName }}"}]
{% endblock %}

{% block topbar_actions %}
  {% if client.status == 'active' %}
    {{ include('components/ui/button.html.twig', {
      label: 'Modifier',
      variant: 'primary',
      size: 'sm',
      href: path('clinic_clients_edit', {id: client.id}),
    }) }}
  {% endif %}
{% endblock %}

{% block content %}
  {# Breadcrumb navigation #}
  <nav style="margin-bottom:var(--space-4);font-size:var(--text-sm);color:var(--text-muted);">
    <a href="{{ path('clinic_clients_list') }}" style="color:var(--brand-600);">Clients</a>
    <span style="margin:0 var(--space-1);">/</span>
    <span style="color:var(--text-primary);">{{ client.firstName }} {{ client.lastName }}</span>
  </nav>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4);">
    {# Contact methods widget #}
    <div class="widget">
      <div class="widget-head">
        <span class="widget-title">Coordonnees</span>
      </div>
      <div class="widget-body">
        {% if client.contactMethods|length > 0 %}
          {% for contact in client.contactMethods %}
            <div style="display:flex;align-items:center;justify-content:space-between;padding:var(--space-2) 0;{% if not loop.last %}border-bottom:1px solid var(--border-light);{% endif %}">
              <div>
                <span style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:var(--text-primary);text-transform:capitalize;">
                  {{ contact.label }}
                </span>
                {% if contact.isPrimary %}
                  <span class="badge b-blue badge-sm" style="margin-left:var(--space-1);">Principal</span>
                {% endif %}
                <div style="font-size:var(--text-xs);color:var(--text-muted);text-transform:capitalize;">
                  {{ contact.type == 'phone' ? 'Telephone' : 'Email' }}
                </div>
              </div>
              <div style="font-size:var(--text-sm);">
                {% if contact.type == 'phone' %}
                  <a href="tel:{{ contact.value }}" style="color:var(--brand-600);">{{ contact.value }}</a>
                {% else %}
                  <a href="mailto:{{ contact.value }}" style="color:var(--brand-600);">{{ contact.value }}</a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          <p style="color:var(--text-subtle);font-size:var(--text-sm);">Aucun moyen de contact enregistre.</p>
        {% endif %}
      </div>
    </div>

    {# Postal address widget #}
    <div class="widget">
      <div class="widget-head">
        <span class="widget-title">Adresse postale</span>
      </div>
      <div class="widget-body">
        {% if client.postalAddress %}
          <address style="font-style:normal;font-size:var(--text-sm);color:var(--text-primary);line-height:1.6;">
            {{ client.postalAddress.streetLine1 }}<br>
            {% if client.postalAddress.streetLine2 %}
              {{ client.postalAddress.streetLine2 }}<br>
            {% endif %}
            {% if client.postalAddress.postalCode %}
              {{ client.postalAddress.postalCode }}
            {% endif %}
            {{ client.postalAddress.city }}<br>
            {% if client.postalAddress.region %}
              {{ client.postalAddress.region }}<br>
            {% endif %}
            <strong style="color:var(--brand-600);">{{ client.postalAddress.countryCode }}</strong>
          </address>
        {% else %}
          <p style="color:var(--text-subtle);font-size:var(--text-sm);">Aucune adresse postale enregistree.</p>
        {% endif %}
      </div>
    </div>
  </div>

  {# Status and info widget #}
  <div class="widget" style="margin-top:var(--space-4);">
    <div class="widget-head">
      <span class="widget-title">Informations</span>
      <div style="display:flex;gap:var(--space-2);">
        {% if client.status == 'active' %}
          <span class="badge b-ok">Actif</span>
        {% else %}
          <span class="badge b-grey">Archive</span>
        {% endif %}
      </div>
    </div>
    <div class="widget-body">
      <div class="info-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-3);">
        <div>
          <div style="font-size:var(--text-xs);color:var(--text-muted);margin-bottom:2px;">Prenom</div>
          <div style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:var(--text-primary);">{{ client.firstName }}</div>
        </div>
        <div>
          <div style="font-size:var(--text-xs);color:var(--text-muted);margin-bottom:2px;">Nom</div>
          <div style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:var(--text-primary);">{{ client.lastName }}</div>
        </div>
        <div>
          <div style="font-size:var(--text-xs);color:var(--text-muted);margin-bottom:2px;">Cree le</div>
          <div style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:var(--text-primary);">{{ client.createdAt|date('d/m/Y H:i') }}</div>
        </div>
        <div>
          <div style="font-size:var(--text-xs);color:var(--text-muted);margin-bottom:2px;">ID</div>
          <div style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:var(--text-primary);font-family:monospace;">{{ client.id|slice(0, 8) }}...</div>
        </div>
      </div>
    </div>
  </div>

  {# Action buttons #}
  <div style="display:flex;gap:var(--space-2);margin-top:var(--space-4);">
    {% if client.status == 'active' %}
      <a href="{{ path('clinic_clients_edit', {id: client.id}) }}" class="btn btn-primary">Modifier</a>
      <form method="post" action="{{ path('clinic_clients_archive', {id: client.id}) }}" style="display:inline;">
        <input type="hidden" name="_token" value="{{ csrf_token('clinic_client_form') }}">
        <button type="submit" class="btn btn-secondary"
                onclick="return confirm('Etes-vous sur de vouloir archiver ce client ?');">
          Archiver
        </button>
      </form>
    {% else %}
      <form method="post" action="{{ path('clinic_clients_unarchive', {id: client.id}) }}" style="display:inline;">
        <input type="hidden" name="_token" value="{{ csrf_token('clinic_client_form') }}">
        <button type="submit" class="btn btn-success"
                onclick="return confirm('Etes-vous sur de vouloir desarchiver ce client ?');">
          Desarchiver
        </button>
      </form>
    {% endif %}
  </div>
{% endblock %}
