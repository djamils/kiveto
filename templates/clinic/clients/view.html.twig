{#
 # Kiveto — templates/clinic/clients/view.html.twig
 # ─────────────────────────────────────────────────
 # Client record page — VetSaaS design from vetos-fiche-client.html mockup.
 # Left column: owner info, contacts, notes.
 # Right column: animal tabs, animal details, widgets, vital charts, documents.
 #
 # Variables:
 #   client           ClientDto { id, firstName, lastName, status, createdAt,
 #                    updatedAt, contactMethods[], postalAddress }
 #   currentClinicId    string
 #   currentClinicName  string
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}{{ client is defined ? client.firstName ~ ' ' ~ client.lastName ~ ' — ' ~ currentClinicName : 'Fiche client — ' ~ currentClinicName }}{% endblock %}

{% block page_title %}{{ client is defined ? client.firstName ~ ' ' ~ client.lastName : 'Sophie Dubois' }}{% endblock %}

{% block breadcrumb %}
  <a href="{{ path('clinic_clients_list') }}" class="cv-breadcrumb-link">
    <svg width="13" height="13" fill="none" viewBox="0 0 16 16"><path d="M10 4L6 8l4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Clients & Animaux
  </a>
  <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M4.5 3l3 3-3 3" stroke="#cbd5e1" stroke-width="1.3" stroke-linecap="round"/></svg>
  <span class="topbar-title cv-breadcrumb-current">
    {% if client is defined %}{{ client.firstName }} {{ client.lastName }}{% else %}Sophie Dubois{% endif %}
  </span>
{% endblock %}

{% block topbar_actions %}
  <div class="topbar-actions cv-topbar-actions">
    <button class="btn btn-secondary" onclick="toast('Nouveau RDV…','#4338ca')">
      <svg width="11" height="11" fill="none" viewBox="0 0 12 12"><rect x="1" y="2" width="10" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M4 1v2M8 1v2M1 5h10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg><span>Nouveau RDV</span>
    </button>
    <button class="btn btn-primary" onclick="toast('Nouvelle consultation…','#4338ca')">
      <svg width="11" height="11" fill="none" viewBox="0 0 12 12"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg><span>Nouvelle consultation</span>
    </button>
  </div>
{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/pages/client-view.css') }}"/>
{% endblock %}

{% block content %}
<div class="drawer-overlay" id="drawer-overlay" onclick="closeAllDrawers()"></div>

<div class="page-body">

  {# Left column: owner identity, contacts, notes #}
  {% include 'clinic/clients/view/_client_info.html.twig' %}

  {# Right column: animal tabs and content area #}
  {% include 'clinic/clients/view/_animal_tabs.html.twig' %}

</div>
{% endblock %}

{% block modals %}
{# All modals: owner edit, phones, prefs, identification, aux contact, status #}
{% include 'clinic/clients/view/_modals.html.twig' %}

<div id="toast"></div>
{% endblock %}

{% block javascripts %}
{% endblock %}
