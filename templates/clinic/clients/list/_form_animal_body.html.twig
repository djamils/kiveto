{# Turbo Streams target: a plain wrapper, replaced whole on a 422. #}

{#
 # Choices drawn as kit chips: a real radio input, visually replaced by its
 # label. Hand-rendered fields are marked rendered, or form_end would print
 # them again.
 #}
{% macro chips(field, emoji) %}
  {% do field.setRendered %}
  <div class="chips" role="radiogroup">
    {% for choice in field.vars.choices %}
      {% set id = field.vars.id ~ '_' ~ loop.index0 %}
      <input type="radio" id="{{ id }}" name="{{ field.vars.full_name }}" value="{{ choice.value }}"{{ choice.value == field.vars.value ? ' checked' }}>
      <label for="{{ id }}">{% if emoji[choice.value] is defined %}<span>{{ emoji[choice.value] }}</span>{% endif %}{{ choice.label }}</label>
    {% endfor %}
  </div>
{% endmacro %}

<div id="new-animal-form-body">
  {{ form_start(form, { attr: { id: 'form-new-animal' }, action: path('clinic_animals_create'), method: 'POST' }) }}
    {{ form_errors(form) }}

    <div class="frow">
      {{ form_label(form.name, "Nom de l'animal", { label_attr: { class: 'flbl' } }) }}
      {{ form_widget(form.name, { attr: { class: 'finput', placeholder: 'Luna' } }) }}
      {{ form_errors(form.name) }}
    </div>

    <div class="frow">
      <span class="flbl">Espèce <span class="req">*</span></span>
      {{ _self.chips(form.species, { dog: '🐕', cat: '🐈', nac: '🐇', other: '🐾' }) }}
      {{ form_errors(form.species) }}
    </div>

    <div class="g2 frow">
      <div>
        {{ form_label(form.breedName, 'Race', { label_attr: { class: 'flbl' } }) }}
        {{ form_widget(form.breedName, { attr: { class: 'finput', placeholder: 'ex : Beauceron, Européen…' } }) }}
        {{ form_errors(form.breedName) }}
      </div>
      <div>
        {{ form_label(form.birthDate, 'Date de naissance', { label_attr: { class: 'flbl' } }) }}
        {{ form_widget(form.birthDate, { attr: { class: 'finput' } }) }}
        {{ form_errors(form.birthDate) }}
      </div>
    </div>

    <div class="g2 frow">
      <div>
        <span class="flbl">Sexe <span class="req">*</span></span>
        {{ _self.chips(form.sex, {}) }}
        {{ form_errors(form.sex) }}
      </div>
      <div>
        <span class="flbl">Stérilisé·e</span>
        {{ _self.chips(form.reproductiveStatus, {}) }}
        {{ form_errors(form.reproductiveStatus) }}
      </div>
    </div>

    {{ form_widget(form.primaryOwnerClientId) }}
    {{ form_widget(form._returnTo) }}
  {{ form_end(form) }}
</div>
