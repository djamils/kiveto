{#
 # Modal: Nouvel animal — shell kit (.mveil / .mbox). The owner picker on top
 # keeps the client-search-autocomplete markup so its controller still drives it.
 #}
<div class="mveil" id="modal-new-animal" role="dialog" aria-modal="true" aria-labelledby="modal-new-animal-title">
  <div class="mbox">
    <div class="mhead">
      <span class="mic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="20" cy="16" r="2"/><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/></svg></span>
      <div class="mt"><b id="modal-new-animal-title">Nouvel animal</b><span>Créer une fiche patient</span></div>
      <button type="button" class="mclose" aria-label="Fermer" data-close>{{ _svg.x|raw }}</button>
    </div>
    <div class="mbody">
      <div class="frow combobox"
           data-controller="client-search-autocomplete"
           data-client-search-autocomplete-url-value="{{ path('api_clinic_clients_search') }}"
           data-client-search-autocomplete-min-chars-value="0"
           data-client-search-autocomplete-create-label-value="Créer un nouveau client">
        <label class="flbl" for="na-owner-search">Propriétaire <span class="req">*</span></label>
        <input type="text" id="na-owner-search" class="finput" placeholder="Rechercher un client…"
               role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="na-owner-listbox" autocomplete="off"
               data-client-search-autocomplete-target="input"
               data-action="input->client-search-autocomplete#onInput keydown->client-search-autocomplete#onKeydown focus->client-search-autocomplete#onFocus">
        <ul id="na-owner-listbox" class="autocomplete-listbox hidden" role="listbox" data-client-search-autocomplete-target="dropdown"></ul>
        <div class="sr-only" aria-live="polite" data-client-search-autocomplete-target="liveRegion"></div>
      </div>
      {{ include('clinic/clients/list/_form_animal_body.html.twig', { form: createAnimalForm }) }}
    </div>
    <div class="mfoot">
      <button type="button" class="btn" data-close>Annuler</button>
      <button type="submit" form="form-new-animal" class="btn primaire">Créer l'animal</button>
    </div>
  </div>
</div>
