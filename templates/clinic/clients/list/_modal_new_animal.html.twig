{# Modal: Nouvel animal — wizard with 2 steps (owner + animal details) #}

<div
  class="modal-overlay hidden"
  id="modal-new-animal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-new-animal-title"
  data-controller="wizard"
>
  <div class="modal wizard-modal" style="max-width: 640px;">

    <div class="modal-head">
      <div class="wizard-head-left">
        <span class="modal-title" id="modal-new-animal-title">Nouvel animal</span>
        <span class="wizard-step-label">
          Étape <span data-wizard-target="currentLabel">1</span> sur <span data-wizard-target="totalLabel">2</span>
        </span>
      </div>
      <button class="btn btn-ghost btn-icon btn-sm" type="button" aria-label="Fermer" data-modal-close>
        <i data-lucide="x"></i>
      </button>
    </div>

    {# Stepper #}
    <div class="wizard-stepper">
      <div class="wizard-step is-active" data-wizard-target="stepIndicator">
        <span class="wizard-step-num">1</span>
        <span class="wizard-step-name">Propriétaire</span>
      </div>
      <div class="wizard-step-sep"></div>
      <div class="wizard-step" data-wizard-target="stepIndicator">
        <span class="wizard-step-num">2</span>
        <span class="wizard-step-name">Animal</span>
      </div>
    </div>

    <div class="modal-body wizard-body">

      {# ── Step 1: Owner ── #}
      <div class="wizard-pane" data-wizard-target="pane">

        <p class="wizard-section-title">Le propriétaire est-il déjà enregistré ?</p>

        <div class="wizard-choice-grid" data-controller="wizard-choice">
          <button type="button" class="wizard-choice is-active" data-action="click->wizard-choice#pick" data-value="existing">
            <span class="wizard-choice-icon" style="background:#dbeafe;color:#2563eb;">
              <i data-lucide="user-search"></i>
            </span>
            <div class="wizard-choice-body">
              <p class="wizard-choice-title">Propriétaire existant</p>
              <p class="wizard-choice-sub">Sélectionner un client déjà enregistré</p>
            </div>
            <span class="wizard-choice-check"><i data-lucide="check"></i></span>
          </button>

          <button type="button" class="wizard-choice" data-action="click->wizard-choice#pick" data-value="new">
            <span class="wizard-choice-icon" style="background:#dcfce7;color:#16a34a;">
              <i data-lucide="user-plus"></i>
            </span>
            <div class="wizard-choice-body">
              <p class="wizard-choice-title">Nouveau propriétaire</p>
              <p class="wizard-choice-sub">Créer un client en même temps</p>
            </div>
            <span class="wizard-choice-check"><i data-lucide="check"></i></span>
          </button>
        </div>

        {# Existing owner panel #}
        <div class="wizard-owner-panel" data-wizard-choice-target="panel" data-panel="existing">
          <div class="field">
            <label class="field-label" for="na-existing-owner">Rechercher un client</label>
            {{ include('components/ui/select.html.twig', {
              name: 'existing_owner',
              id: 'na-existing-owner',
              placeholder: 'Tapez un nom…',
              searchable: true,
              clearable: true,
              options: [
                { value: '1',  label: 'Sophie Dubois' },
                { value: '2',  label: 'Marc Bernard' },
                { value: '3',  label: 'Claire Petit' },
                { value: '4',  label: 'Antoine Dupuis' },
                { value: '5',  label: 'Julie Leclerc' },
                { value: '6',  label: 'Pierre Moreau' },
                { value: '7',  label: 'Isabelle Girard' },
                { value: '8',  label: 'Thomas Lefebvre' },
                { value: '9',  label: 'Nathalie Fontaine' },
                { value: '10', label: 'Camille Chevalier' },
                { value: '11', label: 'François Garnier' },
                { value: '12', label: 'Amélie Roux' },
              ]
            }) }}
          </div>
        </div>

        {# New owner panel (hidden by default) #}
        <div class="wizard-owner-panel hidden" data-wizard-choice-target="panel" data-panel="new">
          <div class="form-grid">
            <div class="field">
              <label class="field-label" for="na-no-first">Prénom</label>
              <input type="text" id="na-no-first" class="form-input" placeholder="Sophie"/>
            </div>
            <div class="field">
              <label class="field-label" for="na-no-last">Nom</label>
              <input type="text" id="na-no-last" class="form-input" placeholder="Dubois"/>
            </div>
            <div class="field form-col-2">
              <label class="field-label" for="na-no-email">Email</label>
              <input type="email" id="na-no-email" class="form-input" placeholder="sophie.dubois@email.fr"/>
            </div>
            <div class="field">
              <label class="field-label" for="na-no-phone">Téléphone</label>
              <input type="tel" id="na-no-phone" class="form-input" placeholder="+33 6 12 34 56 78"/>
            </div>
          </div>
        </div>

      </div>

      {# ── Step 2: Animal details ── #}
      <div class="wizard-pane hidden" data-wizard-target="pane">

        <p class="wizard-section-title">Informations sur l'animal</p>

        <div class="form-grid">
          <div class="field">
            <label class="field-label" for="na-name">Nom</label>
            <input type="text" id="na-name" class="form-input" placeholder="Milo"/>
          </div>
          <div class="field">
            <label class="field-label" for="na-species">Espèce</label>
            {{ include('components/ui/select.html.twig', {
              name: 'species',
              id: 'na-species',
              placeholder: 'Choisir…',
              options: [
                { value: 'Canin',  label: '🐶 Chien' },
                { value: 'Félin',  label: '🐱 Chat' },
                { value: 'Lapin',  label: '🐰 Lapin' },
                { value: 'NAC',    label: '🦎 NAC' },
                { value: 'Oiseau', label: '🦜 Oiseau' },
              ]
            }) }}
          </div>
          <div class="field">
            <label class="field-label" for="na-breed">Race</label>
            <input type="text" id="na-breed" class="form-input" placeholder="Berger Australien"/>
          </div>
          <div class="field">
            <label class="field-label" for="na-sex">Sexe</label>
            {{ include('components/ui/select.html.twig', {
              name: 'sex',
              id: 'na-sex',
              placeholder: 'Choisir…',
              options: [
                { value: 'M', label: 'Mâle' },
                { value: 'F', label: 'Femelle' },
              ]
            }) }}
          </div>
          <div class="field">
            <label class="field-label" for="na-dob">Date de naissance</label>
            <input type="date" id="na-dob" class="form-input"/>
          </div>
          <div class="field">
            <label class="field-label" for="na-weight">Poids</label>
            <input type="text" id="na-weight" class="form-input" placeholder="12 kg"/>
          </div>
          <div class="field form-col-2">
            <label class="field-label" for="na-chip">N° d'identification</label>
            <input type="text" id="na-chip" class="form-input" placeholder="250268500012345"/>
          </div>
          <div class="field form-col-2">
            <label class="field-label" for="na-notes">Notes</label>
            <textarea id="na-notes" class="form-input" placeholder="Allergies, comportement, antécédents…"></textarea>
          </div>
        </div>

      </div>

    </div>

    <div class="modal-foot wizard-foot">
      <button type="button" class="btn btn-secondary btn-sm" data-modal-close>Annuler</button>
      <div class="wizard-foot-right">
        <button
          type="button"
          class="btn btn-secondary btn-sm"
          data-wizard-target="prev"
          data-action="click->wizard#prev"
          disabled
        >
          <i data-lucide="chevron-left"></i>
          Précédent
        </button>
        <button
          type="button"
          class="btn btn-primary btn-sm"
          data-wizard-target="next"
          data-action="click->wizard#next"
        >
          Suivant
          <i data-lucide="chevron-right"></i>
        </button>
        <button
          type="button"
          class="btn btn-primary btn-sm hidden"
          data-wizard-target="finish"
          data-action="click->wizard#finish"
        >
          <i data-lucide="check"></i>
          Créer l'animal
        </button>
      </div>
    </div>

  </div>
</div>
