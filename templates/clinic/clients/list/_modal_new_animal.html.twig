{#
 # Modal: Nouvel animal — the Répertoire design. One pane instead of the old
 # two-step wizard: the mock puts the owner picker at the top of the same form.
 # The autocomplete markup is unchanged so its Stimulus controller keeps working.
 #}
<div
  class="modal-overlay hidden"
  id="modal-new-animal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-new-animal-title"
>
  <div class="modal">

    <div class="modal-head">
      <div class="modal-head-icon" aria-hidden="true"><i data-lucide="paw-print"></i></div>
      <div class="modal-head-title" id="modal-new-animal-title">
        Nouvel animal
        <span class="modal-head-sub">Créer une fiche patient</span>
      </div>
      <button class="modal-close" type="button" aria-label="Fermer" data-modal-close>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 3l10 10M13 3L3 13"/></svg>
      </button>
    </div>

    <div class="modal-body">
      <div
        class="form-row combobox"
        data-controller="client-search-autocomplete"
        data-client-search-autocomplete-url-value="{{ path('api_clinic_clients_search') }}"
        data-client-search-autocomplete-min-chars-value="0"
        data-client-search-autocomplete-create-label-value="Créer un nouveau client"
      >
        <label class="form-label" for="na-owner-search">Propriétaire <span class="req">*</span></label>
        <input
          type="text"
          id="na-owner-search"
          class="form-input"
          placeholder="Rechercher un client…"
          role="combobox"
          aria-expanded="false"
          aria-autocomplete="list"
          aria-controls="na-owner-listbox"
          autocomplete="off"
          data-client-search-autocomplete-target="input"
          data-action="input->client-search-autocomplete#onInput keydown->client-search-autocomplete#onKeydown focus->client-search-autocomplete#onFocus"
        />
        <ul
          id="na-owner-listbox"
          class="autocomplete-listbox combobox-list hidden"
          role="listbox"
          data-client-search-autocomplete-target="dropdown"
        ></ul>
        <div
          class="sr-only"
          aria-live="polite"
          data-client-search-autocomplete-target="liveRegion"
        ></div>
      </div>

      {{ include('clinic/clients/list/_form_animal_body.html.twig', {form: createAnimalForm}) }}
    </div>

    <div class="modal-foot">
      <button type="button" class="btn btn-secondary btn-sm" data-modal-close>Annuler</button>
      <button type="submit" form="form-new-animal" class="btn btn-primary btn-sm">
        <i data-lucide="check"></i>
        Créer l'animal
      </button>
    </div>

  </div>
</div>
