{#
 # Modal: Nouveau client — the Répertoire design, wired to the Symfony form
 # through Turbo Streams.
 #}
<div
  class="modal-overlay hidden"
  id="modal-new-client"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-new-client-title"
>
  <div class="modal">

    <div class="modal-head">
      <div class="modal-head-icon" aria-hidden="true"><i data-lucide="user-plus"></i></div>
      <div class="modal-head-title" id="modal-new-client-title">
        Nouveau client
        <span class="modal-head-sub">Créer une fiche propriétaire</span>
      </div>
      <button class="btn btn-ghost btn-icon btn-sm" type="button" aria-label="Fermer" data-modal-close>
        <i data-lucide="x"></i>
      </button>
    </div>

    <div class="modal-body">
      {{ include('clinic/clients/list/_form_client_body.html.twig', {form: createClientForm}) }}
    </div>

    <div class="modal-foot">
      <button type="button" class="btn btn-secondary btn-sm" data-modal-close>Annuler</button>
      <button type="submit" form="form-new-client" class="btn btn-primary btn-sm">
        <i data-lucide="check"></i>
        Créer le client
      </button>
    </div>

  </div>
</div>
