{#
 # Modal: Nouveau client — shell kit (.mveil / .mbox), wired to the Symfony
 # form through Turbo Streams (_create_client_error.stream on a 422).
 #}
<div class="mveil" id="modal-new-client" role="dialog" aria-modal="true" aria-labelledby="modal-new-client-title">
  <div class="mbox">
    <div class="mhead">
      <span class="mic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg></span>
      <div class="mt"><b id="modal-new-client-title">Nouveau client</b><span>Créer une fiche propriétaire</span></div>
      <button type="button" class="mclose" aria-label="Fermer" data-close>{{ _svg.x|raw }}</button>
    </div>
    <div class="mbody">
      {{ include('clinic/clients/list/_form_client_body.html.twig', { form: createClientForm }) }}
    </div>
    <div class="mfoot">
      <button type="button" class="btn" data-close>Annuler</button>
      <button type="submit" form="form-new-client" class="btn primaire">Créer le client</button>
    </div>
  </div>
</div>
