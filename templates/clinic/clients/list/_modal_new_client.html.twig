{#
 # « Nouveau client » — the client and their animals, in one go. The two
 # columns are drawn by assets/js/pages/clients/create.js.
 #}
<div class="nw-veil" id="mNvCli" role="dialog" aria-modal="true" aria-label="Nouveau client"><div class="nw-box">
  <div class="nw-head"><div><b>Nouveau client</b><span>Le client et ses animaux, en une fois</span></div><button type="button" class="nw-x" data-nwx aria-label="Fermer">{{ _svg.x|raw }}</button></div>
  <div class="nw-body"><div class="nw-cols"><div id="ncCli"></div><div class="nw-div"></div><div id="ncAnis"></div></div></div>
  <div class="nw-foot"><span class="nw-manque" id="ncManque"></span><button type="button" class="btn" data-nwx>Annuler</button><button type="button" class="btn primaire" id="ncOk" disabled>Créer le client</button></div>
</div></div>
