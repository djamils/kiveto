{# Overview tab — KPIs, recent activity, alerts #}

<div class="ca-overview">

  {# ── KPI cards ── #}
  <div class="ca-kpi-grid">
    <div class="ca-kpi-card">
      <div class="ca-kpi-icon" style="background:#e0e7ff;color:#4338ca;">
        <i data-lucide="users"></i>
      </div>
      <div class="ca-kpi-body">
        <p class="ca-kpi-label">Clients actifs</p>
        <p class="ca-kpi-value" id="ca-kpi-clients">12</p>
        <p class="ca-kpi-trend ca-kpi-trend--up">
          <i data-lucide="trending-up"></i> +2 ce mois
        </p>
      </div>
    </div>

    <div class="ca-kpi-card">
      <div class="ca-kpi-icon" style="background:#dcfce7;color:#16a34a;">
        <i data-lucide="paw-print"></i>
      </div>
      <div class="ca-kpi-body">
        <p class="ca-kpi-label">Animaux suivis</p>
        <p class="ca-kpi-value" id="ca-kpi-animals">15</p>
        <p class="ca-kpi-trend ca-kpi-trend--up">
          <i data-lucide="trending-up"></i> +3 ce mois
        </p>
      </div>
    </div>

    <div class="ca-kpi-card">
      <div class="ca-kpi-icon" style="background:#fef9c3;color:#d97706;">
        <i data-lucide="calendar-clock"></i>
      </div>
      <div class="ca-kpi-body">
        <p class="ca-kpi-label">RDV cette semaine</p>
        <p class="ca-kpi-value">8</p>
        <p class="ca-kpi-trend">
          <i data-lucide="minus"></i> Stable
        </p>
      </div>
    </div>

    <div class="ca-kpi-card">
      <div class="ca-kpi-icon" style="background:#fee2e2;color:#dc2626;">
        <i data-lucide="alert-triangle"></i>
      </div>
      <div class="ca-kpi-body">
        <p class="ca-kpi-label">Alertes actives</p>
        <p class="ca-kpi-value" id="ca-kpi-alerts">3</p>
        <p class="ca-kpi-trend ca-kpi-trend--down">
          <i data-lucide="trending-down"></i> -1 cette semaine
        </p>
      </div>
    </div>
  </div>

  {# ── Two columns: recent + alerts ── #}
  <div class="ca-overview-cols">

    {# Recent activity #}
    <div class="ca-card">
      <div class="ca-card-head">
        <div class="ca-card-title">
          <i data-lucide="activity"></i>
          <span>Activité récente</span>
        </div>
        <a href="#" class="ca-card-link">Tout voir</a>
      </div>
      <div class="ca-card-body ca-activity-list">

        <a href="#" class="ca-activity">
          <span class="ca-activity-icon" style="background:#dcfce7;color:#16a34a;">
            <i data-lucide="check"></i>
          </span>
          <div class="ca-activity-body">
            <p class="ca-activity-title">Vaccination annuelle — <strong>Milo</strong></p>
            <p class="ca-activity-meta">Sophie Dubois · il y a 2h</p>
          </div>
          <span class="badge b-ok">Terminé</span>
        </a>

        <a href="#" class="ca-activity">
          <span class="ca-activity-icon" style="background:#dbeafe;color:#2563eb;">
            <i data-lucide="calendar-plus"></i>
          </span>
          <div class="ca-activity-body">
            <p class="ca-activity-title">Nouveau RDV — <strong>Luna</strong></p>
            <p class="ca-activity-meta">Marie Martin · il y a 4h</p>
          </div>
          <span class="badge b-sched">Demain 14h30</span>
        </a>

        <a href="#" class="ca-activity">
          <span class="ca-activity-icon" style="background:#f3e8ff;color:#9333ea;">
            <i data-lucide="user-plus"></i>
          </span>
          <div class="ca-activity-body">
            <p class="ca-activity-title">Nouveau client — <strong>Lucas Petit</strong></p>
            <p class="ca-activity-meta">Inscrit hier · 1 animal</p>
          </div>
          <span class="badge b-new">Nouveau</span>
        </a>

        <a href="#" class="ca-activity">
          <span class="ca-activity-icon" style="background:#fef9c3;color:#d97706;">
            <i data-lucide="file-text"></i>
          </span>
          <div class="ca-activity-body">
            <p class="ca-activity-title">Ordonnance émise — <strong>Rocky</strong></p>
            <p class="ca-activity-meta">Pierre Bernard · il y a 1 jour</p>
          </div>
          <span class="badge b-given">Donnée</span>
        </a>

        <a href="#" class="ca-activity">
          <span class="ca-activity-icon" style="background:#dcfce7;color:#16a34a;">
            <i data-lucide="check"></i>
          </span>
          <div class="ca-activity-body">
            <p class="ca-activity-title">Bilan sanguin — <strong>Bella</strong></p>
            <p class="ca-activity-meta">Emma Roux · il y a 2 jours</p>
          </div>
          <span class="badge b-ok">Terminé</span>
        </a>

      </div>
    </div>

    {# Alerts panel #}
    <div class="ca-card">
      <div class="ca-card-head">
        <div class="ca-card-title">
          <i data-lucide="alert-triangle"></i>
          <span>Alertes</span>
        </div>
        <a href="#" class="ca-card-link">Tout voir</a>
      </div>
      <div class="ca-card-body ca-alerts-list">

        <a href="#" class="ca-alert ca-alert--danger">
          <span class="ca-alert-icon">
            <i data-lucide="alert-circle"></i>
          </span>
          <div class="ca-alert-body">
            <p class="ca-alert-title"><strong>Rocky</strong> · Vaccin expiré</p>
            <p class="ca-alert-sub">Pierre Bernard · Depuis 12 jours</p>
          </div>
        </a>

        <a href="#" class="ca-alert ca-alert--warning">
          <span class="ca-alert-icon">
            <i data-lucide="clock-alert"></i>
          </span>
          <div class="ca-alert-body">
            <p class="ca-alert-title"><strong>Bella</strong> · Bilan à renouveler</p>
            <p class="ca-alert-sub">Emma Roux · Échéance dans 5 jours</p>
          </div>
        </a>

        <a href="#" class="ca-alert ca-alert--warning">
          <span class="ca-alert-icon">
            <i data-lucide="syringe"></i>
          </span>
          <div class="ca-alert-body">
            <p class="ca-alert-title"><strong>Cookie</strong> · Rappel à prévoir</p>
            <p class="ca-alert-sub">Lucas Petit · Échéance dans 8 jours</p>
          </div>
        </a>

      </div>
    </div>

  </div>

  {# ── Quick stats by species ── #}
  <div class="ca-card">
    <div class="ca-card-head">
      <div class="ca-card-title">
        <i data-lucide="pie-chart"></i>
        <span>Répartition par espèce</span>
      </div>
    </div>
    <div class="ca-card-body">
      <div class="ca-species-grid">
        <div class="ca-species-item">
          <span class="ca-species-emoji">🐶</span>
          <div class="ca-species-info">
            <p class="ca-species-name">Chiens</p>
            <p class="ca-species-count">7 animaux</p>
          </div>
          <div class="ca-species-bar"><div class="ca-species-bar-fill" style="width:47%;background:#3b82f6;"></div></div>
        </div>
        <div class="ca-species-item">
          <span class="ca-species-emoji">🐱</span>
          <div class="ca-species-info">
            <p class="ca-species-name">Chats</p>
            <p class="ca-species-count">6 animaux</p>
          </div>
          <div class="ca-species-bar"><div class="ca-species-bar-fill" style="width:40%;background:#f97316;"></div></div>
        </div>
        <div class="ca-species-item">
          <span class="ca-species-emoji">🐰</span>
          <div class="ca-species-info">
            <p class="ca-species-name">Lapins</p>
            <p class="ca-species-count">1 animal</p>
          </div>
          <div class="ca-species-bar"><div class="ca-species-bar-fill" style="width:7%;background:#a855f7;"></div></div>
        </div>
        <div class="ca-species-item">
          <span class="ca-species-emoji">🦜</span>
          <div class="ca-species-info">
            <p class="ca-species-name">Oiseaux</p>
            <p class="ca-species-count">1 animal</p>
          </div>
          <div class="ca-species-bar"><div class="ca-species-bar-fill" style="width:7%;background:#10b981;"></div></div>
        </div>
      </div>
    </div>
  </div>

</div>
