{# Turbo Streams target: a plain wrapper, replaced whole on a 422. #}
<div id="new-client-form-body">
  {{ form_start(form, { attr: { id: 'form-new-client' }, action: path('clinic_clients_create'), method: 'POST' }) }}
    {{ form_errors(form) }}

    <div class="g2 frow">
      <div>
        {{ form_label(form.firstName, 'Prénom', { label_attr: { class: 'flbl' } }) }}
        {{ form_widget(form.firstName, { attr: { class: 'finput', placeholder: 'Sophie' } }) }}
        {{ form_errors(form.firstName) }}
      </div>
      <div>
        {{ form_label(form.lastName, 'Nom', { label_attr: { class: 'flbl' } }) }}
        {{ form_widget(form.lastName, { attr: { class: 'finput', placeholder: 'Dubois' } }) }}
        {{ form_errors(form.lastName) }}
      </div>
    </div>

    <div class="g2 frow">
      <div>
        {{ form_label(form.phone, 'Téléphone', { label_attr: { class: 'flbl' }, required: true }) }}
        {{ form_widget(form.phone, { attr: { class: 'finput', placeholder: '06 12 34 56 78' } }) }}
        {{ form_errors(form.phone) }}
      </div>
      <div>
        {{ form_label(form.email, 'E-mail', { label_attr: { class: 'flbl' } }) }}
        {{ form_widget(form.email, { attr: { class: 'finput', placeholder: 'sophie.dubois@email.fr' } }) }}
        {{ form_errors(form.email) }}
      </div>
    </div>

    {#
     # Real toggle: when it is on, the directory reopens the animal modal on the
     # client that was just created. Written by hand so the theme's label does
     # not land beside the kit checkbox.
     #}
    {% do form._thenAddAnimal.setRendered %}
    <label class="ckline" for="{{ form._thenAddAnimal.vars.id }}">
      <input type="checkbox" class="ck" id="{{ form._thenAddAnimal.vars.id }}"
             name="{{ form._thenAddAnimal.vars.full_name }}" value="1"{{ form._thenAddAnimal.vars.checked ? ' checked' }}>
      Ajouter un premier animal juste après
    </label>

    {{ form_widget(form._returnTo) }}
  {{ form_end(form) }}
</div>
