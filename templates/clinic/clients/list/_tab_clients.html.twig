{#
 # Clients view of the directory: head and rows of the table. Included by
 # index.html.twig, which owns `qs`, `_svg`, `_on` and `sorted`.
 #}
<thead><tr>
  <th class="selcell"><input type="checkbox" class="ck" id="ckAll" aria-label="Tout sélectionner"></th>
  <th class="sortable{{ sorted ? ' son' }}"><a href="{{ path('clinic_clients_list', qs|merge({ dir: sorted and f.direction == 'asc' ? 'desc' : 'asc' })) }}">Client<span class="sarr">{{ (not sorted ? _svg.neutre : (f.direction == 'asc' ? _svg.haut : _svg.bas))|raw }}</span></a></th>
  <th>Contact</th>
  <th data-col="animaux"{{ 'animaux' not in _on ? ' hidden' }}>Animaux</th>
  <th data-col="visite"{{ 'visite' not in _on ? ' hidden' }}>Dernière visite</th>
  <th class="num" data-col="solde"{{ 'solde' not in _on ? ' hidden' }}>Solde</th>
  <th data-col="statut"{{ 'statut' not in _on ? ' hidden' }}>Statut</th>
  <th data-col="depuis"{{ 'depuis' not in _on ? ' hidden' }}>Client depuis</th>
  <th></th>
</tr></thead>
<tbody>
  {% for c in rows %}
    <tr data-id="{{ c.id }}" data-url="{{ path('clinic_clients_view', { id: c.id }) }}" class="{{ c.archived ? 'arch' }}">
      <td class="selcell"><input type="checkbox" class="rowck ck" aria-label="Sélectionner {{ c.name }}"></td>
      <td><div class="cel-id"><span class="av" style="background:{{ c.color }}1f;color:{{ c.color }}">{{ c.initials }}</span><div><b data-csv>{{ c.name }}{% if c.archived %}<span class="puce archb">Archivé</span>{% endif %}</b><span>{{ c.city ?? 'Ville non renseignée' }}</span></div></div></td>
      <td><div class="ctc">
        {% if c.phone %}<b>{{ c.phone|phone_display(false, false) }}</b>{% endif %}
        {% if c.email %}<span>{{ c.email }}</span>{% endif %}
        {% if not c.phone and not c.email %}<span class="nd">Aucune coordonnée</span>{% endif %}
      </div></td>
      <td data-col="animaux"{{ 'animaux' not in _on ? ' hidden' }}>
        {% if c.animals %}
          <span class="anis">{% for a in c.animals %}<span class="ani"><span class="ae">{{ a.emoji }}</span>{{ a.name }}</span>{% endfor %}{% if c.more %}<span class="ani-plus">+{{ c.more }}</span>{% endif %}</span>
        {% else %}
          <span class="ani-aucun">Aucun animal</span>
        {% endif %}
      </td>
      <td data-col="visite"{{ 'visite' not in _on ? ' hidden' }}>
        {% if c.visit %}<div class="lv"><b>{{ c.visit.label }}</b><span>{{ c.visit.animal }}</span></div>{% else %}<div class="lv"><b class="nd">Jamais</b><span>—</span></div>{% endif %}
      </td>
      <td class="num" data-col="solde"{{ 'solde' not in _on ? ' hidden' }}><span class="solde{{ c.balance ? ' impaye' : ' ok' }}">{{ c.balance ?? 'À jour' }}</span></td>
      <td data-col="statut"{{ 'statut' not in _on ? ' hidden' }}><span class="stb{{ c.archived ? ' archive' : ' actif' }}"><i></i>{{ c.archived ? 'Archivé' : 'Actif' }}</span></td>
      <td data-col="depuis"{{ 'depuis' not in _on ? ' hidden' }}><span style="font-size:.78rem;color:var(--encre-60)">{{ c.since }}</span></td>
      <td><div class="racts">
        <a class="ricon" data-turbo-frame="_top" data-tip="Nouveau rendez-vous" aria-label="Nouveau rendez-vous — {{ c.name }}" href="{{ path('clinic_scheduling_agenda', { new: 1, patient: c.pick }) }}">{{ _svg.rdv|raw }}</a>
        <a class="ricon" data-turbo-frame="_top" data-tip="Ouvrir la fiche client" aria-label="Ouvrir la fiche client — {{ c.name }}" href="{{ path('clinic_clients_view', { id: c.id }) }}">{{ _svg.open|raw }}</a>
      </div></td>
    </tr>
  {% else %}
    <tr><td colspan="9"><div class="tvide">{{ f.search or f.cities or f.species or f.states or f.statuses != ['active'] ? 'Aucun client ne correspond à ces filtres.' : 'Aucun client dans cette clinique pour l\'instant.' }}</div></td></tr>
  {% endfor %}
</tbody>
