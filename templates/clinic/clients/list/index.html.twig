{#
 # Kiveto -- templates/clinic/clients/list/index.html.twig
 # ──────────────────────────────────────────────────────
 # Clients & Animaux page — 2 tabs (Clients / Animaux) backed by real
 # SearchClients / SearchAnimals queries. Inactive tab badge shows the
 # filtered count from CountClients / CountAnimals.
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}Clients & Animaux{% endblock %}
{% block page_icon %}<i data-lucide="users-round"></i>{% endblock %}
{% block page_title %}Clients & Animaux{% endblock %}

{% block topbar_actions %}
  <button type="button" class="data-filter-btn data-filter-btn--sm" data-popover-anchor="ca-reports-popover">
    <i data-lucide="file-check-2"></i>
    <span>Rapports</span>
  </button>
  <button type="button" class="data-filter-btn data-filter-btn--sm" data-modal-open="modal-new-animal">
    <i data-lucide="paw-print"></i>
    <span>Nouvel animal</span>
  </button>
  <button type="button" class="btn btn-primary btn-sm" data-modal-open="modal-new-client">
    <i data-lucide="user-plus"></i>
    <span>Nouveau client</span>
  </button>
{% endblock %}

{% block content %}
<div class="ca-page">

  {# ── Tabs nav (server-driven via ?tab=…) ── #}
  <div class="tab-bar-line ca-tabs">
    <a
      href="{{ path('clinic_clients_list', {tab: 'clients', search: search}) }}"
      class="tab-line {{ activeTab == 'clients' ? 'is-active' : '' }}"
    >
      <i data-lucide="users"></i>
      <span>Clients</span>
      <span class="tab-count">{{ clientCount }}</span>
    </a>
    <a
      href="{{ path('clinic_clients_list', {tab: 'animals', search: search}) }}"
      class="tab-line {{ activeTab == 'animals' ? 'is-active' : '' }}"
    >
      <i data-lucide="paw-print"></i>
      <span>Animaux</span>
      <span class="tab-count">{{ animalCount }}</span>
    </a>
  </div>

  {# ── Active tab panel ── #}
  <div class="ca-tab-panel">
    {% if activeTab == 'clients' %}
      {{ include('clinic/clients/list/_tab_clients.html.twig') }}
    {% else %}
      {{ include('clinic/clients/list/_tab_animals.html.twig') }}
    {% endif %}
  </div>

</div>

{# Reports popover (opened by topbar Rapports button) #}
<div class="popover hidden" id="ca-reports-popover" style="width: 230px;">
  <a href="#" class="nav-item" onclick="showToast('Génération du rapport…','#4338ca');return false;">
    <i data-lucide="chart-no-axes-column"></i>
    <span>Générer un rapport</span>
  </a>
  <a href="#" class="nav-item" onclick="showToast('Historique des rapports','#4338ca');return false;">
    <i data-lucide="history"></i>
    <span>Historique des rapports</span>
  </a>

  <div class="popover-divider"></div>

  <a href="#" class="nav-item" onclick="showToast('Export CSV…','#4338ca');return false;">
    <i data-lucide="download"></i>
    <span>Exporter en CSV</span>
  </a>
  <a href="#" class="nav-item" onclick="showToast('Export Excel…','#4338ca');return false;">
    <i data-lucide="file-spreadsheet"></i>
    <span>Exporter en Excel</span>
  </a>

  <div class="popover-divider"></div>

  <a href="#" class="nav-item text-text-subtle" onclick="showToast('Aide rapports','#4338ca');return false;">
    <i data-lucide="info"></i>
    <span>En savoir plus</span>
  </a>
</div>

{# Modals — passed the form objects from ListClientsController #}
{{ include('clinic/clients/list/_modal_new_client.html.twig') }}
{{ include('clinic/clients/list/_modal_new_animal.html.twig') }}

<div id="toast"></div>
{% endblock %}
