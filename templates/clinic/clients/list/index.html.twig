{#
 # Kiveto -- templates/clinic/clients/list/index.html.twig
 # ──────────────────────────────────────────────────────
 # Clients & Animaux page — 3 tabs (Vue d'ensemble / Clients / Animaux)
 # with data tables, hover actions, and a global overview dashboard.
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}Clients & Animaux{% endblock %}
{% block page_icon %}<i data-lucide="users-round"></i>{% endblock %}
{% block page_title %}Clients & Animaux{% endblock %}

{% block topbar_actions %}
  <button type="button" class="btn btn-secondary btn-sm" onclick="showToast('Export CSV…','#4338ca')">
    <i data-lucide="download"></i>
    <span>Exporter</span>
  </button>
  <a href="{{ path('clinic_clients_new') }}" class="btn btn-primary btn-sm">
    <i data-lucide="plus"></i>
    <span>Nouveau client</span>
  </a>
{% endblock %}

{% block content %}
<div class="ca-page" data-tabs>

  {# ── Tabs nav ── #}
  <div class="tab-bar-line ca-tabs">
    <button type="button" class="tab-line active" data-tab-target="ca-overview">
      <i data-lucide="layout-dashboard"></i>
      <span>Vue d'ensemble</span>
    </button>
    <button type="button" class="tab-line" data-tab-target="ca-clients">
      <i data-lucide="users"></i>
      <span>Clients</span>
      <span class="tab-count" id="ca-tab-count-clients">0</span>
    </button>
    <button type="button" class="tab-line" data-tab-target="ca-animals">
      <i data-lucide="paw-print"></i>
      <span>Animaux</span>
      <span class="tab-count" id="ca-tab-count-animals">0</span>
    </button>
  </div>

  {# ── Tab panels ── #}
  <div id="ca-overview" class="ca-tab-panel">
    {{ include('clinic/clients/list/_tab_overview.html.twig') }}
  </div>

  <div id="ca-clients" class="ca-tab-panel hidden">
    {{ include('clinic/clients/list/_tab_clients.html.twig') }}
  </div>

  <div id="ca-animals" class="ca-tab-panel hidden">
    {{ include('clinic/clients/list/_tab_animals.html.twig') }}
  </div>

</div>

<div id="toast"></div>
{% endblock %}

{% block javascripts %}
<script>window.ROUTES = { clientsNew: '{{ path("clinic_clients_new") }}', clientsList: '{{ path("clinic_clients_list") }}' };</script>
{% endblock %}
