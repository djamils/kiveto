{#
 # Kiveto — templates/clinic/clients/list/index.html.twig
 # ──────────────────────────────────────────────────────
 # Répertoire — clients and animals in one table, two views. Ported from
 # docs/frontend-theme/kiveto-theme/repertoire-v-topbar_14.html: page header
 # with the Clients / Animaux switch, filter bar (search, multi-choice pills,
 # column picker), the table, its footer pager and the bulk bar, plus the two
 # creation modals.
 #
 # Filtering and pagination are server-side: the filter bar is a GET form
 # aimed at the results frame, the pager and the sort are links into it, so a
 # view is a shareable URL. The column picker is a per-browser preference.
 #
 # Variables (App\Presentation\Clinic\ViewModel\Directory\DirectoryViewBuilder::page()):
 #   filters      DirectoryFilters
 #   counts       {clients: int, animals: int} — the clinic's totals
 #   cityOptions  list<string>
 #   rows         list of client or animal rows
 #   pagination   {total, page, pages, size, shown}
 #   create       what the two creation windows need (ListClientsController::createWindows())
 #
 # Behaviour: assets/js/pages/clients/list.js — styles: assets/styles/pages/clients/directory.css
 #}
{% extends 'clinic/base.html.twig' %}

{% block sidebar_mode %}full{% endblock %}
{% block page_body_class %}vt{% endblock %}
{% block title %}Répertoire{% endblock %}

{% set f = filters %}
{% set isClients = f.isClients %}

{% set _svg = {
  chev:   '<svg class="chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>',
  lock:   '<svg class="vlock" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>',
  plus:   '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>',
  rdv:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18M12 13v6M9 16h6"/></svg>',
  open:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="m10 17 5-5-5-5"/><path d="M15 12H3"/></svg>',
  neutre: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5M7 9l5-5 5 5"/></svg>',
  haut:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>',
  bas:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>',
  gauche: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>',
  droite: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>',
  x:      '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>',
} %}

{# The current view as query parameters, shared by every link of the frame #}
{% set qs = { mode: f.mode } %}
{% if f.search %}{% set qs = qs|merge({ q: f.search }) %}{% endif %}
{% if isClients %}
  {# An emptied status filter stays explicit, or the default would come back #}
  {% set qs = qs|merge({ status: f.statuses ?: [''] }) %}
  {% if f.cities %}{% set qs = qs|merge({ city: f.cities }) %}{% endif %}
{% endif %}
{% if f.species %}{% set qs = qs|merge({ species: f.species }) %}{% endif %}
{% if f.states %}{% set qs = qs|merge({ etat: f.states }) %}{% endif %}
{# The name order is the default; a header click makes it explicit (and shown) #}
{% set sorted = app.request.query.has('dir') %}
{% if sorted %}{% set qs = qs|merge({ dir: f.direction }) %}{% endif %}
{% if pagination.size != 10 %}{% set qs = qs|merge({ per_page: pagination.size }) %}{% endif %}

{# Multi-choice filter pill: « Libellé (n) », a menu of checkboxes, « Réinitialiser » #}
{% macro pill(id, label, name, options, selected, svg, extra) %}
  {% set n = selected|length %}
  <div class="dd fpill{{ n ? ' actif' }}" id="{{ id }}" data-label="{{ label }}">
    <button type="button" class="dd-btn"><span>{{ label }}</span>{% if n %}<span class="ddn">{{ n }}</span>{% endif %}{{ svg.chev|raw }}</button>
    <div class="dd-menu" style="min-width:185px">
      <div class="dd-titre">{{ label }}</div>
      {% for value, text in options %}
        <label class="dd-ck"><input type="checkbox" class="ck" name="{{ name }}[]" value="{{ value }}"{{ value in selected ? ' checked' }}><span>{{ text }}</span></label>
      {% else %}
        <div class="dd-ck verrou"><span>Aucune valeur renseignée</span></div>
      {% endfor %}
      {{ extra|default('')|raw }}
      <div class="dd-sep"></div>
      <button type="button" class="dd-it razBtn">Réinitialiser</button>
    </div>
  </div>
{% endmacro %}

{% block main %}
{% set _cols = isClients
  ? { lock: ['Client', 'Contact'], defs: [
      { k: 'animaux', l: 'Animaux', on: true }, { k: 'visite', l: 'Dernière visite', on: true }, { k: 'solde', l: 'Solde', on: true },
      { k: 'statut', l: 'Statut', on: false }, { k: 'depuis', l: 'Client depuis', on: false },
    ] }
  : { lock: ['Animal', 'Propriétaire'], defs: [
      { k: 'ident', l: 'Identification', on: true }, { k: 'sante', l: 'Santé', on: true }, { k: 'passage', l: 'Dernier passage', on: true },
      { k: 'ref', l: 'Vétérinaire référent', on: false, off: 'Vétérinaire référent — bientôt disponible' },
    ] } %}
{% set _on = _cols.defs|filter(c => c.on)|map(c => c.k) %}

<div class="rep" data-page="{{ app.request.attributes.get('_route') }}" data-mode="{{ f.mode }}" data-cols-default="{{ _on|join(',') }}">

  <div class="pagehead">
    <h1>Répertoire<small>Base de la clinique · {{ counts.clients }} client{{ counts.clients > 1 ? 's' }} · {{ counts.animals }} anima{{ counts.animals > 1 ? 'ux' : 'l' }}</small></h1>
    <div class="switch" role="tablist">
      <a id="vClients" role="tab" href="{{ path('clinic_clients_list', { mode: 'clients' }|merge(f.search ? { q: f.search } : {})) }}"
         class="{{ isClients ? 'on' }}" aria-selected="{{ isClients ? 'true' : 'false' }}">Clients <span class="n">{{ counts.clients }}</span></a>
      <a id="vAnimaux" role="tab" href="{{ path('clinic_clients_list', { mode: 'animals' }|merge(f.search ? { q: f.search } : {})) }}"
         class="{{ not isClients ? 'on' }}" aria-selected="{{ not isClients ? 'true' : 'false' }}">Animaux <span class="n">{{ counts.animals }}</span></a>
    </div>
    {# Two distinct actions; the main one follows the view. #}
    <div class="right">
      <button type="button" class="btn{{ not isClients ? ' primaire' }}" id="btnNvAni">{{ _svg.plus|raw }}Nouvel animal</button>
      <button type="button" class="btn{{ isClients ? ' primaire' }}" id="btnNvCli">{{ _svg.plus|raw }}Nouveau client</button>
    </div>
  </div>

  {#
   # The filter bar lives outside the results frame, so typing never loses the
   # caret and an open menu stays open while its boxes are ticked.
   #}
  <form class="filtres" id="repFiltres" method="get" action="{{ path('clinic_clients_list') }}" role="search"
        data-turbo-frame="rep-results" data-turbo-action="advance">
    <input type="hidden" name="mode" value="{{ f.mode }}">
    <input type="hidden" name="dir" value="{{ f.direction }}" data-carry>
    <input type="hidden" name="per_page" value="{{ pagination.size }}" data-carry>
    <div class="recherche">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" name="q" value="{{ f.search }}" autocomplete="off" placeholder="Nom, animal, téléphone, n° de puce…">
    </div>
    <span class="flbl-f">Filtres</span>
    {% if isClients %}
      <input type="hidden" name="status[]" value="">
      {{ _self.pill('ddStatut', 'Statut client', 'status', { active: 'Actif', archived: 'Archivé' }, f.statuses, _svg,
        '<label class="dd-ck verrou" data-tip="Statut bloqué — bientôt disponible"><input type="checkbox" class="ck" disabled><span>Bloqué</span></label>') }}
      {% set _villes = {} %}
      {% for c in cityOptions %}{% set _villes = _villes|merge({ (c): c }) %}{% endfor %}
      {{ _self.pill('ddVille', 'Ville', 'city', _villes, f.cities, _svg) }}
    {% endif %}
    {{ _self.pill('ddEspece', 'Espèce', 'species', { dog: '🐕 Chiens', cat: '🐈 Chats', nac: '🐇 Lapins & NAC', other: '🐾 Autres' }, f.species, _svg) }}
    {{ _self.pill('ddEtat', 'État', 'etat', { rappel: 'Rappel de vaccin dû', impaye: 'Solde impayé', vig: 'Vigilance médicale' }, f.states, _svg) }}

    {# Column picker: a preference of this browser, nothing is sent #}
    <div class="dd fpill" id="ddCols" style="margin-left:auto">
      <button type="button" class="dd-btn">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M15 3v18"/></svg>
        <span>Colonnes</span><span class="ddn" hidden></span>{{ _svg.chev|raw }}
      </button>
      <div class="dd-menu droite" style="min-width:195px">
        <div class="dd-titre">Colonnes affichées</div>
        {% for l in _cols.lock %}
          <label class="dd-ck verrou"><input type="checkbox" class="ck" checked disabled><span>{{ l }}</span>{{ _svg.lock|raw }}</label>
        {% endfor %}
        <div class="dd-sep"></div>
        {% for c in _cols.defs %}
          {% if c.off is defined %}
            <label class="dd-ck verrou" data-tip="{{ c.off }}"><input type="checkbox" class="ck" disabled><span>{{ c.l }}</span></label>
          {% else %}
            <label class="dd-ck"><input type="checkbox" class="ck" data-k="{{ c.k }}"{{ c.on ? ' checked' }}><span>{{ c.l }}</span></label>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </form>

  <main class="zone">
    <turbo-frame id="rep-results" class="twidget" data-turbo-action="advance">
      <div class="tscroll scr"><table>
        {% if isClients %}
          {{ include('clinic/clients/list/_tab_clients.html.twig') }}
        {% else %}
          {{ include('clinic/clients/list/_tab_animals.html.twig') }}
        {% endif %}
      </table></div>
      <div class="tfoot">
        {% set _n = rows|length %}
        <span id="footInfo">{{ _n }} {{ isClients ? (_n > 1 ? 'clients' : 'client') : (_n > 1 ? 'animaux' : 'animal') }} affiché{{ _n > 1 ? 's' }} sur {{ pagination.total }}</span>
        <span class="pp"><span class="lbl">Par page :</span>
          {% for size in [10, 25, 50, 100] %}
            <a href="{{ path('clinic_clients_list', qs|merge({ per_page: size })) }}" class="{{ size == pagination.size ? 'on' }}">{{ size }}</a>
          {% endfor %}
        </span>
        <span class="pages">
          {% if pagination.page > 1 %}
            <a class="pg fl" href="{{ path('clinic_clients_list', qs|merge({ page: pagination.page - 1 })) }}" aria-label="Page précédente">{{ _svg.gauche|raw }}</a>
          {% else %}
            <span class="pg fl" aria-disabled="true" aria-label="Page précédente">{{ _svg.gauche|raw }}</span>
          {% endif %}
          {% for p in pagination.shown %}
            {% if not loop.first and p - pagination.shown[loop.index0 - 1] > 1 %}<span class="pg gap">…</span>{% endif %}
            <a class="pg{{ p == pagination.page ? ' on' }}" href="{{ path('clinic_clients_list', qs|merge({ page: p })) }}"{{ p == pagination.page ? ' aria-current="page"' }}>{{ p }}</a>
          {% endfor %}
          {% if pagination.page < pagination.pages %}
            <a class="pg fl" href="{{ path('clinic_clients_list', qs|merge({ page: pagination.page + 1 })) }}" aria-label="Page suivante">{{ _svg.droite|raw }}</a>
          {% else %}
            <span class="pg fl" aria-disabled="true" aria-label="Page suivante">{{ _svg.droite|raw }}</span>
          {% endif %}
        </span>
      </div>
    </turbo-frame>
  </main>

  <div class="bulk" id="bulkBar" role="toolbar" aria-label="Actions groupées">
    <span class="bn" id="bulkN">0</span>
    <span>sélectionné·e·s</span>
    <span class="bdiv"></span>
    <span class="dd bulk-dd" id="bulkDd">
      <button type="button" id="bulkExport">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/></svg>
        Exporter
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:12px;height:12px"><path d="m18 15-6-6-6 6"/></svg>
      </button>
      <div class="bulk-menu">
        <button type="button" class="dd-it" data-fmt="CSV">CSV <span style="color:var(--encre-35)">.csv</span></button>
        <button type="button" class="dd-it" data-fmt="Excel" disabled data-tip="Export Excel — bientôt disponible">Excel <span style="color:var(--encre-35)">.xlsx</span></button>
        <button type="button" class="dd-it" data-fmt="PDF" disabled data-tip="Export PDF — bientôt disponible">PDF <span style="color:var(--encre-35)">.pdf</span></button>
      </div>
    </span>
    <span class="bdiv"></span>
    <button type="button" id="bulkClear">Annuler</button>
  </div>

  {{ include('clinic/clients/list/_modal_new_client.html.twig') }}
  {{ include('clinic/clients/_tax_profile_block.html.twig') }}
  {{ include('clinic/clients/list/_modal_new_animal.html.twig') }}
  <script type="application/json" id="repCreate">{{ create|json_encode|raw }}</script>
</div>
{% endblock %}
