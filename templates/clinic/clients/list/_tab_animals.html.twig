{#
 # Animals view of the directory: head and rows of the table. Included by
 # index.html.twig, which owns `qs`, `_svg` and `_on`.
 #}
<thead><tr>
  <th class="selcell"><input type="checkbox" class="ck" id="ckAll" aria-label="Tout sélectionner"></th>
  <th>Animal</th>
  <th>Propriétaire</th>
  <th data-col="ident"{{ 'ident' not in _on ? ' hidden' }}>Identification</th>
  <th data-col="sante"{{ 'sante' not in _on ? ' hidden' }}>Santé</th>
  <th data-col="passage"{{ 'passage' not in _on ? ' hidden' }}>Dernier passage</th>
  <th></th>
</tr></thead>
<tbody>
  {% for a in rows %}
    <tr data-id="{{ a.id }}" data-url="{{ path('clinic_animals_view', { id: a.id }) }}" class="{{ a.badge ? 'arch' }}">
      <td class="selcell"><input type="checkbox" class="rowck ck" aria-label="Sélectionner {{ a.name }}"></td>
      <td><div class="cel-id"><span class="esp">{{ a.emoji }}</span><div><b data-csv>{{ a.name }}{% if a.badge %}<span class="puce archb">{{ a.badge }}</span>{% endif %}</b><span>{{ a.breedAge }}</span></div></div></td>
      <td><span style="font-size:.8rem">{{ a.owner ?? 'Sans propriétaire' }}</span></td>
      <td data-col="ident"{{ 'ident' not in _on ? ' hidden' }}><span style="font-family:var(--font-data);font-size:.74rem;color:var(--encre-60)">{{ a.chip ?? '—' }}</span></td>
      <td data-col="sante"{{ 'sante' not in _on ? ' hidden' }}>
        {%- for r in a.reminders %}<span class="puce rappel">💉 {{ r }}</span>{% endfor -%}
        {%- for v in a.alerts %}<span class="puce vig">{{ v }}</span>{% endfor -%}
        {%- for s in a.follow %}<span class="puce">{{ s }}</span>{% endfor -%}
        {%- if not a.reminders and not a.alerts and not a.follow %}<span class="puce ok">À jour</span>{% endif -%}
      </td>
      <td data-col="passage"{{ 'passage' not in _on ? ' hidden' }}><span style="font-size:.78rem;color:var(--encre-60)">{{ a.visit ?? 'Jamais' }}</span></td>
      <td><div class="racts">
        <a class="ricon" data-turbo-frame="_top" data-tip="Nouveau rendez-vous" aria-label="Nouveau rendez-vous — {{ a.name }}" href="{{ path('clinic_scheduling_agenda', { new: 1, patient: a.name }) }}">{{ _svg.rdv|raw }}</a>
        <a class="ricon" data-turbo-frame="_top" data-tip="Ouvrir le dossier médical" aria-label="Ouvrir le dossier médical — {{ a.name }}" href="{{ path('clinic_animals_view', { id: a.id }) }}">{{ _svg.open|raw }}</a>
      </div></td>
    </tr>
  {% else %}
    <tr><td colspan="7"><div class="tvide">{{ f.search or f.species or f.states ? 'Aucun animal ne correspond à ces filtres.' : 'Aucun animal dans cette clinique pour l\'instant.' }}</div></td></tr>
  {% endfor %}
</tbody>
