{#
 # Kiveto — templates/clinic/clients/list/_tab_animals.html.twig
 # ────────────────────────────────────────────────────────────
 # Animaux mode of the directory. Included by index.html.twig, which owns the
 # label maps and the query-string helper.
 #}
{% import 'clinic/clients/list/_macros.html.twig' as ui %}

{% if animals|length > 0 %}
  <table class="tbl">
    <thead>
      <tr>
        <th class="col-check">
          <div class="check" id="check-all" role="checkbox" aria-checked="false" tabindex="0" title="Tout sélectionner">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8l3 3 7-7"/></svg>
          </div>
        </th>
        {{ ui.sortHead('name', 'Animal', 'col-patient-name', sort, direction, qs) }}
        {{ ui.sortHead('species', 'Race / âge / poids', 'col-breed', sort, direction, qs) }}
        <th class="col-owner">Propriétaire</th>
        {# No animal↔practitioner assignment exists in the domain #}
        <th class="col-owner" title="Bientôt disponible">Suivi</th>
        <th class="col-alerts">Alertes</th>
        {# No due-date schedule exists in the domain #}
        <th class="col-owner" title="Bientôt disponible">Prochaine échéance</th>
        {{ ui.sortHead('status', 'Statut', 'col-patient-status', sort, direction, qs) }}
        <th class="col-actions"></th>
      </tr>
    </thead>
    <tbody>
      {% for animal in animals %}
        {% set alerts = enrichment[animal.id] ?? [] %}
        {% set lifeClass = LIFE_CLASSES[animal.lifeStatus] ?? 'archived' %}
        <tr data-id="{{ animal.id }}" data-url="{{ path('clinic_animals_view', { id: animal.id }) }}"
            class="{{ animal.lifeStatus != 'alive' ? 'is-gone' : '' }}">
          <td class="col-check">
            <div class="check" role="checkbox" aria-checked="false" data-check="{{ animal.id }}">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8l3 3 7-7"/></svg>
            </div>
          </td>
          <td class="col-patient-name">
            <div class="cell-flex">
              <div class="avatar-species">{{ SPECIES_ICONS[animal.species] ?? '🐾' }}</div>
              <div class="cell-stack">
                <span class="cell-primary">{{ animal.name }}</span>
                <span class="cell-secondary">{{ SEX_GLYPHS[animal.sex] ?? animal.sex }}</span>
              </div>
            </div>
          </td>
          <td class="col-breed">
            <div class="cell-breed">
              <span class="cell-breed-line">
                {{ animal.breedName ?? SPECIES_LABELS[animal.species] ?? animal.species }}
              </span>
              <span class="cell-breed-meta">
                {{ animal.ageLabel() ?? 'Âge inconnu' }}
                {%- if weights[animal.id] is defined %} · {{ weights[animal.id] }}{% endif -%}
              </span>
            </div>
          </td>
          <td class="col-owner">
            {% if animal.primaryOwnerClientId and ownerNames[animal.primaryOwnerClientId] is defined %}
              <a class="cell-owner-link" data-turbo-frame="_top"
                 href="{{ path('clinic_clients_view', { id: animal.primaryOwnerClientId }) }}">
                {{ ownerNames[animal.primaryOwnerClientId] }}
              </a>
            {% else %}
              <span class="cell-none">Sans propriétaire</span>
            {% endif %}
          </td>
          <td class="col-owner"><span class="cell-none">—</span></td>
          <td class="col-alerts">
            <div class="cell-alerts">
              {% for alert in alerts|slice(0, 3) %}
                <span class="alert-badge alert-{{ alert.kind }}" title="{{ ALERT_LABELS[alert.kind] ?? alert.kind }} : {{ alert.label }}">
                  <i data-lucide="{{ alert.kind == 'ALLERGY' ? 'triangle-alert' : 'heart-pulse' }}"></i>
                  {{ alert.label }}
                </span>
              {% else %}
                <span class="cell-none">—</span>
              {% endfor %}
              {% if alerts|length > 3 %}
                <span class="animal-more-inline">+{{ alerts|length - 3 }}</span>
              {% endif %}
            </div>
          </td>
          <td class="col-owner"><span class="cell-none">—</span></td>
          <td class="col-patient-status">
            <span class="status-badge status-{{ lifeClass }}">
              <span class="status-dot"></span>{{ LIFE_LABELS[animal.lifeStatus] ?? animal.lifeStatus }}
            </span>
          </td>
          <td class="col-actions" style="position:relative">
            <button class="row-actions-btn" type="button" data-row-menu-toggle title="Actions" aria-label="Actions">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
            </button>
            <div class="row-menu" data-row-menu>
              {# data-turbo-frame="_top": these leave the list for a full page #}
              <a class="row-menu-item" data-turbo-frame="_top" href="{{ path('clinic_animals_view', { id: animal.id }) }}">
                <i data-lucide="external-link"></i> Ouvrir le dossier
              </a>
              <a class="row-menu-item" data-turbo-frame="_top" href="{{ path('clinic_animals_edit', { id: animal.id }) }}">
                <i data-lucide="pencil"></i> Modifier
              </a>
              {% if animal.primaryOwnerClientId %}
                <a class="row-menu-item" data-turbo-frame="_top" href="{{ path('clinic_clients_view', { id: animal.primaryOwnerClientId }) }}">
                  <i data-lucide="user"></i> Voir le propriétaire
                </a>
              {% endif %}
              <span class="row-menu-item is-disabled" title="Bientôt disponible">
                <i data-lucide="clock"></i> Historique consultations
              </span>
              {% if animal.status == 'active' %}
                <div class="row-menu-sep"></div>
                <form method="post" action="{{ path('clinic_animals_archive', { id: animal.id }) }}" data-turbo-frame="_top">
                  <input type="hidden" name="_token" value="{{ csrf_token('clinic_animal_form') }}">
                  <button class="row-menu-item is-danger" type="submit">
                    <i data-lucide="archive"></i> Archiver
                  </button>
                </form>
              {% endif %}
            </div>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% else %}
  <div class="empty">
    <div class="empty-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </div>
    <div class="empty-title">Aucun animal trouvé</div>
    <div class="empty-sub">Ajustez les filtres, ou créez une fiche patient pour démarrer.</div>
    <button class="btn btn-primary btn-sm" type="button" data-modal-open="modal-new-animal" style="margin-top:12px">
      <i data-lucide="plus"></i> Nouvel animal
    </button>
  </div>
{% endif %}
