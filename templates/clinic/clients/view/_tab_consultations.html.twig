{# Partial: "Consultations" pane — open consultations first, then the closed ones as a table. #}
{% import 'clinic/clients/view/_macros.html.twig' as ui %}
{% set visits = sheet.consultations %}
<section class="fc-card fc-c12" id="fc-s-consult">
  <div class="fc-card-h">
    <span class="fc-card-t">Consultations</span>
    {% if visits.total > 0 %}<span class="fc-card-c">{{ visits.total }}</span>{% endif %}
  </div>
  <div class="fc-card-b fc-flush">
    {% for visit in visits.open %}
      <div class="fc-row">
        <div class="fc-row-ico fc-ico-brand">{{ visit.day }}</div>
        <div class="fc-row-m"><p class="fc-row-t">{{ visit.title }}</p><p class="fc-row-s">{{ visit.subtitle }}</p></div>
        <span class="fc-badge fc-b-brand">En cours</span>
        <div class="fc-row-a"><a class="fc-btn fc-btn-primary fc-btn-xs" href="{{ path('clinic_consultation_details', {id: visit.id}) }}">Reprendre</a></div>
      </div>
    {% endfor %}
    {% if visits.closed|length > 0 %}
      <div class="fc-table-wrap">
        <table class="fc-t">
          <thead><tr><th class="fc-n">Date</th><th>Animal</th><th>Motif</th><th>Praticien</th><th class="fc-n">Montant</th><th>Documents</th></tr></thead>
          <tbody>
            {% for visit in visits.closed %}
              <tr>
                <td class="fc-n">{{ visit.date }}</td>
                <td><b>{{ visit.animalName }}</b></td>
                <td><a class="fc-link" href="{{ path('clinic_consultation_details', {id: visit.id}) }}">{{ visit.reason }}</a></td>
                <td>{{ visit.practitioner }}</td>
                <td class="fc-n">{{ visit.amount is null ? '—' : visit.amount|money(visit.currency) }}</td>
                <td>
                  <div class="fc-doc-act" style="justify-content:flex-start;">
                    <a class="fc-btn fc-btn-ghost fc-btn-xs" href="{{ path('clinic_consultation_report_pdf', {consultationId: visit.id}) }}" target="_blank" rel="noopener" data-turbo="false">Compte rendu</a>
                    {% for prescription in visit.prescriptions %}
                      <a class="fc-btn fc-btn-ghost fc-btn-xs" href="{{ path('clinic_prescription_pdf', {prescriptionId: prescription.id}) }}" target="_blank" rel="noopener" data-turbo="false">Ordonnance</a>
                    {% endfor %}
                    {% if visit.invoiceId %}
                      <a class="fc-btn fc-btn-ghost fc-btn-xs" href="{{ path('clinic_invoice_pdf', {invoiceId: visit.invoiceId}) }}" target="_blank" rel="noopener" data-turbo="false">Facture</a>
                    {% endif %}
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      {{ ui.empty('Aucune consultation clôturée', 'Chaque consultation terminée s’inscrira ici avec son motif, son praticien, son montant et ses documents.', 'sheet') }}
    {% endif %}
  </div>
  {% if visits.firstVisit and visits.total > 1 %}
    <div class="fc-card-f">Première visite le {{ visits.firstVisit }}.</div>
  {% endif %}
</section>
