{# Partial: compact identity header of the client sheet. #}
{% set contact = sheet.contact %}
{% set open_visit = sheet.consultations.open|first %}
<div class="fc-fh">
  <div class="fc-fh-av fc-a-cli">{{ client.firstName|first|upper }}{{ client.lastName|first|upper }}</div>
  <div class="fc-fh-id">
    <h2 class="fc-fh-name">{{ client.fullName }}</h2>
    <div class="fc-fh-meta">
      <div><p class="fc-fh-k">Client depuis</p><p class="fc-fh-v">{{ sheet.since }}</p></div>
      <div>
        <p class="fc-fh-k">Téléphone</p>
        <p class="fc-fh-v{{ contact.mobile or contact.landline ? '' : ' fc-soft' }}">
          {%- if contact.mobile -%}
            <span class="fc-tip" data-tip="Numéro principal" tabindex="0">{{ contact.mobile|phone_display(false, false) }}</span>
          {%- endif -%}
          {%- if contact.mobile and contact.landline -%}<span class="fc-fh-sep">·</span>{%- endif -%}
          {%- if contact.landline -%}
            <span class="fc-tip{{ contact.mobile ? ' fc-fh-2' }}" data-tip="Autre numéro" tabindex="0">{{ contact.landline|phone_display(false, false) }}</span>
          {%- endif -%}
          {%- if not contact.mobile and not contact.landline -%}Non renseigné{%- endif -%}
        </p>
      </div>
      <div><p class="fc-fh-k">Adresse</p><p class="fc-fh-v{{ contact.address ? '' : ' fc-soft' }}">{{ contact.address ?? 'Non renseignée' }}</p></div>
      <div><p class="fc-fh-k">E-mail</p><p class="fc-fh-v fc-soft">{{ contact.email ?? 'Non renseigné' }}</p></div>
    </div>
    {% if archived or not sheet.consents.remindersGranted %}
      <div class="fc-fh-badges">
        {% if archived %}<span class="fc-badge fc-b-grey">Fiche archivée</span>{% endif %}
        {% if not archived and not sheet.consents.remindersGranted %}<span class="fc-badge fc-b-warn">Consentements à recueillir</span>{% endif %}
      </div>
    {% endif %}
    {% set calendar_icon %}<svg width="13" height="13" fill="none" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3.2" width="12" height="10.6" rx="1.8" stroke="currentColor" stroke-width="1.5"/><path d="M5 1.6v3M11 1.6v3M2 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>{% endset %}
    {% if open_visit %}
      <a class="fc-fh-next" href="{{ path('clinic_consultation_details', {id: open_visit.id}) }}">{{ calendar_icon }} {{ open_visit.title }} <span class="fc-q">· {{ open_visit.subtitle }}</span></a>
    {% elseif sheet.appointments.next %}
      <div class="fc-fh-next">{{ calendar_icon }} Prochain rendez-vous — {{ sheet.appointments.next.when }}{% if sheet.appointments.next.detail %} <span class="fc-q">· {{ sheet.appointments.next.detail }}</span>{% endif %}</div>
    {% else %}
      <div class="fc-fh-next fc-soft">{{ calendar_icon }} Aucun rendez-vous programmé</div>
    {% endif %}
  </div>
  <div class="fc-fh-act">
    <button class="fc-btn fc-btn-white" type="button" data-fc-open="fc-m-msg">
      <svg width="13" height="13" fill="none" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3.5" width="12" height="9" rx="1.6" stroke="currentColor" stroke-width="1.4"/><path d="M2.5 4.5L8 8.5l5.5-4" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
      Message
    </button>
    {% if not archived %}
      <button class="fc-btn fc-btn-white" type="button" data-fc-open="fc-m-edit">
        <svg width="13" height="13" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path d="M11 2.5l2.5 2.5-8 8H3v-2.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
        Modifier
      </button>
      <button class="fc-btn fc-btn-primary" type="button" data-fc-open="fc-m-rdv">
        <svg width="13" height="13" fill="none" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 2.5v9M2.5 7h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        Rendez-vous
      </button>
    {% endif %}
    <button class="fc-icon-btn" type="button" data-fc-open="fc-m-more" aria-label="Plus d’actions">
      <svg width="16" height="16" fill="none" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="3.5" r="1.2" fill="currentColor"/><circle cx="8" cy="8" r="1.2" fill="currentColor"/><circle cx="8" cy="12.5" r="1.2" fill="currentColor"/></svg>
    </button>
  </div>
</div>
