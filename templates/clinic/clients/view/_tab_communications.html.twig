{# Partial: "Communications" pane — journal of exchanges and internal notes. #}
{% import 'clinic/clients/view/_macros.html.twig' as ui %}
<section class="fc-card fc-c8" id="fc-s-comm">
  <div class="fc-card-h">
    <span class="fc-card-t">Communications</span>
    {% if sheet.communications|length > 0 %}<span class="fc-card-c">{{ sheet.communications|length }}</span>{% endif %}
    <div class="fc-card-x"><button class="fc-btn fc-btn-ghost fc-btn-xs" type="button" data-fc-open="fc-m-msg">Consigner</button></div>
  </div>
  {% if sheet.communications|length > 0 %}
    <div class="fc-card-b">
      <div class="fc-tl">
        {% for entry in sheet.communications %}
          <div class="fc-tl-i{{ loop.first ? ' fc-now' }}">
            <p class="fc-tl-d">{{ entry.when }}</p>
            <p class="fc-tl-t">{{ entry.title }}</p>
            {% if entry.body %}<p class="fc-tl-s">{{ entry.body|nl2br }}</p>{% endif %}
            <div class="fc-tl-tags"><span class="fc-badge fc-b-grey">{{ entry.direction }}</span><span class="fc-badge fc-b-grey">{{ entry.author }}</span></div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="fc-card-b fc-flush">
      {{ ui.empty('Aucun échange enregistré', 'Appels, SMS, e-mails et courriers consignés par l’équipe apparaîtront ici.') }}
    </div>
  {% endif %}
</section>
<section class="fc-card fc-c4" id="fc-s-notes">
  <div class="fc-card-h">
    <span class="fc-card-t">Notes internes</span>
    <span class="fc-badge fc-b-warn">Jamais visible du client</span>
    <div class="fc-card-x"><button class="fc-btn fc-btn-ghost fc-btn-xs" type="button" data-fc-open="fc-m-note">Ajouter</button></div>
  </div>
  {% if sheet.notes|length > 0 %}
    <div class="fc-card-b">
      {% for note in sheet.notes %}
        <div class="fc-note {{ note.attention ? 'fc-warn' : 'fc-grey' }}"><b>{{ note.heading }}</b> {{ note.content|nl2br }}</div>
      {% endfor %}
    </div>
  {% else %}
    <div class="fc-card-b fc-flush">
      {{ ui.empty('Aucune note', 'Ce qui aide à mieux recevoir ce client se note ici.') }}
    </div>
  {% endif %}
</section>
