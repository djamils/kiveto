{# Macros of the client sheet: species pictograms, empty states, dialog chrome. #}

{% macro species_icon(kind) %}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {% if kind == 'dog' %}
      <path d="M6.4 7.2C5.1 6.1 3.6 6.6 3.6 8.2v3.2c0 1.3.5 2.5 1.3 3.3"/><path d="M17.6 7.2c1.3-1.1 2.8-.6 2.8 1v3.2c0 1.3-.5 2.5-1.3 3.3"/>
      <path d="M12 6.2c3.3 0 5.8 2.5 5.8 5.7 0 2.3-1 4-2.4 5-.6.4-.9 1-1 1.7-.1.8-1 1.3-2.4 1.3s-2.3-.5-2.4-1.3c-.1-.7-.4-1.3-1-1.7-1.4-1-2.4-2.7-2.4-5 0-3.2 2.5-5.7 5.8-5.7z"/>
      <path d="M9.9 12h.01M14.1 12h.01" stroke-width="2.3"/><path d="M12 15.2c-.7 0-1.2.4-1.2.9s.5.8 1.2.8 1.2-.3 1.2-.8-.5-.9-1.2-.9z"/>
    {% elseif kind == 'cat' %}
      <path d="M7.1 8.1 5.8 3.9c-.1-.5.4-.9.9-.6l3.5 2.4"/><path d="M16.9 8.1l1.3-4.2c.1-.5-.4-.9-.9-.6l-3.5 2.4"/>
      <path d="M12 5.4c3.6 0 6.3 2.9 6.3 6.5 0 4-2.8 6.7-6.3 6.7s-6.3-2.7-6.3-6.7C5.7 8.3 8.4 5.4 12 5.4z"/>
      <path d="M9.9 11.2h.01M14.1 11.2h.01" stroke-width="2.3"/><path d="M12 13.4v.9M12 14.3l-1 .8M12 14.3l1 .8"/>
      <path d="M2.6 11h3.1M18.3 11h3.1M2.9 13.4l2.9-.7M18.2 12.7l2.9.7"/>
    {% else %}
      <path d="M9.6 9.6C8.5 7.7 7.7 5 8.3 3.6c.5-1.2 1.8-.8 2.4.5.6 1.3 1 3.2 1 4.7"/>
      <path d="M14.4 9.6c1.1-1.9 1.9-4.6 1.3-6-.5-1.2-1.8-.8-2.4.5-.6 1.3-1 3.2-1 4.7"/>
      <path d="M12 9.7c2.9 0 5.1 2.2 5.1 4.9s-2.2 4.9-5.1 4.9-5.1-2.2-5.1-4.9S9.1 9.7 12 9.7z"/>
      <path d="M10.2 13.9h.01M13.8 13.9h.01" stroke-width="2.3"/><path d="M12 15.9v.8M12 16.7l-1 .7M12 16.7l1 .7"/>
    {% endif %}
  </svg>
{% endmacro %}

{% macro empty(title, detail, icon = 'check', todo = false) %}
  <div class="fc-empty{{ todo ? ' fc-todo' }}">
    <span class="fc-empty-i">
      <svg width="15" height="15" fill="none" viewBox="0 0 16 16" aria-hidden="true">
        {% if icon == 'calendar' %}
          <rect x="2" y="3.2" width="12" height="10.6" rx="1.8" stroke="currentColor" stroke-width="1.5"/><path d="M5 1.6v3M11 1.6v3M2 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        {% elseif icon == 'person' %}
          <circle cx="8" cy="5.4" r="2.6" stroke="currentColor" stroke-width="1.5"/><path d="M2.8 13.6c.4-2.6 2.5-4.2 5.2-4.2s4.8 1.6 5.2 4.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        {% elseif icon == 'sheet' %}
          <path d="M4 2.5h8a1 1 0 011 1v9a1 1 0 01-1 1H4a1 1 0 01-1-1v-9a1 1 0 011-1z" stroke="currentColor" stroke-width="1.5"/><path d="M5.6 6.2h4.8M5.6 8.7h3.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        {% else %}
          <path d="M3.5 8.4l3 3 6-6.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        {% endif %}
      </svg>
    </span>
    <div class="fc-empty-m">
      <p class="fc-empty-t">{{ title }}</p>
      <p class="fc-empty-s">{{ detail }}</p>
    </div>
  </div>
{% endmacro %}

{% macro modal_head(title, subtitle = null, id = null) %}
  <div class="fc-m-h">
    <div style="flex:1;">
      <p class="fc-m-t"{% if id %} id="{{ id }}"{% endif %}>{{ title }}</p>
      {% if subtitle %}<p class="fc-m-s">{{ subtitle }}</p>{% endif %}
    </div>
    <button class="fc-icon-btn" type="button" data-fc-close aria-label="Fermer">
      <svg width="15" height="15" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </button>
  </div>
{% endmacro %}

{# A segmented control backed by a hidden input, so it posts like a radio group. #}
{% macro segmented(name, options, value) %}
  <div class="fc-seg" data-fc-seg>
    <input type="hidden" name="{{ name }}" value="{{ value }}">
    {% for option_value, label in options %}
      <button type="button" data-value="{{ option_value }}" aria-pressed="{{ option_value == value ? 'true' : 'false' }}"
              class="{{ option_value == value ? 'fc-on' }}">{{ label }}</button>
    {% endfor %}
  </div>
{% endmacro %}
