{# Partial: client info — left column with identity, contacts, address #}
<div class="col-left">

  {# Owner identity #}
  <div class="lsec">
    <div class="cv-owner-header">
      <div class="cv-avatar">
        {% if client is defined %}
          {{ client.firstName|first|upper }}{{ client.lastName|first|upper }}
        {% else %}
          SD
        {% endif %}
      </div>
      <div class="cv-owner-name-wrap">
        <h1 class="cv-owner-name">
          {% if client is defined %}{{ client.firstName }} {{ client.lastName }}{% else %}Sophie Dubois{% endif %}
        </h1>
        <p class="cv-owner-since">Client depuis mars 2021</p>
      </div>
      <button class="btn btn-secondary btn-xs" onclick="openModal('modal-owner')">
        <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M8 2l2 2-6 6H2V8l6-6z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>Éditer
      </button>
    </div>
    <div class="info-grid">
      <div class="ic full">
        <p class="ic-label">Adresse</p>
        <p class="ic-value">
          {% if client is defined and client.postalAddress %}
            {{ client.postalAddress.streetLine1 }}, {{ client.postalAddress.postalCode }} {{ client.postalAddress.city }}
          {% else %}
            12 rue de la Paix, 75001 Paris
          {% endif %}
        </p>
      </div>
      <div class="ic"><p class="ic-label">Dernier RDV</p><p class="ic-value">21 mars 2026</p></div>
      <div class="ic"><p class="ic-label">Prochain RDV</p><p class="ic-value cv-next-rdv">15 juin 2026</p></div>
    </div>
  </div>

  {# Phones and contacts #}
  <div class="lsec">
    <p class="lsec-title">Contacts & Téléphones
      <button class="btn btn-ghost btn-xs" onclick="openModal('modal-phones')">
        <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M6 2v8M2 6h8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>
    </p>
    <div class="cv-phones-list" id="phones-list">
      {% if client is defined and client.contactMethods|length > 0 %}
        {% for contact in client.contactMethods %}
          <div class="phone-chip">
            {% if contact.type == 'phone' %}
              <svg width="13" height="13" fill="none" viewBox="0 0 16 16" class="cv-icon-phone"><path d="M3 2h3l1.5 4-2 1.2a10 10 0 004.3 4.3L11 9.5l4 1.5v3a1 1 0 01-1 1C6.2 15 1 9.8 1 3a1 1 0 011-1z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
            {% else %}
              <svg width="13" height="13" fill="none" viewBox="0 0 16 16" class="cv-icon-email"><rect x="2" y="4" width="12" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M2 5l6 5 6-5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
            {% endif %}
            <div class="cv-contact-info">
              <p class="cv-contact-value">{{ contact.value }}</p>
              <p class="cv-contact-label">{{ contact.label }}</p>
            </div>
            <button class="btn btn-ghost btn-icon btn-xs cv-contact-action" onclick="toast('Action…','#059669')">
              <svg width="12" height="12" fill="none" viewBox="0 0 16 16"><path d="M3 2h3l1.5 4-2 1.2a10 10 0 004.3 4.3L11 9.5l4 1.5v3a1 1 0 01-1 1C6.2 15 1 9.8 1 3a1 1 0 011-1z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
            </button>
          </div>
        {% endfor %}
      {% else %}
        <div class="phone-chip">
          <svg width="13" height="13" fill="none" viewBox="0 0 16 16" class="cv-icon-phone"><path d="M3 2h3l1.5 4-2 1.2a10 10 0 004.3 4.3L11 9.5l4 1.5v3a1 1 0 01-1 1C6.2 15 1 9.8 1 3a1 1 0 011-1z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
          <div class="cv-contact-info"><p class="cv-contact-value">+33 6 12 34 56 78</p><p class="cv-contact-label">Mobile principal</p></div>
          <button class="btn btn-ghost btn-icon btn-xs cv-contact-action" onclick="toast('Appel…','#059669')">
            <svg width="12" height="12" fill="none" viewBox="0 0 16 16"><path d="M3 2h3l1.5 4-2 1.2a10 10 0 004.3 4.3L11 9.5l4 1.5v3a1 1 0 01-1 1C6.2 15 1 9.8 1 3a1 1 0 011-1z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
          </button>
        </div>
        <div class="phone-chip">
          <svg width="13" height="13" fill="none" viewBox="0 0 16 16" class="cv-icon-email"><rect x="2" y="4" width="12" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M2 5l6 5 6-5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
          <div class="cv-contact-info"><p class="cv-contact-value">s.dubois@email.fr</p><p class="cv-contact-label">Email</p></div>
          <button class="btn btn-ghost btn-icon btn-xs cv-contact-action" onclick="toast('Email…','#4338ca')">
            <svg width="12" height="12" fill="none" viewBox="0 0 16 16"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
          </button>
        </div>
      {% endif %}
    </div>
    {# Communication preferences #}
    <div class="cv-comm-prefs">
      <svg width="12" height="12" fill="none" viewBox="0 0 16 16" class="cv-icon-info"><path d="M8 2a6 6 0 100 12A6 6 0 008 2z" stroke="currentColor" stroke-width="1.3"/><path d="M8 7v4M8 5.5h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <span class="cv-comm-prefs-text">Préfère les rappels par <strong>SMS</strong> · Disponible <strong>le matin</strong></span>
      <button class="btn btn-ghost btn-xs cv-comm-prefs-edit" onclick="openModal('modal-prefs')">Éditer</button>
    </div>
  </div>

  {# Auxiliary contact #}
  <div class="lsec">
    <p class="lsec-title">Contact auxiliaire
      <button class="btn btn-ghost btn-xs" onclick="openModal('modal-auxcontact')">
        <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M8 2l2 2-6 6H2V8l6-6z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
      </button>
    </p>
    <div id="aux-contact-left"></div>
  </div>

  {# Internal notes #}
  <div class="lsec">
    <p class="lsec-title">Notes internes
      <button class="btn btn-ghost btn-xs" onclick="toast('Ajouter note…','#4338ca')">+ Ajouter</button>
    </p>
    <div class="cv-note-box">
      <p class="cv-note-text">Propriétaire très attentive. Préfère les rappels par SMS. Disponible le matin uniquement.</p>
      <p class="cv-note-meta">Dr. Rousseau · 15 jan. 2026</p>
    </div>
  </div>

</div>
