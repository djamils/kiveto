{#
 # Kiveto — templates/clinic/admission/emergency_form.html.twig
 # ─────────────────────────────────────────────────────────────
 # Emergency admission form.
 #
 # Variables:
 #   intakeChannels  IntakeChannel[]  All possible intake channel cases
 #   triageLevels    TriageLevel[]    All possible triage level cases
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}Nouvelle admission urgente{% endblock %}
{% block page_title %}Nouvelle admission urgente{% endblock %}

{% block content %}
<div class="p-6 max-w-2xl mx-auto">

  {% for message in app.flashes('error') %}
    <div class="mb-4 p-3 rounded bg-red-50 border border-red-200 text-red-700 text-sm">
      {{ message }}
    </div>
  {% endfor %}

  <form method="POST" action="{{ path('clinic_admission_emergency') }}" class="space-y-6">
    <input type="hidden" name="_token" value="{{ csrf_token('admission_emergency') }}">

    {# Intake channel #}
    <div>
      <label for="intake_channel" class="block text-sm font-medium text-gray-700 mb-1">
        Canal d'admission <span class="text-red-500">*</span>
      </label>
      <select id="intake_channel" name="intake_channel" required
              class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="">-- Sélectionner --</option>
        {% for channel in intakeChannels %}
          <option value="{{ channel.value }}">{{ channel.value|replace({'_': ' '})|capitalize }}</option>
        {% endfor %}
      </select>
    </div>

    {# Triage level #}
    <div>
      <label for="triage_level" class="block text-sm font-medium text-gray-700 mb-1">
        Niveau de triage <span class="text-red-500">*</span>
      </label>
      <select id="triage_level" name="triage_level" required
              class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="">-- Sélectionner --</option>
        {% for level in triageLevels %}
          <option value="{{ level.value }}">{{ level.value|replace({'_': ' '})|capitalize }}</option>
        {% endfor %}
      </select>
    </div>

    {# Provisional label (for unidentified animal) #}
    <div>
      <label for="provisional_label" class="block text-sm font-medium text-gray-700 mb-1">
        Étiquette provisoire (animal non identifié)
      </label>
      <input type="text" id="provisional_label" name="provisional_label"
             placeholder="ex. Chat roux blessé"
             class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      <p class="mt-1 text-xs text-gray-500">Requis si l'animal n'est pas identifié dans le système.</p>
    </div>

    {# Observed species #}
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="observed_species" class="block text-sm font-medium text-gray-700 mb-1">
          Espèce observée
        </label>
        <input type="text" id="observed_species" name="observed_species"
               placeholder="ex. Félin"
               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label for="observed_color" class="block text-sm font-medium text-gray-700 mb-1">
          Couleur / robe
        </label>
        <input type="text" id="observed_color" name="observed_color"
               placeholder="ex. Roux tigré"
               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
    </div>

    {# Physical description #}
    <div>
      <label for="physical_description" class="block text-sm font-medium text-gray-700 mb-1">
        Description physique
      </label>
      <textarea id="physical_description" name="physical_description" rows="2"
                placeholder="Description sommaire de l'animal..."
                class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
    </div>

    {# Triage notes #}
    <div>
      <label for="triage_notes" class="block text-sm font-medium text-gray-700 mb-1">
        Notes de triage
      </label>
      <textarea id="triage_notes" name="triage_notes" rows="2"
                placeholder="Motif de consultation, symptômes observés..."
                class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
    </div>

    {# Presenter section #}
    <fieldset class="border border-gray-200 rounded-md p-4">
      <legend class="text-sm font-medium text-gray-700 px-2">Présentateur (optionnel)</legend>
      <div class="space-y-4 mt-2">
        <div>
          <label for="presenter_name" class="block text-sm font-medium text-gray-700 mb-1">
            Nom
          </label>
          <input type="text" id="presenter_name" name="presenter_name"
                 placeholder="Prénom Nom"
                 class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="presenter_phone" class="block text-sm font-medium text-gray-700 mb-1">
              Téléphone (format E.164)
            </label>
            <input type="tel" id="presenter_phone" name="presenter_phone"
                   placeholder="+33612345678"
                   class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>
          <div>
            <label for="presenter_role" class="block text-sm font-medium text-gray-700 mb-1">
              Rôle
            </label>
            <select id="presenter_role" name="presenter_role"
                    class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="">-- Sélectionner --</option>
              <option value="owner">Propriétaire</option>
              <option value="third_party">Tiers</option>
              <option value="authority">Autorité</option>
              <option value="association">Association</option>
              <option value="municipality">Municipalité</option>
              <option value="unknown">Inconnu</option>
            </select>
          </div>
        </div>
      </div>
    </fieldset>

    {# Actions #}
    <div class="flex items-center gap-3 pt-2">
      <button type="submit"
              class="inline-flex items-center gap-2 px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-md hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500">
        <i data-lucide="alert-triangle" class="w-4 h-4"></i>
        Créer l'admission urgente
      </button>
      <a href="{{ path('clinic_admission_queue') }}"
         class="text-sm text-gray-600 hover:text-gray-900">
        Annuler
      </a>
    </div>
  </form>
</div>
{% endblock %}
