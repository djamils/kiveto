{#
 # Kiveto — templates/clinic/admission/queue.html.twig
 # ─────────────────────────────────────────────────────
 # Waiting room — "Flux du jour" kanban layout.
 #
 # Variables:
 #   entries           WaitingRoomItemDto[]   Active admissions in waiting room
 #   countUnidentified int                    Admissions with unidentified patient
 #}
{% extends 'clinic/base.html.twig' %}

{% block show_topbar %}false{% endblock %}
{% block page_title %}Flux du jour{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('styles/pages/scheduling/waiting-room.css') }}"/>
{% endblock %}

{% set channelLabels = {
  'appointment_booked':        'RDV',
  'walk_in':                   'Sans RDV',
  'emergency':                 'Urgence',
  'emergency_by_third_party':  'Urgence tiers',
  'emergency_by_authority':    'Urgence autorités',
  'emergency_by_association':  'Urgence asso.',
  'transfer_from_other_clinic':'Transfert',
} %}

{% set channelBadgeStyle = {
  'appointment_booked':        'background:var(--color-info-bg);color:var(--color-info-text);',
  'walk_in':                   'background:var(--surface-subtle);color:var(--text-secondary);border:1px solid var(--border-medium);',
  'emergency':                 'background:var(--color-danger-bg);color:var(--color-danger-text);',
  'emergency_by_third_party':  'background:var(--color-danger-bg);color:var(--color-danger-text);',
  'emergency_by_authority':    'background:var(--color-danger-bg);color:var(--color-danger-text);',
  'emergency_by_association':  'background:var(--color-warning-bg);color:var(--color-warning-text);',
  'transfer_from_other_clinic':'background:var(--color-purple-bg);color:var(--color-purple-text);',
} %}

{% set urgCount = entries|filter(e => e.triageLevel in ['emergency','vital_emergency'])|length %}
{% set waitEntries = entries|filter(e => e.locationStatus in ['in_waiting_room','at_reception']) %}
{% set consultEntries = entries|filter(e => e.locationStatus == 'in_consultation_room') %}
{% set attenteCount = waitEntries|length %}
{% set consultCount = consultEntries|length %}

{% block content %}
<div data-controller="waiting-room" class="wr-root">

  {# ── Section 1: Topbar ── #}
  <div class="topbar">
    <div>
      <p class="topbar-title">Flux du jour</p>
      <p class="topbar-date">{{ "now"|date("l j F Y")|capitalize }}</p>
    </div>
    <div class="topbar-clock">
      <span class="clock-num" data-waiting-room-target="clockH"></span>
      <span class="clock-sep">:</span>
      <span class="clock-num" data-waiting-room-target="clockM"></span>
      <span class="clock-sep clock-sep--sec">:</span>
      <span class="clock-sec" data-waiting-room-target="clockS"></span>
    </div>
    <div class="topbar-right">
      <button class="btn btn-danger btn-sm"
              data-action="waiting-room#openModal"
              data-waiting-room-modal-id-param="modal-urgence">
        <i data-lucide="alert-triangle" style="width:13px;height:13px;"></i> Urgence
      </button>
      <button class="btn btn-primary btn-sm"
              data-action="waiting-room#openModal"
              data-waiting-room-modal-id-param="modal-checkin">
        <i data-lucide="user-plus" style="width:13px;height:13px;"></i> Walk-in
      </button>
    </div>
  </div>

  {# ── Section 2: Tabs Row with KPIs ── #}
  <div class="tabs-row">
    <div class="tabs-left">
      <button class="tab-btn active" data-tab="amb"
              data-action="click->waiting-room#setTab"
              data-waiting-room-tab-param="amb">
        <i data-lucide="activity"></i>
        <span>Flux ambulatoire</span>
        <span class="tab-badge{% if urgCount > 0 %} warn{% endif %}">{{ entries|length }} · {{ urgCount }} urg.</span>
      </button>
      <button class="tab-btn" data-tab="soins"
              data-action="click->waiting-room#setTab"
              data-waiting-room-tab-param="soins">
        <i data-lucide="bed-double"></i>
        <span>Soins cliniques</span>
        <span class="tab-badge">3 · 4</span>
      </button>
    </div>
    <div class="tabs-kpis" id="tabs-kpis">
      <div class="kpi-item">
        <span class="kpi-num warn">{{ attenteCount }}</span>
        <span class="kpi-label">attente</span>
      </div>
      <div class="kpi-item">
        <span class="kpi-num info">{{ consultCount }}</span>
        <span class="kpi-label">consult</span>
      </div>
      <div class="kpi-item">
        <span class="kpi-num danger">{{ urgCount }}</span>
        <span class="kpi-label">urgences</span>
      </div>
      <div class="kpi-item">
        <span class="kpi-num purple">3</span>
        <span class="kpi-label">bloc</span>
      </div>
      <div class="kpi-item">
        <span class="kpi-num success">4</span>
        <span class="kpi-label">hospi</span>
      </div>
      <div class="kpi-live">
        <span class="kpi-live-dot"></span>
        <span class="kpi-live-text">Live</span>
      </div>
    </div>
  </div>


  {# ── Section 4: Vet & Rooms Strip (REAL) ── #}
  <div class="vstrip">
    <span class="vstrip-l">Équipe</span>
    <div style="display:flex;gap:var(--space-2);align-items:center;flex-wrap:nowrap;">
      {% for vet in practitioners %}
        {% set name = vet.displayName ?? 'N/A' %}
        {% set initials = (name|split(' ')|map(w => w[0:1])|join(''))|upper %}
        {% set color = vet.agendaColor ?? '#4338ca' %}
        <div class="vcard">
          <div class="vcard-av" style="background:{{ color }}22;color:{{ color }};">{{ initials[0:2] }}</div>
          <span class="vcard-name">{{ name|split(' ')|last }}</span>
          <span class="vcard-status">· libre</span>
        </div>
      {% else %}
        <span style="font-size:var(--text-sm);color:var(--text-subtle);">Aucun praticien configuré</span>
      {% endfor %}
    </div>
    <div class="vstrip-rooms">
      <span class="vstrip-l" style="margin-right:4px;">Salles</span>
      <span class="room-pill occupee">S1</span>
      <span class="room-pill occupee">S2</span>
      <span class="room-pill libre">S3</span>
      <span class="room-pill occupee">Bloc</span>
    </div>
  </div>

  {# ── Section 5: Tab Content — Flux Ambulatoire ── #}
  <div class="tab-content active" id="content-amb">
    {# Lookup map: userId → displayName for appointment cards #}
    {% set vetByUserId = {} %}
    {% for vet in practitioners %}
      {% set vetByUserId = vetByUserId|merge({(vet.userId): vet.displayName ?? ''}) %}
    {% endfor %}
    <div class="kanban-amb">
      <div class="kanban-titles">
        <div class="col-title">
          <div>
            <div class="col-title-l">Planifié</div>
            <div class="col-title-meta">{{ appointments|length }} rendez-vous à venir</div>
          </div>
        </div>
        <div class="col-title">
          <div>
            <div class="col-title-l">Salle d'attente</div>
            <div class="col-title-meta">
              {{ waitEntries|length }} patient{{ waitEntries|length > 1 ? 's' : '' }}
              {% if urgCount > 0 %} · <span class="urg-mark">{{ urgCount }} urgence{{ urgCount > 1 ? 's' : '' }}</span>{% endif %}
            </div>
          </div>
        </div>
        <div class="col-title">
          <div>
            <div class="col-title-l">Pris en charge</div>
            <div class="col-title-meta">
              {{ consultEntries|length }} patient{{ consultEntries|length > 1 ? 's' : '' }}
            </div>
          </div>
        </div>
        <div class="col-title">
          <div>
            <div class="col-title-l">Sortie</div>
            <div class="col-title-meta">1 patient</div>
          </div>
        </div>
      </div>
      <div class="kanban-cols">

        {# Planifié (REAL via GetAgendaForClinicDateRange) #}
        <div class="kcol">
          <div class="kcol-scroll">
            {% for appt in appointments %}
              {% set apptTime = appt.startsAtUtc|date('H:i', 'Europe/Paris') %}
              {% set apptTs = appt.startsAtUtc|date('U') %}
              {% set nowTs = 'now'|date('U') %}
              {% set isLate = nowTs > apptTs %}
              {% set minutesLate = isLate ? ((nowTs - apptTs) / 60)|round : 0 %}
              {% if minutesLate >= 60 %}
                {% set lateH = (minutesLate / 60)|round(0, 'floor') %}
                {% set lateM = minutesLate % 60 %}
                {% set lateDisplay = '+' ~ lateH ~ 'h' ~ (lateM > 0 ? lateM : '') %}
              {% else %}
                {% set lateDisplay = '+' ~ minutesLate %}
              {% endif %}
              {% set vetName = vetByUserId[appt.practitionerUserId] ?? (appt.practitionerLabel ?? '') %}
              {% set vetShort = vetName ? vetName|replace({'Dr. ': '', 'Dr ': ''})|split(' ')|last : '' %}
              {% set speciesKey = appt.animalSpecies ? appt.animalSpecies|lower : '' %}
              {% set reasonLow = appt.reason ? appt.reason|lower : '' %}
              {% if reasonLow matches '/(chirurgi|stérilis|castrat|opérat|bloc)/' %}
                {% set rdvBadgeClass = 'surgery' %}
              {% elseif reasonLow matches '/(vaccin|primo|rappel)/' %}
                {% set rdvBadgeClass = 'vaccine' %}
              {% elseif reasonLow matches '/(urgence|vital|hémorrag|convuls)/' %}
                {% set rdvBadgeClass = 'urgent' %}
              {% elseif reasonLow matches '/(consultation|suivi|post.op|bilan|contrôle|détartrage)/' %}
                {% set rdvBadgeClass = 'consult' %}
              {% else %}
                {% set rdvBadgeClass = 'checkup' %}
              {% endif %}
              {% set speciesIcon = {'dog': '🐕', 'cat': '🐈', 'nac': '🐇', 'other': '🐾'}[speciesKey] ?? '🐾' %}
              {% if appt.animalBirthDate %}
                {% set birthYear = appt.animalBirthDate|date('Y') %}
                {% set ageYears = 'now'|date('Y') - birthYear %}
                {% set ageDisplay = ageYears > 0 ? ageYears ~ ' an' ~ (ageYears > 1 ? 's' : '') : '< 1 an' %}
              {% else %}
                {% set ageDisplay = '' %}
              {% endif %}
              <div class="scard stripe-planifie is-collapsed"
                   data-motif="{{ appt.reason ?? '' }}"
                   data-channel="RDV" data-opened-at="{{ apptTime }}"
                   data-triage-label="Standard"
                   data-vet="{{ vetName }}"
                   data-owner-name="{{ appt.ownerLabel ?? '' }}"
                   data-species="{{ appt.animalSpecies ?? '' }}">
                <div class="card-top"
                     data-action="click->waiting-room#toggleCollapse">
                  <span class="card-pet">
                    <span class="card-pet-icon">{{ appt.animalLabel ? speciesIcon : '🐾' }}</span>
                    <span class="card-pet-name">{{ appt.animalLabel ?? '—' }}</span>
                  </span>
                  <span class="card-top-right">
                    {% if appt.reason %}<span class="rdv-badge {{ rdvBadgeClass }}">{{ appt.reason }}</span>{% endif %}
                    <span class="card-when{% if isLate %} late{% endif %}">{{ apptTime }}{% if isLate %} · {{ lateDisplay }}{% endif %}</span>
                    <span class="card-collapse-chevron"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
                  </span>
                </div>
                <div class="sched-split">
                  <div class="sched-col">
                    {% set speciesLabels = {'dog': 'Canin', 'cat': 'Félin', 'nac': 'NAC', 'other': 'Autre'} %}
                    {% set speciesLabel = speciesLabels[speciesKey] ?? '' %}
                    <div class="sched-col-line">{{ speciesLabel }}{% if speciesLabel and appt.animalBreed %} · {% endif %}{{ appt.animalBreed ?? '' }}</div>
                    <div class="sched-col-line muted">{{ ageDisplay }}</div>
                  </div>
                  <div class="sched-col">
                    <div class="sched-col-line">{{ appt.ownerLabel ?? '' }}</div>
                    {% if appt.ownerPhone %}
                      <div class="sched-col-line tel">{{ appt.ownerPhone|phone_display(false, false) }}</div>
                    {% endif %}
                  </div>
                </div>
                {% if appt.notes %}
                  <div class="card-meta" style="font-style:italic;">{{ appt.notes }}</div>
                {% endif %}
                <div class="sched-vet-line">
                  {% if vetShort %}
                    <span class="card-vet-dot" style="background:var(--brand-100);color:var(--brand-700);">{{ vetShort[0:2]|upper }}</span>
                    <span>{{ vetShort }}</span>
                  {% else %}
                    <span class="sched-vet-empty">vétérinaire non assigné</span>
                  {% endif %}
                  <button class="sched-checkin-inline"
                          data-action="click->waiting-room#openCheckinWithPatient"
                          data-animal-id="{{ appt.animalId ?? '' }}"
                          data-animal-name="{{ appt.animalLabel ?? '' }}"
                          data-animal-species="{{ speciesIcon }}"
                          data-animal-subtitle="{{ speciesLabel }}{% if speciesLabel and appt.animalBreed %} · {% endif %}{{ appt.animalBreed ?? '' }}"
                          data-owner-label="{{ appt.ownerLabel ?? '' }}"
                          data-owner-phone="{{ appt.ownerPhone ?? '' }}"
                          data-vet="{{ vetName }}"
                          data-appt-time="{{ apptTime }}"
                          data-appt-ts="{{ apptTs }}"
                          data-appt-id="{{ appt.id }}"
                          data-motif="{{ appt.reason ?? '' }}">Check-in</button>
                </div>
              </div>
            {% else %}
              <div class="col-empty">Aucun RDV planifié aujourd'hui</div>
            {% endfor %}
          </div>
        </div>

        {# En attente (REAL) #}
        <div class="kcol">
          <div class="kcol-scroll">
            {% set urgentEntries = waitEntries|filter(e => e.triageLevel in ['vital_emergency','emergency']) %}
            {% set prioEntries = waitEntries|filter(e => e.triageLevel == 'priority') %}
            {% set stdEntries = waitEntries|filter(e => e.triageLevel == 'standard') %}

{# ─── macro wait-expanded (réutilisé pour les 3 types) ─── #}
            {%- macro waitExpanded(entry, enr, primaryClass) -%}
              {%- set speciesLabels = {'dog': 'Chien', 'cat': 'Chat', 'nac': 'Lapin', 'other': 'Autre'} -%}
              {%- set speciesVal = enr is not empty and enr.species is defined ? enr.species : '' -%}
              {%- set breedVal   = enr is not empty and enr.breed is defined ? enr.breed : '' -%}
              {%- set speciesKey = speciesVal ? speciesVal|lower : '' -%}
              {%- set especeText = speciesLabels[speciesKey] ?? '' -%}
              {%- set especeRace = especeText ~ (breedVal ? ' · ' ~ breedVal : '') -%}
              {%- set ageVal     = enr is not empty and enr.age is defined ? enr.age : '' -%}
              {%- set weightVal  = enr is not empty and enr.weight is defined ? enr.weight : '' -%}
              {%- set ageWeight  = [ageVal, weightVal]|filter(v => v)|join(' · ') -%}
              {%- set ownerName  = enr is not empty and enr.ownerName is defined ? enr.ownerName : '' -%}
              {%- set ownerPhone = enr is not empty and enr.ownerPhone is defined ? enr.ownerPhone : '' -%}
              {%- set isUnknown = (not entry.isPatientIdentifiedAtOpening) and (entry.knownAnimalId is null) -%}
              {%- set dangerCls = primaryClass == 'danger' ? 'danger' : '' -%}
              <div class="wait-expanded">
                <div class="wait-expanded-grid">
                  <div class="wait-expanded-col">
                    {% if isUnknown %}<div class="wed-key">Animal</div>{% endif %}
                    <div class="wait-expanded-line">{{ especeRace ?: 'Non identifié' }}</div>
                    {% if ageWeight %}<div class="wait-expanded-line muted">{{ ageWeight }}</div>{% endif %}
                  </div>
                  <div class="wait-expanded-col">
                    {% if isUnknown %}<div class="wed-key">Propriétaire</div>{% endif %}
                    <div class="wait-expanded-line">{{ ownerName ?: 'Non identifié' }}</div>
                    {% if ownerPhone and not isUnknown %}
                      <div class="wait-expanded-line tel">{{ ownerPhone|phone_display(false, false) }}</div>
                    {% else %}
                      <div class="wait-expanded-line muted">Tél. non renseigné</div>
                    {% endif %}
                  </div>
                </div>
                <div class="wait-actions">
                  {% if isUnknown %}
                    <button class="wait-act-warn" type="button"
                            onclick="openIdentifierModal('{{ entry.admissionId }}', '{{ entry.displayLabel|e('js') }}', '{{ entry.physicalDescription|default('')|e('js') }}', '{{ entry.triageNotes|default('')|e('js') }}')">Identifier</button>
                  {% else %}
                    <button class="wait-act-secondary" type="button">Profil</button>
                  {% endif %}
                  <div class="wait-split {{ dangerCls }}" data-motif="{{ (entry.appointmentReason ?? entry.triageNotes ?? '')|e('html_attr') }}">
                    <button class="wait-split-main" type="button">→ Prendre en charge</button>
                    <button class="wait-split-arrow" type="button" data-action="click->waiting-room#toggleActMenu">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                  </div>
                </div>
              </div>
            {%- endmacro -%}

            {% import _self as cards %}

            {# ── chevron SVG ── #}
            {%- set chevronSvg -%}<span class="card-collapse-chevron"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>{%- endset -%}

            {# ── vet pill ── #}
            {%- macro vetPill(entry, vetByUserId) -%}
              {%- set vetName = (vetByUserId[entry.practitionerUserId] ?? null) ?: (entry.practitionerLabel ?? null) -%}
              {% if vetName %}<span class="card-vet"><span class="card-vet-dot" style="background:var(--brand-100);color:var(--brand-700);">{{ vetName|split(" ")|last|slice(0,2)|upper }}</span>{{ vetName|split(" ")|last }}</span>{% else %}<span></span>{% endif %}
            {%- endmacro -%}

            {% if urgentEntries|length > 0 %}
              <div class="col-section-l urg"><i data-lucide="alert-triangle" style="width:10px;height:10px;"></i> Urgences <span class="col-section-cnt">{{ urgentEntries|length }}</span></div>
              {% for entry in urgentEntries %}
                {% set enr = animalEnrichment[entry.admissionId] ?? {} %}
                {% set waitMin = (('now'|date('U') - entry.openedAt|date('U')) / 60)|round %}{% set waitH = (waitMin / 60)|round(0, 'floor') %}{% set waitM = waitMin % 60 %}{% set waitDisplay = waitMin >= 60 ? waitH ~ 'h' ~ (waitM > 0 ? waitM : '') : (waitMin > 0 ? waitMin ~ ' min' : '<1 min') %}{% set waitClass = waitMin >= 60 ? 'over' : (waitMin >= 20 ? 'warn' : '') %}
                <div class="pcard urgent is-collapsible is-collapsed">
                  <div class="card-top" data-action="click->waiting-room#toggleCollapse">
                    <span class="card-pet">
                      <span class="card-pet-icon">{% if not entry.isPatientIdentifiedAtOpening %}❓{% else %}🐾{% endif %}</span>
                      <span class="card-pet-name">{{ entry.displayLabel }}</span>
                    </span>
                    <span style="display:inline-flex;align-items:center;gap:4px;">
                      <span class="urg-tag{% if not entry.isPatientIdentifiedAtOpening %} nonid{% endif %}">{{ not entry.isPatientIdentifiedAtOpening ? 'NON ID' : (entry.triageLevel == 'vital_emergency' ? 'VITAL' : 'URG') }}</span>
                      {{ chevronSvg }}
                    </span>
                  </div>
                  {% if entry.triageNotes %}<div class="card-meta">{{ entry.triageNotes }}</div>{% endif %}
                  {% if entry.contextNote %}<div class="card-meta" style="font-style:italic;color:var(--text-muted);">{{ entry.contextNote }}</div>{% endif %}
                  <div class="card-foot">
                    {{ cards.vetPill(entry, vetByUserId) }}
                    <span class="card-wait {{ waitClass }}">{{ waitDisplay }}</span>
                  </div>
                  {{ cards.waitExpanded(entry, enr, 'danger') }}
                </div>
              {% endfor %}
            {% endif %}

            {% if prioEntries|length > 0 %}
              <div class="col-section-l warn"><i data-lucide="alert-circle" style="width:10px;height:10px;"></i> Prioritaires <span class="col-section-cnt">{{ prioEntries|length }}</span></div>
              {% for entry in prioEntries %}
                {% set enr = animalEnrichment[entry.admissionId] ?? {} %}
                {% set waitMin = (('now'|date('U') - entry.openedAt|date('U')) / 60)|round %}{% set waitH = (waitMin / 60)|round(0, 'floor') %}{% set waitM = waitMin % 60 %}{% set waitDisplay = waitMin >= 60 ? waitH ~ 'h' ~ (waitM > 0 ? waitM : '') : (waitMin > 0 ? waitMin ~ ' min' : '<1 min') %}{% set waitClass = waitMin >= 60 ? 'over' : (waitMin >= 20 ? 'warn' : '') %}
                <div class="pcard priority is-collapsible is-collapsed">
                  <div class="card-top" data-action="click->waiting-room#toggleCollapse">
                    <span class="card-pet">
                      <span class="card-pet-icon">🐾</span>
                      <span class="card-pet-name">{{ entry.displayLabel }}</span>
                    </span>
                    {{ chevronSvg }}
                  </div>
                  {% if entry.triageNotes %}<div class="card-meta">{{ entry.triageNotes }}</div>{% endif %}
                  {% if entry.contextNote %}<div class="card-meta" style="font-style:italic;color:var(--text-muted);">{{ entry.contextNote }}</div>{% endif %}
                  <div class="sla"><div class="sla-bar"><div class="sla-fill warn" style="width:60%;"></div></div><div class="sla-meta"><span>SLA 15 min</span><span class="warn">{{ waitDisplay }}</span></div></div>
                  <div class="card-foot">
                    {{ cards.vetPill(entry, vetByUserId) }}
                    <span class="card-wait {{ waitClass }}">{{ waitDisplay }}</span>
                  </div>
                  {{ cards.waitExpanded(entry, enr, '') }}
                </div>
              {% endfor %}
            {% endif %}

            {% if stdEntries|length > 0 %}
              <div class="col-section-l">Standard <span class="col-section-cnt">{{ stdEntries|length }}</span></div>
              {% for entry in stdEntries %}
                {% set enr = animalEnrichment[entry.admissionId] ?? {} %}
                {% set waitMin = (('now'|date('U') - entry.openedAt|date('U')) / 60)|round %}{% set waitH = (waitMin / 60)|round(0, 'floor') %}{% set waitM = waitMin % 60 %}{% set waitDisplay = waitMin >= 60 ? waitH ~ 'h' ~ (waitM > 0 ? waitM : '') : (waitMin > 0 ? waitMin ~ ' min' : '<1 min') %}{% set waitClass = waitMin >= 60 ? 'over' : (waitMin >= 20 ? 'warn' : '') %}
                <div class="scard stripe-attente is-collapsible is-collapsed">
                  <div class="card-top" data-action="click->waiting-room#toggleCollapse">
                    <span class="card-pet">
                      <span class="card-pet-icon">{% if not entry.isPatientIdentifiedAtOpening %}❓{% else %}🐾{% endif %}</span>
                      <span class="card-pet-name">{{ entry.displayLabel }}</span>
                    </span>
                    <span style="display:inline-flex;gap:4px;align-items:center;"><span class="card-wait {{ waitClass }}">{{ waitDisplay }}</span>{{ chevronSvg }}</span>
                  </div>
                  {% if entry.triageNotes %}<div class="card-meta">{{ entry.triageNotes }}</div>{% endif %}
                  {% if entry.contextNote %}<div class="card-meta" style="font-style:italic;color:var(--text-muted);">{{ entry.contextNote }}</div>{% endif %}
                  <div class="card-foot">
                    {{ cards.vetPill(entry, vetByUserId) }}
                    <span style="display:inline-flex;gap:4px;flex-shrink:0;align-items:center;">{% if entry.intakeChannel == 'appointment_booked' and entry.appointmentReason %}{% set reasonKey = entry.appointmentReason|lower %}{% if 'chirurgi' in reasonKey or 'stérilis' in reasonKey or 'castrat' in reasonKey %}<span class="rdv-badge surgery">{{ entry.appointmentReason }}</span>{% elseif 'vaccin' in reasonKey or 'rappel' in reasonKey %}<span class="rdv-badge vaccine">{{ entry.appointmentReason }}</span>{% elseif 'consultation' in reasonKey or 'suivi' in reasonKey or 'bilan' in reasonKey or 'contrôle' in reasonKey %}<span class="rdv-badge consult">{{ entry.appointmentReason }}</span>{% else %}<span class="rdv-badge checkup">{{ entry.appointmentReason }}</span>{% endif %}{% endif %}<span class="rdv-badge" style="{{ channelBadgeStyle[entry.intakeChannel] ?? '' }}">{{ channelLabels[entry.intakeChannel] ?? entry.intakeChannel }}</span></span>
                  </div>
                  {{ cards.waitExpanded(entry, enr, '') }}
                </div>
              {% endfor %}
            {% endif %}

            {% if waitEntries|length == 0 %}
              <div class="col-empty">Aucun patient en attente</div>
            {% endif %}
          </div>
        </div>

        {# En consultation (REAL) #}
        <div class="kcol">
          <div class="kcol-scroll">
            {% if consultEntries|length > 0 %}
              <div class="col-section-l">Pris en charge <span class="col-section-cnt">{{ consultEntries|length }}</span></div>
              {% for entry in consultEntries %}
                {% set enr = animalEnrichment[entry.admissionId] ?? {} %}
                <div class="scard stripe-consult" data-admission-id="{{ entry.admissionId }}"
                  data-motif="{{ entry.appointmentReason ?? entry.triageNotes ?? '' }}"
                  data-channel="{{ channelLabels[entry.intakeChannel] ?? entry.intakeChannel }}"
                  data-opened-at="{{ entry.openedAt|date('H\\hi') }}"
                  data-triage-label="{{ { 'vital_emergency': 'Vital', 'emergency': 'Urgence', 'priority': 'Prioritaire', 'standard': 'Standard' }[entry.triageLevel] ?? entry.triageLevel }}"
                  data-species="{{ enr.species ?? '' }}{% if enr.breed ?? false %} · {{ enr.breed }}{% endif %}"
                  data-owner-name="{{ enr.ownerName ?? '' }}"
                  data-owner-phone="{{ enr.ownerPhone ?? '' }}"
                  data-action="click->waiting-room#openDetailSlide">
                  <div class="card-top">
                    <span class="card-pet">
                      <span class="card-pet-icon">🐾</span>
                      <span class="card-pet-name">{{ entry.displayLabel }}</span>
                    </span>
                    <span class="card-when">{{ entry.openedAt|date('H\\hi') }}</span>
                  </div>
                  {% if entry.triageNotes %}<div class="card-meta">{{ entry.triageNotes }}</div>{% endif %}
                  <div class="card-foot">
                    <span class="card-vet"><span class="card-vet-dot card-vet-unassigned">!</span>en cours</span>
                    <span style="display:inline-flex;gap:4px;flex-shrink:0;align-items:center;">{% if entry.intakeChannel == 'appointment_booked' and entry.appointmentReason %}{% set reasonKey = entry.appointmentReason|lower %}{% if 'chirurgi' in reasonKey or 'stérilis' in reasonKey or 'castrat' in reasonKey %}<span class="rdv-badge surgery">{{ entry.appointmentReason }}</span>{% elseif 'vaccin' in reasonKey or 'rappel' in reasonKey %}<span class="rdv-badge vaccine">{{ entry.appointmentReason }}</span>{% elseif 'consultation' in reasonKey or 'suivi' in reasonKey or 'bilan' in reasonKey or 'contrôle' in reasonKey %}<span class="rdv-badge consult">{{ entry.appointmentReason }}</span>{% else %}<span class="rdv-badge checkup">{{ entry.appointmentReason }}</span>{% endif %}{% endif %}<span class="rdv-badge" style="{{ channelBadgeStyle[entry.intakeChannel] ?? '' }}">{{ channelLabels[entry.intakeChannel] ?? entry.intakeChannel }}</span></span>
                  </div>
                </div>
              {% endfor %}
            {% else %}
              <div class="col-empty">Aucun patient en consultation</div>
            {% endif %}

            {# Mock — Prioritaire en consultation #}
            <div class="col-section-l warn"><i data-lucide="alert-circle" style="width:10px;height:10px;"></i> Prioritaires <span class="col-section-cnt">1</span></div>
            <div class="pcard priority"
                 data-motif="Boiterie patte avant droite — radio prescrite"
                 data-channel="RDV" data-opened-at="09h30"
                 data-triage-label="Prioritaire" data-species="Canin · Berger australien"
                 data-vet="Dr. Rousseau · Salle 2" data-owner-name="James Park" data-owner-phone="+33 6 11 22 33 44"
                 data-notes="Boite depuis 48h. Radio numérique programmée. Dossier antécédents fracture 2024."
                 data-action="click->waiting-room#openDetailSlide">
              <div class="card-top">
                <span class="card-pet"><span class="card-pet-icon">🐕</span><span class="card-pet-name">Pixel</span></span>
                <span class="card-when">09h30</span>
              </div>
              <div class="card-meta">Boiterie — radio patte avant</div>
              <div class="card-foot">
                <span class="card-vet"><span class="card-vet-dot" style="background:var(--brand-100);color:var(--brand-700);">RO</span>Rousseau <span class="card-room">S2</span></span>
                <span class="card-wait warn">32 min</span>
              </div>
            </div>

            {# Mock — Standard en consultation #}
            <div class="col-section-l">Standard <span class="col-section-cnt">1</span></div>
            <div class="scard stripe-consult"
                 data-motif="Bilan annuel + vaccination rappel"
                 data-channel="RDV" data-opened-at="09h45"
                 data-triage-label="Standard" data-species="Félin · British Shorthair"
                 data-vet="Dr. Dupont · Salle 1" data-owner-name="Amélie Dubois" data-owner-phone="+33 6 99 88 77 66"
                 data-action="click->waiting-room#openDetailSlide">
              <div class="card-top">
                <span class="card-pet"><span class="card-pet-icon">🐈</span><span class="card-pet-name">Mochi</span></span>
                <span class="card-when">09h45</span>
              </div>
              <div class="card-meta">Bilan annuel + vaccination · Dubois</div>
              <div class="card-foot">
                <span class="card-vet"><span class="card-vet-dot" style="background:#fce7f3;color:#be185d;">DU</span>Dupont <span class="card-room">S1</span></span>
                <span class="card-wait">18 min</span>
              </div>
            </div>
          </div>
        </div>

        {# Sortie (MOCK) #}
        <div class="kcol">
          <div class="kcol-scroll">
            <div class="col-section-l done">Sortie <span class="col-section-cnt">1</span></div>
            <div class="scard stripe-sortie">
              <div class="card-top"><span class="card-pet"><span class="card-pet-icon">🐈</span><span class="card-pet-name">Cleo</span></span><span class="card-when">09:30</span></div>
              <div class="card-meta">Otite — traitement terminé · Anderson</div>
              <div class="card-foot"><span class="card-vet"><span class="card-vet-dot" style="background:#dcfce7;color:#15803d;">MA</span>Martin</span><span class="card-wait" style="color:var(--color-success-600);">Sortie ✓</span></div>
            </div>
          </div>
        </div>

      </div>{# /kanban-cols #}
    </div>{# /kanban-amb #}
  </div>{# /content-amb #}

