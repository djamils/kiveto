{#
 # Kiveto — templates/clinic/admission/queue.html.twig
 # ─────────────────────────────────────────────────────
 # Waiting room — all active admissions (rdv, walk-in, emergency).
 #
 # Variables:
 #   entries  WaitingRoomItemDto[]  Active admissions in waiting room
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}Salle d'attente{% endblock %}
{% block show_topbar %}false{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/pages/scheduling/waiting-room.css') }}"/>
{% endblock %}

{% block content %}

{# ── Topbar ── #}
<div class="wr-topbar">
  <div>
    <p class="wr-topbar-title">Salle d'attente</p>
    <p class="wr-topbar-subtitle">{{ 'now'|date('l d F Y')|capitalize }}</p>
  </div>
  <div class="wr-topbar-clock">
    <span id="wr-clock-h" class="clock-num">--</span><span class="clock-sep">:</span><span id="wr-clock-m" class="clock-num">--</span><span class="clock-sep wr-clock-sep-light">:</span><span id="wr-clock-s" class="clock-sec">--</span>
  </div>
  <div class="wr-topbar-right">
    <a href="{{ path('clinic_admission_emergency') }}?intake=emergency"
       class="btn btn-danger btn-xs">
      <i data-lucide="alert-triangle" class="wr-icon-xs"></i> Urgence
    </a>
    <a href="{{ path('clinic_admission_emergency') }}?intake=walk_in"
       class="btn btn-secondary btn-xs">
      <i data-lucide="plus" class="wr-icon-xs"></i> Walk-in
    </a>
    <a href="{{ path('clinic_admission_emergency') }}"
       class="btn btn-primary btn-xs">
      <i data-lucide="calendar-check" class="wr-icon-xs"></i> Nouvelle admission
    </a>
  </div>
</div>

{# ── Status bar ── #}
{% set countWaiting   = entries|filter(e => e.locationStatus == 'in_waiting_room')|length %}
{% set countConsult   = entries|filter(e => e.locationStatus == 'in_consultation_room')|length %}
{% set countEmergency = entries|filter(e => e.triageLevel in ['emergency', 'vital_emergency'])|length %}

<div class="status-bar">
  <div class="stat-block">
    <div class="stat-icon wr-stat-icon--waiting"><i data-lucide="clock" class="wr-icon-sm wr-icon--amber"></i></div>
    <div><p class="stat-num wr-stat-num--amber">{{ countWaiting }}</p><p class="stat-label">En attente</p></div>
  </div>
  <div class="stat-block">
    <div class="stat-icon wr-stat-icon--consult"><i data-lucide="stethoscope" class="wr-icon-sm wr-icon--blue"></i></div>
    <div><p class="stat-num wr-stat-num--blue">{{ countConsult }}</p><p class="stat-label">En consultation</p></div>
  </div>
  <div class="stat-block">
    <div class="stat-icon wr-stat-icon--urgence"><i data-lucide="alert-triangle" class="wr-icon-sm wr-icon--red"></i></div>
    <div><p class="stat-num wr-stat-num--red">{{ countEmergency }}</p><p class="stat-label">Urgences</p></div>
  </div>
  <div class="stat-block">
    <div class="stat-icon wr-stat-icon--done"><i data-lucide="check-circle" class="wr-icon-sm wr-icon--green"></i></div>
    <div><p class="stat-num wr-stat-num--green">{{ entries|length }}</p><p class="stat-label">Total</p></div>
  </div>
</div>

{# ── Queue list ── #}
<div class="page-body" style="padding: var(--space-4);">
  <div style="max-width: 900px;">

    {% if entries is empty %}
      <div class="widget" style="text-align: center; padding: var(--space-8);">
        <i data-lucide="check-circle" style="width: 40px; height: 40px; color: var(--color-success-text); margin: 0 auto var(--space-3);"></i>
        <p style="color: var(--text-muted); font-size: var(--text-md);">Aucun patient en salle d'attente</p>
      </div>
    {% else %}

      {#
        Stripe colour by triage level:
          vital_emergency → red (urgence)
          emergency       → red (urgence)
          priority        → amber (prio)
          standard        → slate (attente)
      #}
      {% set triageStripe = {
        'vital_emergency': 'urgence',
        'emergency':       'urgence',
        'priority':        'prio',
        'standard':        'attente',
      } %}

      {# Channel labels #}
      {% set channelLabel = {
        'appointment_booked':        'RDV',
        'walk_in':                   'Sans RDV',
        'emergency':                 'Urgence',
        'emergency_by_third_party':  'Urgence (tiers)',
        'emergency_by_authority':    'Urgence (autorités)',
        'emergency_by_association':  'Urgence (asso.)',
        'emergency_by_municipality': 'Urgence (mairie)',
        'transfer_from_other_clinic':'Transfert',
      } %}

      {# Channel badge style #}
      {% set channelStyle = {
        'appointment_booked':        'background: var(--color-info-bg); color: var(--color-info-text);',
        'walk_in':                   'background: var(--color-warning-bg); color: var(--color-warning-text);',
        'emergency':                 'background: var(--color-danger-bg); color: var(--color-danger-text);',
        'emergency_by_third_party':  'background: var(--color-danger-bg); color: var(--color-danger-text);',
        'emergency_by_authority':    'background: var(--color-danger-bg); color: var(--color-danger-text);',
        'emergency_by_association':  'background: var(--color-danger-bg); color: var(--color-danger-text);',
        'emergency_by_municipality': 'background: var(--color-danger-bg); color: var(--color-danger-text);',
        'transfer_from_other_clinic':'background: var(--surface-subtle); color: var(--text-muted); border: 1px solid var(--border-medium);',
      } %}

      {# Triage labels #}
      {% set triageLabel = {
        'vital_emergency': 'Urgence vitale',
        'emergency':       'Urgence',
        'priority':        'Prioritaire',
        'standard':        'Standard',
      } %}

      {# Triage badge style #}
      {% set triageStyle = {
        'vital_emergency': 'background: #fef2f2; color: #dc2626;',
        'emergency':       'background: #fff7ed; color: #ea580c;',
        'priority':        'background: #fffbeb; color: #d97706;',
        'standard':        'background: var(--surface-subtle); color: var(--text-muted); border: 1px solid var(--border-light);',
      } %}

      {% for entry in entries %}
        {% set stripe = triageStripe[entry.triageLevel] ?? 'attente' %}
        {% set isEmergency = entry.triageLevel in ['emergency', 'vital_emergency'] %}

        {# Wait time #}
        {% set openedTs = entry.openedAt|date('U') %}
        {% set nowTs    = 'now'|date('U') %}
        {% set waitMin  = (((nowTs - openedTs) / 60)|round)|abs %}
        {% set waitH    = (waitMin / 60)|round(0, 'floor') %}
        {% set waitM    = waitMin % 60 %}

        <div class="qcard{{ isEmergency ? ' urgence' : '' }}">
          <div class="qcard-stripe {{ stripe }}"></div>

          <div class="qcard-body">
            <div style="flex: 1; min-width: 0;">

              {# Badges row #}
              <div style="display: flex; align-items: center; gap: var(--space-1); margin-bottom: var(--space-1); flex-wrap: wrap;">
                {# Intake channel badge #}
                <span class="badge" style="{{ channelStyle[entry.intakeChannel] ?? '' }}">
                  {{ channelLabel[entry.intakeChannel] ?? entry.intakeChannel }}
                </span>

                {# Triage badge (only if not standard) #}
                {% if entry.triageLevel != 'standard' %}
                  <span class="badge" style="{{ triageStyle[entry.triageLevel] ?? '' }}">
                    {{ triageLabel[entry.triageLevel] ?? entry.triageLevel }}
                  </span>
                {% endif %}

                {# Location badge if not in waiting room #}
                {% if entry.locationStatus != 'in_waiting_room' %}
                  <span class="badge" style="background: var(--color-info-bg); color: var(--color-info-text);">
                    {% if entry.locationStatus == 'in_consultation_room' %}En consultation
                    {% elseif entry.locationStatus == 'in_hospitalization' %}Hospitalisé
                    {% elseif entry.locationStatus == 'in_surgery' %}En chirurgie
                    {% elseif entry.locationStatus == 'at_reception' %}Réception
                    {% else %}{{ entry.locationStatus }}
                    {% endif %}
                  </span>
                {% endif %}
              </div>

              {# Patient display label #}
              <div class="qcard-name">{{ entry.displayLabel }}</div>

              {# Triage notes #}
              {% if entry.triageNotes %}
                <div class="qcard-motif">{{ entry.triageNotes }}</div>
              {% endif %}
            </div>

            {# Right: wait time + actions #}
            <div class="qcard-right">
              <span class="wait-big">
                {%- if waitH > 0 -%}{{ waitH }}h{{ waitM < 10 ? '0' }}{{ waitM }}{%- else -%}{{ waitM }}min{%- endif -%}
              </span>
              <span class="wait-label">d'attente</span>

              {# Triage update #}
              <div style="margin-top: var(--space-2);">
                <form method="POST" action="{{ path('clinic_admission_update_triage', {admissionId: entry.admissionId}) }}">
                  <input type="hidden" name="_token" value="{{ csrf_token('admission_triage_' ~ entry.admissionId) }}">
                  <select name="triage_level" onchange="this.form.submit()"
                          class="text-xs border border-gray-200 rounded px-2 py-1 bg-white text-gray-700"
                          style="font-size: 11px; padding: 2px 4px; border: 1px solid var(--border-medium); border-radius: var(--radius-sm); background: var(--surface-base); color: var(--text-secondary);">
                    <option value="standard" {{ entry.triageLevel == 'standard' ? 'selected' : '' }}>Standard</option>
                    <option value="priority" {{ entry.triageLevel == 'priority' ? 'selected' : '' }}>Prioritaire</option>
                    <option value="emergency" {{ entry.triageLevel == 'emergency' ? 'selected' : '' }}>Urgence</option>
                    <option value="vital_emergency" {{ entry.triageLevel == 'vital_emergency' ? 'selected' : '' }}>Urgence vitale</option>
                  </select>
                </form>
              </div>

              {# Actions #}
              <div style="display: flex; gap: var(--space-1); margin-top: var(--space-1);">
                <form method="POST"
                      action="{{ path('clinic_admission_close', {admissionId: entry.admissionId}) }}"
                      onsubmit="return confirm('Clôturer cette admission ?')">
                  <input type="hidden" name="_token" value="{{ csrf_token('admission_close_' ~ entry.admissionId) }}">
                  <input type="hidden" name="closure_reason" value="consultation_completed">
                  <button type="submit" class="btn btn-secondary btn-xs">Terminer</button>
                </form>
              </div>
            </div>
          </div>
        </div>

      {% endfor %}
    {% endif %}

  </div>
</div>

<script>
  (function () {
    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    function tick() {
      var d = new Date();
      document.getElementById('wr-clock-h').textContent = pad(d.getHours());
      document.getElementById('wr-clock-m').textContent = pad(d.getMinutes());
      document.getElementById('wr-clock-s').textContent = pad(d.getSeconds());
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>

{% endblock %}
