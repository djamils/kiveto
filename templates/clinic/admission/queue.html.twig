{#
 # Kiveto — templates/clinic/admission/queue.html.twig
 # ─────────────────────────────────────────────────────
 # Waiting room — "Flux du jour" kanban layout.
 #
 # Variables:
 #   entries           WaitingRoomItemDto[]   Active admissions in waiting room
 #   countUnidentified int                    Admissions with unidentified patient
 #}
{% extends 'clinic/base.html.twig' %}

{% block show_topbar %}false{% endblock %}
{% block page_title %}Flux du jour{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('styles/pages/scheduling/waiting-room.css') }}"/>
{% endblock %}

{% set channelLabels = {
  'appointment_booked':        'RDV',
  'walk_in':                   'Sans RDV',
  'emergency':                 'Urgence',
  'emergency_by_third_party':  'Urgence tiers',
  'emergency_by_authority':    'Urgence autorités',
  'emergency_by_association':  'Urgence asso.',
  'emergency_by_municipality': 'Urgence mairie',
  'transfer_from_other_clinic':'Transfert',
} %}

{% set urgCount = entries|filter(e => e.triageLevel in ['emergency','vital_emergency'])|length %}
{% set waitEntries = entries|filter(e => e.locationStatus in ['in_waiting_room','at_reception']) %}
{% set consultEntries = entries|filter(e => e.locationStatus == 'in_consultation_room') %}
{% set attenteCount = waitEntries|length %}
{% set consultCount = consultEntries|length %}

{% block content %}
<div data-controller="waiting-room" class="wr-root">

  {# ── Section 1: Topbar ── #}
  <div class="topbar">
    <div>
      <p class="topbar-title">Flux du jour</p>
      <p class="topbar-date">{{ "now"|date("l j F Y")|capitalize }}</p>
    </div>
    <div class="topbar-clock">
      <span class="clock-num" data-waiting-room-target="clockH"></span>
      <span class="clock-sep">:</span>
      <span class="clock-num" data-waiting-room-target="clockM"></span>
      <span class="clock-sep clock-sep--sec">:</span>
      <span class="clock-sec" data-waiting-room-target="clockS"></span>
    </div>
    <div class="topbar-right">
      <button class="btn btn-danger btn-sm"
              data-action="waiting-room#openModal"
              data-waiting-room-modal-id-param="modal-urgence">
        <i data-lucide="alert-triangle" style="width:13px;height:13px;"></i> Urgence
      </button>
      <button class="btn btn-primary btn-sm"
              data-action="waiting-room#openModal"
              data-waiting-room-modal-id-param="modal-checkin">
        <i data-lucide="plus" style="width:13px;height:13px;"></i> Check-in
      </button>
    </div>
  </div>

  {# ── Section 2: Tabs Row with KPIs ── #}
  <div class="tabs-row">
    <div class="tabs-left">
      <button class="tab-btn active" data-tab="amb"
              data-action="click->waiting-room#setTab"
              data-waiting-room-tab-param="amb">
        <i data-lucide="activity"></i>
        <span>Flux ambulatoire</span>
        <span class="tab-badge{% if urgCount > 0 %} warn{% endif %}">{{ entries|length }} · {{ urgCount }} urg.</span>
      </button>
      <button class="tab-btn" data-tab="soins"
              data-action="click->waiting-room#setTab"
              data-waiting-room-tab-param="soins">
        <i data-lucide="bed-double"></i>
        <span>Soins cliniques</span>
        <span class="tab-badge">3 · 4</span>
      </button>
    </div>
    <div class="tabs-kpis" id="tabs-kpis">
      <div class="kpi-item">
        <span class="kpi-num warn">{{ attenteCount }}</span>
        <span class="kpi-label">attente</span>
      </div>
      <div class="kpi-item">
        <span class="kpi-num info">{{ consultCount }}</span>
        <span class="kpi-label">consult</span>
      </div>
      <div class="kpi-item">
        <span class="kpi-num danger">{{ urgCount }}</span>
        <span class="kpi-label">urgences</span>
      </div>
      <div class="kpi-item">
        <span class="kpi-num purple">3</span>
        <span class="kpi-label">bloc</span>
      </div>
      <div class="kpi-item">
        <span class="kpi-num success">4</span>
        <span class="kpi-label">hospi</span>
      </div>
      <div class="kpi-live">
        <span class="kpi-live-dot"></span>
        <span class="kpi-live-text">Live</span>
      </div>
    </div>
  </div>

  {# ── Section 3: Urgence Alert Banner (MOCK) ── #}
  <div class="urg-alert" id="urg-alert">
    <span class="urg-alert-dot"></span>
    <div class="urg-alert-body">
      <span class="urg-alert-title">Urgence non prise en charge · Olive · Hémorragie post-chute</span>
      <span class="urg-alert-meta">1 min écoulée · Dr. Martin libre · Salle 3 disponible</span>
    </div>
    <div class="urg-alert-actions">
      <button class="btn btn-danger btn-sm" onclick="affecterUrgence()">
        <i data-lucide="zap" style="width:11px;height:11px;"></i> Affecter Dr. Martin · S3
      </button>
      <button class="btn btn-ghost btn-sm" onclick="document.getElementById('urg-alert').style.display='none'">Autre</button>
    </div>
  </div>

  {# ── Section 4: Vet & Rooms Strip (MOCK) ── #}
  <div class="vstrip">
    <span class="vstrip-l">Équipe</span>
    <div style="display:flex;gap:var(--space-2);align-items:center;">
      <div class="vcard"><div class="vcard-av" style="background:var(--brand-100);color:var(--brand-700);">RO</div><span class="vcard-name">Rousseau</span><span class="vcard-status">· S2</span></div>
      <div class="vcard"><div class="vcard-av" style="background:#fce7f3;color:#be185d;">MA</div><span class="vcard-name">Martin</span><span class="vcard-status free">· libre</span></div>
      <div class="vcard"><div class="vcard-av" style="background:#f0fdf4;color:#15803d;">DU</div><span class="vcard-name">Dupont</span><span class="vcard-status">· S1</span></div>
      <div class="vcard"><div class="vcard-av" style="background:#f5f3ff;color:#7c3aed;">LA</div><span class="vcard-name">Lambert</span><span class="vcard-status bloc">· au bloc</span></div>
    </div>
    <div class="vstrip-rooms">
      <span class="vstrip-l" style="margin-right:4px;">Salles</span>
      <span class="room-pill occupee">S1</span>
      <span class="room-pill occupee">S2</span>
      <span class="room-pill libre">S3</span>
      <span class="room-pill occupee">Bloc</span>
    </div>
  </div>

  {# ── Section 5: Tab Content — Flux Ambulatoire ── #}
  <div class="tab-content active" id="content-amb">
    <div class="kanban-amb">
      <div class="kanban-titles">
        <div class="col-title">
          <div>
            <div class="col-title-l">Planifié</div>
            <div class="col-title-meta">6 RDV à venir</div>
          </div>
          <button class="col-title-action"
                  data-action="waiting-room#openModal"
                  data-waiting-room-modal-id-param="modal-checkin">
            <i data-lucide="plus" style="width:11px;height:11px;"></i>Walk-in
          </button>
        </div>
        <div class="col-title">
          <div>
            <div class="col-title-l">Salle d'attente</div>
            <div class="col-title-meta">
              {{ waitEntries|length }} patient{{ waitEntries|length > 1 ? 's' : '' }}
              {% if urgCount > 0 %} · <span class="urg-mark">{{ urgCount }} urgence{{ urgCount > 1 ? 's' : '' }}</span>{% endif %}
            </div>
          </div>
        </div>
        <div class="col-title">
          <div>
            <div class="col-title-l">En consultation</div>
            <div class="col-title-meta">
              {{ consultEntries|length }} patient{{ consultEntries|length > 1 ? 's' : '' }}
            </div>
          </div>
        </div>
        <div class="col-title">
          <div>
            <div class="col-title-l">Sortie</div>
            <div class="col-title-meta">1 patient</div>
          </div>
        </div>
      </div>
      <div class="kanban-cols">

        {# Planifié (MOCK) #}
        <div class="kcol">
          <div class="kcol-scroll">
            <div class="scard stripe-planifie">
              <div class="card-top"><span class="card-pet"><span class="card-pet-icon">🐕</span><span class="card-pet-name">Tako</span></span><span class="card-when late">09:45 · +11</span></div>
              <div class="card-meta">Vaccin annuel · Lefebvre</div>
              <button class="btn-checkin" data-action="waiting-room#openModal" data-waiting-room-modal-id-param="modal-checkin">Check-in</button>
            </div>
            <div class="scard stripe-planifie">
              <div class="card-top"><span class="card-pet"><span class="card-pet-icon">🐈</span><span class="card-pet-name">Mochi</span></span><span class="card-when">10:15</span></div>
              <div class="card-meta">Contrôle post-op · Dubois</div>
              <button class="btn-checkin" data-action="waiting-room#openModal" data-waiting-room-modal-id-param="modal-checkin">Check-in</button>
            </div>
            <div class="scard stripe-planifie">
              <div class="card-top"><span class="card-pet"><span class="card-pet-icon">🐕</span><span class="card-pet-name">Luna</span></span><span class="card-when">10:30</span></div>
              <div class="card-meta">Bilan sanguin · Moreau</div>
              <button class="btn-checkin" data-action="waiting-room#openModal" data-waiting-room-modal-id-param="modal-checkin">Check-in</button>
            </div>
            <div class="scard stripe-planifie">
              <div class="card-top"><span class="card-pet"><span class="card-pet-icon">🐇</span><span class="card-pet-name">Pixel</span></span><span class="card-when">11:00</span></div>
              <div class="card-meta">Vaccin annuel · Garnier</div>
              <button class="btn-checkin" data-action="waiting-room#openModal" data-waiting-room-modal-id-param="modal-checkin">Check-in</button>
            </div>
            <div class="scard stripe-planifie">
              <div class="card-top"><span class="card-pet"><span class="card-pet-icon">🐕</span><span class="card-pet-name">Rocky</span></span><span class="card-when">11:30</span></div>
              <div class="card-meta">Détartrage · Simon</div>
              <button class="btn-checkin" data-action="waiting-room#openModal" data-waiting-room-modal-id-param="modal-checkin">Check-in</button>
            </div>
            <div class="scard stripe-planifie">
              <div class="card-top"><span class="card-pet"><span class="card-pet-icon">🐈</span><span class="card-pet-name">Cleo</span></span><span class="card-when">12:00</span></div>
              <div class="card-meta">Stérilisation · Blanc</div>
              <button class="btn-checkin" data-action="waiting-room#openModal" data-waiting-room-modal-id-param="modal-checkin">Check-in</button>
            </div>
          </div>
        </div>

        {# En attente (REAL) #}
        <div class="kcol">
          <div class="kcol-scroll">
            {% set urgentEntries = waitEntries|filter(e => e.triageLevel in ['vital_emergency','emergency']) %}
            {% set prioEntries = waitEntries|filter(e => e.triageLevel == 'priority') %}
            {% set stdEntries = waitEntries|filter(e => e.triageLevel == 'standard') %}

            {% if urgentEntries|length > 0 %}
              <div class="col-section-l urg"><i data-lucide="alert-triangle" style="width:10px;height:10px;"></i> Urgences <span class="col-section-cnt">{{ urgentEntries|length }}</span></div>
              {% for entry in urgentEntries %}
                <div class="pcard urgent" data-admission-id="{{ entry.admissionId }}" data-action="click->waiting-room#openDetailSlide">
                  <div class="card-top">
                    <span class="card-pet">
                      <span class="card-pet-icon">{% if not entry.isPatientIdentifiedAtOpening %}❓{% else %}🐾{% endif %}</span>
                      <span class="card-pet-name">{{ entry.displayLabel }}</span>
                    </span>
                    <span class="urg-tag{% if not entry.isPatientIdentifiedAtOpening %} nonid{% endif %}">
                      {{ not entry.isPatientIdentifiedAtOpening ? 'NON ID' : (entry.triageLevel == 'vital_emergency' ? 'VITAL' : 'URG') }}
                    </span>
                  </div>
                  {% if entry.triageNotes %}<div class="card-meta">{{ entry.triageNotes }}</div>{% endif %}
                  <div class="card-foot">
                    <span class="card-vet"><span class="card-vet-dot card-vet-unassigned">!</span>à orienter</span>
                    <span class="card-wait over">{{ entry.openedAt|date('H\\hi') }}</span>
                  </div>
                </div>
              {% endfor %}
            {% endif %}

            {% if prioEntries|length > 0 %}
              <div class="col-section-l warn"><i data-lucide="alert-circle" style="width:10px;height:10px;"></i> Prioritaires <span class="col-section-cnt">{{ prioEntries|length }}</span></div>
              {% for entry in prioEntries %}
                <div class="pcard priority" data-admission-id="{{ entry.admissionId }}" data-action="click->waiting-room#openDetailSlide">
                  <div class="card-top">
                    <span class="card-pet">
                      <span class="card-pet-icon">🐾</span>
                      <span class="card-pet-name">{{ entry.displayLabel }}</span>
                    </span>
                  </div>
                  {% if entry.triageNotes %}<div class="card-meta">{{ entry.triageNotes }}</div>{% endif %}
                  <div class="sla"><div class="sla-bar"><div class="sla-fill warn" style="width:60%;"></div></div><div class="sla-meta"><span>SLA 15 min</span><span>{{ entry.openedAt|date('H\\hi') }}</span></div></div>
                  <div class="card-foot">
                    <span class="card-vet"><span class="card-vet-dot card-vet-unassigned">!</span>à orienter</span>
                    <span class="card-wait">{{ entry.openedAt|date('H\\hi') }}</span>
                  </div>
                </div>
              {% endfor %}
            {% endif %}

            {% if stdEntries|length > 0 %}
              <div class="col-section-l">Standard <span class="col-section-cnt">{{ stdEntries|length }}</span></div>
              {% for entry in stdEntries %}
                <div class="scard stripe-attente" data-admission-id="{{ entry.admissionId }}" data-action="click->waiting-room#openDetailSlide">
                  <div class="card-top">
                    <span class="card-pet">
                      <span class="card-pet-icon">{% if not entry.isPatientIdentifiedAtOpening %}❓{% else %}🐾{% endif %}</span>
                      <span class="card-pet-name">{{ entry.displayLabel }}</span>
                    </span>
                    <span class="card-when">{{ entry.openedAt|date('H\\hi') }}</span>
                  </div>
                  {% if entry.triageNotes %}<div class="card-meta">{{ entry.triageNotes }}</div>{% endif %}
                  <div class="card-foot">
                    <span class="card-vet"><span class="card-vet-dot card-vet-unassigned">!</span>à orienter</span>
                    <span class="card-wait">{{ channelLabels[entry.intakeChannel] ?? entry.intakeChannel }}</span>
                  </div>
                </div>
              {% endfor %}
            {% endif %}

            {% if waitEntries|length == 0 %}
              <div class="col-empty">Aucun patient en attente</div>
            {% endif %}
          </div>
        </div>

        {# En consultation (REAL) #}
        <div class="kcol">
          <div class="kcol-scroll">
            {% if consultEntries|length > 0 %}
              <div class="col-section-l">En consultation <span class="col-section-cnt">{{ consultEntries|length }}</span></div>
              {% for entry in consultEntries %}
                <div class="scard stripe-consult" data-admission-id="{{ entry.admissionId }}" data-action="click->waiting-room#openDetailSlide">
                  <div class="card-top">
                    <span class="card-pet">
                      <span class="card-pet-icon">🐾</span>
                      <span class="card-pet-name">{{ entry.displayLabel }}</span>
                    </span>
                    <span class="card-when">{{ entry.openedAt|date('H\\hi') }}</span>
                  </div>
                  {% if entry.triageNotes %}<div class="card-meta">{{ entry.triageNotes }}</div>{% endif %}
                  <div class="card-foot">
                    <span class="card-vet"><span class="card-vet-dot card-vet-unassigned">!</span>en cours</span>
                    <span class="card-wait">{{ channelLabels[entry.intakeChannel] ?? entry.intakeChannel }}</span>
                  </div>
                </div>
              {% endfor %}
            {% else %}
              <div class="col-empty">Aucun patient en consultation</div>
            {% endif %}
          </div>
        </div>

        {# Sortie (MOCK) #}
        <div class="kcol">
          <div class="kcol-scroll">
            <div class="col-section-l done">Sortie <span class="col-section-cnt">1</span></div>
            <div class="scard stripe-sortie">
              <div class="card-top"><span class="card-pet"><span class="card-pet-icon">🐈</span><span class="card-pet-name">Cleo</span></span><span class="card-when">09:30</span></div>
              <div class="card-meta">Otite — traitement terminé · Anderson</div>
              <div class="card-foot"><span class="card-vet"><span class="card-vet-dot" style="background:#dcfce7;color:#15803d;">MA</span>Martin</span><span class="card-wait" style="color:var(--color-success-600);">Sortie ✓</span></div>
            </div>
          </div>
        </div>

      </div>{# /kanban-cols #}
    </div>{# /kanban-amb #}
  </div>{# /content-amb #}

  {# ── Section 6: Tab Content — Soins Cliniques (MOCK) ── #}
  <div class="tab-content" id="content-soins">
    <div class="soins-grid">
      {# LEFT: Bloc opératoire #}
      <div class="soins-pane">
        <div class="soins-pane-head">
          <div class="soins-pane-title">
            <div class="soins-pane-icon bloc"><i data-lucide="syringe" style="width:14px;height:14px;"></i></div>
            <div><div class="soins-pane-title-name">Bloc opératoire</div><div class="soins-pane-title-meta">3 interventions · 1 en cours</div></div>
          </div>
          <button class="btn btn-secondary btn-sm"><i data-lucide="plus" style="width:11px;height:11px;"></i> Programmer</button>
        </div>
        <div class="bloc-cols">
          <div class="bloc-subcol">
            <div class="bloc-substatus"><i data-lucide="clipboard-list" style="width:11px;height:11px;"></i> Pré-op <span class="bloc-substatus-cnt">1</span></div>
            <div class="bloc-subcol-scroll">
              <div class="surg-card preop">
                <div class="card-top"><span class="surg-pet">🐇 Coco</span><span class="surg-room">Bloc 1</span></div>
                <div class="surg-motif">Stérilisation</div>
                <div class="surg-meta"><span class="surg-meta-item"><i data-lucide="user" style="width:11px;height:11px;"></i>Dr. Lambert</span></div>
                <div class="surg-checklist">
                  <div class="surg-check done"><div class="surg-check-box"><svg width="8" height="8" viewBox="0 0 10 10"><path d="M2 5l2.5 2.5L8 2.5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg></div> À jeun depuis 22:00</div>
                  <div class="surg-check done"><div class="surg-check-box"><svg width="8" height="8" viewBox="0 0 10 10"><path d="M2 5l2.5 2.5L8 2.5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg></div> Prise de sang OK</div>
                  <div class="surg-check done"><div class="surg-check-box"><svg width="8" height="8" viewBox="0 0 10 10"><path d="M2 5l2.5 2.5L8 2.5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg></div> Consentement signé</div>
                  <div class="surg-check"><div class="surg-check-box"></div> Vérification du matériel</div>
                </div>
              </div>
            </div>
          </div>
          <div class="bloc-subcol">
            <div class="bloc-substatus"><i data-lucide="zap" style="width:11px;height:11px;"></i> Per-op <span class="bloc-substatus-cnt">1</span></div>
            <div class="bloc-subcol-scroll">
              <div class="surg-card perop">
                <div class="card-top"><span class="surg-pet">🐕 Bella</span><span class="surg-room">Bloc 2</span></div>
                <div class="surg-motif">Ostéosynthèse fémur</div>
                <div class="surg-meta"><span class="surg-meta-item"><i data-lucide="user" style="width:11px;height:11px;"></i>Dr. Rousseau</span></div>
                <div class="surg-progress">
                  <div class="surg-bar"><div class="surg-bar-fill live" style="width:21%;"></div></div>
                  <div class="sla-meta"><span>19 min écoulées</span><span>71 min restantes</span></div>
                </div>
              </div>
            </div>
          </div>
          <div class="bloc-subcol">
            <div class="bloc-substatus"><i data-lucide="moon" style="width:11px;height:11px;"></i> Réveil <span class="bloc-substatus-cnt">1</span></div>
            <div class="bloc-subcol-scroll">
              <div class="surg-card reveil">
                <div class="card-top"><span class="surg-pet">🐈 Felix</span><span class="surg-room">Réveil 1</span></div>
                <div class="surg-motif">Castration</div>
                <div class="surg-meta">
                  <div class="surg-meta-item"><i data-lucide="thermometer" style="width:11px;height:11px;"></i>T° 38.4 · FC 142</div>
                  <div class="surg-meta-item"><i data-lucide="clock" style="width:11px;height:11px;"></i>35 min</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {# RIGHT: Hospitalisation #}
      <div class="soins-pane">
        <div class="soins-pane-head">
          <div class="soins-pane-title">
            <div class="soins-pane-icon hospi"><i data-lucide="bed-double" style="width:14px;height:14px;"></i></div>
            <div><div class="soins-pane-title-name">Hospitalisation</div><div class="soins-pane-title-meta">4 patients · 4 cages libres</div></div>
          </div>
          <button class="btn btn-secondary btn-sm"><i data-lucide="plus" style="width:11px;height:11px;"></i> Hospitaliser</button>
        </div>
        <div class="hospi-list">
          <div class="hospi-row critique">
            <div class="hospi-head"><span class="hospi-cage">C-01</span><span class="hospi-pet">🐕 Gaia <span class="hospi-day">J+1</span></span><span class="hospi-status critique">critique</span></div>
            <div class="hospi-motif">Post-urgence · Convulsions traitées</div>
            <div class="hospi-vet">Dr. Martin</div>
            <div class="hospi-soins">
              <div class="hospi-soin"><div class="hospi-soin-label">Dernier soin</div><div class="hospi-soin-value hospi-soin-done">✓ 08:45</div><div class="hospi-soin-act">anticonvulsivants</div></div>
              <div class="hospi-soin"><div class="hospi-soin-label">Prochain soin</div><div class="hospi-soin-value imminent">10:00</div><div class="hospi-soin-act">bilan neuro + ECG</div></div>
            </div>
          </div>
          <div class="hospi-row surveillance">
            <div class="hospi-head"><span class="hospi-cage">C-04</span><span class="hospi-pet">🐈 Tigrou <span class="hospi-day">J+2</span></span><span class="hospi-status surveillance">surveillance</span></div>
            <div class="hospi-motif">Post-op rein gauche</div>
            <div class="hospi-vet">Dr. Lambert</div>
            <div class="hospi-soins">
              <div class="hospi-soin"><div class="hospi-soin-label">Dernier soin</div><div class="hospi-soin-value hospi-soin-done">✓ 09:30</div><div class="hospi-soin-act">perfusion</div></div>
              <div class="hospi-soin"><div class="hospi-soin-label">Prochain soin</div><div class="hospi-soin-value imminent">11:00</div><div class="hospi-soin-act">perfusion + bilan rénal</div></div>
            </div>
          </div>
          <div class="hospi-row stable">
            <div class="hospi-head"><span class="hospi-cage">C-07</span><span class="hospi-pet">🐕 Max <span class="hospi-day">J+3</span></span><span class="hospi-status stable">stable</span></div>
            <div class="hospi-motif">Fracture patte · immobilisation</div>
            <div class="hospi-vet">Dr. Rousseau</div>
            <div class="hospi-soins">
              <div class="hospi-soin"><div class="hospi-soin-label">Dernier soin</div><div class="hospi-soin-value hospi-soin-done">✓ 08:00</div><div class="hospi-soin-act">analgésiques</div></div>
              <div class="hospi-soin"><div class="hospi-soin-label">Prochain soin</div><div class="hospi-soin-value soon">14:00</div><div class="hospi-soin-act">analgésiques + kiné</div></div>
            </div>
          </div>
          <div class="hospi-row stable">
            <div class="hospi-head"><span class="hospi-cage">C-09</span><span class="hospi-pet">🐈 Nala <span class="hospi-day">J+1</span></span><span class="hospi-status stable">stable</span></div>
            <div class="hospi-motif">Pyomètre post-op</div>
            <div class="hospi-vet">Dr. Dupont</div>
            <div class="hospi-soins">
              <div class="hospi-soin"><div class="hospi-soin-label">Dernier soin</div><div class="hospi-soin-value hospi-soin-done">✓ 09:00</div><div class="hospi-soin-act">antibiotiques</div></div>
              <div class="hospi-soin"><div class="hospi-soin-label">Prochain soin</div><div class="hospi-soin-value">16:00</div><div class="hospi-soin-act">antibiotiques</div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>{# /content-soins #}

  {# ── Section 7: Detail Slide ── #}
  <div class="detail-slide" id="detail-slide">
    <div class="detail-head">
      <p class="detail-head-title" id="slide-title">Détail patient</p>
      <button class="btn-modal-close" onclick="closeDetailSlide()">
        <i data-lucide="x" style="width:12px;height:12px;"></i>
      </button>
    </div>
    <div class="detail-scroll" id="slide-content">
      <div style="padding:var(--space-4);color:var(--text-subtle);font-size:var(--text-sm);">Sélectionnez un patient pour voir son détail.</div>
    </div>
  </div>

  {# FABs (mobile) #}
  <div class="fab-group">
    <button class="fab fab-danger"
            data-action="waiting-room#openModal"
            data-waiting-room-modal-id-param="modal-urgence">
      <i data-lucide="alert-triangle" class="wr-icon-md"></i> Urgence
    </button>
    <button class="fab fab-primary"
            data-action="waiting-room#openModal"
            data-waiting-room-modal-id-param="modal-checkin">
      <i data-lucide="plus" class="wr-icon-md"></i> Check-in patient
    </button>
  </div>

  {# ══════════════════════════════════════════════════════════════════ #}
  {#  MODALS                                                           #}
  {# ══════════════════════════════════════════════════════════════════ #}

  {# ── [UI-2] Modal Check-in ── #}
  <div class="modal-overlay hidden" id="modal-checkin"
       data-action="click->waiting-room#closeOnOverlayClick">
    <div class="wr-modal-box" style="width:600px;max-width:calc(100vw - 24px);">
      <div class="wr-modal-head">
        <p class="wr-modal-title">Check-in patient</p>
        <button class="btn-modal-close"
                data-action="waiting-room#closeModal"
                data-waiting-room-modal-id-param="modal-checkin">
          <i data-lucide="x" class="wr-icon-xs"></i>
        </button>
      </div>

      <form method="post" action="{{ path('clinic_admission_walkin') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('waiting_room_action') }}">
        <input type="hidden" name="arrivalMode" value="STANDARD">
        <input type="hidden" name="animalId" id="checkin-animal-id">
        <input type="hidden" name="animalName" id="checkin-animal-name">
        <div class="wr-modal-body">
          {# Recherche live — global-search controller en mode pick #}
          <div class="form-row"
               data-controller="global-search"
               data-global-search-url-value="{{ path('clinic_search') }}"
               data-global-search-mode-value="pick"
               data-global-search-picker-id-value="walkin-checkin"
               data-global-search-type-value="animal">
            <label class="form-label-wr">Rechercher — nom, puce, téléphone propriétaire</label>
            <input type="search"
                   class="form-input-wr"
                   placeholder="Nom animal, propriétaire, puce, téléphone…"
                   autocomplete="off"
                   data-global-search-target="input"
                   data-action="input->global-search#search">
            <div class="wr-search-results" data-global-search-target="results"></div>
            <div class="sr-only" aria-live="polite" data-global-search-target="liveRegion"></div>
          </div>
          <div class="wr-form-grid-2">
            <div class="form-row">
              <label class="form-label-wr">Animal / Propriétaire</label>
              <input class="form-input-wr" name="foundAnimalDescription" id="checkin-label"
                     placeholder="Ex : Milo (Félin) — James Park">
            </div>
            <div class="form-row">
              <label class="form-label-wr">Motif de visite</label>
              <input class="form-input-wr" name="triageNotes" placeholder="Décrivez brièvement…">
            </div>
          </div>
        </div>
        <div class="wr-modal-foot">
          <button type="button" class="btn-wr btn-secondary"
                  data-action="waiting-room#closeModal"
                  data-waiting-room-modal-id-param="modal-checkin">Annuler</button>
          <button type="submit" class="btn-wr btn-primary">
            <i data-lucide="check" class="wr-icon-xs"></i> Valider l'arrivée
          </button>
        </div>
      </form>
    </div>
  </div>

  {# ── [UI-1] Modal Urgence — wizard 2 étapes ── #}
  <div class="modal-overlay hidden" id="modal-urgence"
       data-action="click->waiting-room#closeOnOverlayClick">
    <div class="wr-modal-box" style="width:580px;max-width:calc(100vw - 24px);">

      {# Head #}
      <div class="wr-modal-head wr-modal-head--urgence">
        <div class="wr-modal-urgence-title">
          <div class="wr-modal-urgence-icon">
            <i data-lucide="alert-triangle" class="wr-icon-sm wr-icon--white"></i>
          </div>
          <p class="wr-modal-urgence-text" id="urg-title">Urgence — Identification</p>
        </div>
        <button class="btn-modal-close wr-modal-close--urgence"
                onclick="urgClose()">
          <i data-lucide="x" class="wr-icon-xs wr-icon--red"></i>
        </button>
      </div>

      {# Stepper #}
      <div style="display:flex;align-items:center;gap:var(--space-2);padding:var(--space-3) var(--space-4);border-bottom:1px solid var(--border-light);background:var(--surface-subtle);">
        <div id="urg-dot-1" style="width:20px;height:20px;border-radius:50%;background:#dc2626;color:#fff;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-shrink:0;">1</div>
        <span style="font-size:var(--text-xs);color:var(--text-subtle);">Identification</span>
        <div style="flex:1;height:1px;background:var(--border-medium);"></div>
        <div id="urg-dot-2" style="width:20px;height:20px;border-radius:50%;background:var(--border-medium);color:var(--text-subtle);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-shrink:0;">2</div>
        <span style="font-size:var(--text-xs);color:var(--text-subtle);">Admission</span>
      </div>

      {# ── STEP 1 ── #}
      {# Champ caché partagé pour transporter l'animalId vers les formulaires step 2 #}
      <input type="hidden" id="urg-animal-id">

      <div id="urg-step-1">
        <div class="wr-modal-body">
          <div class="wr-urgence-alert">
            <i data-lucide="zap" class="wr-urgence-alert-icon"></i>
            Ce patient sera placé immédiatement en tête de file.
          </div>

          {# Recherche live unifiée (puce ou nom/propriétaire) #}
          <div class="form-row"
               data-controller="global-search"
               data-global-search-url-value="{{ path('clinic_search') }}"
               data-global-search-mode-value="pick"
               data-global-search-picker-id-value="walkin-urgence"
               data-global-search-type-value="animal">
            <label class="form-label-wr">Rechercher — puce, nom animal, propriétaire, téléphone</label>
            <input type="search"
                   class="form-input-wr"
                   id="urg-search"
                   placeholder="250269… ou nom animal, propriétaire, téléphone…"
                   autocomplete="off"
                   autofocus
                   data-global-search-target="input"
                   data-action="input->global-search#search input->global-search#onTyped">
            <div class="wr-search-results" data-global-search-target="results"></div>
            <div class="sr-only" aria-live="polite" data-global-search-target="liveRegion"></div>
          </div>

          {# Animal sélectionné — affiché après pick #}
          <div id="urg-selected-animal" style="display:none;padding:var(--space-2) var(--space-3);background:#eff6ff;border:1px solid #bfdbfe;border-radius:var(--radius-md);font-size:var(--text-sm);color:#1d4ed8;margin-bottom:var(--space-3);">
            <i data-lucide="check-circle" style="width:13px;height:13px;display:inline-block;vertical-align:middle;margin-right:4px;"></i>
            <span id="urg-selected-label"></span>
          </div>

          {# Toggle non identifié #}
          <div id="urg-toggle-nonid"
               style="display:flex;align-items:center;gap:var(--space-2);padding:var(--space-2) var(--space-3);border-radius:var(--radius-md);cursor:pointer;border:2px solid var(--border-medium);transition:.15s;"
               onclick="urgToggleNonId()">
            <div id="urg-checkbox-box"
                 style="width:18px;height:18px;border-radius:4px;border:2px solid #d97706;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg id="urg-checkbox-check" width="10" height="10" fill="none" viewBox="0 0 10 10" style="display:none;">
                <path d="M2 5l2.5 2.5L8 2.5" stroke="#d97706" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <p style="font-size:var(--text-base);font-weight:var(--weight-medium);color:var(--text-primary);">Animal non identifié</p>
              <p style="font-size:var(--text-sm);color:var(--text-muted);">Urgence vitale ou errant — régularisation après stabilisation</p>
            </div>
          </div>
        </div>
        <div class="wr-modal-foot">
          <button type="button" class="btn-wr btn-secondary" onclick="urgClose()">Annuler</button>
          <button type="button" class="btn-wr btn-danger" id="urg-next-btn"
                  onclick="urgGoStep2()" disabled style="opacity:.5;cursor:not-allowed;">
            Continuer <i data-lucide="arrow-right" class="wr-icon-xs"></i>
          </button>
        </div>
      </div>

      {# ── STEP 2 ── #}
      <div id="urg-step-2" style="display:none;">

        {# Bandeau mode #}
        <div id="urg-mode-banner"
             style="margin:var(--space-3) var(--space-4) 0;padding:var(--space-2) var(--space-3);border-radius:var(--radius-md);font-size:var(--text-sm);font-weight:var(--weight-medium);display:flex;align-items:center;gap:var(--space-2);">
        </div>

        {# 2A — dossier existant (animal identifié via live search) #}
        <div id="urg-2a" style="display:none;">
          <form method="post" action="{{ path('clinic_admission_walkin') }}" id="urg-2a-form">
            <input type="hidden" name="_token" value="{{ csrf_token('waiting_room_action') }}">
            <input type="hidden" name="arrivalMode" value="EMERGENCY">
            <input type="hidden" name="priority" value="2">
            <input type="hidden" name="animalId" id="urg-2a-animal-id">
            <input type="hidden" name="animalName" id="urg-2a-animal-name">
            <input type="hidden" name="foundAnimalDescription" id="urg-2a-label">
            <div class="wr-modal-body">
              <div class="form-row">
                <label class="form-label-wr">Motif d'urgence *</label>
                <input class="form-input-wr" name="triageNotes" required placeholder="Symptômes observés…">
              </div>
            </div>
            <div class="wr-modal-foot">
              <button type="button" class="btn-wr btn-secondary" onclick="urgGoStep1()">
                <i data-lucide="arrow-left" class="wr-icon-xs"></i> Retour
              </button>
              <button type="submit" class="btn-wr btn-danger">
                <i data-lucide="alert-triangle" class="wr-icon-xs"></i> Enregistrer l'urgence
              </button>
            </div>
          </form>
        </div>

        {# 2B — nouveau dossier (non trouvé en base) #}
        <div id="urg-2b" style="display:none;">
          <form method="post" action="{{ path('clinic_admission_walkin') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('waiting_room_action') }}">
            <input type="hidden" name="arrivalMode" value="EMERGENCY">
            <input type="hidden" name="priority" value="2">
            <div class="wr-modal-body">
              <div class="wr-form-grid-2">
                <div class="form-row">
                  <label class="form-label-wr">Animal *</label>
                  <input class="form-input-wr" name="foundAnimalDescription" required placeholder="Nom de l'animal">
                </div>
                <div class="form-row">
                  <label class="form-label-wr">Motif d'urgence *</label>
                  <input class="form-input-wr" name="triageNotes" required placeholder="Symptômes…">
                </div>
              </div>
            </div>
            <div class="wr-modal-foot">
              <button type="button" class="btn-wr btn-secondary" onclick="urgGoStep1()">
                <i data-lucide="arrow-left" class="wr-icon-xs"></i> Retour
              </button>
              <button type="submit" class="btn-wr btn-danger">
                <i data-lucide="alert-triangle" class="wr-icon-xs"></i> Enregistrer l'urgence
              </button>
            </div>
          </form>
        </div>

        {# 2C — non identifié #}
        <div id="urg-2c" style="display:none;">
          <form method="post" action="{{ path('clinic_admission_emergency') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('admission_emergency') }}">
            <input type="hidden" name="triage_level" value="emergency">
            <div class="wr-modal-body">
              <div class="wr-form-grid-2">
                <div class="form-row">
                  <label class="form-label-wr">Espèce présumée *</label>
                  <select name="observed_species" class="form-input-wr" required>
                    <option value="">— Sélectionner —</option>
                    <option>Canin</option><option>Félin</option><option>Lapin</option>
                    <option>NAC</option><option>Oiseau</option>
                  </select>
                </div>
                <div class="form-row">
                  <label class="form-label-wr">Canal d'entrée *</label>
                  <select name="intake_channel" class="form-input-wr">
                    <option value="emergency_by_third_party">Particulier tiers</option>
                    <option value="emergency_by_authority">Police / Pompiers</option>
                    <option value="emergency_by_association">Association</option>
                    <option value="emergency_by_municipality">Mairie / Fourrière</option>
                  </select>
                </div>
              </div>
              <div class="form-row">
                <label class="form-label-wr">État clinique *</label>
                <input class="form-input-wr" name="triage_notes" required
                       placeholder="Ex : inconscient, plaie ouverte, dyspnée…">
              </div>
              <div class="wr-form-grid-2">
                <div class="form-row">
                  <label class="form-label-wr">Présentateur — Nom</label>
                  <input class="form-input-wr" name="presenter_name" placeholder="Optionnel">
                </div>
                <div class="form-row">
                  <label class="form-label-wr">Présentateur — Tél.</label>
                  <input class="form-input-wr" name="presenter_phone" placeholder="+33 6 …">
                </div>
              </div>
              <div class="wr-form-grid-2">
                <div class="form-row">
                  <label class="form-label-wr">Description physique</label>
                  <input class="form-input-wr" name="provisional_label"
                         placeholder="Ex : chat tigré, ~3 kg, yeux verts">
                </div>
                <div class="form-row">
                  <label class="form-label-wr">Lieu de découverte</label>
                  <input class="form-input-wr" name="observed_color"
                         placeholder="Ex : rue St-Denis, Paris 1er">
                </div>
              </div>
            </div>
            <div class="wr-modal-foot">
              <button type="button" class="btn-wr btn-secondary" onclick="urgGoStep1()">
                <i data-lucide="arrow-left" class="wr-icon-xs"></i> Retour
              </button>
              <button type="submit" class="btn-wr btn-danger">
                <i data-lucide="alert-triangle" class="wr-icon-xs"></i> Enregistrer l'urgence
              </button>
            </div>
          </form>
        </div>

      </div>{# /urg-step-2 #}
    </div>
  </div>

</div>{# /waiting-room controller #}
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    /* ── Queue filter (kept for compatibility) ── */
    function filterQueue(btn) {
      const filter = btn.dataset.filter;
      btn.closest('.queue-filter').querySelectorAll('.qf-tab')
        .forEach(t => t.classList.remove('active'));
      btn.classList.add('active');

      const cards = document.querySelectorAll('#queue-list .qcard');
      let visible = 0;
      cards.forEach(function (card) {
        const triage   = card.dataset.triage ?? '';
        const location = card.dataset.location ?? '';
        const isUrgent  = triage === 'emergency' || triage === 'vital_emergency';
        const isConsult = location === 'in_consultation_room';

        let show = false;
        if (filter === 'all')               show = true;
        else if (filter === 'urgence')      show = isUrgent;
        else if (filter === 'attente')      show = !isConsult;
        else if (filter === 'consultation') show = isConsult;

        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      const counter = document.getElementById('queue-count');
      if (counter) counter.textContent = visible + ' patient' + (visible > 1 ? 's' : '');
    }

    /* ── [UI-5] Detail panel (kept for compatibility) ── */
    const CHANNEL_LABELS = {
      appointment_booked: 'RDV', walk_in: 'Sans RDV',
      emergency: 'Urgence', emergency_by_third_party: 'Urgence tiers',
      emergency_by_authority: 'Urgence autorités',
      emergency_by_association: 'Urgence asso.',
      emergency_by_municipality: 'Urgence mairie',
      transfer_from_other_clinic: 'Transfert',
    };

    function showDetail(card) {
      document.querySelectorAll('#queue-list .qcard').forEach(c => c.classList.remove('active'));
      card.classList.add('active');

      const isUnidentified = card.dataset.unidentified === 'true';
      const label    = card.querySelector('.qcard-name')?.textContent?.trim() ?? '—';
      const waitEl   = card.querySelector('.wait-big');
      const waitText = waitEl ? waitEl.textContent.trim() + ' ' + (card.querySelector('.wait-label')?.textContent?.trim() ?? '') : '—';
      const notesEl  = card.querySelector('.qcard-motif');

      document.getElementById('detail-empty').style.display = 'none';
      document.getElementById('detail-content').style.display = '';

      const avatarEl = document.getElementById('detail-avatar');
      if (isUnidentified) {
        avatarEl.style.background = '#fff7ed';
        avatarEl.style.color      = '#d97706';
        avatarEl.style.borderRadius = 'var(--radius-md)';
        avatarEl.innerHTML = '<svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" d="M12 16v-4M12 8h.01"/></svg>';
      } else {
        avatarEl.style.background = 'var(--brand-50)';
        avatarEl.style.color      = 'var(--brand-600)';
        avatarEl.style.borderRadius = 'var(--radius-full)';
        avatarEl.innerHTML = label.slice(0, 2).toUpperCase();
      }

      document.getElementById('detail-name').textContent = label;
      document.getElementById('detail-wait').textContent = waitText;

      const notesDiv = document.getElementById('detail-notes');
      if (notesEl && notesEl.textContent.trim()) {
        notesDiv.textContent = notesEl.textContent.trim();
        notesDiv.style.display = '';
      } else {
        notesDiv.style.display = 'none';
      }

      document.getElementById('detail-identification').style.display = isUnidentified ? '' : 'none';

      if (window.lucide) window.lucide.createIcons();
    }

    /* ── Detail slide ── */
    function closeDetailSlide() {
      document.getElementById('detail-slide').classList.remove('open');
    }

    /* ── Urgence alert (MOCK) ── */
    function affecterUrgence() {
      document.getElementById('urg-alert').style.display = 'none';
    }

    /* ── [UI-1] Urgence wizard ── */
    var urgMode = null;
    var urgNonIdChecked = false;

    function urgClose() {
      document.getElementById('modal-urgence').classList.add('hidden');
      urgReset();
    }
    function urgReset() {
      urgMode = null; urgNonIdChecked = false;
      document.getElementById('urg-step-1').style.display = '';
      document.getElementById('urg-step-2').style.display = 'none';
      document.getElementById('urg-dot-1').style.background = '#dc2626';
      document.getElementById('urg-dot-1').style.color = '#fff';
      document.getElementById('urg-dot-2').style.background = 'var(--border-medium)';
      document.getElementById('urg-dot-2').style.color = 'var(--text-subtle)';
      var s = document.getElementById('urg-search'); if (s) s.value = '';
      var results = document.querySelector('[data-global-search-picker-id-value="walkin-urgence"] [data-global-search-target="results"]');
      if (results) results.innerHTML = '';
      document.getElementById('urg-toggle-nonid').style.borderColor = 'var(--border-medium)';
      document.getElementById('urg-checkbox-check').style.display = 'none';
      document.getElementById('urg-title').textContent = 'Urgence — Identification';
      var sel = document.getElementById('urg-selected-animal'); if (sel) sel.style.display = 'none';
      var aid = document.getElementById('urg-animal-id'); if (aid) aid.value = '';
      urgUpdateBtn();
    }
    function urgUpdateBtn() {
      var btn = document.getElementById('urg-next-btn');
      var ok  = urgMode !== null;
      btn.disabled = !ok;
      btn.style.opacity = ok ? '1' : '.5';
      btn.style.cursor  = ok ? 'pointer' : 'not-allowed';
    }
    function urgToggleNonId() {
      urgNonIdChecked = !urgNonIdChecked;
      var el = document.getElementById('urg-toggle-nonid');
      el.style.borderColor  = urgNonIdChecked ? '#d97706' : 'var(--border-medium)';
      el.style.background   = urgNonIdChecked ? '#fff7ed' : '';
      document.getElementById('urg-checkbox-check').style.display = urgNonIdChecked ? '' : 'none';
      urgMode = urgNonIdChecked ? 'non-identifie' : null;
      urgUpdateBtn();
    }
    /* Called by waiting_room_controller when a pick event arrives for walkin-urgence */
    function urgSetFromPick(animalId, description) {
      urgMode = 'existant'; urgNonIdChecked = false;
      document.getElementById('urg-toggle-nonid').style.borderColor = 'var(--border-medium)';
      document.getElementById('urg-toggle-nonid').style.background = '';
      document.getElementById('urg-checkbox-check').style.display = 'none';
      var aid = document.getElementById('urg-animal-id'); if (aid) aid.value = animalId;
      var label = document.getElementById('urg-selected-label'); if (label) label.textContent = description;
      var sel = document.getElementById('urg-selected-animal'); if (sel) sel.style.display = '';
      urgUpdateBtn();
    }
    /* Called by global-search onTyped action (any typing without pick = nouveau dossier) */
    function urgOnTyped(val) {
      if (val.length >= 2 && urgMode !== 'existant') {
        urgMode = 'nouveau'; urgUpdateBtn();
      } else if (val.length < 2 && urgMode === 'nouveau') {
        urgMode = null; urgUpdateBtn();
      }
    }

    function urgGoStep2() {
      if (!urgMode) return;
      document.getElementById('urg-step-1').style.display = 'none';
      document.getElementById('urg-step-2').style.display = '';
      document.getElementById('urg-dot-1').style.background = '#16a34a';
      document.getElementById('urg-dot-2').style.background = '#dc2626';
      document.getElementById('urg-dot-2').style.color = '#fff';

      ['urg-2a','urg-2b','urg-2c'].forEach(id => document.getElementById(id).style.display = 'none');
      var subId = urgMode === 'existant' ? 'urg-2a' : urgMode === 'non-identifie' ? 'urg-2c' : 'urg-2b';
      document.getElementById(subId).style.display = '';

      var banner = document.getElementById('urg-mode-banner');
      if (urgMode === 'existant') {
        banner.style.cssText = 'background:#eff6ff;border:1px solid #bfdbfe;color:#1d4ed8;margin:var(--space-3) var(--space-4) 0;padding:var(--space-2) var(--space-3);border-radius:var(--radius-md);font-size:var(--text-sm);font-weight:500;display:flex;align-items:center;gap:var(--space-2);';
        banner.innerHTML = '<svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg> Rattachement à dossier existant';
        document.getElementById('urg-title').textContent = 'Urgence — Admission';
      } else if (urgMode === 'non-identifie') {
        banner.style.cssText = 'background:#fff7ed;border:1px solid #fed7aa;color:#d97706;margin:var(--space-3) var(--space-4) 0;padding:var(--space-2) var(--space-3);border-radius:var(--radius-md);font-size:var(--text-sm);font-weight:500;display:flex;align-items:center;gap:var(--space-2);';
        banner.innerHTML = '<svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" d="M12 16v-4M12 8h.01"/></svg> <strong>Animal non identifié</strong> — régularisation différée';
        document.getElementById('urg-title').textContent = 'Urgence — Animal non identifié';
      } else {
        banner.style.cssText = 'background:#f5f3ff;border:1px solid #ddd6fe;color:#6d28d9;margin:var(--space-3) var(--space-4) 0;padding:var(--space-2) var(--space-3);border-radius:var(--radius-md);font-size:var(--text-sm);font-weight:500;display:flex;align-items:center;gap:var(--space-2);';
        banner.innerHTML = '<svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg> <strong>Création nouveau dossier</strong>';
        document.getElementById('urg-title').textContent = 'Urgence — Nouveau dossier';
      }
      if (window.lucide) window.lucide.createIcons();
    }

    function urgGoStep1() {
      document.getElementById('urg-step-2').style.display = 'none';
      document.getElementById('urg-step-1').style.display = '';
      document.getElementById('urg-dot-1').style.background = '#dc2626';
      document.getElementById('urg-dot-1').style.color = '#fff';
      document.getElementById('urg-dot-2').style.background = 'var(--border-medium)';
      document.getElementById('urg-dot-2').style.color = 'var(--text-subtle)';
      document.getElementById('urg-title').textContent = 'Urgence — Identification';
    }
  </script>
{% endblock %}
