{#
 # Kiveto — templates/clinic/scheduling/_agenda.html.twig
 # ──────────────────────────────────────────────────────
 # Day agenda panel using Kiveto widget pattern.
 #
 # Variables (inherited from dashboard):
 #   appointments   array               List of appointment DTOs
 #   selectedDate   DateTimeImmutable    Currently viewed date
 #}

<div class="widget">
    {# Widget header with date #}
    <div class="w-head">
        <span class="w-title">Agenda du {{ selectedDate|date('d/m/Y') }}</span>
        <span style="font-size: var(--text-sm); color: var(--text-subtle);">
            {{ appointments|length }} rendez-vous
        </span>
    </div>

    {# Date navigator #}
    <div style="display: flex; align-items: center; justify-content: space-between; padding: var(--space-2) var(--space-4); border-bottom: 1px solid var(--border-light);">
        <a href="{{ path('clinic_scheduling_agenda', {date: selectedDate|date_modify('-1 day')|date('Y-m-d')}) }}" class="btn btn-secondary btn-xs">
            <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
            Précédent
        </a>
        <a href="{{ path('clinic_scheduling_agenda') }}" class="btn btn-secondary btn-xs">Aujourd'hui</a>
        <a href="{{ path('clinic_scheduling_agenda', {date: selectedDate|date_modify('+1 day')|date('Y-m-d')}) }}" class="btn btn-secondary btn-xs">
            Suivant
            <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
    </div>

    {# Appointments list #}
    {% if appointments is empty %}
        <div class="w-body" style="text-align: center; padding: var(--space-6) var(--space-4);">
            <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="color: var(--text-subtle); margin: 0 auto var(--space-2);">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            <p style="font-size: var(--text-md); color: var(--text-muted); margin-bottom: var(--space-3);">Aucun rendez-vous prévu ce jour</p>
            <button
                class="btn btn-primary btn-sm"
                type="button"
                data-action="click->modal#open"
                data-modal-id-param="modalNewAppointment"
            >
                <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
                Planifier un RDV
            </button>
        </div>
    {% else %}
        <div class="w-body" style="display: flex; flex-direction: column; gap: var(--space-2);">
            {% for appointment in appointments %}
                {# Determine border colour by status #}
                {% set border_color = 'var(--brand-400)' %}
                {% if appointment.status == 'COMPLETED' %}
                    {% set border_color = 'var(--color-success-text)' %}
                {% elseif appointment.status == 'CANCELLED' %}
                    {% set border_color = 'var(--color-danger-text)' %}
                {% elseif appointment.status == 'NO_SHOW' %}
                    {% set border_color = '#f59e0b' %}
                {% endif %}

                <div style="display: flex; align-items: stretch; border: 1px solid var(--border-light); border-left: 3px solid {{ border_color }}; border-radius: var(--radius-md); padding: var(--space-3); gap: var(--space-3); transition: background .12s;{% if appointment.status == 'CANCELLED' %} opacity: .5;{% endif %}"
                     onmouseenter="this.style.background='var(--surface-subtle)'" onmouseleave="this.style.background='transparent'">

                    {# Time column #}
                    <div style="flex-shrink: 0; text-align: center; min-width: 50px;">
                        <div style="font-size: var(--text-lg); font-weight: var(--weight-medium); color: var(--brand-600); line-height: 1;">
                            {{ appointment.startsAtUtc|date('H:i') }}
                        </div>
                        <div style="font-size: var(--text-xs); color: var(--text-subtle); margin-top: 2px;">
                            {{ appointment.durationMinutes }} min
                        </div>
                    </div>

                    {# Main info #}
                    <div style="flex: 1; min-width: 0;">
                        {# Practitioner #}
                        {% if appointment.practitionerUserId %}
                            <div style="font-size: var(--text-sm); color: var(--text-muted); margin-bottom: 2px;">
                                Dr. {{ appointment.practitionerUserId|slice(0, 8) }}...
                            </div>
                        {% endif %}

                        {# Owner #}
                        {% if appointment.ownerId %}
                            <div style="font-size: var(--text-md); font-weight: var(--weight-medium); color: var(--text-primary);">
                                Proprio {{ appointment.ownerId|slice(0, 8) }}...
                            </div>
                        {% endif %}

                        {# Reason badge #}
                        {% if appointment.reason %}
                            <div style="margin-top: var(--space-1);">
                                <span class="badge" style="background: var(--surface-subtle); color: var(--text-muted); border: 1px solid var(--border-medium);">
                                    {{ appointment.reason }}
                                </span>
                            </div>
                        {% endif %}

                        {# Notes #}
                        {% if appointment.notes %}
                            <div style="font-size: var(--text-sm); color: var(--text-subtle); margin-top: var(--space-1); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                {{ appointment.notes }}
                            </div>
                        {% endif %}
                    </div>

                    {# Right side: status + actions #}
                    <div style="flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-1);">
                        {# Status badge #}
                        {% if appointment.status == 'PLANNED' %}
                            <span class="badge" style="background: var(--color-info-bg); color: var(--color-info-text);">Planifié</span>
                        {% elseif appointment.status == 'COMPLETED' %}
                            <span class="badge" style="background: var(--color-success-bg); color: var(--color-success-text);">Terminé</span>
                        {% elseif appointment.status == 'CANCELLED' %}
                            <span class="badge" style="background: var(--color-danger-bg); color: var(--color-danger-text);">Annulé</span>
                        {% elseif appointment.status == 'NO_SHOW' %}
                            <span class="badge" style="background: var(--color-warning-bg); color: var(--color-warning-text);">Absent</span>
                        {% endif %}

                        {# Action buttons for PLANNED appointments #}
                        {% if appointment.status == 'PLANNED' %}
                            <form method="post" action="{{ path('clinic_scheduling_appointment_checkin', {appointmentId: appointment.id}) }}" style="margin-top: auto;">
                                <button type="submit" class="btn btn-green btn-xs">Check-in</button>
                            </form>
                            <form method="post" action="{{ path('clinic_consultation_start_from_appointment', {appointmentId: appointment.id}) }}">
                                <button type="submit" class="btn btn-primary btn-xs">Consultation</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
