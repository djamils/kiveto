{#
 # Kiveto — templates/clinic/scheduling/waiting_room.html.twig
 # ────────────────────────────────────────────────────────────
 # Waiting room — real-time queue management.
 # Source: vetos-salle-attente.html mockup
 #
 # Variables:
 #   waitingRoomEntries  array    List of waiting-room entry DTOs
 #   currentClinicId     string   Active clinic UUID
 #   currentClinicName   string   Active clinic display name
 #}
{% extends 'clinic/base.html.twig' %}

{% block show_topbar %}false{% endblock %}
{% block page_title %}Salle d'attente{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lucide-static@latest/font/lucide.min.css"/>
<link rel="stylesheet" href="{{ asset('styles/pages/scheduling-waiting-room.css') }}"/>
<script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
{% endblock %}

{% block content %}
<!-- Topbar -->
<div class="wr-topbar">
  <div>
    <p style="font-size:var(--text-lg,16px);font-weight:var(--weight-medium,500);color:var(--text-primary,#0f172a);line-height:1.2;">Salle d'attente</p>
    <p style="font-size:var(--text-sm,13px);color:var(--text-subtle,#94a3b8);">Samedi 22 mars 2026</p>
  </div>
  <div class="wr-topbar-clock">
    <span class="clock-num" id="clock-h"></span><span class="clock-sep">:</span><span class="clock-num" id="clock-m"></span><span class="clock-sep" style="font-size:var(--text-md,14px);color:var(--slate-300,#cbd5e1);">:</span><span class="clock-sec" id="clock-s"></span>
  </div>
  <div class="wr-topbar-right">
    <button class="btn-wr btn-danger btn-xs" onclick="openModal('modal-urgence')"><i data-lucide="alert-triangle" style="width:11px;height:11px;"></i> Urgence</button>
    <button class="btn-wr btn-primary btn-xs" onclick="openModal('modal-checkin')"><i data-lucide="plus" style="width:11px;height:11px;"></i> Check-in patient</button>
  </div>
</div>

<!-- Status bar -->
<div class="status-bar">
  <div class="stat-block">
    <div class="stat-icon" style="background:#fff7ed;"><i data-lucide="clock" style="width:14px;height:14px;color:#d97706;"></i></div>
    <div><p class="stat-num" style="color:#d97706;">4</p><p class="stat-label">En attente</p></div>
  </div>
  <div class="stat-block">
    <div class="stat-icon" style="background:#eff6ff;"><i data-lucide="stethoscope" style="width:14px;height:14px;color:#2563eb;"></i></div>
    <div><p class="stat-num" style="color:#2563eb;">2</p><p class="stat-label">En consultation</p></div>
  </div>
  <div class="stat-block">
    <div class="stat-icon" style="background:#fef2f2;"><i data-lucide="alert-triangle" style="width:14px;height:14px;color:#dc2626;"></i></div>
    <div><p class="stat-num" style="color:#dc2626;">1</p><p class="stat-label">Urgences</p></div>
  </div>
  <div class="stat-block">
    <div class="stat-icon" style="background:#f0fdf4;"><i data-lucide="check-circle" style="width:14px;height:14px;color:#16a34a;"></i></div>
    <div><p class="stat-num" style="color:#059669;">7</p><p class="stat-label">Trait&eacute;s</p></div>
  </div>
  <div style="margin-left:auto;display:flex;align-items:center;gap:var(--space-1,4px);padding-left:var(--space-3,12px);">
    <span style="width:7px;height:7px;border-radius:50%;background:#16a34a;display:block;"></span>
    <span style="font-size:var(--text-sm,13px);color:#15803d;font-weight:var(--weight-medium,500);">Temps r&eacute;el</span>
  </div>
</div>

<!-- Desktop layout -->
<div class="page-body" id="page-body-desktop">
  <div class="queue-panel" id="queue-panel">
    <div class="queue-head">
      <span style="font-size:var(--text-base,14px);font-weight:var(--weight-medium,500);color:var(--text-primary,#0f172a);">File d'attente</span>
      <span style="font-size:var(--text-sm,13px);color:var(--text-subtle,#94a3b8);background:var(--surface-hover,#f1f5f9);padding:2px var(--space-2,8px);border-radius:20px;" id="queue-count">7 patients</span>
      <button class="btn-wr btn-secondary btn-xs" style="margin-left:auto;" onclick="openModal('modal-checkin')"><i data-lucide="plus" style="width:10px;height:10px;"></i> Check-in</button>
    </div>
    <div class="queue-filter">
      <button class="qf-tab active" data-f="all" onclick="setQFilter(this)">Tous</button>
      <button class="qf-tab urg" data-f="urgence" onclick="setQFilter(this)">Urgences</button>
      <button class="qf-tab" data-f="attente" onclick="setQFilter(this)">En attente</button>
      <button class="qf-tab" data-f="consultation" onclick="setQFilter(this)">Consultation</button>
    </div>
    <div class="queue-list" id="queue-list"></div>
  </div>

  <div class="control-panel" id="control-panel">
    <div class="control-scroll">
      <div class="urgence-banner"><i data-lucide="alert-triangle" style="width:14px;height:14px;flex-shrink:0;"></i><span>URGENCE &mdash; Gaia (Labrador) &middot; Convulsions &middot; Arriv&eacute;e 10h02</span><button class="btn-wr btn-xs" style="margin-left:auto;background:rgba(255,255,255,.2);color:#fff;border:1px solid rgba(255,255,255,.3);" onclick="toast('Prise en charge lanc\u00e9e','#dc2626')">Prendre en charge</button></div>
      <div id="patient-detail-wrap"></div>
      <div class="widget"><div class="wh"><span class="wt">V&eacute;t&eacute;rinaires de garde</span></div><div style="display:grid;grid-template-columns:1fr 1fr;" id="vets-list"></div></div>
      <div class="widget"><div class="wh"><span class="wt">Flux de la journ&eacute;e</span><span style="font-size:var(--text-sm,13px);color:var(--text-subtle,#94a3b8);">9h&ndash;18h</span></div><div class="wb" id="timeline-list"></div></div>
    </div>
  </div>

  <!-- Slide detail tablet -->
  <div class="detail-slide" id="detail-slide">
    <div class="detail-slide-head">
      <p style="font-size:var(--text-base,14px);font-weight:var(--weight-medium,500);color:var(--text-primary,#0f172a);" id="slide-title">D&eacute;tail patient</p>
      <button class="btn-modal-close" onclick="closeDetailSlide()"><i data-lucide="x" style="width:12px;height:12px;"></i></button>
    </div>
    <div class="detail-slide-scroll" id="slide-content"></div>
  </div>
</div>

<!-- Tablet portrait layout -->
<div class="page-body" id="page-body-tabs" style="display:none;flex-direction:column;">
  <div style="flex:1;overflow:hidden;position:relative;">
    <div class="tab-pane active" id="tab-queue">
      <div class="queue-head">
        <span style="font-size:var(--text-base,14px);font-weight:var(--weight-medium,500);">File d'attente</span>
        <span style="font-size:var(--text-sm,13px);color:var(--text-subtle,#94a3b8);background:var(--surface-hover,#f1f5f9);padding:2px var(--space-2,8px);border-radius:20px;" id="queue-count-tab">7 patients</span>
      </div>
      <div class="queue-filter">
        <button class="qf-tab active" data-f="all" onclick="setQFilterTab(this)">Tous</button>
        <button class="qf-tab urg" data-f="urgence" onclick="setQFilterTab(this)">Urgences</button>
        <button class="qf-tab" data-f="attente" onclick="setQFilterTab(this)">En attente</button>
        <button class="qf-tab" data-f="consultation" onclick="setQFilterTab(this)">Consultation</button>
      </div>
      <div class="queue-list" id="queue-list-tab"></div>
    </div>
    <div class="tab-pane" id="tab-rooms" style="overflow-y:auto;padding:var(--space-3,12px);">
      <div class="widget" style="margin-bottom:var(--space-3,12px);"><div class="wh"><span class="wt">V&eacute;t&eacute;rinaires de garde</span></div><div style="display:grid;grid-template-columns:1fr 1fr;" id="vets-list-tab"></div></div>
      <div class="widget"><div class="wh"><span class="wt">Flux de la journ&eacute;e</span><span style="font-size:var(--text-sm,13px);color:var(--text-subtle,#94a3b8);">9h&ndash;18h</span></div><div class="wb" id="timeline-list-tab"></div></div>
    </div>
  </div>
  <div class="bottom-tabs">
    <button class="bottom-tab active" id="btab-queue" onclick="switchTab('queue')"><i data-lucide="list" style="width:20px;height:20px;"></i><span class="bottom-tab-label">File d'attente</span></button>
    <button class="bottom-tab" id="btab-rooms" onclick="switchTab('rooms')"><i data-lucide="door-open" style="width:20px;height:20px;"></i><span class="bottom-tab-label">V&eacute;t&eacute;rinaires &amp; Flux</span></button>
  </div>
</div>

<!-- FABs tablet -->
<div class="fab-group" id="fab-group">
  <button class="fab fab-danger" onclick="openModal('modal-urgence')"><i data-lucide="alert-triangle" style="width:18px;height:18px;"></i> Urgence</button>
  <button class="fab fab-primary" onclick="openModal('modal-checkin')"><i data-lucide="plus" style="width:18px;height:18px;"></i> Check-in patient</button>
</div>

<!-- Bottom sheet portrait -->
<div id="bso" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.3);z-index:100;backdrop-filter:blur(2px);" onclick="closeBottomSheet()"></div>
<div id="bs" style="display:none;position:fixed;left:0;right:0;bottom:0;background:var(--surface-card,#fff);border-radius:var(--radius-lg,12px) var(--radius-lg,12px) 0 0;box-shadow:0 -8px 24px rgba(0,0,0,.12);z-index:101;max-height:82vh;overflow:hidden;flex-direction:column;transform:translateY(100%);transition:transform .3s ease;">
  <div style="padding:var(--space-2,8px);display:flex;justify-content:center;flex-shrink:0;"><div style="width:40px;height:4px;border-radius:2px;background:var(--border-medium,#e2e8f0);"></div></div>
  <div style="flex:1;overflow-y:auto;" id="bs-content"></div>
</div>

<!-- Modal Check-in -->
<div class="modal-overlay" id="modal-checkin" onclick="if(event.target===this)closeModal('modal-checkin')">
  <div class="modal-box">
    <div class="modal-head"><p class="modal-title">Check-in patient</p><button class="btn-modal-close" onclick="closeModal('modal-checkin')"><i data-lucide="x" style="width:12px;height:12px;"></i></button></div>
    <div class="modal-body">
      <div class="form-row"><label class="form-label-wr">Rechercher un RDV ou propri&eacute;taire</label><div style="position:relative;"><i data-lucide="search" style="width:13px;height:13px;position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--text-subtle,#94a3b8);"></i><input class="form-input-wr" style="padding-left:32px;" placeholder="Nom, propri&eacute;taire ou t&eacute;l&eacute;phone..."></div></div>
      <div style="border:1px solid var(--border-medium,#e2e8f0);border-radius:var(--radius-md,8px);overflow:hidden;margin-bottom:var(--space-3,12px);">
        <div style="display:flex;align-items:center;gap:var(--space-2,8px);padding:var(--space-2,8px) var(--space-3,12px);border-bottom:1px solid var(--border-light,#e8edf2);cursor:pointer;" onclick="selectCheckinRdv(this)" onmouseenter="this.style.background='var(--brand-50,#eef2ff)'" onmouseleave="this.style.background=''">
          <div style="width:32px;height:32px;border-radius:50%;background:var(--brand-50,#eef2ff);color:var(--brand-600,#4338ca);display:flex;align-items:center;justify-content:center;font-size:var(--text-xs,11px);font-weight:var(--weight-medium,500);flex-shrink:0;">ML</div>
          <div style="flex:1;min-width:0;"><p style="font-size:var(--text-base,14px);font-weight:var(--weight-medium,500);">Milo &mdash; British Shorthair</p><p style="font-size:var(--text-sm,13px);color:var(--text-subtle,#94a3b8);">James Park &middot; 10h15 &middot; Dr. Rousseau</p></div>
          <span class="badge-wr b-wait">RDV 10h15</span>
        </div>
        <div style="display:flex;align-items:center;gap:var(--space-2,8px);padding:var(--space-2,8px) var(--space-3,12px);cursor:pointer;" onclick="selectCheckinRdv(this)" onmouseenter="this.style.background='var(--brand-50,#eef2ff)'" onmouseleave="this.style.background=''">
          <div style="width:32px;height:32px;border-radius:50%;background:#fdf2f8;color:#db2777;display:flex;align-items:center;justify-content:center;font-size:var(--text-xs,11px);font-weight:var(--weight-medium,500);flex-shrink:0;">NL</div>
          <div style="flex:1;min-width:0;"><p style="font-size:var(--text-base,14px);font-weight:var(--weight-medium,500);">Nala &mdash; Berger Malinois</p><p style="font-size:var(--text-sm,13px);color:var(--text-subtle,#94a3b8);">Claire Moreau &middot; 10h30 &middot; Dr. Martin</p></div>
          <span class="badge-wr b-wait">RDV 10h30</span>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-3,12px);">
        <div class="form-row"><label class="form-label-wr">Motif de visite</label><input class="form-input-wr" placeholder="D&eacute;crivez bri&egrave;vement..."></div>
        <div class="form-row"><label class="form-label-wr">Priorit&eacute;</label><select class="form-input-wr"><option>Normal</option><option>Prioritaire</option><option>Urgence</option></select></div>
        <div class="form-row"><label class="form-label-wr">V&eacute;t&eacute;rinaire</label><select class="form-input-wr"><option>Dr. Rousseau</option><option>Dr. Martin</option><option>Dr. Dupont</option><option>Dr. Lambert</option><option>&mdash; Non assign&eacute; &mdash;</option></select></div>
        <div class="form-row"><label class="form-label-wr">Note d'accueil</label><input class="form-input-wr" placeholder="Optionnel..."></div>
      </div>
    </div>
    <div class="modal-foot"><button class="btn-wr btn-secondary" onclick="closeModal('modal-checkin')">Annuler</button><button class="btn-wr btn-primary" onclick="doCheckin()"><i data-lucide="check" style="width:11px;height:11px;"></i> Valider l'arriv&eacute;e</button></div>
  </div>
</div>

<!-- Modal Urgence -->
<div class="modal-overlay" id="modal-urgence" onclick="if(event.target===this)closeModal('modal-urgence')">
  <div class="modal-box">
    <div class="modal-head" style="background:#fef2f2;border-bottom:1px solid #fecaca;">
      <div style="display:flex;align-items:center;gap:var(--space-2,8px);"><div style="width:28px;height:28px;border-radius:var(--radius-md,8px);background:#dc2626;display:flex;align-items:center;justify-content:center;"><i data-lucide="alert-triangle" style="width:14px;height:14px;color:#fff;"></i></div><p style="font-size:var(--text-base,14px);font-weight:var(--weight-medium,500);color:#dc2626;">Enregistrement urgence</p></div>
      <button class="btn-modal-close" style="background:#fecaca;" onclick="closeModal('modal-urgence')"><i data-lucide="x" style="width:12px;height:12px;color:#dc2626;"></i></button>
    </div>
    <div class="modal-body">
      <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:var(--radius-md,8px);padding:var(--space-2,8px) var(--space-3,12px);margin-bottom:var(--space-4,16px);font-size:var(--text-sm,13px);color:#dc2626;font-weight:var(--weight-medium,500);display:flex;align-items:center;gap:var(--space-2,8px);"><i data-lucide="zap" style="width:13px;height:13px;flex-shrink:0;"></i>Ce patient sera plac&eacute; imm&eacute;diatement en t&ecirc;te de file.</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-3,12px);">
        <div class="form-row"><label class="form-label-wr">Animal *</label><input class="form-input-wr" placeholder="Nom de l'animal"></div>
        <div class="form-row"><label class="form-label-wr">Esp&egrave;ce</label><select class="form-input-wr"><option>Canin</option><option>F&eacute;lin</option><option>Lapin</option><option>NAC</option><option>Oiseau</option></select></div>
        <div class="form-row"><label class="form-label-wr">Propri&eacute;taire *</label><input class="form-input-wr" placeholder="Nom du propri&eacute;taire"></div>
        <div class="form-row"><label class="form-label-wr">T&eacute;l&eacute;phone</label><input class="form-input-wr" placeholder="+33 6 ..."></div>
      </div>
      <div class="form-row"><label class="form-label-wr">Motif d'urgence *</label><input class="form-input-wr" placeholder="D&eacute;crivez les sympt&ocirc;mes..."></div>
      <div class="form-row"><label class="form-label-wr">V&eacute;t&eacute;rinaire &agrave; alerter</label><select class="form-input-wr"><option>Dr. Rousseau (disponible)</option><option>Dr. Martin (en consultation)</option><option>Dr. Dupont (disponible)</option><option>Dr. Lambert (en consultation)</option></select></div>
    </div>
    <div class="modal-foot"><button class="btn-wr btn-secondary" onclick="closeModal('modal-urgence')">Annuler</button><button class="btn-wr btn-danger" onclick="doUrgence()"><i data-lucide="alert-triangle" style="width:11px;height:11px;"></i> Enregistrer l'urgence</button></div>
  </div>
</div>

<!-- Modal Appel -->
<div class="modal-overlay" id="modal-appel" onclick="if(event.target===this)closeModal('modal-appel')">
  <div class="modal-box" style="width:400px;">
    <div class="modal-head"><p class="modal-title" id="modal-appel-title">Appeler le patient</p><button class="btn-modal-close" onclick="closeModal('modal-appel')"><i data-lucide="x" style="width:12px;height:12px;"></i></button></div>
    <div class="modal-body">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-3,12px);margin-bottom:var(--space-3,12px);">
        <div class="form-row"><label class="form-label-wr">Salle</label><select class="form-input-wr" id="appel-salle"><option>Salle 1 &mdash; Dr. Rousseau</option><option>Salle 2 &mdash; Dr. Martin</option><option>Salle 3 &mdash; Dr. Dupont</option><option>Chirurgie &mdash; Dr. Lambert</option></select></div>
        <div class="form-row"><label class="form-label-wr">V&eacute;t&eacute;rinaire</label><select class="form-input-wr"><option>Dr. Rousseau</option><option>Dr. Martin</option><option>Dr. Dupont</option><option>Dr. Lambert</option></select></div>
      </div>
      <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:var(--radius-md,8px);padding:var(--space-2,8px) var(--space-3,12px);font-size:var(--text-sm,13px);color:#15803d;display:flex;align-items:center;gap:var(--space-2,8px);"><i data-lucide="megaphone" style="width:13px;height:13px;flex-shrink:0;"></i>Un affichage appara&icirc;tra sur l'&eacute;cran de la salle d'attente.</div>
    </div>
    <div class="modal-foot"><button class="btn-wr btn-secondary" onclick="closeModal('modal-appel')">Annuler</button><button class="btn-wr btn-green" onclick="doAppel()"><i data-lucide="send" style="width:11px;height:11px;"></i> Appeler</button></div>
  </div>
</div>

<div id="wr-toast"></div>
{% endblock %}

{% block javascripts %}
{% endblock %}
