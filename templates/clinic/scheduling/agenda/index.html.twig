{#
 # Kiveto — templates/clinic/scheduling/agenda/index.html.twig
 # ───────────────────────────────────────────────────────────
 # Agenda / scheduling page with week and day views.
 # Uses the global Kiveto sidebar + a contextual scheduling aside.
 #}
{% extends 'clinic/base.html.twig' %}

{% block show_sidebar %}true{% endblock %}
{% block show_topbar %}false{% endblock %}
{% block page_title %}Agenda{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block content %}
{# Drawer overlay for mobile scheduling aside #}
<div class="drawer-overlay" id="drawer-overlay" onclick="closeAgendaSidebar()"></div>

<div class="scheduling-shell">

  {# ── CONTEXTUAL ASIDE ── #}
  {{ include('clinic/scheduling/_scheduling_aside.html.twig', {
    page: 'agenda',
    selected_date: selectedDate|date('Y-m-d'),
    week_highlight: true,
    veterinarians: veterinarians,
    currentUserId: currentUserId,
  }) }}

  {# ── MAIN CONTENT ── #}
  {# The page header lives OUTSIDE the turbo-frame so it's never swapped:
   # nav link hrefs, is-active state and the week label are patched in place
   # from agenda.js whenever the frame reloads. The `data-turbo-frame`
   # attribute on each <a> still routes its click to the frame. #}
  <div class="scheduling-content">

    {# PAGE HEADER (no topbar) — static across frame swaps #}
    <div class="scheduling-page-header">
      <button class="btn-burger" onclick="toggleAgendaSidebar()" aria-label="Filtres">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>

      <div class="scheduling-page-header-nav">
        <a href="{{ todayLink }}" data-nav="today" data-turbo-frame="agenda-frame" class="data-filter-btn data-filter-btn--sm" id="today-btn">Aujourd'hui</a>

        <div class="scheduling-page-header-chevrons">
          <a href="{{ prevLink }}" data-nav="prev" data-turbo-frame="agenda-frame" class="data-filter-btn data-filter-btn--sm" aria-label="Précédent">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          </a>
          <a href="{{ nextLink }}" data-nav="next" data-turbo-frame="agenda-frame" class="data-filter-btn data-filter-btn--sm" aria-label="Suivant">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        </div>

        <span class="scheduling-page-header-label" id="week-label"></span>
      </div>

      <div style="flex:1;"></div>

      <div class="scheduling-view-toggle">
        <a href="{{ weekViewLink }}" data-nav="week-view" data-turbo-frame="agenda-frame" id="view-week" class="{{ view == 'week' ? 'is-active' : '' }}">Semaine</a>
        <a href="{{ dayViewLink }}" data-nav="day-view" data-turbo-frame="agenda-frame" id="view-day" class="{{ view == 'day' ? 'is-active' : '' }}">Jour</a>
      </div>

      <button id="free-slots-btn" type="button" onclick="toggleFreeSlots()" class="data-filter-btn data-filter-btn--sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>Créneaux libres</span>
      </button>
      <div id="free-dur-picker" style="display:none;align-items:center;gap:4px;">
        <button type="button" onclick="setFreeDur(15)" class="data-filter-btn data-filter-btn--sm" data-dur="15">15</button>
        <button type="button" onclick="setFreeDur(20)" class="data-filter-btn data-filter-btn--sm is-active" data-dur="20">20</button>
        <button type="button" onclick="setFreeDur(30)" class="data-filter-btn data-filter-btn--sm" data-dur="30">30</button>
        <button type="button" onclick="setFreeDur(60)" class="data-filter-btn data-filter-btn--sm" data-dur="60">60</button>
      </div>

      <button type="button" class="btn btn-primary btn-sm" onclick="openNewRdvGlobal()">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5v14"/></svg>
        <span>Nouveau RDV</span>
      </button>
    </div>

    {# ── AGENDA GRID (Turbo Frame — only this swaps on navigation) ── #}
    <turbo-frame id="agenda-frame">
      <div class="agenda-wrap">
        <div class="agenda-head" id="agenda-head" style="grid-template-columns:55px repeat(7,1fr) 6px;">
          <div style="background:#fff;"></div>
        </div>
        <div class="agenda-body" id="agenda-body">
          <div class="agenda-inner" id="agenda-inner" data-turbo-temporary style="grid-template-columns:55px repeat(7,1fr);"></div>
        </div>
      </div>

      {#
       # Server → client payload for agenda.js. Expected shape:
       # {
       #   appointments: list<AppointmentItem>
       #   veterinarians: list<ClinicVeterinarianItem>
       #   view: 'day' | 'week'
       #   selectedDate: string ("Y-m-d")
       #   currentUserId: string (UUID)
       #   clinicTimezone: string (IANA)
       #   checkinUrlTemplate: string (URL with literal '__ID__' placeholder)
       # }
       # Inside the frame so it's delivered alongside the replaced grid.
       #}
      <script type="application/json" id="agenda-data">
      {{ {
        appointments: appointments,
        veterinarians: veterinarians,
        view: view,
        selectedDate: selectedDate|date('Y-m-d'),
        currentUserId: currentUserId,
        clinicTimezone: clinicTimezone,
        checkinUrlTemplate: checkinUrlTemplate,
      }|json_encode|raw }}
      </script>
    </turbo-frame>

  </div>
</div>

{# APPOINTMENT MODAL #}
{{ include('clinic/scheduling/_modal_new_appointment.html.twig') }}

{# OVERLAY (close popups) #}
<div class="overlay" id="overlay" style="display:none;" onclick="closeAllPopups()"></div>

{# RDV DETAIL POPUP #}
<div class="rdv-popup" id="rdv-popup" style="display:none;">
  <div id="rdv-popup-header" style="padding:12px 14px 10px;border-bottom:1px solid #f1f5f9;">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
      <div>
        <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;">
          <span id="pp-animal" style="font-size:14px;font-weight:700;color:#0f172a;"></span>
          <span id="pp-badge" class="badge"></span>
        </div>
        <div style="font-size:12px;color:#64748b;" id="pp-proprio"></div>
      </div>
      <button onclick="closeAllPopups()" style="width:22px;height:22px;border-radius:5px;border:none;background:#f1f5f9;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <svg width="8" height="8" fill="none" viewBox="0 0 8 8"><path d="M1 1l6 6M7 1L1 7" stroke="#64748b" stroke-width="1.3" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
  <div style="padding:10px 14px;display:flex;flex-direction:column;gap:6px;">
    <div style="display:flex;align-items:center;gap:7px;">
      <svg width="12" height="12" fill="none" viewBox="0 0 16 16" style="color:#94a3b8;flex-shrink:0;"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.3"/><path d="M8 5v3l2 1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      <span style="font-size:12.5px;color:#334155;" id="pp-time"></span>
      <span style="font-size:11px;color:#94a3b8;" id="pp-duration"></span>
    </div>
    <div style="display:flex;align-items:center;gap:7px;">
      <svg width="12" height="12" fill="none" viewBox="0 0 16 16" style="color:#94a3b8;flex-shrink:0;"><path d="M8 2a4 4 0 100 8A4 4 0 008 2z" stroke="currentColor" stroke-width="1.3"/><path d="M8 10v4M5 14h6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      <span style="font-size:12.5px;color:#334155;" id="pp-vet"></span>
    </div>
    <div style="display:flex;align-items:center;gap:7px;">
      <svg width="12" height="12" fill="none" viewBox="0 0 16 16" style="color:#94a3b8;flex-shrink:0;"><path d="M4 4h8M4 8h8M4 12h5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      <span style="font-size:12.5px;color:#334155;" id="pp-motif"></span>
    </div>
    <div id="pp-note-row" style="display:none;align-items:center;gap:7px;">
      <svg width="12" height="12" fill="none" viewBox="0 0 16 16" style="color:#94a3b8;flex-shrink:0;"><path d="M3 3h10a1 1 0 011 1v8a1 1 0 01-1 1H3a1 1 0 01-1-1V4a1 1 0 011-1z" stroke="currentColor" stroke-width="1.3"/></svg>
      <span style="font-size:12px;color:#64748b;font-style:italic;" id="pp-note"></span>
    </div>
  </div>
  <div style="padding:8px 14px 12px;display:flex;gap:6px;border-top:1px solid #f1f5f9;" class="pp-actions">
    <button onclick="placerSalleAttente()" class="btn btn-primary btn-xs" style="flex:1;justify-content:center;">
      <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Salle d'attente
    </button>
    <button onclick="editAppointment()" class="btn btn-secondary btn-xs" id="pp-edit-btn" style="flex:1;justify-content:center;">
      <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M8.5 1.5l2 2L4 10H2V8L8.5 1.5z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Modifier
    </button>
    <button onclick="cancelAppointment()" class="btn btn-danger btn-xs" id="pp-cancel-btn" style="flex:1;justify-content:center;">
      <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M2 2l8 8M10 2L2 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      Annuler
    </button>
  </div>
  {# Cancel confirmation inline #}
  <div id="pp-cancel-confirm" style="display:none;padding:8px 14px 12px;border-top:1px solid #f1f5f9;">
    <p style="font-size:12px;color:var(--color-danger-text);margin-bottom:6px;">Confirmer l'annulation ?</p>
    <div style="display:flex;gap:6px;">
      <button onclick="confirmCancel()" class="btn btn-danger btn-xs" id="pp-confirm-cancel-btn" style="flex:1;justify-content:center;">Confirmer</button>
      <button onclick="cancelCancelConfirm()" class="btn btn-secondary btn-xs" style="flex:1;justify-content:center;">Non</button>
    </div>
  </div>
</div>

{# Single hidden check-in form — JS sets .action per appointment before submit. #}
<form id="checkin-form" method="POST" action="" style="display:none;">
  <input type="hidden" name="_token" value="{{ csrf_token('submit') }}"/>
  <input type="hidden" name="arrivalMode" value="STANDARD"/>
  <input type="hidden" name="priority" value="0"/>
</form>

{# TOAST #}
<div id="toast" style="position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(8px);padding:8px 16px;border-radius:8px;font-size:13px;font-weight:500;color:#fff;opacity:0;transition:all .25s;pointer-events:none;z-index:999;white-space:nowrap;background:#16a34a;"></div>
{% endblock %}

{% block javascripts %}{% endblock %}
