{#
 # Kiveto — templates/clinic/scheduling/agenda/index.html.twig
 # ─────────────────────────────────────────────────────────────
 # Agenda, ported from docs/frontend-theme/kiveto-theme/agenda-v-topbar_5.html
 # (and its « semaine chargée » variant agenda-v-topbar-charge_3.html):
 # aside (mini-calendar, practitioners, motifs, statuses), toolbar (today,
 # period, week / day, planning blocks, free slots, new booking), the time
 # grid, the booking card (popover) and the booking modal.
 #
 # The grid, the aside lists and the popover are drawn by the page module
 # from the JSON payload below (AgendaViewBuilder::page()).
 #
 # Variables from controller:
 #   agenda   payload of App\Presentation\Clinic\ViewModel\Agenda\AgendaViewBuilder::page()
 #   openNew  bool — ?new=1 (shell « R » shortcut, dashboard) opens the modal
 #   newPatient string — ?patient=… (directory row action) pre-fills its patient search
 #
 # Behaviour: assets/js/pages/scheduling/agenda.js
 # Styles:    assets/styles/pages/scheduling/sched.css (shared shell with
 #            the planning) + assets/styles/pages/scheduling/agenda.css
 #}
{% extends 'clinic/base.html.twig' %}

{% block page_body_class %}vt{% endblock %}
{% block title %}Agenda{% endblock %}

{% set _x = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>' %}

{% block main %}
{% set _data = agenda|merge({
  openNew: openNew,
  newPatient: newPatient ?? '',
  token: csrf_token('appointment'),
  urls: {
    range:      path('clinic_scheduling_agenda_range'),
    page:       path('clinic_scheduling_agenda'),
    create:     path('clinic_scheduling_appointment_create'),
    reschedule: path('clinic_scheduling_appointment_reschedule', { appointmentId: '__ID__' }),
    cancel:     path('clinic_scheduling_appointment_cancel', { appointmentId: '__ID__' }),
    noShow:     path('clinic_scheduling_appointment_no_show', { appointmentId: '__ID__' }),
    search:     path('clinic_search', { format: 'agenda', mode: 'pick', type: 'animal' }),
    animal:     path('clinic_animals_view', { id: '__ID__' }),
    client:     path('clinic_clients_view', { id: '__ID__' }),
  },
}) %}

<div class="sched agd" data-page="{{ app.request.attributes.get('_route') }}">
  <aside class="sch-aside scr">
    <div id="miniCal"></div>
    <div>
      <p class="asd-lbl">Vétérinaires</p>
      <div id="vetList"></div>
    </div>
    <div>
      <p class="asd-lbl">Motifs</p>
      <div id="motLegend"></div>
    </div>
    <div>
      <p class="asd-lbl">Statuts</p>
      <div class="st-leg">
        <span><i style="background:#4f86c638"></i>À venir</span>
        <span><i style="background:#4f86c638 repeating-linear-gradient(135deg,rgba(255,255,255,.62) 0 3px,transparent 3px 6px)"></i>Passé</span>
        <span><i style="background:#fee2e2 repeating-linear-gradient(135deg,rgba(220,38,38,.14) 0 3px,transparent 3px 6px)"></i>Non venu</span>
        <span><i style="background:#fff;outline:1px dashed #cbd5e1;outline-offset:-1px"></i><s style="color:var(--encre-35)">Annulé</s></span>
      </div>
    </div>
  </aside>

  <div class="sch-main">
    <div class="sch-head">
      <button class="hbtn" id="btnAuj">Aujourd'hui</button>
      <button class="hbtn ic" id="btnPrev" data-tip="Période précédente" aria-label="Période précédente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button>
      <button class="hbtn ic" id="btnNext" data-tip="Période suivante" aria-label="Période suivante"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button>
      <span class="sch-label" id="schLabel">—</span>
      <span style="flex:1"></span>
      <div class="seg" id="vueSeg"><button data-v="week"{% if agenda.view == 'week' %} class="on"{% endif %}>Semaine</button><button data-v="day"{% if agenda.view == 'day' %} class="on"{% endif %}>Jour</button></div>
      <button class="hbtn" id="btnBlocs">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 13h3v5H8z"/></svg>
        Blocs planning
      </button>
      <button class="hbtn" id="btnLibres">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        Créneaux libres
      </button>
      <div class="durs" id="durs"><button data-d="15">15</button><button data-d="20" class="on">20</button><button data-d="30">30</button><button data-d="60">60</button></div>
      <button class="btn primaire" id="btnNouveau">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        Nouveau RDV
      </button>
    </div>
    <div class="cal">
      <div class="cal-head" id="calHead"></div>
      <div class="cal-body scr" id="calBody"><div class="cal-inner" id="calInner"></div></div>
    </div>
  </div>

  {# Booking card (anchored popover) #}
  <div class="pop" id="rdvPop" role="dialog" aria-label="Rendez-vous"></div>

  {# New / edit booking modal #}
  <div class="mveil" id="rdvVeil" role="dialog" aria-modal="true" aria-label="Rendez-vous">
    <div class="mbox" style="width:min(780px,95vw)">
      <div class="mhead">
        <div class="mt"><b id="rdvTitre">Nouveau rendez-vous</b><span id="rdvSlot">—</span></div>
        <button class="mclose" id="rdvX" aria-label="Fermer">{{ _x|raw }}</button>
      </div>
      <div class="mbody rdv-grid">
        <div>
          <div class="rbox">
            <p class="rbox-t">Horaire</p>
            <div class="g2">
              <div><label class="flbl">Jour</label><div class="dd" id="ddJour"></div></div>
              <div><label class="flbl" for="rdvH">Début</label><div class="hor"><input class="finput" id="rdvH" value="14:00" maxlength="5" autocomplete="off"><span class="fin" id="rdvFin">→ 14:30</span></div></div>
            </div>
            <div class="durchips" id="durChips"><button type="button" data-d="15">15 min</button><button type="button" data-d="20">20 min</button><button type="button" data-d="30" class="on">30 min</button><button type="button" data-d="45">45 min</button><button type="button" data-d="60">1 h</button></div>
          </div>
          <div class="frow">
            <label class="flbl" for="psIn">Patient <span class="req">*</span></label>
            <div id="psZone">
              <div class="ps">
                <div class="ps-in"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input id="psIn" placeholder="Animal, propriétaire, téléphone…" autocomplete="off"></div>
                <div class="ps-menu scr" id="psMenu"></div>
              </div>
            </div>
            <div id="psFiche" style="display:none"></div>
          </div>
          <div class="frow"><label class="flbl">Vétérinaire <span class="req">*</span></label><div class="dd" id="ddVet"></div></div>
          <div class="frow"><label class="flbl" for="rdvNote">Note / contexte <span class="opt">(optionnel)</span></label><textarea class="ftext" id="rdvNote" placeholder="Précision, symptômes, contexte…"></textarea></div>
        </div>
        <div>
          <div class="frow"><label class="flbl">Motif <span class="req">*</span></label><div class="mot-chips" id="motChips"></div></div>
          {# Not wired yet: no e-mail / SMS / team notification channel exists #}
          <div class="rbox soon" data-tip="Envoi des confirmations et rappels : bientôt disponible">
            <p class="rbox-t">Notifications &amp; rappels <span class="soon-tag">Bientôt</span></p>
            <div class="nrow"><span>E-mail de confirmation</span><span class="sw" aria-disabled="true"></span></div>
            <div class="nrow"><span>SMS de rappel</span><div class="dd" id="ddSms"></div><span class="sw" aria-disabled="true"></span></div>
            <div class="nrow"><span>Notifier l'équipe</span><span class="sw" aria-disabled="true"></span></div>
          </div>
          {# Not wired yet: bookings do not repeat #}
          <div class="rrow soon" data-tip="Rendez-vous récurrents : bientôt disponible"><span>Récurrence <span class="soon-tag">Bientôt</span></span><div class="dd" id="ddRec"></div></div>
          <div class="conflit" id="rdvConflit"></div>
        </div>
      </div>
      <div class="mfoot">
        <button class="btn" id="rdvAnnuler" style="flex:1;justify-content:center">Annuler</button>
        <button class="btn primaire" id="rdvOk" style="flex:2;justify-content:center" disabled>Confirmer le rendez-vous</button>
      </div>
    </div>
  </div>

  <script type="application/json" id="agenda-data">{{ _data|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }}</script>
</div>
{% endblock %}
