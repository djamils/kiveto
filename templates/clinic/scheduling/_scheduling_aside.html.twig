{#
 # Kiveto — templates/clinic/scheduling/_scheduling_aside.html.twig
 # ────────────────────────────────────────────────────────────────
 # Contextual aside (≈240px) shared by Agenda and Planning pages.
 # Sits next to the global Kiveto sidebar and contains:
 #   - inline calendar (UI kit)
 #   - veterinarians filter
 #   - (agenda only) appointment-type filters
 #
 # Parameters:
 #   page             string   'agenda' | 'planning' (default: 'agenda')
 #   selected_date    string   ISO yyyy-mm-dd of the initially selected day
 #   week_highlight   bool     Highlight the whole active week (agenda mode)
 #}
{% set _page = page|default('agenda') %}
{% set _selected_date = selected_date|default('') %}
{% set _week_highlight = week_highlight|default(false) %}

<aside class="scheduling-aside">

  {# ── Calendar module ── #}
  <div class="scheduling-aside-section">
    {{ include('components/ui/calendar.html.twig', {
      id: 'scheduling-calendar',
      selected: _selected_date,
      week_highlight: _week_highlight,
    }) }}
  </div>

  {# ── Vets filter ── #}
  <div class="scheduling-aside-section">
    <p class="scheduling-aside-label">Vétérinaires</p>
    <div class="vet-chip" onclick="toggleVet(this,'rousseau')">
      <div class="vet-dot" style="background:#4338ca;"></div>
      <span>Dr. Rousseau</span>
      <svg id="check-rousseau" width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="#4338ca" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div class="vet-chip" onclick="toggleVet(this,'martin')">
      <div class="vet-dot" style="background:#0891b2;"></div>
      <span>Dr. Martin</span>
      <svg id="check-martin" width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="#0891b2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div class="vet-chip" onclick="toggleVet(this,'dupont')">
      <div class="vet-dot" style="background:#059669;"></div>
      <span>Dr. Dupont</span>
      <svg id="check-dupont" width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="#059669" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div class="vet-chip" onclick="toggleVet(this,'lambert')">
      <div class="vet-dot" style="background:#db2777;"></div>
      <span>Dr. Lambert</span>
      <svg id="check-lambert" width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="#db2777" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
  </div>

  {% if _page == 'agenda' %}
    {# ── RDV type filters (filled by JS) ── #}
    <div class="scheduling-aside-section scheduling-aside-section-grow">
      <p class="scheduling-aside-label">Types de RDV</p>
      <div id="motif-filters" class="motif-filters" data-turbo-temporary></div>
    </div>
  {% else %}
    {# ── Planning legend (filled by JS) ── #}
    <div class="scheduling-aside-section scheduling-aside-section-grow">
      <p class="scheduling-aside-label">Types d'activité</p>
      <div id="legend-items" class="legend-items" data-turbo-temporary></div>
    </div>
  {% endif %}

</aside>
