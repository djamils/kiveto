{#
 # Kiveto — templates/clinic/scheduling/_scheduling_aside.html.twig
 # ────────────────────────────────────────────────────────────────
 # Contextual aside (≈240px) shared by Agenda and Planning pages.
 # Sits next to the global Kiveto sidebar and contains:
 #   - inline calendar (UI kit)
 #   - veterinarians filter
 #   - (agenda only) appointment-type filters
 #
 # Parameters:
 #   page             string   'agenda' | 'planning' (default: 'agenda')
 #   selected_date    string   ISO yyyy-mm-dd of the initially selected day
 #   week_highlight   bool     Highlight the whole active week (agenda mode)
 #   veterinarians    list     List of ClinicVeterinarianItem {userId, role, engagement}
 #   currentUserId    ?string  Current user id — highlighted as "Moi"
 #}
{% set _page = page|default('agenda') %}
{% set _selected_date = selected_date|default('') %}
{% set _week_highlight = week_highlight|default(false) %}
{% set _veterinarians = veterinarians|default([]) %}
{% set _current_user_id = currentUserId|default(null) %}
{% set _vet_palette = ['#4338ca','#0891b2','#059669','#db2777','#7c3aed','#b45309','#0369a1','#9d174d'] %}

<aside class="scheduling-aside">

  {# ── Calendar module ── #}
  <div class="scheduling-aside-section">
    {{ include('components/ui/calendar.html.twig', {
      id: 'scheduling-calendar',
      selected: _selected_date,
      week_highlight: _week_highlight,
    }) }}
  </div>

  {# ── Vets filter ── #}
  <div class="scheduling-aside-section">
    <p class="scheduling-aside-label">Vétérinaires</p>
    {% if _veterinarians|length > 0 %}
      {% for index, vet in _veterinarians %}
        {% set _is_me = _current_user_id is not null and vet.userId == _current_user_id %}
        {% set _title_prefix = vet.professionalTitle == 'DR' ? 'Dr. ' : (vet.professionalTitle == 'PR' ? 'Pr. ' : '') %}
        {% set _label = _is_me ? 'Moi' : (vet.displayName ? (_title_prefix ~ vet.displayName) : ('Praticien ' ~ (index + 1))) %}
        {% set _color = _is_me ? '#0d9488' : (vet.agendaColor ?? _vet_palette[index % _vet_palette|length]) %}
        <div class="vet-chip" data-vet-id="{{ vet.userId }}" onclick="toggleVet(this, '{{ vet.userId }}')">
          <div class="vet-dot" style="background:{{ _color }};"></div>
          <span>{{ _label }}</span>
          <svg class="vet-check" data-vet-check="{{ vet.userId }}" width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="{{ _color }}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      {% endfor %}
    {% else %}
      <p class="scheduling-aside-empty">Aucun vétérinaire actif dans cette clinique.</p>
    {% endif %}
  </div>

  {% if _page != 'agenda' %}
    {# ── Planning legend (filled by JS) ── #}
    <div class="scheduling-aside-section scheduling-aside-section-grow">
      <p class="scheduling-aside-label">Types d'activité</p>
      <div id="legend-items" class="legend-items" data-turbo-temporary></div>
    </div>
  {% endif %}

</aside>
