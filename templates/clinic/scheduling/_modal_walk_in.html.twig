{#
 # Kiveto — templates/clinic/scheduling/_modal_walk_in.html.twig
 # ─────────────────────────────────────────────────────────────
 # Modal for registering a walk-in / emergency patient.
 # Uses the Kiveto modal component.
 #}

{% embed 'components/layout/modal.html.twig' with {
    id: 'modalWalkIn',
    title: 'Enregistrer une urgence Walk-in',
    size: 'md',
    show_footer: true,
    cancel_label: 'Annuler',
    submit_label: "Enregistrer l'urgence",
    submit_variant: 'primary',
    form_id: 'formWalkIn',
} %}
    {% block modal_body %}
        {# Warning banner #}
        <div style="display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-3); background: var(--color-warning-bg); border: 1px solid #fde68a; border-radius: var(--radius-md); margin-bottom: var(--space-4); font-size: var(--text-sm); color: var(--color-warning-text);">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <div>
                <strong>Urgence sans rendez-vous</strong><br>
                <span style="font-size: var(--text-xs);">Pour un animal arrivé sans RDV préalable.</span>
            </div>
        </div>

        <form
            id="formWalkIn"
            method="post"
            action="{{ path('clinic_scheduling_walkin_create') }}"
        >
            {# Arrival mode #}
            <div class="form-row">
                <label class="form-label">Mode d'arrivée <span style="color: var(--color-danger-text);">*</span></label>
                {# Arrival mode selector (custom select component) #}
                {{ include('components/ui/select.html.twig', {
                  name: 'arrivalMode',
                  value: 'EMERGENCY',
                  options: [
                    { value: 'EMERGENCY', label: 'URGENCE' },
                    { value: 'STANDARD', label: 'Standard' },
                  ]
                }) }}
            </div>

            {# Priority #}
            <div class="form-row">
                <label class="form-label">Priorité <span style="color: var(--color-danger-text);">*</span></label>
                {# Priority level selector (custom select component) #}
                {{ include('components/ui/select.html.twig', {
                  name: 'priority',
                  value: '5',
                  options: [
                    { value: '10', label: '10 - Critique (danger de mort)' },
                    { value: '8', label: '8 - Très urgent' },
                    { value: '5', label: '5 - Urgent' },
                    { value: '3', label: '3 - Modéré' },
                    { value: '0', label: '0 - Standard' },
                  ]
                }) }}
            </div>

            {# Found animal description #}
            <div class="form-row">
                <label class="form-label">Description de l'animal</label>
                <input
                    type="text"
                    name="foundAnimalDescription"
                    class="form-input"
                    placeholder="Ex: Chat noir, blessure patte avant gauche"
                >
                <span style="font-size: var(--text-xs); color: var(--text-subtle); margin-top: 2px; display: block;">
                    Pour animaux inconnus ou trouvés
                </span>
            </div>

            {# Triage notes #}
            <div class="form-row">
                <label class="form-label">Notes de triage <span style="color: var(--color-danger-text);">*</span></label>
                <textarea
                    name="triageNotes"
                    class="form-input"
                    rows="4"
                    placeholder="Symptômes, observations, état général..."
                    required
                ></textarea>
            </div>

            <div style="border-top: 1px solid var(--border-light); margin: var(--space-3) 0;"></div>

            {# Optional owner & animal #}
            <div class="form-row">
                <label class="form-label">Propriétaire (si connu)</label>
                <input
                    type="text"
                    name="ownerId"
                    class="form-input"
                    placeholder="UUID du propriétaire"
                >
            </div>

            <div class="form-row">
                <label class="form-label">Animal (si connu)</label>
                <input
                    type="text"
                    name="animalId"
                    class="form-input"
                    placeholder="UUID de l'animal"
                >
            </div>
        </form>
    {% endblock %}
{% endembed %}
