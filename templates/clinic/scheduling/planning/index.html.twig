{#
 # Kiveto — templates/clinic/scheduling/planning/index.html.twig
 # ───────────────────────────────────────────────────────────────
 # Staff planning, ported from docs/frontend-theme/kiveto-theme/planning-v-topbar_5.html:
 # aside (mini-calendar, practitioners and activity types with their hours),
 # toolbar (today, period, day / week / month, add a block), the time grid
 # (one column per practitioner in the day view, one lane per practitioner
 # in the week view), the month view and the block modal.
 #
 # The grid, the aside lists and the modal options are drawn by the page
 # module from the JSON payload below (PlanningViewBuilder::page()).
 #
 # Variables from controller:
 #   planning  payload of App\Presentation\Clinic\ViewModel\Planning\PlanningViewBuilder::page()
 #
 # Behaviour: assets/js/pages/scheduling/planning.js
 # Styles:    assets/styles/pages/scheduling/sched.css (shared shell with
 #            the agenda) + assets/styles/pages/scheduling/planning.css
 #}
{% extends 'clinic/base.html.twig' %}

{% block page_body_class %}vt{% endblock %}
{% block title %}Planning{% endblock %}

{% block main %}
{% set _data = planning|merge({
  urls: {
    range:  path('clinic_scheduling_planning_range'),
    page:   path('clinic_scheduling_planning'),
    create: path('clinic_planning_block_create'),
    update: path('clinic_planning_block_update', { id: '__ID__' }),
    delete: path('clinic_planning_block_delete', { id: '__ID__' }),
  },
}) %}

<div class="sched pln" data-page="{{ app.request.attributes.get('_route') }}">
  <aside class="sch-aside scr">
    <div id="miniCal"></div>
    <div>
      <p class="asd-lbl">Vétérinaires</p>
      <div id="vetList"></div>
    </div>
    <div>
      <p class="asd-lbl">Types d'activité</p>
      <div id="typeList"></div>
    </div>
  </aside>

  <div class="sch-main">
    <div class="sch-head">
      <button class="hbtn" id="btnAuj">Aujourd'hui</button>
      <button class="hbtn ic" id="btnPrev" data-tip="Période précédente" aria-label="Période précédente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button>
      <button class="hbtn ic" id="btnNext" data-tip="Période suivante" aria-label="Période suivante"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button>
      <span class="sch-label" id="schLabel">—</span>
      <span style="flex:1"></span>
      <div class="seg" id="vueSeg">{% for v, l in { day: 'Jour', week: 'Semaine', month: 'Mois' } %}<button data-v="{{ v }}"{% if planning.view == v %} class="on"{% endif %}>{{ l }}</button>{% endfor %}</div>
      <button class="btn primaire" id="btnAjout">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        Ajouter un bloc
      </button>
    </div>
    <div class="cal" id="calZone">
      <div class="cal-head" id="calHead"></div>
      <div class="cal-body scr" id="calBody"><div class="cal-inner" id="calInner"></div></div>
    </div>
    <div class="mgrid" id="mGrid" style="display:none"></div>
  </div>

  {# Block modal #}
  <div class="mveil" id="blkVeil" role="dialog" aria-modal="true" aria-label="Bloc de planning">
    <div class="mbox" style="width:min(520px,95vw)">
      <div class="mhead">
        <div class="mt" style="flex:1;min-width:0"><b id="blkTitre">Nouveau bloc</b><span id="blkSous">—</span></div>
        <button class="btn ghost-danger" id="blkSuppr" style="margin-left:auto;padding:6px 11px;font-size:.78rem;display:none">Supprimer</button>
        <button class="mclose" id="blkX" aria-label="Fermer" style="margin-left:6px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
      </div>
      <div class="mbody">
        <div class="frow"><label class="flbl">Type d'activité</label><div class="types" id="typeGrid"></div></div>
        <div class="frow"><label class="flbl">Vétérinaire</label><div class="dd" id="ddVet"></div></div>
        <div class="frow g3">
          <div><label class="flbl">Date</label><div class="dd" id="ddDate"></div></div>
          <div><label class="flbl" for="bS">Début</label><input class="finput tin" id="bS" maxlength="5" autocomplete="off"></div>
          <div><label class="flbl" for="bE">Fin</label><input class="finput tin" id="bE" maxlength="5" autocomplete="off"></div>
        </div>
        {# Not wired yet: there is no online booking nor motif catalogue — every
           bookable block is booked by the team, for any motif #}
        <div class="frow resa soon" id="capRow" data-tip="Réservation en ligne : bientôt disponible">
          <div class="resa-h"><span><b>Réservable en ligne <span class="soon-tag">Bientôt</span></b><small id="resaSub">Réservation par l'équipe uniquement</small></span><span class="sw" id="bLigne" aria-disabled="true"></span></div>
          <label class="flbl" style="margin-top:10px">Motifs acceptés</label>
          <div class="mchips" id="bMotifs"></div>
        </div>
        <div class="frow"><div class="reprow" id="repRow"><span>Répéter ce bloc</span><div class="dd" id="ddRep"></div></div></div>
        <div class="frow"><label class="flbl" for="bNote">Note <span class="opt">(optionnel)</span></label><input class="finput" id="bNote" maxlength="500" placeholder="Ex : retour de congé, formation externe…"></div>
        <div class="conflit" id="blkConflit"></div>
      </div>
      <div class="mfoot">
        <button class="btn" id="blkAnnuler">Annuler</button>
        <button class="btn primaire" id="blkOk">Enregistrer</button>
      </div>
    </div>
  </div>

  <script type="application/json" id="planning-data">{{ _data|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }}</script>
</div>
{% endblock %}
