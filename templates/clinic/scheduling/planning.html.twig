      </div>
      <div class="vet-chip">
        <div class="vet-dot" style="background:#0891b2;"></div>
        <span style="font-size:12.5px;color:#334155;flex:1;">Dr. Martin</span>
        <svg width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="#0891b2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
