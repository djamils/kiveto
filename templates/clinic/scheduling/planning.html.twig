{#
 # Kiveto — templates/clinic/scheduling/planning.html.twig
 # ────────────────────────────────────────────────────────
 # Planning page — full-featured scheduling grid with day/week/month views,
 # drag-to-select block creation, mini calendar, vet filters, and popup form.
 # Faithfully reproduced from the vetos-planning.html mockup.
 #}
{% extends 'clinic/base.html.twig' %}

{% block show_sidebar %}false{% endblock %}
{% block show_topbar %}false{% endblock %}

{% block page_title %}Planning{% endblock %}

{% block stylesheets %}
<style>
  /* Override base layout for full-height planning grid */
  .app-scroll{overflow:hidden !important;}
  .app-body{padding:0 !important;display:flex;flex-direction:column;overflow:hidden;height:100%;}

  /* ── SIDEBAR ── */
  .sidebar{width:232px;flex-shrink:0;background:#fff;border-right:1px solid #e8edf2;display:flex;flex-direction:column;}
  .sb-top{height:48px;display:flex;align-items:center;padding:0 10px;border-bottom:1px solid #e8edf2;flex-shrink:0;}
  .sb-clinic-btn{width:100%;display:flex;align-items:center;gap:8px;padding:7px 8px;border-radius:9px;border:none;background:transparent;cursor:pointer;text-align:left;transition:background .13s;font-family:'DM Sans',system-ui,sans-serif;}
  .sb-clinic-btn:hover{background:#f1f5f9;}
  .sb-foot{border-top:1px solid #e8edf2;padding:8px 6px 10px;flex-shrink:0;}
  .sb-user{display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:8px;cursor:pointer;}
  .sb-settings{display:flex;align-items:center;gap:8px;padding:7px 10px;margin:2px 6px;border-radius:8px;font-size:14.5px;color:#64748b;cursor:pointer;transition:background .12s;}
  .sb-settings:hover{background:#f8fafc;}

  /* mini cal */
  .mini-cal{padding:12px 14px;border-bottom:1px solid #f1f5f9;flex-shrink:0;}
  .mini-cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
  .mini-cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;}
  .mini-cal-dow{font-size:10px;font-weight:600;color:#94a3b8;text-align:center;padding-bottom:2px;}
  .mini-cal-day{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:11px;border-radius:5px;cursor:pointer;transition:all .1s;color:#475569;position:relative;}
  .mini-cal-day:hover{background:#f1f5f9;}
  .mini-cal-day.today{background:#4338ca;color:#fff;font-weight:700;}
  .mini-cal-day.selected{background:#eef2ff;color:#4338ca;font-weight:600;}
  .mini-cal-day.other-month{color:#cbd5e1;}
  .mini-cal-day.has-blocks::after{content:'';display:block;width:3px;height:3px;border-radius:50%;background:#4338ca;position:absolute;bottom:2px;left:50%;transform:translateX(-50%);}

  /* vet filter */
  .vet-filter{padding:10px 14px;border-bottom:1px solid #f1f5f9;flex-shrink:0;}
  .vet-chip{display:flex;align-items:center;gap:7px;padding:5px 8px;border-radius:7px;cursor:pointer;transition:background .1s;margin-bottom:3px;}
  .vet-chip:hover{background:#f8fafc;}
  .vet-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}

  /* ── MAIN ── */
  .content{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0;min-height:0;}
  .topbar{height:48px;flex-shrink:0;background:#fff;border-bottom:1px solid #e8edf2;display:flex;align-items:center;padding:0 18px;gap:10px;}

  /* ── PLANNING GRID ── */
  .planning-wrap{flex:1;min-height:0;position:relative;overflow:hidden;}
  .planning-head{background:#fff;border-bottom:1px solid #e8edf2;flex-shrink:0;display:flex;}
  .planning-body{flex:1;overflow-y:auto;overflow-x:auto;position:relative;}
  .planning-inner{position:relative;}

  /* vet row */
  .vet-row{display:flex;position:relative;border-bottom:1px solid #e8edf2;}
  .vet-label{width:120px;flex-shrink:0;background:#fff;border-right:2px solid #e2e8f0;padding:0 12px;display:flex;flex-direction:column;justify-content:center;gap:2px;position:sticky;left:0;z-index:20;}
  .vet-row-grid{flex:1;position:relative;}

  /* hour cols */
  .hour-slot{position:absolute;top:0;bottom:0;border-left:1px solid #f1f5f9;cursor:pointer;transition:background .1s;}
  .hour-slot:hover{background:rgba(99,102,241,.04);}
  .hour-slot:first-child{border-left:none;}

  /* grid borders */
  .vet-row{border-bottom:1px solid #e8edf2;}
  .hour-slot{border-left:1px solid #c9d0d8;}
  .hour-slot:first-child{border-left:none;}
  .hour-slot-half{position:absolute;top:0;bottom:0;left:50%;border-left:1px dashed #dde2e7;pointer-events:none;}

  /* activity blocks */
  .act-block{position:absolute;top:6px;bottom:6px;border-radius:7px;cursor:pointer;overflow:hidden;transition:filter .12s;border-left:3px solid transparent;}
  .act-block:hover{filter:brightness(.95);}
  .act-block-inner{padding:5px 8px;height:100%;display:flex;flex-direction:column;justify-content:center;overflow:hidden;}
  .act-block-type{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .act-block-time{font-size:10.5px;font-weight:500;white-space:nowrap;margin-top:1px;}
  .act-block-cap{font-size:9.5px;margin-top:2px;opacity:.7;white-space:nowrap;}

  /* popup */
  .popup-overlay{position:fixed;inset:0;background:rgba(15,23,42,.35);backdrop-filter:blur(2px);z-index:400;display:none;align-items:center;justify-content:center;}
  .popup-overlay.open{display:flex;}
  .popup-box{background:#fff;border-radius:14px;width:460px;max-width:calc(100vw - 32px);box-shadow:0 20px 60px rgba(0,0,0,.18);overflow:hidden;transform:scale(.97);opacity:0;transition:all .2s cubic-bezier(.34,1.56,.64,1);}
  .popup-overlay.open .popup-box{transform:scale(1);opacity:1;}

  /* buttons */
  .btn{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:8px;font-size:12.5px;font-weight:500;font-family:'DM Sans',system-ui,sans-serif;cursor:pointer;border:none;transition:all .13s;white-space:nowrap;}
  .btn-primary{background:#4338ca;color:#fff;}
  .btn-primary:hover{background:#3730a3;}
  .btn-secondary{background:#f8fafc;color:#374151;border:1px solid #e2e8f0;}
  .btn-secondary:hover{background:#f1f5f9;border-color:#cbd5e1;}
  .btn-xs{padding:4px 9px;font-size:11.5px;}
  .btn-danger{background:#fef2f2;color:#dc2626;border:1px solid #fecaca;}
  .btn-danger:hover{background:#fee2e2;}

  /* form */
  .form-input{width:100%;font-size:12.5px;font-family:'DM Sans',system-ui,sans-serif;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:6px 10px;outline:none;color:#0f172a;transition:border-color .15s,background .15s;}
  .form-input:focus{border-color:#818cf8;background:#fff;}
  .form-label{font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.07em;display:block;margin-bottom:5px;}

  /* view toggle */
  .view-btn{padding:4px 12px;border-radius:6px;border:none;font-size:12px;font-weight:500;cursor:pointer;font-family:inherit;background:transparent;color:#64748b;transition:all .13s;}
  .view-btn.active{background:#fff;color:#0f172a;box-shadow:0 1px 3px rgba(0,0,0,.08);}

  /* month view */
  .month-grid{display:grid;grid-template-columns:120px repeat(7,1fr);}
  .month-cell{border-right:1px solid #f1f5f9;border-bottom:1px solid #f1f5f9;min-height:80px;padding:4px 6px;position:relative;cursor:pointer;transition:background .1s;}
  .month-cell:hover{background:#f8fafc;}
  .month-cell.other-month{background:#fafafa;}

  /* toast */
  #toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(8px);padding:8px 16px;border-radius:8px;font-size:13px;font-weight:500;color:#fff;opacity:0;transition:all .25s;pointer-events:none;z-index:999;white-space:nowrap;}

  /* ── Burger ── */
  .btn-burger{display:none;width:34px;height:34px;border-radius:8px;border:1px solid #e2e8f0;background:#f8fafc;cursor:pointer;align-items:center;justify-content:center;color:#64748b;flex-shrink:0;}
  .btn-burger:hover{background:#f1f5f9;}

  /* ── Drawer overlay ── */
  .drawer-overlay{display:none;position:fixed;inset:0;background:rgba(15,23,42,.3);z-index:80;backdrop-filter:blur(2px);}
  .drawer-overlay.open{display:block;}

  /* ── FAB (mobile) ── */
  .fab{display:none;position:fixed;bottom:24px;right:20px;width:52px;height:52px;border-radius:50%;background:#4338ca;color:#fff;border:none;cursor:pointer;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(67,56,202,.4);z-index:60;transition:transform .15s;}
  .fab:hover{transform:scale(1.08);}

  /* ── iPad Pro landscape ── */
  @media(max-width:1280px){
    .topbar-label{min-width:120px !important;}
  }

  /* ── iPad portrait ── */
  @media(max-width:1024px){
    .sidebar{
      position:fixed;left:0;top:0;bottom:0;z-index:90;
      transform:translateX(-100%);
      transition:transform .28s cubic-bezier(.4,0,.2,1);
    }
    .sidebar.open{transform:translateX(0);box-shadow:4px 0 24px rgba(0,0,0,.15);}
    .btn-burger{display:flex;}
    .topbar-breadcrumb{display:none;}
  }

  /* ── Mobile ── */
  @media(max-width:640px){
    .topbar{padding:0 10px;gap:6px;}
    .topbar-label{font-size:12px !important;min-width:90px !important;}
    .topbar-add-btn{display:none !important;}
    .topbar-view-toggle{display:none !important;}
    .fab{display:flex;}
  }
</style>
{% endblock %}

{% block content %}
{# Drawer overlay for mobile sidebar #}
<div class="drawer-overlay" id="drawer-overlay" onclick="closeSidebar()"></div>

{# FAB button for mobile #}
<button class="fab" onclick="openBlockPopup(null,null,null)">
  <svg width="20" height="20" fill="none" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
</button>

{# Main planning shell (sidebar + content) #}
<div style="display:flex;flex:1;overflow:hidden;min-height:0;">

<!-- ══ SIDEBAR ══ -->
<aside class="sidebar">
  <div class="sb-top">
    <button class="sb-clinic-btn">
      <div style="width:28px;height:28px;background:#1e1b4b;border-radius:7px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;font-weight:700;flex-shrink:0;">V</div>
      <div style="flex:1;min-width:0;">
        <p style="font-size:12.5px;font-weight:600;color:#0f172a;line-height:1.2;">{{ activeClinic.name|default('Ma clinique') }}</p>
        <p style="font-size:12px;color:#64748b;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ activeClinic.type|default('Vétérinaire') }}</p>
      </div>
      <svg width="12" height="12" fill="none" viewBox="0 0 12 12" style="flex-shrink:0;color:#94a3b8;"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  <!-- Mini calendar -->
  <div class="mini-cal">
    <div class="mini-cal-head">
      <span style="font-size:12.5px;font-weight:700;color:#0f172a;" id="mini-month">Mars 2026</span>
      <div style="display:flex;gap:2px;">
        <button onclick="miniCalPrev()" style="width:22px;height:22px;border-radius:5px;border:none;background:#f1f5f9;cursor:pointer;display:flex;align-items:center;justify-content:center;">
          <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M7.5 2l-4 4 4 4" stroke="#64748b" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button onclick="miniCalNext()" style="width:22px;height:22px;border-radius:5px;border:none;background:#f1f5f9;cursor:pointer;display:flex;align-items:center;justify-content:center;">
          <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M4.5 2l4 4-4 4" stroke="#64748b" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
    <div class="mini-cal-grid" id="mini-cal-dow">
      <div class="mini-cal-dow">L</div><div class="mini-cal-dow">M</div><div class="mini-cal-dow">M</div>
      <div class="mini-cal-dow">J</div><div class="mini-cal-dow">V</div><div class="mini-cal-dow">S</div>
      <div class="mini-cal-dow">D</div>
    </div>
    <div class="mini-cal-grid" id="mini-cal-grid"></div>
  </div>

  <!-- Vet filters -->
  <div class="vet-filter">
    <p style="font-size:10px;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px;">Vétérinaires</p>
    <div class="vet-chip" onclick="toggleVet(this,'rousseau')">
      <div class="vet-dot" style="background:#4338ca;"></div>
      <span style="font-size:12.5px;color:#334155;flex:1;">Dr. Rousseau</span>
      <svg id="check-rousseau" width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="#4338ca" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div class="vet-chip" onclick="toggleVet(this,'martin')">
      <div class="vet-dot" style="background:#0891b2;"></div>
      <span style="font-size:12.5px;color:#334155;flex:1;">Dr. Martin</span>
      <svg id="check-martin" width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="#0891b2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div class="vet-chip" onclick="toggleVet(this,'dupont')">
      <div class="vet-dot" style="background:#059669;"></div>
      <span style="font-size:12.5px;color:#334155;flex:1;">Dr. Dupont</span>
      <svg id="check-dupont" width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="#059669" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div class="vet-chip" onclick="toggleVet(this,'lambert')">
      <div class="vet-dot" style="background:#db2777;"></div>
      <span style="font-size:12.5px;color:#334155;flex:1;">Dr. Lambert</span>
      <svg id="check-lambert" width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="#db2777" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
  </div>

  <div style="flex:1;"></div>

  <!-- Footer -->
  <div class="sb-foot">
    <div style="padding:6px 8px 4px;">
      <a href="{{ path('clinic_dashboard') }}" style="width:100%;display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:8px;border:1.5px solid #c7d2fe;background:#eef2ff;cursor:pointer;font-family:inherit;font-size:12.5px;color:#4338ca;font-weight:500;transition:all .13s;text-decoration:none;" onmouseenter="this.style.background='#e0e7ff'" onmouseleave="this.style.background='#eef2ff'">
        <svg width="13" height="13" fill="none" viewBox="0 0 16 16"><path d="M7 3L2 8l5 5M2 8h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Retour à l'application
      </a>
    </div>
    <div class="sb-settings">
      <svg width="14" height="14" fill="none" viewBox="0 0 16 16" style="opacity:.7"><path d="M8 10a2 2 0 100-4 2 2 0 000 4z" stroke="currentColor" stroke-width="1.4"/><path d="M13 7a5 5 0 00-.2-1L14 5l-1.5-2.5-1.5.6A5 5 0 0010 2.6L9.5 1h-3L6 2.6a5 5 0 00-1 .5L3.5 2.5 2 5l1.2 1a5 5 0 000 2L2 9l1.5 2.5 1.5-.6a5 5 0 001 .5l.5 1.6h3l.5-1.6a5 5 0 001-.5l1.5.6L14 9l-1.2-1A5 5 0 0013 7z" stroke="currentColor" stroke-width="1.4"/></svg>
      Paramètres
    </div>
    <div style="border-top:1px solid #e8edf2;">
      <div class="sb-user">
        <div style="width:27px;height:27px;border-radius:50%;background:#dbeafe;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:#1d4ed8;flex-shrink:0;">DR</div>
        <div style="flex:1;min-width:0;">
          <p style="font-size:13px;font-weight:500;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ app.user.email|default('Utilisateur') }}</p>
          <p style="font-size:11.5px;color:#94a3b8;">Vétérinaire</p>
        </div>
        <svg width="12" height="12" fill="none" viewBox="0 0 12 12" style="flex-shrink:0;color:#94a3b8;"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>
  </div>
</aside>

<!-- ══ MAIN ══ -->
<div class="content">

  <!-- TOPBAR -->
  <div class="topbar">
    <button class="btn-burger" onclick="toggleSidebar()"><svg width="16" height="16" fill="none" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
    <span class="topbar-breadcrumb" style="font-size:13px;color:#94a3b8;">VET-OS</span>
    <svg class="topbar-breadcrumb" width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M4.5 3l3 3-3 3" stroke="#cbd5e1" stroke-width="1.3" stroke-linecap="round"/></svg>
    <span class="topbar-breadcrumb" style="font-size:13px;font-weight:500;color:#0f172a;">Planning</span>
    <div style="flex:1;"></div>

    <!-- Date navigation -->
    <div style="display:flex;align-items:center;gap:6px;">
      <button class="btn btn-secondary btn-xs" onclick="prevPeriod()">
        <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M7.5 2l-4 4 4 4" stroke="#64748b" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>
      <button class="btn btn-secondary btn-xs" onclick="goToday()">Aujourd'hui</button>
      <button class="btn btn-secondary btn-xs" onclick="nextPeriod()">
        <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M4.5 2l4 4-4 4" stroke="#64748b" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>
      <span class="topbar-label" style="font-size:13.5px;font-weight:500;color:#0f172a;min-width:180px;text-align:center;" id="period-label"></span>
    </div>

    <div style="flex:1;"></div>

    <!-- View toggle -->
    <div class="topbar-view-toggle" style="display:flex;background:#f1f5f9;border-radius:8px;padding:2px;gap:1px;">
      <button class="view-btn active" id="view-day-btn" onclick="setView('day')">Jour</button>
      <button class="view-btn" id="view-week-btn" onclick="setView('week')">Semaine</button>
      <button class="view-btn" id="view-month-btn" onclick="setView('month')">Mois</button>
    </div>

    <!-- Add block -->
    <button class="btn btn-primary topbar-add-btn" onclick="openBlockPopup(null,null,null)">
      <svg width="11" height="11" fill="none" viewBox="0 0 12 12"><path d="M6 2v8M2 6h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      Ajouter un bloc
    </button>
  </div>

  <!-- LEGEND -->
  <div style="display:flex;align-items:center;gap:8px;padding:8px 18px;background:#fff;border-bottom:1px solid #e8edf2;flex-shrink:0;overflow-x:auto;">
    <span style="font-size:10.5px;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:.07em;flex-shrink:0;">Types :</span>
    <div id="legend-items" style="display:flex;gap:6px;flex-wrap:nowrap;"></div>
  </div>

  <!-- PLANNING -->
  <div class="planning-wrap" id="planning-wrap">
    <!-- Filled by JS -->
  </div>

</div><!-- .content -->

</div><!-- /planning shell flex wrapper -->

<!-- ══ POPUP BLOC ══ -->
<div class="popup-overlay" id="block-overlay" onclick="if(event.target===this) closePopup()">
  <div class="popup-box" id="block-popup">

    <div style="padding:16px 20px 14px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
      <p style="font-size:14px;font-weight:700;color:#0f172a;" id="popup-title">Nouveau bloc</p>
      <div style="display:flex;gap:6px;align-items:center;">
        <button id="popup-delete-btn" onclick="deleteBlock()" class="btn btn-danger btn-xs" style="display:none;">
          <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M2 3h8M5 3V2h2v1M4 3v7h4V3H4z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Supprimer
        </button>
        <button onclick="closePopup()" style="width:26px;height:26px;border-radius:7px;border:none;background:#f1f5f9;cursor:pointer;display:flex;align-items:center;justify-content:center;" onmouseenter="this.style.background='#e2e8f0'" onmouseleave="this.style.background='#f1f5f9'">
          <svg width="9" height="9" fill="none" viewBox="0 0 8 8"><path d="M1 1l6 6M7 1L1 7" stroke="#64748b" stroke-width="1.3" stroke-linecap="round"/></svg>
        </button>
      </div>
    </div>

    <div style="padding:16px 20px;display:flex;flex-direction:column;gap:13px;">

      <!-- Activity type -->
      <div>
        <label class="form-label">Type d'activité</label>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;" id="activity-type-grid">
          <!-- Filled by JS -->
        </div>
      </div>

      <!-- Veterinarian -->
      <div>
        <label class="form-label">Vétérinaire</label>
        <select class="form-input" id="popup-vet">
          <option value="rousseau">Dr. Rousseau</option>
          <option value="martin">Dr. Martin</option>
          <option value="dupont">Dr. Dupont</option>
          <option value="lambert">Dr. Lambert</option>
        </select>
      </div>

      <!-- Date + times -->
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;">
        <div>
          <label class="form-label">Date</label>
          <input type="date" class="form-input" id="popup-date" value="2026-03-23">
        </div>
        <div>
          <label class="form-label">Début</label>
          <input type="time" class="form-input" id="popup-start" value="08:00">
        </div>
        <div>
          <label class="form-label">Fin</label>
          <input type="time" class="form-input" id="popup-end" value="12:00">
        </div>
      </div>

      <!-- Appointment capacity (hidden for leave) -->
      <div id="popup-capacity-row">
        <label class="form-label">Capacité max de RDV <span style="font-weight:400;color:#94a3b8;">(par heure)</span></label>
        <div style="display:flex;gap:6px;align-items:center;">
          <input type="range" id="popup-capacity" min="1" max="8" value="3" style="-webkit-appearance:none;flex:1;height:4px;border-radius:2px;background:linear-gradient(to right,#4338ca 37.5%,#e2e8f0 37.5%);outline:none;" oninput="updateCapacityDisplay(this)">
          <span style="font-size:14px;font-weight:700;color:#4338ca;min-width:24px;text-align:center;" id="popup-capacity-val">3</span>
          <span style="font-size:11px;color:#94a3b8;">RDV/h</span>
        </div>
      </div>

      <!-- Recurrence -->
      <div style="display:flex;align-items:center;gap:10px;padding:10px 12px;background:#f8fafc;border:1px solid #e8edf2;border-radius:9px;">
        <svg width="13" height="13" fill="none" viewBox="0 0 16 16" style="color:#94a3b8;flex-shrink:0;"><path d="M14 8a6 6 0 01-6 6 6 6 0 01-6-6 6 6 0 016-6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M14 4v4h-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span style="font-size:12.5px;color:#334155;flex:1;">Répéter ce bloc</span>
        <select class="form-input" id="popup-recurrence" style="width:auto;padding:4px 10px;font-size:12px;">
          <option value="none">Aucune</option>
          <option value="daily">Chaque jour</option>
          <option value="weekly">Chaque semaine</option>
          <option value="weekdays">Jours ouvrés</option>
        </select>
      </div>

      <!-- Note -->
      <div>
        <label class="form-label">Note <span style="font-weight:400;color:#94a3b8;">(optionnel)</span></label>
        <input type="text" class="form-input" id="popup-note" placeholder="Ex : Retour de congé maternité, Formation externe…">
      </div>

    </div>

    <div style="padding:12px 20px 16px;border-top:1px solid #f1f5f9;display:flex;gap:8px;justify-content:flex-end;">
      <button onclick="closePopup()" class="btn btn-secondary">Annuler</button>
      <button onclick="saveBlock()" class="btn btn-primary">
        <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Enregistrer
      </button>
    </div>
  </div>
</div>

<!-- TOAST -->
<div id="toast"></div>
{% endblock %}

