{#
 # Kiveto — templates/clinic/scheduling/planning.html.twig
 # ────────────────────────────────────────────────────────
 # Planning page — horizontal vet-row grid showing activity blocks.
 # Source: vetos-planning.html mockup
 #
 # Variables:
 #   currentClinicId     string   Active clinic UUID
 #   currentClinicName   string   Active clinic display name
 #}
{% extends 'clinic/base.html.twig' %}

{% block show_sidebar %}false{% endblock %}

{% block page_title %}Planning{% endblock %}

{% block stylesheets %}
<style>
  /* Override base layout for full-height planning grid */
  .app-scroll { overflow: hidden !important; }
  .app-body { padding: 0 !important; display: flex; flex-direction: column; overflow: hidden; height: 100%; }

  /* ── Mini calendar (reused from agenda) ── */
  .mini-cal { padding: 12px 14px; border-bottom: 1px solid #f1f5f9; flex-shrink: 0; }
  .mini-cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .mini-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
  .mini-cal-dow { font-size: 10px; font-weight: 600; color: #94a3b8; text-align: center; padding-bottom: 2px; }
  .mini-cal-day {
    aspect-ratio: 1; display: flex; align-items: center; justify-content: center;
    font-size: 11px; border-radius: 5px; cursor: pointer; transition: all .1s;
    color: #475569; position: relative;
  }
  .mini-cal-day:hover { background: #f1f5f9; }
  .mini-cal-day.today { background: var(--brand-600, #4338ca); color: #fff; font-weight: 700; }
  .mini-cal-day.other-month { color: #cbd5e1; }

  /* ── Vet filter ── */
  .vet-filter { padding: 10px 14px; border-bottom: 1px solid #f1f5f9; flex-shrink: 0; }
  .vet-chip {
    display: flex; align-items: center; gap: 7px;
    padding: 5px 8px; border-radius: 7px; cursor: pointer;
    transition: background .1s; margin-bottom: 3px;
  }
  .vet-chip:hover { background: #f8fafc; }
  .vet-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }

  /* ── Planning layout ── */
  .planning-shell {
    display: flex; flex: 1; overflow: hidden; min-height: 0;
  }

  /* Left panel (mini-cal + vet filters) */
  .planning-left {
    width: 232px; flex-shrink: 0; background: #fff;
    border-right: 1px solid var(--border-light, #e8edf2);
    display: flex; flex-direction: column; overflow-y: auto;
  }

  /* Right area (topbar + grid) */
  .planning-right {
    flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0;
  }

  /* Planning topbar */
  .planning-topbar {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 18px; background: #fff;
    border-bottom: 1px solid var(--border-light, #e8edf2);
    flex-shrink: 0;
  }
  .planning-topbar .spacer { flex: 1; }

  /* View toggle buttons */
  .view-toggle { display: flex; background: #f1f5f9; border-radius: 8px; padding: 2px; gap: 1px; }
  .view-btn {
    padding: 4px 12px; border-radius: 6px; border: none;
    font-size: 12px; font-weight: 500; cursor: pointer;
    font-family: inherit; background: transparent; color: #64748b;
    transition: all .13s;
  }
  .view-btn.active { background: #fff; color: #0f172a; box-shadow: 0 1px 3px rgba(0,0,0,.08); }

  /* Legend bar */
  .planning-legend {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 18px; background: #fff;
    border-bottom: 1px solid var(--border-light, #e8edf2);
    flex-shrink: 0; overflow-x: auto;
  }
  .legend-label {
    font-size: 10.5px; font-weight: 600; color: #94a3b8;
    text-transform: uppercase; letter-spacing: .07em; flex-shrink: 0;
  }
  .legend-item {
    display: flex; align-items: center; gap: 4px;
    font-size: 11px; color: #334155; flex-shrink: 0;
  }
  .legend-dot { width: 8px; height: 8px; border-radius: 3px; flex-shrink: 0; }

  /* Planning grid */
  .planning-grid { flex: 1; overflow: auto; position: relative; background: #fff; }

  /* Time header row */
  .time-header {
    display: flex; position: sticky; top: 0; z-index: 10;
    background: #fff; border-bottom: 1px solid #e8edf2;
  }
  .time-header-label {
    width: 120px; flex-shrink: 0; background: #fff;
    border-right: 2px solid #e2e8f0;
  }
  .time-header-slots { display: flex; flex: 1; }
  .time-slot-header {
    flex: 1; min-width: 80px; text-align: center;
    font-size: 11px; font-weight: 600; color: #64748b;
    padding: 6px 0; border-left: 1px solid #e8edf2;
  }
  .time-slot-header:first-child { border-left: none; }

  /* Vet row */
  .vet-row {
    display: flex; position: relative;
    border-bottom: 1px solid #e8edf2; min-height: 64px;
  }
  .vet-label {
    width: 120px; flex-shrink: 0; background: #fff;
    border-right: 2px solid #e2e8f0;
    padding: 0 12px; display: flex; flex-direction: column;
    justify-content: center; gap: 2px;
    position: sticky; left: 0; z-index: 5;
  }
  .vet-label-name { font-size: 12.5px; font-weight: 600; color: #0f172a; }
  .vet-label-spec { font-size: 10.5px; color: #94a3b8; }
  .vet-row-grid {
    flex: 1; position: relative; display: flex; min-width: 0;
  }

  /* Hour slot backgrounds */
  .hour-slot {
    flex: 1; min-width: 80px; position: relative;
    border-left: 1px solid #e8edf2;
  }
  .hour-slot:first-child { border-left: none; }
  .hour-slot:hover { background: rgba(99,102,241,.04); }

  /* Activity blocks */
  .act-block {
    position: absolute; top: 6px; bottom: 6px;
    border-radius: 7px; cursor: pointer; overflow: hidden;
    transition: filter .12s; border-left: 3px solid transparent;
    z-index: 2;
  }
  .act-block:hover { filter: brightness(.95); }
  .act-block-inner {
    padding: 5px 8px; height: 100%; display: flex;
    flex-direction: column; justify-content: center; overflow: hidden;
  }
  .act-block-type {
    font-size: 10px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .06em; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis;
  }
  .act-block-time {
    font-size: 10.5px; font-weight: 500; white-space: nowrap; margin-top: 1px;
  }
  .act-block-cap {
    font-size: 9.5px; margin-top: 2px; opacity: .7; white-space: nowrap;
  }

  /* Small button styles */
  .btn-plan {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 9px; border-radius: 6px; font-size: 11.5px;
    font-weight: 500; font-family: inherit; cursor: pointer;
    border: none; transition: all .13s; white-space: nowrap;
  }
  .btn-plan-secondary {
    background: #f8fafc; color: #374151;
    border: 1px solid #e2e8f0;
  }
  .btn-plan-secondary:hover { background: #f1f5f9; border-color: #cbd5e1; }
  .btn-plan-primary {
    background: var(--brand-600, #4338ca); color: #fff;
  }
  .btn-plan-primary:hover { background: var(--brand-700, #3730a3); }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .planning-left { width: 200px; }
  }
  @media (max-width: 640px) {
    .planning-left { display: none; }
    .planning-topbar { padding: 8px 10px; gap: 6px; }
  }
</style>
{% endblock %}

{% block content %}
