        </div>
        <div class="vet-row-grid">
          <div class="hour-slot"></div><div class="hour-slot"></div><div class="hour-slot"></div>
          <div class="hour-slot"></div><div class="hour-slot"></div><div class="hour-slot"></div>
          <div class="hour-slot"></div><div class="hour-slot"></div><div class="hour-slot"></div>
