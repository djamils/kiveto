            <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M7.5 2l-4 4 4 4" stroke="#64748b" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button style="width:22px;height:22px;border-radius:5px;border:none;background:#f1f5f9;cursor:pointer;display:flex;align-items:center;justify-content:center;">
