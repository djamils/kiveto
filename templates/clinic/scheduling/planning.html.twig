        <div class="mini-cal-day other-month">3</div>
      </div>
    </div>

    {# Vet filters #}
    <div class="vet-filter">
      <p style="font-size:10px;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px;">
