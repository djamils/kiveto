{#
 # Kiveto — templates/clinic/scheduling/waiting-room/index.html.twig
 # ─────────────────────────────────────────────────────────────────
 # Waiting room — real-time queue management.
 #
 # Variables:
 #   currentDate      string   Today's date in French (e.g. "Samedi 19 avril 2026")
 #   countWaiting     int      # entries in WAITING status
 #   countService     int      # entries in IN_SERVICE status
 #   countEmergency   int      # entries with EMERGENCY arrival mode
 #   currentClinicId  string   Active clinic UUID
 #   currentClinicName string  Active clinic display name
 #}
{% extends 'clinic/base.html.twig' %}

{% block show_topbar %}false{% endblock %}
{% block page_title %}Salle d'attente{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/pages/scheduling/waiting-room.css') }}"/>
{% endblock %}

{% block content %}
<div data-controller="waiting-room" style="display:contents">
  {% include 'clinic/scheduling/waiting-room/_topbar.html.twig' %}

  <div class="page-body">
    {% include 'clinic/scheduling/waiting-room/_queue_panel.html.twig' %}
    {% include 'clinic/scheduling/waiting-room/_control_panel.html.twig' %}
  </div>

  <!-- FABs (mobile/tablet) -->
  <div class="fab-group" id="fab-group">
    <button class="fab fab-danger"
            data-action="waiting-room#openModal"
            data-waiting-room-modal-id-param="modal-urgence">
      <i data-lucide="alert-triangle" class="wr-icon-fab"></i> Urgence
    </button>
    <button class="fab fab-primary"
            data-action="waiting-room#openModal"
            data-waiting-room-modal-id-param="modal-checkin">
      <i data-lucide="plus" class="wr-icon-fab"></i> Check-in patient
    </button>
  </div>

  {% include 'clinic/scheduling/waiting-room/_modals.html.twig' %}
</div>

<div id="wr-toast"></div>
{% endblock %}
