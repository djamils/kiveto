{# Detail panel — WaitingRoomEntryDetailsDTO #}

{% set rawDesc     = entry.foundAnimalDescription ?? '' %}
{% set animalName  = rawDesc ? (rawDesc|split('(')|first|trim|split(' ')|first) : 'Patient' %}
{% set initials    = animalName|slice(0, 2)|upper %}
{% set speciesPart = '' %}
{% if '(' in rawDesc %}
  {% set speciesPart = rawDesc|split('(')|last|split(')')|first %}
{% endif %}

{% set avatarBg    = entry.arrivalMode == 'EMERGENCY' ? '#fef2f2' : '#eef2ff' %}
{% set avatarColor = entry.arrivalMode == 'EMERGENCY' ? '#dc2626' : '#4338ca' %}

{% set arrivedTs = entry.arrivedAtUtc|date('U') %}
{% set nowTs     = 'now'|date('U') %}
{% set waitMin   = (((nowTs - arrivedTs) / 60)|round)|abs %}
{% set waitH     = (waitMin / 60)|round(0, 'floor') %}
{% set waitM     = waitMin % 60 %}

{% set priorityLabel = entry.priority == 2 ? 'Urgence' : (entry.priority == 1 ? 'Prioritaire' : 'Normal') %}
{% set priorityColor = entry.priority == 2 ? '#dc2626' : (entry.priority == 1 ? '#d97706' : 'var(--text-subtle,#94a3b8)') %}

<turbo-frame id="patient-detail">

  {# ── Triage modal (rendered with fresh data on each patient load) ── #}
  <div class="modal-overlay hidden" id="modal-triage"
       data-action="click->waiting-room#closeOnOverlayClick">
    <div class="modal modal-narrow">
      <div class="modal-head">
        <p class="modal-title">Modifier le triage</p>
        <button class="cv-modal-close"
                data-action="waiting-room#closeModal"
                data-waiting-room-modal-id-param="modal-triage">
          <svg width="9" height="9" fill="none" viewBox="0 0 8 8"><path d="M1 1l6 6M7 1L1 7" stroke="#64748b" stroke-width="1.3" stroke-linecap="round"/></svg>
        </button>
      </div>
      <form method="post"
            action="{{ path('clinic_scheduling_waitingroom_triage', {entryId: entry.waitingRoomEntryId}) }}"
            data-turbo-frame="_top">
        <input type="hidden" name="_token" value="{{ csrf_token('waiting_room_action') }}">
        <div class="modal-body" style="display:flex;flex-direction:column;gap:var(--space-3,12px)">
          <div class="form-row">
            <label class="form-label">Mode d'arriv&eacute;e</label>
            <select name="arrivalMode" class="form-input">
              <option value="STANDARD" {{ entry.arrivalMode == 'STANDARD' ? 'selected' : '' }}>Standard</option>
              <option value="EMERGENCY" {{ entry.arrivalMode == 'EMERGENCY' ? 'selected' : '' }}>Urgence</option>
            </select>
          </div>
          <div class="form-row">
            <label class="form-label">Priorit&eacute;</label>
            <select name="priority" class="form-input">
              <option value="0" {{ entry.priority == 0 ? 'selected' : '' }}>Normal</option>
              <option value="1" {{ entry.priority == 1 ? 'selected' : '' }}>Prioritaire</option>
              <option value="2" {{ entry.priority == 2 ? 'selected' : '' }}>Urgence</option>
            </select>
          </div>
          <div class="form-row">
            <label class="form-label">Notes de triage</label>
            <textarea name="triageNotes" class="form-input" rows="3" placeholder="Sympt&ocirc;mes, observations&hellip;">{{ entry.triageNotes }}</textarea>
          </div>
        </div>
        <div class="modal-foot">
          <button type="button" class="btn btn-secondary btn-sm"
                  data-action="waiting-room#closeModal"
                  data-waiting-room-modal-id-param="modal-triage">Annuler</button>
          <button type="submit" class="btn btn-primary btn-sm">Enregistrer</button>
        </div>
      </form>
    </div>
  </div>

  {# ── Main detail widget ── #}
  <div class="widget" style="margin-bottom:var(--space-3,12px)">

    {# Header: avatar + name + actions #}
    <div style="padding:var(--space-4,16px);border-bottom:1px solid var(--border-light);display:flex;align-items:flex-start;gap:var(--space-3,12px)">
      <div style="width:44px;height:44px;border-radius:var(--radius-full,9999px);background:{{ avatarBg }};color:{{ avatarColor }};display:flex;align-items:center;justify-content:center;font-size:var(--text-base,14px);font-weight:var(--weight-medium,500);flex-shrink:0">{{ initials }}</div>

      <div style="flex:1;min-width:0">
        <div style="display:flex;align-items:center;gap:var(--space-2,8px);flex-wrap:wrap;margin-bottom:2px">
          <h2 style="font-size:var(--text-lg,16px);font-weight:var(--weight-medium,500);color:var(--text-primary)">{{ animalName }}</h2>
          {% if speciesPart %}
            <span style="font-size:var(--text-md,14px);color:var(--text-muted)">{{ speciesPart }}</span>
          {% endif %}
          {% if entry.arrivalMode == 'EMERGENCY' %}
            <span class="badge b-urgence">URGENCE</span>
          {% elseif entry.status == 'IN_SERVICE' %}
            <span class="badge b-exam">En consultation</span>
          {% else %}
            <span class="badge b-wait">En attente</span>
          {% endif %}
        </div>
        <p style="font-size:var(--text-sm,13px);color:var(--text-subtle)">
          {{ entry.origin == 'WALK_IN' ? 'Walk-in — sans rendez-vous' : 'Depuis un rendez-vous' }}
        </p>
      </div>

      {# Action buttons #}
      <div style="display:flex;gap:var(--space-1,4px);flex-wrap:wrap;justify-content:flex-end">
        {% if entry.status in ['WAITING', 'CALLED'] %}
          <form method="post"
                action="{{ path('clinic_scheduling_waitingroom_start_from_queue', {entryId: entry.waitingRoomEntryId}) }}"
                data-turbo-frame="_top">
            <input type="hidden" name="_token" value="{{ csrf_token('waiting_room_action') }}">
            <button type="submit" class="btn btn-primary btn-xs">
              <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              Prendre en charge
            </button>
          </form>
        {% endif %}
        {% if entry.status == 'IN_SERVICE' %}
          <form method="post"
                action="{{ path('clinic_scheduling_waitingroom_close_from_queue', {entryId: entry.waitingRoomEntryId}) }}"
                data-turbo-frame="_top">
            <input type="hidden" name="_token" value="{{ csrf_token('waiting_room_action') }}">
            <button type="submit" class="btn btn-secondary btn-xs">Terminer</button>
          </form>
        {% endif %}
      </div>
    </div>

    {# Body: KPIs + detail rows #}
    <div style="padding:var(--space-3,12px) var(--space-4,16px)">

      {# KPI row #}
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:var(--space-2,8px);margin-bottom:var(--space-3,12px)">

        {# KPI: Attente #}
        <div class="pd-kpi">
          <p class="pd-kpi-label">Attente</p>
          <p class="pd-kpi-val" style="color:#dc2626">
            {%- if waitH > 0 -%}{{ waitH }}h{{ waitM < 10 ? '0' : '' }}{{ waitM }}{%- else -%}{{ waitM }}min{%- endif -%}
          </p>
        </div>

        {# KPI: Priorité — flèches ▲▼ #}
        <div class="pd-kpi" style="gap:4px">
          <p class="pd-kpi-label">Priorit&eacute;</p>
          <div style="display:flex;align-items:center;justify-content:center;gap:var(--space-1,4px);margin-top:2px">
            {# ▼ — baisser #}
            {% if entry.priority > 0 %}
              <form method="post"
                    action="{{ path('clinic_scheduling_waitingroom_triage', {entryId: entry.waitingRoomEntryId}) }}"
                    data-turbo-frame="_top"
                    style="display:contents">
                <input type="hidden" name="_token" value="{{ csrf_token('waiting_room_action') }}">
                <input type="hidden" name="arrivalMode" value="{{ entry.arrivalMode }}">
                <input type="hidden" name="priority" value="{{ entry.priority - 1 }}">
                <input type="hidden" name="triageNotes" value="{{ entry.triageNotes ?? '' }}">
                <button type="submit"
                        title="R&eacute;duire la priorit&eacute;"
                        style="display:flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:var(--radius-md,8px);border:1px solid var(--border-medium);background:var(--surface-subtle);cursor:pointer;transition:.15s;flex-shrink:0">
                  <svg width="10" height="10" fill="none" viewBox="0 0 10 10"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </form>
            {% else %}
              <span style="display:flex;align-items:center;justify-content:center;width:22px;height:22px;flex-shrink:0;opacity:.2">
                <svg width="10" height="10" fill="none" viewBox="0 0 10 10"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            {% endif %}

            <span style="font-size:var(--text-sm,13px);font-weight:var(--weight-medium,500);color:{{ priorityColor }};white-space:nowrap">{{ priorityLabel }}</span>

            {# ▲ — monter #}
            {% if entry.priority < 2 %}
              <form method="post"
                    action="{{ path('clinic_scheduling_waitingroom_triage', {entryId: entry.waitingRoomEntryId}) }}"
                    data-turbo-frame="_top"
                    style="display:contents">
                <input type="hidden" name="_token" value="{{ csrf_token('waiting_room_action') }}">
                <input type="hidden" name="arrivalMode" value="{{ entry.arrivalMode }}">
                <input type="hidden" name="priority" value="{{ entry.priority + 1 }}">
                <input type="hidden" name="triageNotes" value="{{ entry.triageNotes ?? '' }}">
                <button type="submit"
                        title="Augmenter la priorit&eacute;"
                        style="display:flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:var(--radius-md,8px);border:1px solid var(--border-medium);background:var(--surface-subtle);cursor:pointer;transition:.15s;flex-shrink:0">
                  <svg width="10" height="10" fill="none" viewBox="0 0 10 10"><path d="M2 6.5l3-3 3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </form>
            {% else %}
              <span style="display:flex;align-items:center;justify-content:center;width:22px;height:22px;flex-shrink:0;opacity:.2">
                <svg width="10" height="10" fill="none" viewBox="0 0 10 10"><path d="M2 6.5l3-3 3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            {% endif %}
          </div>
        </div>

        {# KPI: RDV #}
        <div class="pd-kpi">
          <p class="pd-kpi-label">RDV</p>
          <p class="pd-kpi-val" style="font-size:var(--text-base,14px);color:{{ entry.linkedAppointmentId ? '#059669' : '#d97706' }}">
            {{ entry.linkedAppointmentId ? 'Oui' : 'Non' }}
          </p>
        </div>

      </div>

      {# Detail rows #}
      {% if entry.triageNotes %}
        <div class="pd-row">
          <span class="pd-label">Motif</span>
          <span style="font-size:var(--text-md,14px);font-weight:var(--weight-medium,500);color:var(--text-primary);text-align:right;max-width:200px">{{ entry.triageNotes }}</span>
        </div>
      {% endif %}

      <div class="pd-row">
        <span class="pd-label">Statut</span>
        <span style="font-size:var(--text-md,14px);font-weight:var(--weight-medium,500);color:var(--text-primary)">
          {% if entry.status == 'WAITING' %}En attente
          {% elseif entry.status == 'IN_SERVICE' %}En consultation
          {% elseif entry.status == 'CALLED' %}Appel&eacute;
          {% else %}{{ entry.status }}{% endif %}
        </span>
      </div>

      <div class="pd-row">
        <span class="pd-label">Arriv&eacute;e</span>
        <span style="font-size:var(--text-md,14px);color:var(--text-primary)">{{ entry.arrivedAtUtc|date('H:i') }}</span>
      </div>

      {% if entry.serviceStartedAtUtc %}
        <div class="pd-row">
          <span class="pd-label">Consultation</span>
          <span style="font-size:var(--text-md,14px);color:var(--text-primary)">{{ entry.serviceStartedAtUtc|date('H:i') }}</span>
        </div>
      {% endif %}

      {# Triage edit trigger #}
      <div style="margin-top:var(--space-3,12px);padding-top:var(--space-3,12px);border-top:1px solid var(--border-light)">
        <button class="btn btn-secondary btn-xs"
                data-action="waiting-room#openModal"
                data-waiting-room-modal-id-param="modal-triage">
          <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M8.5 1.5l2 2L4 10H2v-2l6.5-6.5z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Modifier le triage
        </button>
      </div>

    </div>
  </div>

</turbo-frame>
