{# Turbo Frame: queue-head + filter tabs + queue cards #}

{% set palette = [
  {bg: '#eef2ff', color: '#4338ca'},
  {bg: '#ecfdf5', color: '#059669'},
  {bg: '#eff6ff', color: '#2563eb'},
  {bg: '#f5f3ff', color: '#7c3aed'},
  {bg: '#fdf2f8', color: '#db2777'},
  {bg: '#ecfeff', color: '#0891b2'},
  {bg: '#fffbeb', color: '#f59e0b'},
  {bg: '#fff7ed', color: '#ea580c'},
] %}

<turbo-frame id="waiting-queue">

  <!-- Queue head -->
  <div class="queue-head">
    <span class="wr-queue-title">File d'attente</span>
    <span class="wr-queue-count" id="queue-count">{{ entries|length }} patient{{ entries|length > 1 ? 's' : '' }}</span>
  </div>

  <!-- Filter tabs -->
  <div class="queue-filter">
    <a href="{{ path('clinic_scheduling_waitingroom_queue', {filter: 'all'}) }}"
       data-turbo-frame="waiting-queue"
       class="qf-tab {{ currentFilter == 'all' ? 'active' : '' }}">Tous</a>
    <a href="{{ path('clinic_scheduling_waitingroom_queue', {filter: 'urgence'}) }}"
       data-turbo-frame="waiting-queue"
       class="qf-tab urg {{ currentFilter == 'urgence' ? 'active' : '' }}">Urgences</a>
    <a href="{{ path('clinic_scheduling_waitingroom_queue', {filter: 'attente'}) }}"
       data-turbo-frame="waiting-queue"
       class="qf-tab {{ currentFilter == 'attente' ? 'active' : '' }}">En attente</a>
    <a href="{{ path('clinic_scheduling_waitingroom_queue', {filter: 'consultation'}) }}"
       data-turbo-frame="waiting-queue"
       class="qf-tab {{ currentFilter == 'consultation' ? 'active' : '' }}">Consultation</a>
  </div>

  <!-- Queue list -->
  {% if entries is empty %}
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:48px 16px;color:var(--text-subtle,#94a3b8)">
      <i data-lucide="inbox" style="width:32px;height:32px;opacity:.4"></i>
      <p style="font-size:var(--text-sm,13px)">Aucun patient en salle d'attente</p>
    </div>
  {% else %}
    <div class="queue-list" id="queue-list">
      {% for entry in entries %}
        {# --- Parse foundAnimalDescription: "Name (Species Breed) — Mme Owner" --- #}
        {% set rawDesc    = entry.foundAnimalDescription ?? '' %}
        {% set animalName = rawDesc ? (rawDesc|split('(')|first|trim|split(' ')|first) : ('Entrée') %}
        {% set initials   = animalName|slice(0, 2)|upper %}
        {% set speciesPart = '' %}
        {% if '(' in rawDesc %}
          {% set speciesPart = rawDesc|split('(')|last|split(')')|first %}
        {% endif %}

        {# --- Avatar colors (cycle through palette; EMERGENCY overrides) --- #}
        {% set c = palette[loop.index0 % palette|length] %}

        {# --- Wait time --- #}
        {% set arrivedTs = entry.arrivedAtUtc|date('U') %}
        {% set nowTs     = 'now'|date('U') %}
        {% set waitMin   = (((nowTs - arrivedTs) / 60)|round)|abs %}
        {% set waitH     = (waitMin / 60)|round(0, 'floor') %}
        {% set waitM     = waitMin % 60 %}

        {# --- CSS classes --- #}
        {% set stripeClass = entry.arrivalMode == 'EMERGENCY' ? 'urgence'
          : (entry.priority >= 1 ? 'prio'
          : (entry.status == 'IN_SERVICE' ? 'consult' : 'attente')) %}

        <div class="qcard {{ entry.arrivalMode == 'EMERGENCY' ? 'urgence' : '' }}" id="qcard-{{ entry.id|slice(0, 8) }}">
          <div class="qcard-stripe {{ stripeClass }}"></div>
          <a href="{{ path('clinic_scheduling_waitingroom_entry_details', {entryId: entry.id}) }}"
             class="qcard-body"
             data-turbo-frame="patient-detail"
             style="text-decoration:none">

            {# Avatar #}
            {% if entry.arrivalMode == 'EMERGENCY' %}
              <div style="width:40px;height:40px;border-radius:var(--radius-md,8px);background:#fef2f2;border:1px solid #fecaca;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="18" height="18" fill="none" viewBox="0 0 14 14">
                  <path d="M7 2l5 9H2l5-9z" stroke="#dc2626" stroke-width="1.4" stroke-linejoin="round"/>
                  <path d="M7 5.5v2M7 9h.01" stroke="#dc2626" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
              </div>
            {% else %}
              <div style="width:40px;height:40px;border-radius:var(--radius-full,9999px);background:{{ c.bg }};color:{{ c.color }};display:flex;align-items:center;justify-content:center;font-size:var(--text-sm,13px);font-weight:600;flex-shrink:0;">{{ initials }}</div>
            {% endif %}

            {# Info #}
            <div style="flex:1;min-width:0;">
              <div style="display:flex;align-items:center;gap:var(--space-1,4px);margin-bottom:2px;">
                <p class="qcard-name">{{ animalName }}</p>
                {% if entry.origin == 'WALK_IN' %}
                  <span style="font-size:10px;font-weight:600;color:#d97706;background:#fff7ed;border:1px solid #fde68a;border-radius:var(--radius-full,9999px);padding:0 var(--space-1,4px);">Sans RDV</span>
                {% endif %}
              </div>
              {% if speciesPart %}
                <p class="qcard-race">{{ speciesPart }}</p>
              {% endif %}
              {% if entry.triageNotes %}
                <p class="qcard-motif">{{ entry.triageNotes }}</p>
              {% endif %}
              <div class="qcard-meta" style="display:flex;align-items:center;gap:var(--space-1,4px);">
                <span>Non assign&eacute;</span>
              </div>
            </div>

            {# Right: status badge + wait time #}
            <div class="qcard-right">
              {% if entry.arrivalMode == 'EMERGENCY' %}
                <span style="font-size:var(--text-xs,11px);font-weight:var(--weight-medium,500);color:#dc2626;background:#fef2f2;padding:2px var(--space-2,8px);border-radius:var(--radius-full,9999px);">URGENCE</span>
              {% elseif entry.priority >= 1 %}
                <span style="font-size:var(--text-xs,11px);font-weight:var(--weight-medium,500);color:#d97706;background:#fffbeb;padding:2px var(--space-2,8px);border-radius:var(--radius-full,9999px);">Prioritaire</span>
              {% elseif entry.status == 'IN_SERVICE' %}
                <span style="font-size:var(--text-xs,11px);font-weight:var(--weight-medium,500);color:#2563eb;background:#eff6ff;padding:2px var(--space-2,8px);border-radius:var(--radius-full,9999px);">En consultation</span>
              {% elseif entry.status == 'CALLED' %}
                <span style="font-size:var(--text-xs,11px);font-weight:var(--weight-medium,500);color:#d97706;background:#fff7ed;padding:2px var(--space-2,8px);border-radius:var(--radius-full,9999px);">Appel&eacute;</span>
              {% else %}
                <span style="font-size:var(--text-xs,11px);font-weight:var(--weight-medium,500);color:#64748b;background:#f8fafc;padding:2px var(--space-2,8px);border-radius:var(--radius-full,9999px);">En attente</span>
              {% endif %}

              {% if entry.status != 'IN_SERVICE' %}
                <span class="wait-big" style="color:#dc2626;">
                  {%- if waitH > 0 -%}{{ waitH }}h{{ waitM < 10 ? '0' : '' }}{{ waitM }}{%- else -%}{{ waitM }}min{%- endif -%}
                </span>
                <span class="wait-label">d'attente</span>
              {% endif %}
            </div>

          </a>
        </div>
      {% endfor %}
    </div>
  {% endif %}

</turbo-frame>
