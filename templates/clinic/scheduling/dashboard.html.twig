// === UTILS ===
function getWeekStart(d){
  const day = d.getDay();
  const diff = (day === 0) ? -6 : 1 - day;
  const s = new Date(d);
  s.setDate(d.getDate() + diff);
  s.setHours(0,0,0,0);
  return s;
}
function addDays(d, n){ const r = new Date(d); r.setDate(r.getDate()+n); return r; }
function fmtDate(d){ return d.toISOString().split('T')[0]; }
function fmtTime(hhmm){ const [h,m]=hhmm.split(':'); return h+'h'+(m==='00'?'':m); }
function timeToMin(hhmm){ const [h,m]=hhmm.split(':'); return +h*60+ +m; }
function minToTime(m){ return String(Math.floor(m/60)).padStart(2,'0')+':'+String(m%60).padStart(2,'0'); }
const DOW_FR = ['Dim','Lun','Mar','Mer','Jeu','Ven','Sam'];
const MONTHS_FR = ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'];

// === MINI CALENDAR ===
function renderMiniCal(){
  const y = miniCalDate.getFullYear(), m = miniCalDate.getMonth();
  document.getElementById('mini-month').textContent = MONTHS_FR[m]+' '+y;
  const grid = document.getElementById('mini-cal-grid');
  grid.innerHTML = '';
  ['L','M','M','J','V','S','D'].forEach(function(d){
    var el = document.createElement('div');
    el.className = 'mini-cal-dow';
    el.textContent = d;
    grid.appendChild(el);
  });
  const first = new Date(y, m, 1);
  const startDow = (first.getDay()+6)%7;
  const days = new Date(y, m+1, 0).getDate();
  for(var i=0;i<startDow;i++){ grid.appendChild(document.createElement('div')); }
  const rdvDates = new Set(appointments.map(function(a){return a.date;}));
  for(var d=1;d<=days;d++){
    var el = document.createElement('div');
    el.className = 'mini-cal-day';
    el.textContent = d;
    var thisDate = new Date(y,m,d);
    var dateStr = fmtDate(thisDate);
    if(fmtDate(thisDate)===fmtDate(today)) el.classList.add('today');
    var ws = getWeekStart(thisDate);
    if(fmtDate(ws)===fmtDate(currentWeekStart)) el.classList.add('selected');
    if(rdvDates.has(dateStr)) el.classList.add('has-rdv');
    (function(td,ds){
      el.onclick = function(){ currentWeekStart = getWeekStart(td); selectedDay = ds; renderWeek(); renderMiniCal(); };
    })(thisDate, dateStr);
    grid.appendChild(el);
  }
}
function miniCalPrev(){ miniCalDate.setMonth(miniCalDate.getMonth()-1); renderMiniCal(); }
function miniCalNext(){ miniCalDate.setMonth(miniCalDate.getMonth()+1); renderMiniCal(); }

// === WEEK RENDER ===
const HOUR_START = 7;
const HOUR_END = 20;
const SLOT_H = 80;

function renderWeek(){
  var head = document.getElementById('agenda-head');
  var inner = document.getElementById('agenda-inner');
  var cols = currentView === 'week' ? 7 : 1;
  var gridCols = '55px repeat('+cols+',1fr)';
  var headCols = '55px repeat('+cols+',1fr) 6px';
  head.style.gridTemplateColumns = headCols;
  inner.style.gridTemplateColumns = gridCols;
  while(head.children.length > 1) head.removeChild(head.lastChild);
  inner.innerHTML = '';
  var days = [];
  for(var i=0;i<cols;i++) days.push(addDays(currentWeekStart, i));
  var ws = days[0], we = days[days.length-1];
  document.getElementById('week-label').textContent =
    currentView === 'week'
      ? ws.getDate()+' \u2013 '+we.getDate()+' '+MONTHS_FR[we.getMonth()]+' '+we.getFullYear()
      : DOW_FR[days[0].getDay()]+' '+days[0].getDate()+' '+MONTHS_FR[days[0].getMonth()];
  days.forEach(function(d, di){
    var isToday = fmtDate(d) === fmtDate(today);
    var isSelected = fmtDate(d) === selectedDay;
    var el = document.createElement('div');
    el.style.cssText = 'padding:8px 0;text-align:center;border-left:'+(di===0?'1px solid #dde3ea':'1px solid #f1f5f9')+';cursor:pointer;transition:background .1s;'+(isToday?'background:#f5f3ff;':isSelected?'background:#f8f7ff;':'');
    el.innerHTML = '<div style="font-size:10.5px;font-weight:600;color:'+(isToday?'#4338ca':isSelected?'#6366f1':'#94a3b8')+';text-transform:uppercase;letter-spacing:.06em;">'+DOW_FR[(d.getDay()+6)%7+1 < 7 ? (d.getDay()+6)%7+1 : 0]+'</div>'
      +'<div style="font-size:18px;font-weight:'+(isToday||isSelected?'800':'600')+';color:'+(isToday?'#4338ca':isSelected?'#6366f1':'#0f172a')+';line-height:1.1;margin-top:1px;">'+d.getDate()+'</div>'
      +'<div style="font-size:10px;color:#94a3b8;margin-top:1px;">'+countRdv(fmtDate(d))+' RDV</div>';
    (function(ds){ el.onclick = function(){ selectedDay = ds; renderWeek(); }; })(fmtDate(d));
    head.appendChild(el);
  });
  head.appendChild(document.createElement('div'));
  var timeCol = document.createElement('div');
  timeCol.className = 'time-col';
  for(var h=HOUR_START;h<=HOUR_END;h++){
    var lbl = document.createElement('div');
    lbl.className = 'time-label';
    lbl.textContent = String(h);
    timeCol.appendChild(lbl);
  }
  inner.appendChild(timeCol);
  days.forEach(function(d,di){
    var isToday = fmtDate(d) === fmtDate(today);
    var col = document.createElement('div');
    col.className = 'day-col';
    if(isToday) col.style.background = '#fdfcff';
    var totalH = (HOUR_END - HOUR_START + 1);
    col.style.height = (totalH * SLOT_H)+'px';
    col.style.position = 'relative';
    for(var h=HOUR_START;h<=HOUR_END;h++){
      var slotWrap = document.createElement('div');
      slotWrap.style.cssText = 'position:absolute;top:'+((h-HOUR_START)*SLOT_H)+'px;left:0;right:0;height:'+SLOT_H+'px;border-bottom:1px solid #c9d0d8;';
      var top2 = document.createElement('div');
      top2.style.cssText = 'position:absolute;top:0;left:0;right:0;height:50%;cursor:pointer;transition:background .1s;';
      top2.dataset.time = String(h).padStart(2,'0')+':00';
      top2.onmouseenter = function(){ this.style.background='#f5f3ff'; };
      top2.onmouseleave = function(){ this.style.background=''; };
      (function(dateStr, timeStr){ top2.onclick = function(e){ e.stopPropagation(); openNewRdv(dateStr, timeStr); }; })(fmtDate(d), top2.dataset.time);
      var bot = document.createElement('div');
      bot.style.cssText = 'position:absolute;bottom:0;left:0;right:0;height:50%;cursor:pointer;transition:background .1s;border-top:1px dashed #dde2e7;';
      bot.dataset.time = String(h).padStart(2,'0')+':30';
      bot.onmouseenter = function(){ this.style.background='#f5f3ff'; };
      bot.onmouseleave = function(){ this.style.background=''; };
      (function(dateStr, timeStr){ bot.onclick = function(e){ e.stopPropagation(); openNewRdv(dateStr, timeStr); }; })(fmtDate(d), bot.dataset.time);
      slotWrap.appendChild(top2);
      slotWrap.appendChild(bot);
      col.appendChild(slotWrap);
    }
    var dayAppts = appointments.filter(function(a){
      return a.date === fmtDate(d) && activeVets.has(a.vet) && activeMotifs.has(a.motif.split(' ')[0]);
    });
    var lanes = [];
    dayAppts.forEach(function(a){
      var s = timeToMin(a.start);
      var e = s + a.durationMin;
      var lane = 0;
      while(lanes[lane] && lanes[lane] > s) lane++;
      lanes[lane] = e;
      a._lane = lane;
    });
    var totalLanes = lanes.length || 1;
    dayAppts.forEach(function(a){ a._totalLanes = totalLanes; });
    dayAppts.forEach(function(a){
      var block = createRdvBlock(a);
      var laneW = 100 / a._totalLanes;
      var left = a._lane * laneW;
      block.style.left = 'calc('+left+'% + 3px)';
      block.style.right = 'calc('+(100 - left - laneW)+'% + 3px)';
      col.appendChild(block);
    });
    if(isToday){
      var nowMin = today.getHours()*60 + today.getMinutes();
      var startMin = HOUR_START * 60;
      if(nowMin >= startMin && nowMin <= HOUR_END*60){
        var topPx = (nowMin - startMin) / 60 * SLOT_H;
        var line = document.createElement('div');
        line.className = 'now-line';
        line.style.top = topPx+'px';
        line.innerHTML = '<div class="now-dot"></div>';
        col.appendChild(line);
      }
    }
    if(freeSlotsActive) renderFreeSlots(col, fmtDate(d));
    inner.appendChild(col);
  });
  var body = document.getElementById('agenda-body');
  body.scrollTop = (8 - HOUR_START) * SLOT_H;
}

function countRdv(dateStr){ return appointments.filter(function(a){ return a.date === dateStr && activeVets.has(a.vet); }).length; }

function createRdvBlock(a){
  var animal = ANIMALS.find(function(x){ return x.id === a.animalId; });
  var vet = VETS[a.vet];
  var startMin = timeToMin(a.start);
  var topPx = (startMin - HOUR_START*60) / 60 * SLOT_H + 1;
  var heightPx = Math.max(a.durationMin / 60 * SLOT_H - 3, 14);
  var motifColor = MOTIF_COLORS[a.motif.split(' ')[0]] || vet.color;
  var apptEnd = new Date(a.date + 'T' + minToTime(timeToMin(a.start) + a.durationMin));
  var isPast = !a.status && apptEnd < today;
  var isCancelled = a.status === 'cancelled';
  var lines = Math.floor((heightPx - 2) / 15);
  var block = document.createElement('div');
  block.className = 'rdv-block';
  block.dataset.id = a.id;
  var bg, borderColor, opacity = '1';
  if(isCancelled){ bg='#f1f5f9'; borderColor='#94a3b8'; opacity='0.8'; }
  else if(isPast){ bg='#e2e8f0'; borderColor=vet.color; opacity='0.8'; }
  else { bg=vet.bg; borderColor=vet.color; }
  block.style.cssText = 'top:'+topPx+'px;height:'+heightPx+'px;background:'+bg+';border-left-color:'+borderColor+';opacity:'+opacity+';overflow:hidden;';
  var nameColor = (isCancelled||isPast) ? '#334155' : '#0f172a';
  var subColor  = (isCancelled||isPast) ? '#475569' : '#64748b';
  var timeColor = (isCancelled||isPast) ? '#64748b' : vet.color;
  var strikethrough = isCancelled ? 'text-decoration:line-through;' : '';
  var cancelBadge = isCancelled ? '<span style="font-size:9px;background:#fee2e2;color:#dc2626;padding:0 3px;border-radius:2px;flex-shrink:0;margin-left:2px;">\u2715</span>' : '';
  var dot = '<span style="width:6px;height:6px;border-radius:50%;background:'+motifColor+';flex-shrink:0;display:inline-block;"></span>';
  var R = 'display:flex;align-items:center;gap:3px;overflow:hidden;white-space:nowrap;height:15px;min-height:15px;max-height:15px;flex-shrink:0;';
  var html = '<div style="display:flex;flex-direction:column;overflow:hidden;width:100%;height:'+(heightPx - 2)+'px;justify-content:center;">';
  if(lines <= 0){
    // Too small
  } else if(lines === 1){
    html += '<div style="'+R+'">'+dot+'<span style="font-size:10px;font-weight:700;color:'+timeColor+';flex-shrink:0;">'+fmtTime(a.start)+' \u00B7 '+a.durationMin+'min</span><span style="font-size:10px;color:'+nameColor+';'+strikethrough+'overflow:hidden;text-overflow:ellipsis;">\u00B7 '+(animal?animal.name:'?')+'</span>'+cancelBadge+'</div>';
  } else {
    html += '<div style="'+R+'">'+dot+'<span style="font-size:10px;font-weight:700;color:'+timeColor+';flex-shrink:0;">'+fmtTime(a.start)+' \u00B7 '+a.durationMin+'min</span>'+cancelBadge+'</div>';
    if(lines >= 2) html += '<div style="'+R+'"><span style="font-size:11.5px;font-weight:700;color:'+nameColor+';'+strikethrough+'overflow:hidden;text-overflow:ellipsis;">'+(animal?animal.emoji:'')+' '+(animal?animal.name:'?')+'</span></div>';
    if(lines >= 3) html += '<div style="'+R+'"><span style="font-size:10.5px;color:'+subColor+';overflow:hidden;text-overflow:ellipsis;">'+(animal?animal.owner:'')+'</span></div>';
    if(lines >= 4) html += '<div style="'+R+'"><span style="font-size:10.5px;color:'+(isCancelled?subColor:motifColor)+';font-weight:500;overflow:hidden;text-overflow:ellipsis;">'+a.motif+(a.note?' \u00B7 '+a.note:'')+'</span></div>';
  }
  html += '</div>';
  block.innerHTML = html;
  (function(id){ block.onclick = function(e){ e.stopPropagation(); showRdvPopup(id, e); }; })(a.id);
  return block;
}

// === POPUPS ===
function showRdvPopup(id, e){
  var a = appointments.find(function(x){ return x.id === id; });
  if(!a) return;
  var animal = ANIMALS.find(function(x){ return x.id === a.animalId; });
  var vet = VETS[a.vet];
  document.getElementById('pp-animal').textContent = (animal?animal.emoji:'')+' '+(animal?animal.name:'?');
  document.getElementById('pp-proprio').textContent = (animal?animal.owner:'')+' \u00B7 '+(animal?animal.phone:'');
  var badge = document.getElementById('pp-badge');
  badge.textContent = a.source === 'online' ? 'En ligne' : a.motif;
  badge.className = 'badge-agenda ' + (a.source === 'online' ? 'badge-online' : (a.motif==='Urgence'?'badge-urgent':'badge-followup'));
  document.getElementById('pp-time').textContent = a.start.replace(':',' h ')+' \u2014 '+minToTime(timeToMin(a.start)+a.durationMin).replace(':',' h ');
  document.getElementById('pp-duration').textContent = a.durationMin+' min';
  document.getElementById('pp-vet').textContent = vet.name;
  document.getElementById('pp-motif').textContent = a.motif;
  var noteRow = document.getElementById('pp-note-row');
  if(a.note){ noteRow.style.display='flex'; document.getElementById('pp-note').textContent = a.note; }
  else noteRow.style.display='none';
  var popup = document.getElementById('rdv-popup');
  popup.dataset.rdvId = id;
  positionPopup(popup, e);
  showPopup(popup);
}
function openNewRdv(date, hour){
  newRdvSlotDate = date;
  newRdvSlotHour = hour;
  var d = new Date(date);
  var dow = ['Dim','Lun','Mar','Mer','Jeu','Ven','Sam'];
  document.getElementById('new-rdv-slot').textContent = dow[d.getDay()]+' '+d.getDate()+' '+MONTHS_FR[d.getMonth()]+' \u00B7 '+hour.replace(':','\u00a0h\u00a0');
  document.getElementById('new-rdv-time').value = hour;
  resetNewRdvForm();
  showCenteredPopup(document.getElementById('new-rdv-popup'));
}
function openNewRdvGlobal(){
  newRdvSlotDate = fmtDate(today);
  newRdvSlotHour = '09:00';
  document.getElementById('new-rdv-slot').textContent = "Aujourd'hui \u00B7 09\u00a0h\u00a000";
  document.getElementById('new-rdv-time').value = '09:00';
  resetNewRdvForm();
  showCenteredPopup(document.getElementById('new-rdv-popup'));
}
function showCenteredPopup(popup){
  closeAllPopups();
  popup.style.display = 'block';
  popup.style.position = 'fixed';
  popup.style.top = '50%';
  popup.style.left = '50%';
  popup.style.transform = 'translate(-50%,-50%)';
  popup.style.right = 'auto';
  popup.style.zIndex = '500';
  document.getElementById('overlay').style.display = 'block';
}
function positionPopup(popup, e){
  var x = e.clientX, y = e.clientY;
  var w = 300, h = 300;
  var left = x + 12;
  var top = y - 40;
  if(left + w > window.innerWidth - 16) left = x - w - 12;
  if(top + h > window.innerHeight - 16) top = window.innerHeight - h - 16;
  popup.style.left = left + 'px';
  popup.style.top = Math.max(8, top) + 'px';
  popup.style.right = 'auto';
}
function showPopup(popup){
  closeAllPopups();
  popup.style.display = 'block';
  document.getElementById('overlay').style.display = 'block';
}
function closeAllPopups(){
  document.getElementById('rdv-popup').style.display='none';
  document.getElementById('new-rdv-popup').style.display='none';
  document.getElementById('overlay').style.display='none';
  document.getElementById('animal-suggestions').style.display='none';
}

// === NEW RDV FORM ===
function resetNewRdvForm(){
  document.getElementById('new-animal-input').value='';
  document.getElementById('new-note-input').value='';
  selectedAnimal = null;
  selectedMotif = '';
  selectedDuration = 20;
  document.querySelectorAll('.motif-chip').forEach(function(c){
    c.style.borderColor='#e2e8f0';c.style.background='#f8fafc';c.style.color='#64748b';
  });
  ['15','20','30','60'].forEach(function(d){
    var btn = document.getElementById('dur-'+d);
    if(!btn) return;
    btn.style.borderColor='#e2e8f0';btn.style.background='#fff';btn.style.color='#64748b';
  });
  document.getElementById('dur-20').style.borderColor='#4338ca';
  document.getElementById('dur-20').style.background='#eef2ff';
  document.getElementById('dur-20').style.color='#4338ca';
  updateEndTime();
}
function updateEndTime(){
  var timeInput = document.getElementById('new-rdv-time');
  if(!timeInput) return;
  var parts = timeInput.value.split(':').map(Number);
  var endMin = parts[0]*60+parts[1]+selectedDuration;
  var eh = String(Math.floor(endMin/60)).padStart(2,'0');
  var em = String(endMin%60).padStart(2,'0');
  var el = document.getElementById('new-rdv-end');
  if(el) el.textContent = eh+' h '+(em==='00'?'00':em);
}
function setDuration(d){
  selectedDuration = d;
  ['15','20','30','60'].forEach(function(v){
    var btn = document.getElementById('dur-'+v);
    if(!btn) return;
    var active = v==d;
    btn.style.borderColor = active ? '#4338ca' : '#e2e8f0';
    btn.style.background = active ? '#eef2ff' : '#fff';
    btn.style.color = active ? '#4338ca' : '#64748b';
  });
  updateEndTime();
}
function selectMotif(el, motif){
  selectedMotif = motif;
  document.querySelectorAll('.motif-chip').forEach(function(c){
    c.style.borderColor='#e2e8f0';c.style.background='#f8fafc';c.style.color='#64748b';
  });
  var col = MOTIF_COLORS[motif] || '#4338ca';
  el.style.borderColor=col;el.style.background=col+'18';el.style.color=col;
}
function searchAnimals(q){
  var box = document.getElementById('animal-suggestions');
  if(!q){ box.style.display='none'; return; }
  var results = ANIMALS.filter(function(a){
    return a.name.toLowerCase().indexOf(q.toLowerCase())>=0 || a.owner.toLowerCase().indexOf(q.toLowerCase())>=0;
  });
  if(!results.length){ box.style.display='none'; return; }
  box.innerHTML = results.map(function(a){
    return '<div onclick="selectAnimal('+a.id+')" style="display:flex;align-items:center;gap:8px;padding:8px 12px;cursor:pointer;transition:background .1s;" onmouseenter="this.style.background=\'#f8fafc\'" onmouseleave="this.style.background=\'\'">'
      +'<span style="font-size:16px;">'+a.emoji+'</span>'
      +'<div><p style="font-size:12.5px;font-weight:600;color:#0f172a;">'+a.name+'</p><p style="font-size:11px;color:#94a3b8;">'+a.breed+' \u00B7 '+a.owner+'</p></div>'
    +'</div>';
  }).join('');
  box.style.display='block';
}
function selectAnimal(id){
  selectedAnimal = ANIMALS.find(function(a){return a.id===id;});
  document.getElementById('new-animal-input').value = selectedAnimal.emoji+' '+selectedAnimal.name+' \u00B7 '+selectedAnimal.owner;
  document.getElementById('animal-suggestions').style.display='none';
}
function confirmNewRdv(){
  if(!selectedAnimal){ showToast('Sélectionner un patient', '#f59e0b'); return; }
  if(!selectedMotif){ showToast('Sélectionner un motif', '#f59e0b'); return; }
  var vet = document.getElementById('new-vet-select').value;
  var note = document.getElementById('new-note-input').value.trim();
  var source = document.getElementById('new-source-select').value;
  var timeVal = document.getElementById('new-rdv-time').value || newRdvSlotHour;
  appointments.push({ id: nextId++, animalId: selectedAnimal.id, date: newRdvSlotDate, start: timeVal, durationMin: selectedDuration, vet:vet, motif: selectedMotif, note:note, source:source });
  closeAllPopups();
  renderWeek();
  renderMiniCal();
  showToast('RDV confirmé \u00B7 '+selectedAnimal.name+' \u00B7 '+timeVal.replace(':',' h '), '#16a34a');
}

// === ACTIONS ===
function placerSalleAttente(){ closeAllPopups(); showToast("Placé en salle d'attente", '#059669'); }
function openConsultation(){ closeAllPopups(); showToast('Ouverture de la consultation...', '#4338ca'); }
function editRdv(){ showToast('Modification bientôt disponible', '#64748b'); }
function cancelRdv(){
  var id = +document.getElementById('rdv-popup').dataset.rdvId;
  var a = appointments.find(function(x){ return x.id === id; });
  if(a) a.status = 'cancelled';
  closeAllPopups();
  renderWeek();
  renderMiniCal();
  showToast('RDV annulé', '#dc2626');
}

// === NAV ===
function prevWeek(){ currentWeekStart = addDays(currentWeekStart, currentView==='week' ? -7 : -1); renderWeek(); renderMiniCal(); }
function nextWeek(){ currentWeekStart = addDays(currentWeekStart, currentView==='week' ? 7 : 1); renderWeek(); renderMiniCal(); }
function goToday(){ currentWeekStart = getWeekStart(today); renderWeek(); renderMiniCal(); }
function setView(v){
  currentView = v;
  if(v==='day') currentWeekStart = today;
  document.getElementById('view-week').style.cssText = v==='week' ? 'padding:4px 10px;border-radius:6px;border:none;font-size:12px;font-weight:500;cursor:pointer;font-family:inherit;background:#fff;color:#0f172a;box-shadow:0 1px 3px rgba(0,0,0,.08);' : 'padding:4px 10px;border-radius:6px;border:none;font-size:12px;font-weight:500;cursor:pointer;font-family:inherit;background:transparent;color:#64748b;';
  document.getElementById('view-day').style.cssText = v==='day' ? 'padding:4px 10px;border-radius:6px;border:none;font-size:12px;font-weight:500;cursor:pointer;font-family:inherit;background:#fff;color:#0f172a;box-shadow:0 1px 3px rgba(0,0,0,.08);' : 'padding:4px 10px;border-radius:6px;border:none;font-size:12px;font-weight:500;cursor:pointer;font-family:inherit;background:transparent;color:#64748b;';
  renderWeek();
}
function toggleVet(el, vet){
  if(activeVets.has(vet)) activeVets.delete(vet);
  else activeVets.add(vet);
  var check = document.getElementById('check-'+vet);
  check.style.opacity = activeVets.has(vet) ? '1' : '0.15';
  renderWeek();
}

// === TOAST ===
function showToast(msg, color){
  color = color || '#16a34a';
  var t = document.getElementById('agenda-toast');
  t.textContent = msg;
  t.style.background = color;
  t.style.opacity = '1';
  t.style.transform = 'translateX(-50%) translateY(0)';
  setTimeout(function(){
    t.style.opacity='0';
    t.style.transform='translateX(-50%) translateY(8px)';
  }, 2500);
}

// === SIDEBAR DRAWER ===
function closeAgendaSidebar(){
  document.getElementById('agenda-sidebar-panel').classList.remove('open');
  document.getElementById('agenda-drawer-overlay').style.display='none';
}

// === MOTIF FILTERS ===
function initMotifFilters(){
  var container = document.getElementById('motif-filters');
  if(!container) return;
  container.innerHTML = '';
  Object.entries(MOTIF_COLORS).forEach(function(entry){
    var motif = entry[0], color = entry[1];
    var active = activeMotifs.has(motif);
    var chip = document.createElement('div');
    chip.className = 'vet-chip';
    chip.innerHTML = '<div style="width:10px;height:10px;border-radius:2px;background:'+color+';flex-shrink:0;"></div>'
      +'<span style="font-size:12px;color:#334155;flex:1;">'+motif+'</span>'
      +'<svg style="opacity:'+(active?1:.15)+'" width="13" height="13" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="'+color+'" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    (function(m){
      chip.onclick = function(){
        if(activeMotifs.has(m)) activeMotifs.delete(m);
        else activeMotifs.add(m);
        initMotifFilters();
        renderWeek();
      };
    })(motif);
    container.appendChild(chip);
  });
}

// === FREE SLOTS ===
function toggleFreeSlots(){
  freeSlotsActive = !freeSlotsActive;
  var btn = document.getElementById('free-slots-btn');
  var picker = document.getElementById('free-dur-picker');
  var sbBtn = document.getElementById('sb-free-slots-btn');
  var sbDur = document.getElementById('sb-free-dur');
  if(freeSlotsActive){
    if(btn){btn.style.background='#eef2ff';btn.style.borderColor='#4338ca';btn.style.color='#4338ca';}
    if(picker) picker.style.display='flex';
    if(sbBtn){sbBtn.style.background='#eef2ff';sbBtn.style.borderColor='#4338ca';sbBtn.style.color='#4338ca';}
    if(sbDur) sbDur.style.display='flex';
  } else {
    if(btn){btn.style.background='';btn.style.borderColor='';btn.style.color='';}
    if(picker) picker.style.display='none';
    if(sbBtn){sbBtn.style.background='';sbBtn.style.borderColor='';sbBtn.style.color='';}
    if(sbDur) sbDur.style.display='none';
  }
  renderWeek();
}
function setFreeDur(dur){
  freeDuration = dur;
  document.querySelectorAll('.free-dur-btn').forEach(function(b){
    var active = +b.dataset.dur === dur;
    b.style.borderColor = active ? '#4338ca' : '#e2e8f0';
    b.style.background  = active ? '#eef2ff' : '#fff';
    b.style.color       = active ? '#4338ca' : '#64748b';
  });
  renderWeek();
}
function renderFreeSlots(col, dateStr){
  Array.from(activeVets).forEach(function(vetKey){
    var vet = VETS[vetKey];
    if(!vet) return;
    var vetAppts = appointments
      .filter(function(a){ return a.date === dateStr && a.vet === vetKey && a.status !== 'cancelled'; })
      .map(function(a){ return { s: timeToMin(a.start), e: timeToMin(a.start) + a.durationMin }; })
      .sort(function(a,b){ return a.s - b.s; });
    var gaps = [];
    var cursor = FREE_START;
    vetAppts.forEach(function(o){
      if(o.s > cursor) gaps.push({ s: cursor, e: o.s });
      cursor = Math.max(cursor, o.e);
    });
    if(cursor < FREE_END) gaps.push({ s: cursor, e: FREE_END });
    gaps.forEach(function(gap){
      if(gap.e - gap.s < freeDuration) return;
      var t = Math.ceil(gap.s / 15) * 15;
      while(t + freeDuration <= gap.e){
        renderFreeSlotBlock(col, vetKey, vet, dateStr, t, t + freeDuration);
        t += 15;
      }
    });
  });
}
function renderFreeSlotBlock(col, vetKey, vet, dateStr, startMin, endMin){
  var topPx  = (startMin - HOUR_START * 60) / 60 * SLOT_H + 1;
  var heightPx = (endMin - startMin) / 60 * SLOT_H - 2;
  if(heightPx < 10) return;
  var vetList = Array.from(activeVets);
  var idx = vetList.indexOf(vetKey);
  var total = vetList.length;
  var laneW = 100 / total;
  var leftPct = idx * laneW;
  var el = document.createElement('div');
  el.className = 'free-slot';
  el.style.cssText = 'top:'+topPx+'px;height:'+heightPx+'px;left:calc('+leftPct+'% + 2px);width:calc('+laneW+'% - 4px);background:'+vet.bg+';border:1.5px dashed '+vet.color+';opacity:.85;align-items:flex-start;padding:2px 5px;';
  el.innerHTML = '<span style="font-size:10px;font-weight:700;color:'+vet.color+';">'+fmtTime(minToTime(startMin))+'</span>';
  (function(ds,sm,vk){
    el.onclick = function(e){
      e.stopPropagation();
      newRdvSlotDate = ds;
      newRdvSlotHour = minToTime(sm);
      var d2 = new Date(ds);
      var dow = ['Dim','Lun','Mar','Mer','Jeu','Ven','Sam'];
      document.getElementById('new-rdv-slot').textContent = dow[d2.getDay()]+' '+d2.getDate()+' '+MONTHS_FR[d2.getMonth()]+' \u00B7 '+minToTime(sm).replace(':','\u00a0h\u00a0');
      document.getElementById('new-rdv-time').value = minToTime(sm);
      resetNewRdvForm();
      showCenteredPopup(document.getElementById('new-rdv-popup'));
    };
  })(dateStr, startMin, vetKey);
  col.appendChild(el);
}

// === INIT ===
if(window.innerWidth <= 640 && currentView === 'week'){
  currentView = 'day';
  currentWeekStart = today;
}
renderMiniCal();
renderWeek();
initMotifFilters();
window.addEventListener('resize', function(){
  if(window.innerWidth <= 640 && currentView === 'week'){
    currentView = 'day'; currentWeekStart = today; renderWeek();
  }
});
document.addEventListener('input', function(e){
  if(e.target && e.target.id === 'new-rdv-time') updateEndTime();
});
</script>
