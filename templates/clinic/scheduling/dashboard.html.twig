{#
 # Kiveto — templates/clinic/scheduling/dashboard.html.twig
 # ────────────────────────────────────────────────────────
 # Agenda view — weekly/daily appointment scheduling grid.
 # Source: vetos-agenda.html mockup
 #
 # Variables:
 #   currentClinicId     string   Active clinic UUID
 #   currentClinicName   string   Active clinic display name
 #}
{% extends 'clinic/base.html.twig' %}

{% block page_title %}Agenda{% endblock %}

{% block stylesheets %}
<style>
    *{box-sizing:border-box;margin:0;padding:0;}
    html,body{height:100%;font-family:'DM Sans',system-ui,sans-serif;font-size:16px;color:#1e293b;background:#f4f5f7;overflow:hidden;}
    ::-webkit-scrollbar{width:6px;height:6px;}
    ::-webkit-scrollbar-track{background:transparent;}
    ::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:10px;}
    ::-webkit-scrollbar-thumb:hover{background:#94a3b8;}

    /* Override base layout to allow agenda full height */
    .app-scroll{overflow:hidden !important;}
    .app-body{padding:0 !important;display:flex;flex-direction:column;overflow:hidden;height:100%;}

    /* Mini calendar */
    .mini-cal{padding:12px 14px;border-bottom:1px solid #f1f5f9;}
    .mini-cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
    .mini-cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;}
    .mini-cal-day{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:11px;border-radius:5px;cursor:pointer;transition:all .1s;color:#475569;}
    .mini-cal-day:hover{background:#f1f5f9;}
    .mini-cal-day.today{background:#4338ca;color:#fff;font-weight:700;}
    .mini-cal-day.selected{background:#eef2ff;color:#4338ca;font-weight:600;}
    .mini-cal-day.has-rdv::after{content:'';display:block;width:3px;height:3px;border-radius:50%;background:#4338ca;position:absolute;bottom:2px;left:50%;transform:translateX(-50%);}
    .mini-cal-day{position:relative;}
    .mini-cal-dow{font-size:10px;font-weight:600;color:#94a3b8;text-align:center;padding-bottom:2px;}

    /* Vets filter */
    .vet-filter{padding:10px 14px;}
    .vet-chip{display:flex;align-items:center;gap:7px;padding:5px 8px;border-radius:7px;cursor:pointer;transition:background .1s;margin-bottom:3px;}
    .vet-chip:hover{background:#f8fafc;}
    .vet-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}

    /* Agenda grid */
    .agenda-wrap{flex:1;overflow:hidden;display:flex;flex-direction:column;}
    .agenda-head{display:grid;background:#fff;border-bottom:1px solid #e8edf2;flex-shrink:0;}
    .agenda-body{flex:1;overflow-y:auto;overflow-x:hidden;position:relative;}
    .agenda-inner{display:grid;position:relative;}

    /* Time col */
    .time-col{width:55px;flex-shrink:0;background:#fff;box-sizing:border-box;}
    .time-label{height:80px;display:flex;align-items:flex-start;justify-content:flex-end;padding-right:8px;padding-top:3px;font-size:12.5px;color:#334155;font-weight:400;letter-spacing:0;box-sizing:border-box;}

    /* Day col */
    .day-col{border-left:1px solid #dde3ea;position:relative;}

    /* Free slots */
    .free-slot{position:absolute;border-radius:5px;cursor:pointer;z-index:8;display:flex;align-items:center;justify-content:center;transition:filter .12s;box-sizing:border-box;}
    .free-slot:hover{filter:brightness(.9);}

    .rdv-block{position:absolute;left:2px;right:2px;border-radius:5px;padding:0 5px;cursor:pointer;overflow:hidden;transition:all .15s;z-index:10;border-left:3px solid transparent;display:flex;align-items:center;}
    .rdv-block:hover{filter:brightness(.94);z-index:20;box-shadow:0 4px 12px rgba(0,0,0,.14);}

    /* RDV popup */
    .rdv-popup{position:fixed;background:#fff;border:1px solid #e8edf2;border-radius:12px;padding:0;box-shadow:0 12px 40px rgba(0,0,0,.15);z-index:500;width:300px;overflow:hidden;animation:popIn .15s ease;}
    @keyframes popIn{from{opacity:0;transform:scale(.95) translateY(-4px);}to{opacity:1;transform:scale(1) translateY(0);}}

    /* New RDV popup */
    .new-rdv-popup{background:#fff;border-radius:14px;padding:20px;box-shadow:0 24px 64px rgba(0,0,0,.2);z-index:500;width:440px;max-width:calc(100vw - 32px);max-height:calc(100vh - 40px);overflow-y:auto;animation:modalIn .2s cubic-bezier(.34,1.56,.64,1);}
    @keyframes modalIn{from{opacity:0;transform:translate(-50%,-48%);}to{opacity:1;transform:translate(-50%,-50%);}}

    /* Buttons */
    .btn-agenda{display:inline-flex;align-items:center;gap:5px;padding:6px 12px;border-radius:8px;font-size:13px;font-weight:500;font-family:'DM Sans',system-ui,sans-serif;cursor:pointer;border:1px solid transparent;transition:all .13s;}
    .btn-agenda.btn-primary{background:#4338ca;color:#fff;border-color:#4338ca;}
    .btn-agenda.btn-primary:hover{background:#3730a3;}
    .btn-agenda.btn-secondary{background:#f8fafc;color:#374151;border-color:#e2e8f0;}
    .btn-agenda.btn-secondary:hover{background:#f1f5f9;}
    .btn-agenda.btn-xs{padding:4px 10px;font-size:12px;border-radius:7px;}
    .btn-agenda.btn-icon{width:28px;height:28px;padding:0;justify-content:center;border-radius:7px;}

    /* Form inputs */
    .form-input-agenda{width:100%;padding:7px 10px;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;font-family:'DM Sans',system-ui,sans-serif;color:#0f172a;background:#f8fafc;outline:none;transition:border-color .13s;}
    .form-input-agenda:focus{border-color:#818cf8;background:#fff;}
    .agenda-label{font-size:11.5px;font-weight:500;color:#475569;display:block;margin-bottom:4px;}

    /* Badges */
    .badge-agenda{font-size:10.5px;font-weight:600;padding:2px 7px;border-radius:20px;white-space:nowrap;}
    .badge-online{background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;}
    .badge-urgent{background:#fef2f2;color:#dc2626;border:1px solid #fecaca;}
    .badge-new{background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe;}
    .badge-followup{background:#fdf4ff;color:#7e22ce;border:1px solid #e9d5ff;}

    /* Overlay */
    .overlay{position:fixed;inset:0;z-index:400;background:rgba(15,23,42,.35);backdrop-filter:blur(2px);}

    /* Current time line */
    .now-line{position:absolute;left:0;right:0;height:2px;background:#ef4444;z-index:15;pointer-events:none;}
    .now-dot{position:absolute;left:-4px;top:-4px;width:10px;height:10px;border-radius:50%;background:#ef4444;}

    /* Status dot */
    .status-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}

    @keyframes pulse{0%,100%{opacity:1;}50%{opacity:.5;}}
    .pulse{animation:pulse 2s infinite;}

    /* Tooltip */
    .tooltip{position:absolute;bottom:calc(100%+6px);left:50%;transform:translateX(-50%);background:#1e293b;color:#fff;font-size:11px;padding:4px 8px;border-radius:5px;white-space:nowrap;pointer-events:none;z-index:100;}

    /* FAB new RDV (mobile) */
    .fab-rdv{display:none;position:fixed;bottom:24px;right:20px;width:52px;height:52px;border-radius:50%;background:#4338ca;color:#fff;border:none;cursor:pointer;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(67,56,202,.4);z-index:60;transition:transform .15s;}
    .fab-rdv:hover{transform:scale(1.08);}

    /* Agenda layout with sidebar panel */
    .agenda-layout{display:flex;flex:1;overflow:hidden;}
    .agenda-sidebar-panel{width:232px;flex-shrink:0;background:#fff;border-right:1px solid #e8edf2;display:flex;flex-direction:column;overflow-y:auto;}
    .agenda-main{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0;}

    /* Agenda topbar */
    .agenda-topbar{height:48px;flex-shrink:0;background:#fff;border-bottom:1px solid #e8edf2;display:flex;align-items:center;padding:0 18px;gap:10px;}

    /* iPad Pro landscape */
    @media(max-width:1280px){
      .topbar-week-label{min-width:120px !important;}
      .topbar-free-slots{display:none !important;}
      #sb-free-slots-wrap{display:block !important;}
    }

    /* iPad portrait */
    @media(max-width:1024px){
      .agenda-sidebar-panel{
        position:fixed;left:0;top:0;bottom:0;z-index:90;
        transform:translateX(-100%);
        transition:transform .28s cubic-bezier(.4,0,.2,1);
        box-shadow:none;
      }
      .agenda-sidebar-panel.open{transform:translateX(0);box-shadow:4px 0 24px rgba(0,0,0,.15);}
      .topbar-free-slots{display:none !important;}
      .topbar-view-toggle{display:none !important;}
    }

    /* Mobile */
    @media(max-width:640px){
      .agenda-topbar{padding:0 10px;gap:6px;}
      .topbar-week-nav .btn-agenda.btn-secondary{padding:4px 8px;}
      .topbar-week-label{font-size:12px !important;min-width:90px !important;}
      .topbar-new-rdv{display:none !important;}
      .fab-rdv{display:flex;}
    }

    /* Toast */
    #agenda-toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(8px);padding:8px 16px;border-radius:8px;font-size:13px;font-weight:500;color:#fff;opacity:0;transition:all .25s;pointer-events:none;z-index:999;white-space:nowrap;background:#16a34a;}
</style>
{% endblock %}

{% block content %}
<!-- Drawer overlay for mobile sidebar panel -->
<div class="overlay" id="agenda-drawer-overlay" style="display:none;z-index:80;" onclick="closeAgendaSidebar()"></div>

<!-- FAB mobile -->
<button class="fab-rdv" id="fab-rdv" onclick="openNewRdvGlobal()">
  <svg width="20" height="20" fill="none" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
</button>

<!-- Two-panel layout: mini-cal sidebar + agenda -->
<div class="agenda-layout">

  <!-- LEFT SIDEBAR PANEL: Mini calendar + filters -->
  <div class="agenda-sidebar-panel" id="agenda-sidebar-panel">
    <!-- Mini calendar -->
    <div class="mini-cal">
      <div class="mini-cal-head">
        <span style="font-size:12.5px;font-weight:700;color:#0f172a;" id="mini-month">Mars 2026</span>
        <div style="display:flex;gap:2px;">
          <button class="btn-agenda btn-icon btn-secondary" onclick="miniCalPrev()" style="width:22px;height:22px;border-radius:5px;">
            <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M7.5 2l-4 4 4 4" stroke="#64748b" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="btn-agenda btn-icon btn-secondary" onclick="miniCalNext()" style="width:22px;height:22px;border-radius:5px;">
            <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M4.5 2l4 4-4 4" stroke="#64748b" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
      <div class="mini-cal-grid" id="mini-cal-grid">
        <!-- Filled by JS -->
      </div>
    </div>

    <!-- Vets filter -->
    <div class="vet-filter">
      <p style="font-size:10px;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px;">V&eacute;t&eacute;rinaires</p>
      <div class="vet-chip" onclick="toggleVet(this,'rousseau')">
        <div class="vet-dot" style="background:#4338ca;"></div>
        <span style="font-size:12.5px;color:#334155;flex:1;">Dr. Rousseau</span>
        <svg id="check-rousseau" width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="#4338ca" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="vet-chip" onclick="toggleVet(this,'martin')">
        <div class="vet-dot" style="background:#0891b2;"></div>
        <span style="font-size:12.5px;color:#334155;flex:1;">Dr. Martin</span>
        <svg id="check-martin" width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="#0891b2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="vet-chip" onclick="toggleVet(this,'dupont')">
        <div class="vet-dot" style="background:#059669;"></div>
        <span style="font-size:12.5px;color:#334155;flex:1;">Dr. Dupont</span>
        <svg id="check-dupont" width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="#059669" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="vet-chip" onclick="toggleVet(this,'lambert')">
        <div class="vet-dot" style="background:#db2777;"></div>
        <span style="font-size:12.5px;color:#334155;flex:1;">Dr. Lambert</span>
        <svg id="check-lambert" width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="#db2777" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>

    <!-- RDV type filters -->
    <div style="flex:1;overflow-y:auto;padding:10px 12px 6px;">
      <p style="font-size:10px;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px;">Types de RDV</p>
      <div id="motif-filters" style="display:flex;flex-direction:column;gap:2px;">
        <!-- Filled by JS -->
      </div>
    </div>

    <div style="border-top:1px solid #e8edf2;padding:8px 6px 10px;">
      <!-- Free slots toggle (visible on tablet/mobile) -->
      <div id="sb-free-slots-wrap" style="padding:6px 8px 4px;display:none;">
        <button onclick="toggleFreeSlots();closeAgendaSidebar();" style="width:100%;display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:8px;border:1.5px solid #e2e8f0;background:#f8fafc;cursor:pointer;font-family:inherit;font-size:12.5px;color:#64748b;font-weight:500;transition:all .13s;" id="sb-free-slots-btn">
          <svg width="13" height="13" fill="none" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4"/><path d="M8 5v3l2 1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          Cr&eacute;neaux libres
        </button>
        <div id="sb-free-dur" style="display:none;gap:4px;margin-top:6px;justify-content:center;">
          <button onclick="setFreeDur(15)" class="free-dur-btn" data-dur="15" style="flex:1;padding:4px 0;border-radius:6px;font-size:11px;font-weight:500;border:1.5px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer;font-family:inherit;">15</button>
          <button onclick="setFreeDur(20)" class="free-dur-btn" data-dur="20" style="flex:1;padding:4px 0;border-radius:6px;font-size:11px;font-weight:500;border:1.5px solid #4338ca;background:#eef2ff;color:#4338ca;cursor:pointer;font-family:inherit;">20</button>
          <button onclick="setFreeDur(30)" class="free-dur-btn" data-dur="30" style="flex:1;padding:4px 0;border-radius:6px;font-size:11px;font-weight:500;border:1.5px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer;font-family:inherit;">30</button>
          <button onclick="setFreeDur(60)" class="free-dur-btn" data-dur="60" style="flex:1;padding:4px 0;border-radius:6px;font-size:11px;font-weight:500;border:1.5px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer;font-family:inherit;">60</button>
        </div>
      </div>
    </div>
  </div>

  <!-- MAIN AGENDA AREA -->
  <div class="agenda-main">

    <!-- TOPBAR -->
    <div class="agenda-topbar">
      <div style="flex:1;"></div>

      <!-- Week nav -->
      <div class="topbar-week-nav" style="display:flex;align-items:center;gap:6px;">
        <button class="btn-agenda btn-secondary btn-xs" onclick="prevWeek()">
          <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M7.5 2l-4 4 4 4" stroke="#64748b" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="btn-agenda btn-secondary btn-xs" onclick="goToday()" id="today-btn">Aujourd'hui</button>
        <button class="btn-agenda btn-secondary btn-xs" onclick="nextWeek()">
          <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M4.5 2l4 4-4 4" stroke="#64748b" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <span class="topbar-week-label" style="font-size:13.5px;font-weight:600;color:#0f172a;min-width:160px;text-align:center;" id="week-label"></span>
      </div>

      <div style="flex:1;"></div>

      <!-- View toggles -->
      <div class="topbar-view-toggle" style="display:flex;background:#f1f5f9;border-radius:8px;padding:2px;gap:1px;">
        <button onclick="setView('week')" id="view-week" style="padding:4px 10px;border-radius:6px;border:none;font-size:12px;font-weight:500;cursor:pointer;font-family:inherit;background:#fff;color:#0f172a;box-shadow:0 1px 3px rgba(0,0,0,.08);">Semaine</button>
        <button onclick="setView('day')" id="view-day" style="padding:4px 10px;border-radius:6px;border:none;font-size:12px;font-weight:500;cursor:pointer;font-family:inherit;background:transparent;color:#64748b;">Jour</button>
      </div>

      <!-- Free slots finder -->
      <div id="free-slots-bar" class="topbar-free-slots" style="display:flex;align-items:center;gap:6px;">
        <div id="free-dur-picker" style="display:none;align-items:center;gap:4px;">
          <span style="font-size:11.5px;color:#64748b;">Dur&eacute;e</span>
          <div style="display:flex;gap:3px;">
            <button onclick="setFreeDur(15)" class="free-dur-btn" data-dur="15" style="padding:3px 7px;border-radius:5px;font-size:11px;font-weight:500;border:1.5px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer;font-family:inherit;">15</button>
            <button onclick="setFreeDur(20)" class="free-dur-btn" data-dur="20" style="padding:3px 7px;border-radius:5px;font-size:11px;font-weight:500;border:1.5px solid #4338ca;background:#eef2ff;color:#4338ca;cursor:pointer;font-family:inherit;">20</button>
            <button onclick="setFreeDur(30)" class="free-dur-btn" data-dur="30" style="padding:3px 7px;border-radius:5px;font-size:11px;font-weight:500;border:1.5px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer;font-family:inherit;">30</button>
            <button onclick="setFreeDur(60)" class="free-dur-btn" data-dur="60" style="padding:3px 7px;border-radius:5px;font-size:11px;font-weight:500;border:1.5px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer;font-family:inherit;">60</button>
          </div>
        </div>
        <button id="free-slots-btn" onclick="toggleFreeSlots()" class="btn-agenda btn-secondary btn-xs" style="gap:5px;">
          <svg width="11" height="11" fill="none" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4"/><path d="M8 5v3l2 1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          Cr&eacute;neaux libres
        </button>
      </div>

      <!-- New RDV -->
      <button class="btn-agenda btn-primary topbar-new-rdv" onclick="openNewRdvGlobal()">
        <svg width="11" height="11" fill="none" viewBox="0 0 12 12"><path d="M6 2v8M2 6h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        Nouveau RDV
      </button>
    </div>

    <!-- AGENDA -->
    <div class="agenda-wrap">
      <!-- Day headers -->
      <div class="agenda-head" id="agenda-head" style="grid-template-columns:55px repeat(7,1fr) 6px;">
        <div style="background:#fff;"></div>
        <!-- Filled by JS -->
      </div>

      <!-- Grid body -->
      <div class="agenda-body" id="agenda-body">
        <div class="agenda-inner" id="agenda-inner" style="grid-template-columns:55px repeat(7,1fr);">
          <!-- Filled by JS -->
        </div>
      </div>
    </div>
  </div>
</div>

<!-- OVERLAY (close popups) -->
<div class="overlay" id="overlay" style="display:none;" onclick="closeAllPopups()"></div>

<!-- RDV DETAIL POPUP -->
<div class="rdv-popup" id="rdv-popup" style="display:none;">
  <div id="rdv-popup-header" style="padding:12px 14px 10px;border-bottom:1px solid #f1f5f9;">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
      <div>
        <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;">
          <span id="pp-animal" style="font-size:14px;font-weight:700;color:#0f172a;"></span>
          <span id="pp-badge" class="badge-agenda"></span>
        </div>
        <div style="font-size:12px;color:#64748b;" id="pp-proprio"></div>
      </div>
      <button onclick="closeAllPopups()" style="width:22px;height:22px;border-radius:5px;border:none;background:#f1f5f9;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <svg width="8" height="8" fill="none" viewBox="0 0 8 8"><path d="M1 1l6 6M7 1L1 7" stroke="#64748b" stroke-width="1.3" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
  <div style="padding:10px 14px;display:flex;flex-direction:column;gap:6px;">
    <div style="display:flex;align-items:center;gap:7px;">
      <svg width="12" height="12" fill="none" viewBox="0 0 16 16" style="color:#94a3b8;flex-shrink:0;"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.3"/><path d="M8 5v3l2 1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      <span style="font-size:12.5px;color:#334155;" id="pp-time"></span>
      <span style="font-size:11px;color:#94a3b8;" id="pp-duration"></span>
    </div>
    <div style="display:flex;align-items:center;gap:7px;">
      <svg width="12" height="12" fill="none" viewBox="0 0 16 16" style="color:#94a3b8;flex-shrink:0;"><path d="M8 2a4 4 0 100 8A4 4 0 008 2z" stroke="currentColor" stroke-width="1.3"/><path d="M8 10v4M5 14h6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
