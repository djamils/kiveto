{#
 # Kiveto — templates/clinic/scheduling/dashboard.html.twig
 # ─────────────────────────────────────────────────────────
 # Agenda / scheduling page with week and day views.
 # Uses its own sidebar panel (not the standard app sidebar).
 #}
{% extends 'clinic/base.html.twig' %}

{% block show_sidebar %}false{% endblock %}
{% block show_topbar %}false{% endblock %}
{% block page_title %}Agenda{% endblock %}

{% block stylesheets %}
<style>
    /* Override app layout for full-height agenda */
    .app-scroll{overflow:hidden !important;}
    .app-body{padding:0 !important;display:flex;flex-direction:column;overflow:hidden;height:100%;}

    /* Agenda shell layout */
    .agenda-shell{display:flex;height:100%;overflow:hidden;}
    .agenda-sidebar{width:232px;flex-shrink:0;background:#fff;border-right:1px solid #e8edf2;display:flex;flex-direction:column;}
    .agenda-content{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0;}

    /* Topbar */
    .topbar{height:48px;flex-shrink:0;background:#fff;border-bottom:1px solid #e8edf2;display:flex;align-items:center;padding:0 18px;gap:10px;}

    /* Sidebar elements */
    .sb-top{height:48px;display:flex;align-items:center;padding:0 10px;border-bottom:1px solid #e8edf2;flex-shrink:0;}
    .sb-clinic-btn{width:100%;display:flex;align-items:center;gap:8px;padding:7px 8px;border-radius:9px;border:none;background:transparent;cursor:pointer;text-align:left;transition:background .13s;font-family:'DM Sans',system-ui,sans-serif;}
    .sb-clinic-btn:hover{background:#f1f5f9;}
    .sb-settings{display:flex;align-items:center;gap:8px;padding:7px 10px;margin:2px 6px;border-radius:8px;font-size:14.5px;color:#64748b;cursor:pointer;transition:background .12s;}
    .sb-settings:hover{background:#f8fafc;}
    .nav{flex:1;padding:8px 0;overflow-y:auto;}
    .nav-section{font-size:11.5px;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:.08em;padding:8px 16px 4px;}
    .nav-item{display:flex;align-items:center;gap:8px;padding:6px 10px;margin:1px 6px;border-radius:8px;font-size:14.5px;font-weight:400;color:#64748b;cursor:pointer;transition:background .12s,color .12s;}
    .nav-item:hover{background:#f8fafc;color:#334155;}
    .nav-item.active{background:#eef2ff;color:#4338ca;font-weight:500;}
    .sb-foot{border-top:1px solid #e8edf2;padding:8px 6px 10px;}
    .sb-user{display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:8px;cursor:pointer;}

    /* Mini calendar */
    .mini-cal{padding:12px 14px;border-bottom:1px solid #f1f5f9;}
    .mini-cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
    .mini-cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;}
    .mini-cal-day{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:11px;border-radius:5px;cursor:pointer;transition:all .1s;color:#475569;}
    .mini-cal-day:hover{background:#f1f5f9;}
    .mini-cal-day.today{background:#4338ca;color:#fff;font-weight:700;}
    .mini-cal-day.selected{background:#eef2ff;color:#4338ca;font-weight:600;}
    .mini-cal-day.has-rdv::after{content:'';display:block;width:3px;height:3px;border-radius:50%;background:#4338ca;position:absolute;bottom:2px;left:50%;transform:translateX(-50%);}
    .mini-cal-day{position:relative;}
    .mini-cal-dow{font-size:10px;font-weight:600;color:#94a3b8;text-align:center;padding-bottom:2px;}

    /* Vets filter */
    .vet-filter{padding:10px 14px;}
    .vet-chip{display:flex;align-items:center;gap:7px;padding:5px 8px;border-radius:7px;cursor:pointer;transition:background .1s;margin-bottom:3px;}
    .vet-chip:hover{background:#f8fafc;}
    .vet-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}

    /* Agenda grid */
    .agenda-wrap{flex:1;overflow:hidden;display:flex;flex-direction:column;}
    .agenda-head{display:grid;background:#fff;border-bottom:1px solid #e8edf2;flex-shrink:0;}
    .agenda-body{flex:1;overflow-y:auto;overflow-x:hidden;position:relative;}
    .agenda-inner{display:grid;position:relative;}

    /* Time col */
    .time-col{width:55px;flex-shrink:0;background:#fff;box-sizing:border-box;}
    .time-label{height:80px;display:flex;align-items:flex-start;justify-content:flex-end;padding-right:8px;padding-top:3px;font-size:12.5px;color:#334155;font-weight:400;letter-spacing:0;box-sizing:border-box;}

    /* Day col */
    .day-col{border-left:1px solid #dde3ea;position:relative;}

    /* Free slots */
    .free-slot{position:absolute;border-radius:5px;cursor:pointer;z-index:8;display:flex;align-items:center;justify-content:center;transition:filter .12s;box-sizing:border-box;}
    .free-slot:hover{filter:brightness(.9);}

    .rdv-block{position:absolute;left:2px;right:2px;border-radius:5px;padding:0 5px;cursor:pointer;overflow:hidden;transition:all .15s;z-index:10;border-left:3px solid transparent;display:flex;align-items:center;}
    .rdv-block:hover{filter:brightness(.94);z-index:20;box-shadow:0 4px 12px rgba(0,0,0,.14);}

    /* RDV popup */
    .rdv-popup{position:fixed;background:#fff;border:1px solid #e8edf2;border-radius:12px;padding:0;box-shadow:0 12px 40px rgba(0,0,0,.15);z-index:500;width:300px;overflow:hidden;animation:popIn .15s ease;}
    @keyframes popIn{from{opacity:0;transform:scale(.95) translateY(-4px);}to{opacity:1;transform:scale(1) translateY(0);}}

    /* New RDV popup */
    .new-rdv-popup{background:#fff;border-radius:14px;padding:20px;box-shadow:0 24px 64px rgba(0,0,0,.2);z-index:500;width:440px;max-width:calc(100vw - 32px);max-height:calc(100vh - 40px);overflow-y:auto;animation:modalIn .2s cubic-bezier(.34,1.56,.64,1);}
    @keyframes modalIn{from{opacity:0;transform:translate(-50%,-48%);}to{opacity:1;transform:translate(-50%,-50%);}}

    /* Buttons */
    .btn{display:inline-flex;align-items:center;gap:5px;padding:6px 12px;border-radius:8px;font-size:13px;font-weight:500;font-family:'DM Sans',system-ui,sans-serif;cursor:pointer;border:1px solid transparent;transition:all .13s;}
    .btn-primary{background:#4338ca;color:#fff;border-color:#4338ca;}
    .btn-primary:hover{background:#3730a3;}
    .btn-secondary{background:#f8fafc;color:#374151;border-color:#e2e8f0;}
    .btn-secondary:hover{background:#f1f5f9;}
    .btn-xs{padding:4px 10px;font-size:12px;border-radius:7px;}
    .btn-icon{width:28px;height:28px;padding:0;justify-content:center;border-radius:7px;}

    /* Form inputs */
    .form-input{width:100%;padding:7px 10px;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;font-family:'DM Sans',system-ui,sans-serif;color:#0f172a;background:#f8fafc;outline:none;transition:border-color .13s;}
    .form-input:focus{border-color:#818cf8;background:#fff;}
    label{font-size:11.5px;font-weight:500;color:#475569;display:block;margin-bottom:4px;}

    /* Badges */
    .badge{font-size:10.5px;font-weight:600;padding:2px 7px;border-radius:20px;white-space:nowrap;}
    .badge-online{background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;}
    .badge-urgent{background:#fef2f2;color:#dc2626;border:1px solid #fecaca;}
    .badge-new{background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe;}
    .badge-followup{background:#fdf4ff;color:#7e22ce;border:1px solid #e9d5ff;}

    /* Overlay */
    .overlay{position:fixed;inset:0;z-index:400;background:rgba(15,23,42,.35);backdrop-filter:blur(2px);}

    /* Current time line */
    .now-line{position:absolute;left:0;right:0;height:2px;background:#ef4444;z-index:15;pointer-events:none;}
    .now-dot{position:absolute;left:-4px;top:-4px;width:10px;height:10px;border-radius:50%;background:#ef4444;}

    /* Status dot */
    .status-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}

    @keyframes pulse{0%,100%{opacity:1;}50%{opacity:.5;}}
    .pulse{animation:pulse 2s infinite;}

    /* Tooltip */
    .tooltip{position:absolute;bottom:calc(100%+6px);left:50%;transform:translateX(-50%);background:#1e293b;color:#fff;font-size:11px;padding:4px 8px;border-radius:5px;white-space:nowrap;pointer-events:none;z-index:100;}

    /* Burger button for mobile sidebar toggle */
    .btn-burger{display:none;width:34px;height:34px;border-radius:8px;border:1px solid #e2e8f0;background:#f8fafc;cursor:pointer;align-items:center;justify-content:center;color:#64748b;flex-shrink:0;}
    .btn-burger:hover{background:#f1f5f9;}

    /* Drawer overlay */
    .drawer-overlay{display:none;position:fixed;inset:0;background:rgba(15,23,42,.3);z-index:80;backdrop-filter:blur(2px);}
    .drawer-overlay.open{display:block;}

    /* FAB new RDV (mobile) */
    .fab-rdv{display:none;position:fixed;bottom:24px;right:20px;width:52px;height:52px;border-radius:50%;background:#4338ca;color:#fff;border:none;cursor:pointer;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(67,56,202,.4);z-index:60;transition:transform .15s;}
    .fab-rdv:hover{transform:scale(1.08);}

    /* iPad Pro landscape */
    @media(max-width:1280px){
      .topbar-week-label{min-width:120px !important;}
      .topbar-free-slots{display:none !important;}
    }

    /* iPad portrait */
    @media(max-width:1024px){
      .agenda-sidebar{
        position:fixed;left:0;top:0;bottom:0;z-index:90;
        transform:translateX(-100%);
        transition:transform .28s cubic-bezier(.4,0,.2,1);
        box-shadow:none;
      }
      .agenda-sidebar.open{transform:translateX(0);box-shadow:4px 0 24px rgba(0,0,0,.15);}
      .btn-burger{display:flex;}
      .topbar-breadcrumb{display:none;}
      .topbar-free-slots{display:none !important;}
      .topbar-view-toggle{display:none !important;}
    }
    @media(max-width:1280px){
      #sb-free-slots-wrap{display:block !important;}
    }

    /* Mobile */
    @media(max-width:640px){
      .topbar{padding:0 10px;gap:6px;}
      .topbar-week-nav .btn-secondary{padding:4px 8px;}
      .topbar-week-label{font-size:12px !important;min-width:90px !important;}
      .topbar-new-rdv{display:none !important;}
      .fab-rdv{display:flex;}
    }
</style>
{% endblock %}

{% block content %}
{# Drawer overlay for mobile agenda sidebar #}
<div class="drawer-overlay" id="drawer-overlay" onclick="closeAgendaSidebar()"></div>

{# FAB button for mobile new RDV #}
<button class="fab-rdv" id="fab-rdv" onclick="openNewRdvGlobal()">
  <svg width="20" height="20" fill="none" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
</button>

<div class="agenda-shell">

  {# ── AGENDA SIDEBAR ── #}
  <div class="agenda-sidebar" id="agenda-sidebar">
    {# Clinic selector #}
    <div class="sb-top">
      <button class="sb-clinic-btn">
        <div style="width:28px;height:28px;background:#1e1b4b;border-radius:7px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;font-weight:700;flex-shrink:0;">V</div>
        <div style="flex:1;min-width:0;">
          <p style="font-size:12.5px;font-weight:600;color:#0f172a;line-height:1.2;">VET-OS</p>
          <p style="font-size:12px;color:#64748b;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ activeClinic.name|default('Ma clinique') }}</p>
        </div>
        <svg width="12" height="12" fill="none" viewBox="0 0 12 12" style="flex-shrink:0;color:#94a3b8;"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

    {# Mini calendar #}
    <div class="mini-cal">
      <div class="mini-cal-head">
        <span style="font-size:12.5px;font-weight:700;color:#0f172a;" id="mini-month">Mars 2026</span>
        <div style="display:flex;gap:2px;">
          <button class="btn btn-icon btn-secondary" onclick="miniCalPrev()" style="width:22px;height:22px;border-radius:5px;">
            <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M7.5 2l-4 4 4 4" stroke="#64748b" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="btn btn-icon btn-secondary" onclick="miniCalNext()" style="width:22px;height:22px;border-radius:5px;">
            <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M4.5 2l4 4-4 4" stroke="#64748b" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
      <div class="mini-cal-grid" id="mini-cal-grid">
        {# Filled by JS #}
      </div>
    </div>

    {# Vets filter #}
    <div class="vet-filter">
      <p style="font-size:10px;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px;">Vétérinaires</p>
      <div class="vet-chip" onclick="toggleVet(this,'rousseau')">
        <div class="vet-dot" style="background:#4338ca;"></div>
        <span style="font-size:12.5px;color:#334155;flex:1;">Dr. Rousseau</span>
        <svg id="check-rousseau" width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="#4338ca" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="vet-chip" onclick="toggleVet(this,'martin')">
        <div class="vet-dot" style="background:#0891b2;"></div>
        <span style="font-size:12.5px;color:#334155;flex:1;">Dr. Martin</span>
        <svg id="check-martin" width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="#0891b2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="vet-chip" onclick="toggleVet(this,'dupont')">
        <div class="vet-dot" style="background:#059669;"></div>
        <span style="font-size:12.5px;color:#334155;flex:1;">Dr. Dupont</span>
        <svg id="check-dupont" width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="#059669" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="vet-chip" onclick="toggleVet(this,'lambert')">
        <div class="vet-dot" style="background:#db2777;"></div>
        <span style="font-size:12.5px;color:#334155;flex:1;">Dr. Lambert</span>
        <svg id="check-lambert" width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3.5 3.5 6.5-7" stroke="#db2777" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>

    {# RDV type filters #}
    <div style="flex:1;overflow-y:auto;padding:10px 12px 6px;">
      <p style="font-size:10px;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px;">Types de RDV</p>
      <div id="motif-filters" style="display:flex;flex-direction:column;gap:2px;">
        {# Filled by JS #}
      </div>
    </div>

    <div class="sb-foot">
      {# Free slots toggle — visible on tablet/mobile #}
      <div id="sb-free-slots-wrap" style="padding:6px 8px 4px;display:none;">
        <button onclick="toggleFreeSlots();closeAgendaSidebar();" style="width:100%;display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:8px;border:1.5px solid #e2e8f0;background:#f8fafc;cursor:pointer;font-family:inherit;font-size:12.5px;color:#64748b;font-weight:500;transition:all .13s;" id="sb-free-slots-btn">
          <svg width="13" height="13" fill="none" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4"/><path d="M8 5v3l2 1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          Créneaux libres
        </button>
        <div id="sb-free-dur" style="display:none;gap:4px;margin-top:6px;justify-content:center;">
          <button onclick="setFreeDur(15)" class="free-dur-btn" data-dur="15" style="flex:1;padding:4px 0;border-radius:6px;font-size:11px;font-weight:500;border:1.5px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer;font-family:inherit;">15</button>
          <button onclick="setFreeDur(20)" class="free-dur-btn" data-dur="20" style="flex:1;padding:4px 0;border-radius:6px;font-size:11px;font-weight:500;border:1.5px solid #4338ca;background:#eef2ff;color:#4338ca;cursor:pointer;font-family:inherit;">20</button>
          <button onclick="setFreeDur(30)" class="free-dur-btn" data-dur="30" style="flex:1;padding:4px 0;border-radius:6px;font-size:11px;font-weight:500;border:1.5px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer;font-family:inherit;">30</button>
          <button onclick="setFreeDur(60)" class="free-dur-btn" data-dur="60" style="flex:1;padding:4px 0;border-radius:6px;font-size:11px;font-weight:500;border:1.5px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer;font-family:inherit;">60</button>
        </div>
      </div>
      {# Back to app button #}
      <div style="padding:6px 8px 8px;">
        <a href="{{ path('clinic_dashboard') }}" style="width:100%;display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:8px;border:1.5px solid #c7d2fe;background:#eef2ff;cursor:pointer;font-family:inherit;font-size:12.5px;color:#4338ca;font-weight:500;transition:all .13s;text-decoration:none;" onmouseenter="this.style.background='#e0e7ff';this.style.borderColor='#a5b4fc'" onmouseleave="this.style.background='#eef2ff';this.style.borderColor='#c7d2fe'">
          <svg width="13" height="13" fill="none" viewBox="0 0 16 16"><path d="M7 3L2 8l5 5M2 8h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Retour à l'application
        </a>
      </div>
      {# User profile #}
      <div style="border-top:1px solid #e8edf2;">
        <div class="sb-user" style="display:flex;align-items:center;gap:8px;padding:8px 12px 10px;cursor:pointer;">
          <div style="width:27px;height:27px;border-radius:50%;background:#dbeafe;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:#1d4ed8;flex-shrink:0;">DR</div>
          <div style="flex:1;min-width:0;">
            <p style="font-size:13px;font-weight:500;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ app.user.email|default('Utilisateur') }}</p>
            <p style="font-size:12px;color:#94a3b8;">{{ activeClinic.type|default('Vétérinaire') }}</p>
          </div>
          <svg width="12" height="12" fill="none" viewBox="0 0 12 12" style="flex-shrink:0;color:#94a3b8;"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </div>
    </div>
  </div>

  {# ── MAIN CONTENT ── #}
  <div class="agenda-content">

    {# TOPBAR #}
    <div class="topbar">
      <button class="btn-burger" onclick="toggleAgendaSidebar()"><svg width="16" height="16" fill="none" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
      {# Breadcrumb #}
      <span class="topbar-breadcrumb" style="font-size:13px;color:#94a3b8;">VET-OS</span>
      <svg class="topbar-breadcrumb" width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M4.5 3l3 3-3 3" stroke="#cbd5e1" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span class="topbar-breadcrumb" style="font-size:13px;font-weight:500;color:#0f172a;">Agenda</span>

      <div style="flex:1;"></div>

      {# Week navigation #}
      <div class="topbar-week-nav" style="display:flex;align-items:center;gap:6px;">
        <button class="btn btn-secondary btn-xs" onclick="prevWeek()">
          <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M7.5 2l-4 4 4 4" stroke="#64748b" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="btn btn-secondary btn-xs" onclick="goToday()" id="today-btn">Aujourd'hui</button>
        <button class="btn btn-secondary btn-xs" onclick="nextWeek()">
          <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M4.5 2l4 4-4 4" stroke="#64748b" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <span class="topbar-week-label" style="font-size:13.5px;font-weight:600;color:#0f172a;min-width:160px;text-align:center;" id="week-label"></span>
      </div>

      <div style="flex:1;"></div>

      {# View toggles #}
      <div class="topbar-view-toggle" style="display:flex;background:#f1f5f9;border-radius:8px;padding:2px;gap:1px;">
        <button onclick="setView('week')" id="view-week" style="padding:4px 10px;border-radius:6px;border:none;font-size:12px;font-weight:500;cursor:pointer;font-family:inherit;background:#fff;color:#0f172a;box-shadow:0 1px 3px rgba(0,0,0,.08);">Semaine</button>
        <button onclick="setView('day')" id="view-day" style="padding:4px 10px;border-radius:6px;border:none;font-size:12px;font-weight:500;cursor:pointer;font-family:inherit;background:transparent;color:#64748b;">Jour</button>
      </div>

      {# Free slots finder #}
      <div id="free-slots-bar" class="topbar-free-slots" style="display:flex;align-items:center;gap:6px;">
        <div id="free-dur-picker" style="display:none;align-items:center;gap:4px;">
          <span style="font-size:11.5px;color:#64748b;">Durée</span>
          <div style="display:flex;gap:3px;">
            <button onclick="setFreeDur(15)"  class="free-dur-btn" data-dur="15"  style="padding:3px 7px;border-radius:5px;font-size:11px;font-weight:500;border:1.5px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer;font-family:inherit;">15</button>
            <button onclick="setFreeDur(20)"  class="free-dur-btn" data-dur="20"  style="padding:3px 7px;border-radius:5px;font-size:11px;font-weight:500;border:1.5px solid #4338ca;background:#eef2ff;color:#4338ca;cursor:pointer;font-family:inherit;">20</button>
            <button onclick="setFreeDur(30)"  class="free-dur-btn" data-dur="30"  style="padding:3px 7px;border-radius:5px;font-size:11px;font-weight:500;border:1.5px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer;font-family:inherit;">30</button>
            <button onclick="setFreeDur(60)"  class="free-dur-btn" data-dur="60"  style="padding:3px 7px;border-radius:5px;font-size:11px;font-weight:500;border:1.5px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer;font-family:inherit;">60</button>
          </div>
        </div>
        <button id="free-slots-btn" onclick="toggleFreeSlots()" class="btn btn-secondary btn-xs" style="gap:5px;">
          <svg width="11" height="11" fill="none" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4"/><path d="M8 5v3l2 1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          Créneaux libres
        </button>
      </div>

      {# New RDV button #}
      <button class="btn btn-primary topbar-new-rdv" onclick="openNewRdvGlobal()">
        <svg width="11" height="11" fill="none" viewBox="0 0 12 12"><path d="M6 2v8M2 6h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        Nouveau RDV
      </button>
    </div>

    {# AGENDA GRID #}
    <div class="agenda-wrap">

      {# Day headers #}
      <div class="agenda-head" id="agenda-head" style="grid-template-columns:55px repeat(7,1fr) 6px;">
        <div style="background:#fff;"></div>
        {# Filled by JS #}
      </div>

      {# Grid body #}
      <div class="agenda-body" id="agenda-body">
        <div class="agenda-inner" id="agenda-inner" style="grid-template-columns:55px repeat(7,1fr);">
          {# Filled by JS #}
        </div>
      </div>

    </div>
  </div>
</div>

{# OVERLAY (close popups) #}
<div class="overlay" id="overlay" style="display:none;" onclick="closeAllPopups()"></div>

{# RDV DETAIL POPUP #}
<div class="rdv-popup" id="rdv-popup" style="display:none;">
  <div id="rdv-popup-header" style="padding:12px 14px 10px;border-bottom:1px solid #f1f5f9;">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
      <div>
        <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;">
          <span id="pp-animal" style="font-size:14px;font-weight:700;color:#0f172a;"></span>
          <span id="pp-badge" class="badge"></span>
        </div>
        <div style="font-size:12px;color:#64748b;" id="pp-proprio"></div>
      </div>
      <button onclick="closeAllPopups()" style="width:22px;height:22px;border-radius:5px;border:none;background:#f1f5f9;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <svg width="8" height="8" fill="none" viewBox="0 0 8 8"><path d="M1 1l6 6M7 1L1 7" stroke="#64748b" stroke-width="1.3" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
  <div style="padding:10px 14px;display:flex;flex-direction:column;gap:6px;">
    <div style="display:flex;align-items:center;gap:7px;">
      <svg width="12" height="12" fill="none" viewBox="0 0 16 16" style="color:#94a3b8;flex-shrink:0;"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.3"/><path d="M8 5v3l2 1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      <span style="font-size:12.5px;color:#334155;" id="pp-time"></span>
      <span style="font-size:11px;color:#94a3b8;" id="pp-duration"></span>
    </div>
    <div style="display:flex;align-items:center;gap:7px;">
      <svg width="12" height="12" fill="none" viewBox="0 0 16 16" style="color:#94a3b8;flex-shrink:0;"><path d="M8 2a4 4 0 100 8A4 4 0 008 2z" stroke="currentColor" stroke-width="1.3"/><path d="M8 10v4M5 14h6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      <span style="font-size:12.5px;color:#334155;" id="pp-vet"></span>
    </div>
    <div style="display:flex;align-items:center;gap:7px;">
      <svg width="12" height="12" fill="none" viewBox="0 0 16 16" style="color:#94a3b8;flex-shrink:0;"><path d="M4 4h8M4 8h8M4 12h5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      <span style="font-size:12.5px;color:#334155;" id="pp-motif"></span>
    </div>
    <div style="display:flex;align-items:center;gap:7px;" id="pp-note-row" style="display:none;">
      <svg width="12" height="12" fill="none" viewBox="0 0 16 16" style="color:#94a3b8;flex-shrink:0;"><path d="M3 3h10a1 1 0 011 1v8a1 1 0 01-1 1H3a1 1 0 01-1-1V4a1 1 0 011-1z" stroke="currentColor" stroke-width="1.3"/></svg>
      <span style="font-size:12px;color:#64748b;font-style:italic;" id="pp-note"></span>
    </div>
  </div>
  <div style="padding:8px 14px 12px;display:flex;gap:6px;border-top:1px solid #f1f5f9;" class="pp-actions">
    <button onclick="openConsultation()" class="btn btn-primary btn-xs" style="flex:1;justify-content:center;">
      <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Ouvrir consultation
    </button>
    <button onclick="editRdv()" class="btn btn-secondary btn-xs">
      <svg width="10" height="10" fill="none" viewBox="0 0 12 12"><path d="M8 2l2 2-6 6H2V8l6-6z" stroke="#64748b" stroke-width="1.3" stroke-linejoin="round"/></svg>
    </button>
    <button onclick="cancelRdv()" class="btn btn-secondary btn-xs" style="color:#dc2626;border-color:#fecaca;">
      <svg width="10" height="10" fill="none" viewBox="0 0 8 8"><path d="M1 1l6 6M7 1L1 7" stroke="#dc2626" stroke-width="1.3" stroke-linecap="round"/></svg>
    </button>
  </div>
</div>

{# NEW RDV POPUP #}
<div class="new-rdv-popup" id="new-rdv-popup" style="display:none;width:640px;">

  {# Header #}
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
    <div>
      <p style="font-size:15px;font-weight:700;color:#0f172a;">Nouveau rendez-vous</p>
      <p style="font-size:12px;color:#94a3b8;margin-top:2px;" id="new-rdv-slot"></p>
    </div>
    <button onclick="closeAllPopups()" style="width:28px;height:28px;border-radius:7px;border:none;background:#f1f5f9;cursor:pointer;display:flex;align-items:center;justify-content:center;" onmouseenter="this.style.background='#e2e8f0'" onmouseleave="this.style.background='#f1f5f9'">
      <svg width="9" height="9" fill="none" viewBox="0 0 8 8"><path d="M1 1l6 6M7 1L1 7" stroke="#64748b" stroke-width="1.3" stroke-linecap="round"/></svg>
    </button>
  </div>

  {# 2-column grid #}
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">

    {# LEFT COLUMN #}
    <div style="display:flex;flex-direction:column;gap:12px;">

      {# Time slot and duration #}
      <div style="background:#f8fafc;border:1px solid #e8edf2;border-radius:10px;padding:12px;">
        <p style="font-size:10px;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:.07em;margin-bottom:9px;">Horaire</p>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
          <svg width="13" height="13" fill="none" viewBox="0 0 16 16" style="color:#4338ca;flex-shrink:0;"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4"/><path d="M8 5v3l2 1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          <input type="time" id="new-rdv-time" class="form-input" style="flex:1;padding:5px 9px;font-size:12.5px;" value="09:00">
          <svg width="11" height="11" fill="none" viewBox="0 0 12 12" style="color:#94a3b8;flex-shrink:0;"><path d="M2 6h8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          <span id="new-rdv-end" style="font-size:12.5px;font-weight:600;color:#475569;white-space:nowrap;">09 h 20</span>
        </div>
        <div style="display:flex;gap:5px;">
          <button onclick="setDuration(15)" id="dur-15" style="flex:1;padding:5px 0;border-radius:6px;font-size:11.5px;font-weight:500;border:1.5px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer;font-family:inherit;transition:all .1s;">15 min</button>
          <button onclick="setDuration(20)" id="dur-20" style="flex:1;padding:5px 0;border-radius:6px;font-size:11.5px;font-weight:500;border:1.5px solid #4338ca;background:#eef2ff;color:#4338ca;cursor:pointer;font-family:inherit;transition:all .1s;">20 min</button>
          <button onclick="setDuration(30)" id="dur-30" style="flex:1;padding:5px 0;border-radius:6px;font-size:11.5px;font-weight:500;border:1.5px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer;font-family:inherit;transition:all .1s;">30 min</button>
          <button onclick="setDuration(60)" id="dur-60" style="flex:1;padding:5px 0;border-radius:6px;font-size:11.5px;font-weight:500;border:1.5px solid #e2e8f0;background:#fff;color:#64748b;cursor:pointer;font-family:inherit;transition:all .1s;">1 h</button>
        </div>
      </div>

      {# Patient search #}
      <div>
        <label style="font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.07em;display:block;margin-bottom:6px;">Patient</label>
        <div style="position:relative;">
          <input type="text" class="form-input" id="new-animal-input" placeholder="🔍 Rechercher Luna, Max…" oninput="searchAnimals(this.value)" autocomplete="off">
          <div id="animal-suggestions" style="display:none;position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid #e2e8f0;border-radius:8px;box-shadow:0 8px 20px rgba(0,0,0,.1);z-index:100;overflow:hidden;margin-top:3px;max-height:160px;overflow-y:auto;"></div>
        </div>
      </div>

      {# Vet and source selectors #}
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
        <div>
          <label style="font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.07em;display:block;margin-bottom:6px;">Vétérinaire</label>
          <select class="form-input" id="new-vet-select" style="appearance:none;">
            <option value="rousseau">Dr. Rousseau</option>
            <option value="martin">Dr. Martin</option>
            <option value="dupont">Dr. Dupont</option>
            <option value="lambert">Dr. Lambert</option>
          </select>
        </div>
        <div>
          <label style="font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.07em;display:block;margin-bottom:6px;">Source</label>
          <select class="form-input" id="new-source-select" style="appearance:none;">
            <option value="cabinet">Cabinet</option>
            <option value="online">En ligne</option>
            <option value="phone">Téléphone</option>
          </select>
        </div>
      </div>

      {# Note / context #}
      <div>
        <label style="font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.07em;display:block;margin-bottom:6px;">Note / contexte</label>
        <textarea class="form-input" id="new-note-input" rows="3" placeholder="Précision, symptômes, contexte…" style="resize:none;"></textarea>
      </div>

    </div>

    {# RIGHT COLUMN #}
    <div style="display:flex;flex-direction:column;gap:12px;">

      {# Motif selection #}
      <div>
        <label style="font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.07em;display:block;margin-bottom:8px;">Motif</label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;" id="motif-chips">
          <button onclick="selectMotif(this,'Consultation')" class="motif-chip" style="padding:8px 10px;border-radius:8px;font-size:12px;border:1.5px solid #e2e8f0;background:#f8fafc;color:#64748b;cursor:pointer;font-family:inherit;transition:all .1s;text-align:left;display:flex;align-items:center;gap:6px;">
            <span style="width:8px;height:8px;border-radius:50%;background:#4338ca;flex-shrink:0;display:inline-block;"></span>Consultation
          </button>
          <button onclick="selectMotif(this,'Vaccin')" class="motif-chip" style="padding:8px 10px;border-radius:8px;font-size:12px;border:1.5px solid #e2e8f0;background:#f8fafc;color:#64748b;cursor:pointer;font-family:inherit;transition:all .1s;text-align:left;display:flex;align-items:center;gap:6px;">
            <span style="width:8px;height:8px;border-radius:50%;background:#0891b2;flex-shrink:0;display:inline-block;"></span>Vaccin
          </button>
          <button onclick="selectMotif(this,'Suivi')" class="motif-chip" style="padding:8px 10px;border-radius:8px;font-size:12px;border:1.5px solid #e2e8f0;background:#f8fafc;color:#64748b;cursor:pointer;font-family:inherit;transition:all .1s;text-align:left;display:flex;align-items:center;gap:6px;">
            <span style="width:8px;height:8px;border-radius:50%;background:#7c3aed;flex-shrink:0;display:inline-block;"></span>Suivi
          </button>
          <button onclick="selectMotif(this,'Chirurgie')" class="motif-chip" style="padding:8px 10px;border-radius:8px;font-size:12px;border:1.5px solid #e2e8f0;background:#f8fafc;color:#64748b;cursor:pointer;font-family:inherit;transition:all .1s;text-align:left;display:flex;align-items:center;gap:6px;">
            <span style="width:8px;height:8px;border-radius:50%;background:#b45309;flex-shrink:0;display:inline-block;"></span>Chirurgie
          </button>
          <button onclick="selectMotif(this,'Bilan')" class="motif-chip" style="padding:8px 10px;border-radius:8px;font-size:12px;border:1.5px solid #e2e8f0;background:#f8fafc;color:#64748b;cursor:pointer;font-family:inherit;transition:all .1s;text-align:left;display:flex;align-items:center;gap:6px;">
            <span style="width:8px;height:8px;border-radius:50%;background:#059669;flex-shrink:0;display:inline-block;"></span>Bilan
          </button>
          <button onclick="selectMotif(this,'Urgence')" class="motif-chip" style="padding:8px 10px;border-radius:8px;font-size:12px;border:1.5px solid #fecaca;background:#fef2f2;color:#dc2626;cursor:pointer;font-family:inherit;transition:all .1s;text-align:left;display:flex;align-items:center;gap:6px;">
            <span style="width:8px;height:8px;border-radius:50%;background:#dc2626;flex-shrink:0;display:inline-block;"></span>🚨 Urgence
          </button>
        </div>
      </div>

      {# Notifications and reminders #}
      <div style="background:#f8fafc;border:1px solid #e8edf2;border-radius:10px;padding:12px;">
        <p style="font-size:10px;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:.07em;margin-bottom:10px;">Notifications & Rappels</p>
        <div style="display:flex;flex-direction:column;gap:8px;">
          <div style="display:flex;align-items:center;justify-content:space-between;">
            <div style="display:flex;align-items:center;gap:6px;">
              <svg width="12" height="12" fill="none" viewBox="0 0 16 16" style="color:#4338ca;"><rect x="2" y="3" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M2 6l6 4 6-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
              <span style="font-size:12px;color:#334155;">Email de confirmation</span>
            </div>
            <input type="checkbox" id="notif-email" checked style="accent-color:#4338ca;width:14px;height:14px;cursor:pointer;">
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;">
            <div style="display:flex;align-items:center;gap:6px;">
              <svg width="12" height="12" fill="none" viewBox="0 0 16 16" style="color:#0891b2;"><rect x="2" y="2" width="12" height="10" rx="2" stroke="currentColor" stroke-width="1.3"/><path d="M5 13l3 2 3-2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span style="font-size:12px;color:#334155;">SMS de rappel</span>
            </div>
            <div style="display:flex;align-items:center;gap:6px;">
              <select id="sms-delay" style="font-size:11px;border:1px solid #e2e8f0;border-radius:5px;padding:2px 6px;background:#fff;color:#475569;font-family:inherit;outline:none;">
                <option value="24">24h avant</option>
                <option value="48">48h avant</option>
                <option value="1h">1h avant</option>
              </select>
              <input type="checkbox" id="notif-sms" checked style="accent-color:#0891b2;width:14px;height:14px;cursor:pointer;">
            </div>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;">
            <div style="display:flex;align-items:center;gap:6px;">
              <svg width="12" height="12" fill="none" viewBox="0 0 16 16" style="color:#7c3aed;"><path d="M8 2a4 4 0 100 8A4 4 0 008 2z" stroke="currentColor" stroke-width="1.3"/><path d="M2 14c0-2.5 2.5-4 6-4s6 1.5 6 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
              <span style="font-size:12px;color:#334155;">Notif. équipe</span>
            </div>
            <input type="checkbox" id="notif-team" style="accent-color:#7c3aed;width:14px;height:14px;cursor:pointer;">
          </div>
        </div>
      </div>

      {# Recurrence #}
      <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 12px;background:#f8fafc;border:1px solid #e8edf2;border-radius:10px;">
        <div style="display:flex;align-items:center;gap:6px;">
          <svg width="12" height="12" fill="none" viewBox="0 0 16 16" style="color:#94a3b8;"><path d="M14 8a6 6 0 01-6 6 6 6 0 01-6-6 6 6 0 016-6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M14 4v4h-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span style="font-size:12px;color:#334155;">Récurrence</span>
        </div>
        <select id="recurrence-select" style="font-size:11.5px;border:1px solid #e2e8f0;border-radius:6px;padding:4px 8px;background:#fff;color:#475569;font-family:inherit;outline:none;">
          <option value="none">Aucune</option>
          <option value="weekly">Hebdomadaire</option>
          <option value="biweekly">Bimensuelle</option>
          <option value="monthly">Mensuelle</option>
        </select>
      </div>

    </div>
  </div>

  {# Footer actions #}
  <div style="display:flex;gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid #f1f5f9;">
    <button onclick="closeAllPopups()" class="btn btn-secondary" style="flex:1;justify-content:center;">Annuler</button>
    <button onclick="confirmNewRdv()" class="btn btn-primary" style="flex:2;justify-content:center;">
      <svg width="11" height="11" fill="none" viewBox="0 0 12 12"><path d="M2 6l3.5 3.5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Confirmer le rendez-vous
    </button>
  </div>

</div>

{# TOAST #}
<div id="toast" style="position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(8px);padding:8px 16px;border-radius:8px;font-size:13px;font-weight:500;color:#fff;opacity:0;transition:all .25s;pointer-events:none;z-index:999;white-space:nowrap;background:#16a34a;"></div>
{% endblock %}

{% block javascripts %}{% endblock %}
