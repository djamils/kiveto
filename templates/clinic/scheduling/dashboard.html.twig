          <button onclick="selectMotif(this,'Chirurgie')" class="motif-chip" style="padding:8px 10px;border-radius:8px;font-size:12px;border:1.5px solid #e2e8f0;background:#f8fafc;color:#64748b;cursor:pointer;font-family:inherit;transition:all .1s;text-align:left;display:flex;align-items:center;gap:6px;">
            <span style="width:8px;height:8px;border-radius:50%;background:#b45309;flex-shrink:0;display:inline-block;"></span>Chirurgie
          </button>
          <button onclick="selectMotif(this,'Bilan')" class="motif-chip" style="padding:8px 10px;border-radius:8px;font-size:12px;border:1.5px solid #e2e8f0;background:#f8fafc;color:#64748b;cursor:pointer;font-family:inherit;transition:all .1s;text-align:left;display:flex;align-items:center;gap:6px;">
            <span style="width:8px;height:8px;border-radius:50%;background:#059669;flex-shrink:0;display:inline-block;"></span>Bilan
