{#
 # Kiveto -- templates/clinic/select-clinic.html.twig
 # Clinic picker shown after sign-in when the member works in several clinics
 # and has no default one yet (connexion_3.html, « Votre clinique par défaut »,
 # then « Entrée »). Picking a clinic makes it the default and opens it: the
 # hidden form is posted to clinic_select_clinic_post once the welcome screen
 # has played (assets/js/pages/auth.js).
 #
 # Variables from controller:
 #   csrf_token string   CSRF token value
 # The clinics themselves come from clinic_shell() (colour, initial, role).
 #}
{% extends 'security/_auth_layout.html.twig' %}

{% block title %}Votre clinique — Kiveto{% endblock %}

{% block screens %}
  {% set _shell = clinic_shell() %}
  <section class="ecran on" id="e-clin" aria-labelledby="t-clin">
    <a class="retourb" href="{{ path('_logout_clinic') }}" data-turbo="false"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg>Se déconnecter</a>
    <h1 class="titre" id="t-clin">Votre clinique par défaut</h1>
    <p class="sous">Vous avez accès à plusieurs cliniques du groupe. Celle-ci s'ouvrira à chaque connexion ; vous pourrez en changer à tout moment.</p>
    <div class="clins" id="clins">
      {% for clinic in _shell.clinics %}
        <button type="button" class="clin{{ clinic.isDefault ? ' def' }}" data-clinic-id="{{ clinic.id }}" data-clinic-name="{{ clinic.name }}">
          <span class="sq" style="background:{{ clinic.color }}">{{ clinic.initial }}</span>
          <span class="tx"><b>{{ clinic.name }}{% if clinic.isDefault %}<span class="tag">Par défaut</span>{% endif %}</b><span>{{ clinic.subtitle }}</span></span>
          {% if loop.index <= 9 %}<kbd>{{ loop.index }}</kbd>{% endif %}
        </button>
      {% endfor %}
    </div>
  </section>

  {% include 'security/_welcome_screen.html.twig' %}

  <form id="clinic-select-form" method="post" action="{{ path('clinic_select_clinic_post') }}" hidden>
    <input type="hidden" name="_token" value="{{ csrf_token }}">
    <input type="hidden" name="clinic_id" id="clinic-select-input" value="">
  </form>
{% endblock %}
