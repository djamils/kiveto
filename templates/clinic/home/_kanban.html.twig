      <span class="kol-title">Planifi&eacute;</span>
      <span class="kol-count">3</span>
    </div>
    <div class="kol-body">
      <div class="kcard">
        <p class="kcard-name">Bella</p>
        <p class="kcard-meta">Canin &middot; Bouledogue fran&ccedil;ais</p>
        <p class="kcard-reason">Suivi post-op (st&eacute;rilisation)</p>
        <div class="kcard-time"><i data-lucide="clock" style="width:10px;height:10px;"></i>10h00 &middot; Maria Torres</div>
      </div>
      <div class="kcard">
        <p class="kcard-name">Oscar</p>
        <p class="kcard-meta">F&eacute;lin &middot; Maine Coon</p>
        <p class="kcard-reason">D&eacute;tartrage dentaire</p>
