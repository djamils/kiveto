{#
 # Kiveto — templates/clinic/home/index.html.twig
 # ──────────────────────────────────────────────
 # Clinic dashboard, ported from
 # docs/frontend-theme/kiveto-theme/dashboard-v-topbar-calme_2.html:
 # « La journée en chiffres » strip with the quick actions, hospitalisation
 # band (only when someone is hospitalised), then three columns — « Fil du
 # jour » (timeline with the live now-line), « Flux ambulatoire » (patients on
 # site) and « À traiter » (tasks raised from the data, done today, calm-day
 # suggestions).
 #
 # Variables from controller:
 #   dashboard  App\Presentation\Clinic\ViewModel\Dashboard\DashboardView
 #
 # Behaviour: assets/js/pages/home.js — styles: assets/styles/pages/home.css
 #}
{% extends 'clinic/base.html.twig' %}

{# The dashboard mock-up shows the sidebar expanded and scrolls as a whole #}
{% block sidebar_mode %}full{% endblock %}
{% block page_body_class %}vt page-scroll{% endblock %}

{% block title %}Tableau de bord{% endblock %}

{% set _tk_ico = {
  labo:   '<path d="M10 3v6l-5.2 8.6A2 2 0 0 0 6.5 21h11a2 2 0 0 0 1.7-3.4L14 9V3"/><path d="M8 3h8"/>',
  cr:     '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h4"/>',
  vaccin: '<path d="m18 2 4 4"/><path d="m17 7 3-3"/><path d="M19 9 8.7 19.3c-1 1-2.5 1-3.4 0l-.6-.6c-1-1-1-2.5 0-3.4L15 5"/><path d="m9 11 4 4"/>',
  fact:   '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2Z"/><path d="M9 8h6M9 12h6"/>',
  stock:  '<path d="M21 8 12 3 3 8v8l9 5 9-5Z"/><path d="M3 8l9 5 9-5M12 13v8"/>',
} %}
{% set _tk_style = {
  urgent: { lbl: 'Urgent',         c: 'var(--garance)',  bg: 'var(--garance-pale)', fg: '#b91c1c' },
  jour:   { lbl: "Aujourd'hui",    c: 'var(--ambre)',    bg: 'var(--ambre-pale)',   fg: '#92550a' },
  fond:   { lbl: 'Quand possible', c: 'var(--encre-35)', bg: 'var(--brume)',        fg: 'var(--encre-60)' },
} %}
{% set _vis_lbl = { asv: 'ASV', veto: 'Vétos' } %}

{% block main %}
{% set d = dashboard %}
<div class="dash" data-page="{{ app.request.attributes.get('_route') }}" data-tz="{{ d.timeZone }}">

  {# ── La journée en chiffres + actions rapides ── #}
  <div class="kpi-strip" aria-label="La journée en chiffres">
    {% for kpi in d.kpis %}
      <div class="kpi"><span class="v"{% if kpi.id %} id="{{ kpi.id }}"{% endif %}>{{ kpi.value }}</span><span class="l">{{ kpi.label }}</span>{% if kpi.note %}<span class="d{{ kpi.noteTone ? ' ' ~ kpi.noteTone }}">{{ kpi.note }}</span>{% endif %}</div>
    {% endfor %}
    <div class="qa2">
      <a class="qa2-btn primaire" href="{{ path('clinic_scheduling_agenda', {new: 1}) }}" data-tip="Raccourci : R">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18M12 13v6M9 16h6"/></svg>
        Nouveau RDV
      </a>
      <a class="qa2-btn" href="{{ path('clinic_admission_queue') }}" data-tip="Raccourci : A">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg>
        Arrivée
      </a>
      <a class="qa2-btn" href="{{ path('clinic_invoices', {status: ['ISSUED', 'PARTIALLY_PAID']}) }}" data-tip="Raccourci : E">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/></svg>
        Encaisser
      </a>
    </div>
  </div>

  {# ── Hospitalisations — horizontal band, only while someone is hospitalised ── #}
  {% if d.beds is not empty %}
    <section class="hospit-band" id="modHospit" aria-label="Hospitalisations en cours">
      <div class="hb-head">
        <h2>Hospitalisations</h2>
        <span class="hb-count" id="hospitCount">{{ d.beds|length }} en cours</span>
      </div>
      <div class="hb-lits">
        {% for bed in d.beds %}
          <div class="lit">
            <div class="top">
              <span class="esp">{{ bed.emoji }}</span>
              <span class="id"><b>{{ bed.name }}</b><span>{{ bed.subtitle }}</span></span>
              <span class="box" title="Jour d'hospitalisation">{{ bed.stayLabel }}</span>
            </div>
            <div class="soin"><span>Admis <b>{{ bed.admittedLabel }}</b> · {{ bed.practitioner }}</span><span class="quand" title="Durée d'hospitalisation">{{ bed.sinceLabel }}</span></div>
            <div class="h-acts">
              {% if bed.animalId %}
                <a class="h-btn" href="{{ path('clinic_animals_view', {id: bed.animalId}) }}">Dossier</a>
              {% endif %}
              <a class="h-btn fait" href="{{ path('clinic_admission_queue') }}">Suivi au flux</a>
            </div>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <main class="grid">

    {# ── Colonne 1 : Fil du jour ── #}
    <section class="col" aria-labelledby="h-jour">
      <div class="col-head">
        <h2 id="h-jour">Fil du jour</h2>
        <span class="count">{{ d.appointmentCount }} rendez-vous</span>
        <a class="aside" href="{{ path('clinic_scheduling_agenda') }}">Agenda complet</a>
      </div>
      <div class="timeline" id="timeline">
        {% if d.timeline is not empty %}
          <div class="now" id="nowLine" data-h="{{ d.nowLabel }}" aria-hidden="true"></div>
        {% endif %}
        {% for slot in d.timeline %}
          <div class="slot" data-min="{{ slot.minutes }}" data-end="{{ slot.endMinutes }}"><div class="h">{{ slot.time }}</div><div class="body">
            {% if slot.isFree %}
              <div class="creux-mini">libre</div>
            {% else %}
              {% for a in slot.appointments %}
                <div class="rdv consult{{ a.state in ['done', 'noshow'] ? ' done' }}" tabindex="0">
                  <div class="esp">{{ a.emoji }}</div>
                  <div class="txt"><b>{{ a.title }}</b><span>{{ a.subtitle }}</span></div>
                  <div class="dur">{{ a.durationLabel }}</div>
                  {% if a.state == 'planned' %}
                    <div class="acts">
                      {% if a.animalId %}<a class="mini-btn" href="{{ path('clinic_animals_view', {id: a.animalId}) }}">Dossier</a>{% endif %}
                      <form method="post" action="{{ path('clinic_admission_checkin') }}" data-turbo="false">
                        <input type="hidden" name="_token" value="{{ csrf_token('waiting_room_action') }}">
                        <input type="hidden" name="appointmentId" value="{{ a.id }}">
                        {% if a.animalId %}<input type="hidden" name="animalId" value="{{ a.animalId }}">{% endif %}
                        {% if a.animalName %}<input type="hidden" name="animalName" value="{{ a.animalName }}">{% endif %}
                        <button type="submit" class="mini-btn primaire">Arrivée</button>
                      </form>
                    </div>
                  {% elseif a.state == 'onsite' %}
                    <div class="acts">
                      <a class="mini-btn" href="{{ path('clinic_admission_queue') }}">Voir au flux</a>
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            {% endif %}
          </div></div>
        {% endfor %}
        {% if d.rest %}
          <div class="creux">
            <b>{{ d.rest.title }}</b>
            <span>{{ d.rest.text }}</span>
            <div class="creux-acts">
              <a class="mini-btn" href="{{ path('clinic_scheduling_agenda') }}">Bloquer une plage</a>
              <a class="mini-btn primaire" href="{{ path('clinic_scheduling_agenda', {new: 1}) }}">Prendre un RDV</a>
            </div>
          </div>
        {% endif %}
      </div>
    </section>

    {# ── Colonne 2 : Flux patients ── #}
    <section class="col" aria-labelledby="h-flux">
      <div class="col-head">
        <h2 id="h-flux">Flux ambulatoire</h2>
        <span class="count" id="ambuN">{{ d.flux|length }} sur place</span>
        <a class="aside" href="{{ path('clinic_admission_queue') }}">Ouvrir le flux →</a>
      </div>
      <div class="flux" id="ambuListe" data-flux-url="{{ path('clinic_admission_queue') }}">
        {% for p in d.flux %}
          <a class="ambu{{ p.isEmergency ? ' urg' }}" href="{{ path('clinic_admission_queue') }}" data-nom="{{ p.name }}" title="Ouvrir le flux ambulatoire — {{ p.name }}">
            <span class="top">
              <span class="esp">{{ p.emoji }}</span>
              <span class="id"><b>{{ p.name }}{% if p.isEmergency %} <span class="badge-urg">Urgence</span>{% endif %}</b><span>{{ p.subtitle }}</span></span>
              <span class="chrono{{ p.isLong ? ' long' }}">⏱ {{ p.chrono }}</span>
            </span>
            <span class="parcours" aria-label="Parcours : étape {{ p.currentStep + 1 }} sur {{ p.steps|length }}">
              {% for s in p.steps %}<span class="pstep{{ loop.index0 < p.currentStep ? ' done' : (loop.index0 == p.currentStep ? ' cur') }}">{{ s }}</span>{% endfor %}
            </span>
            <span class="ou"><b>{{ p.where }}</b><span class="sep">·</span>{{ p.who }}</span>
          </a>
        {% else %}
          <div class="vide-col">
            <span class="vide-ic">🛋️</span>
            <b>Personne sur place</b>
            <span>Les patients enregistrés à l'arrivée apparaissent ici, étape par étape.</span>
            <a class="mini-btn primaire" href="{{ path('clinic_admission_queue') }}">Enregistrer une arrivée</a>
            <span class="vide-note">{{ d.nextExpected ? 'Prochain patient attendu : ' ~ d.nextExpected : "Aucun autre rendez-vous aujourd'hui" }}</span>
          </div>
        {% endfor %}
      </div>
    </section>

    {# ── Colonne 3 : À traiter ── #}
    <section class="col col-3" aria-labelledby="h-taches">
      <div class="col-head">
        <h2 id="h-taches">À traiter</h2>
        <span class="count" id="tkN">{{ d.tasks|length }}</span>
        <span class="tk-filtre" role="tablist">
          <button type="button" class="on" data-f="moi">Pour moi</button>
          <button type="button" data-f="tout">Toutes</button>
        </span>
      </div>
      {# Manual tasks have no backend yet: the composer stays visible, inert. #}
      <div class="tk-compose" id="tkCompose" data-tip="Tâches manuelles — bientôt disponibles">
        <input id="tkInput" placeholder="＋ Nouvelle tâche… (bientôt disponible)" autocomplete="off" disabled>
      </div>
      <div class="pile" id="tkPile" data-audiences="{{ d.myAudiences|join(' ') }}" data-me="{{ d.currentUserId }}">
        {% for g in ['urgent', 'jour', 'fond'] %}
          {% set _liste = d.tasks|filter(t => t.group == g) %}
          {% if _liste is not empty %}
            {% set st = _tk_style[g] %}
            <div class="tk-grp" data-grp="{{ g }}"><span class="gd" style="background:{{ st.c }}"></span>{{ st.lbl }}</div>
            {% for t in _liste %}
              <div class="tk" data-grp="{{ g }}" data-vis="{{ t.audience }}"{% if t.assigneeUserId %} data-assignee="{{ t.assigneeUserId }}"{% endif %}>
                <span class="ico" style="background:{{ st.bg }};color:{{ st.fg }}" title="Tâche automatique">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ _tk_ico[t.icon]|raw }}</svg>
                </span>
                <span class="txt"><b>{{ t.title }}{% if t.audience != 'clinique' %}<span class="tk-vis {{ t.audience }}">{{ _vis_lbl[t.audience] }}</span>{% endif %}</b><span>{{ t.subtitle }}</span></span>
                <a class="go" href="{{ t.actionUrl }}">{{ t.actionLabel }}</a>
              </div>
            {% endfor %}
          {% endif %}
        {% endfor %}
      </div>
      <div class="tk-vide{{ d.tasks is empty ? ' on' }}" id="tkVide">
        <span class="vi">✓</span>
        <b>Tout est traité</b>
        <span>Rien n'attend — les nouvelles tâches arrivent ici.</span>
      </div>
      {% if d.done is not empty %}
        <div class="fait-liste" aria-label="Traité aujourd'hui">
          {% for f in d.done %}
            <div class="fait"><span>{{ f.emoji }}</span> {{ f.label }}{% if f.time %} <small>{{ f.time }}</small>{% endif %}</div>
          {% endfor %}
        </div>
      {% endif %}
      {% if d.isCalm %}
        <div class="sugg-calme">
          <b>Profiter du calme ?</b>
          <a class="mini-btn" href="{{ path(d.hasStockAlerts ? 'clinic_stock_alerts' : 'clinic_stock') }}">Passer la commande de stock</a>
          <a class="mini-btn" href="{{ path('clinic_clients_list') }}">Relancer les clients pas revenus depuis 1 an</a>
        </div>
      {% endif %}
    </section>

  </main>
</div>
{% endblock %}
