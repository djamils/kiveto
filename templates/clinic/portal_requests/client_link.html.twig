{#
 # Kiveto — templates/clinic/portal_requests/client_link.html.twig
 # ──────────────────────────────────────────────────────────────
 # One « Rattachement » request: a Portal account (an accepted link
 # suggestion) asks to reach client files of the clinic. The Portal profile
 # name is shown next to each file's name and animals, with the « Nom
 # différent » and « Déjà relié à un autre compte Portal » badges; staff
 # check, then « Confirmer » or « Refuser » the files listed. The profile
 # name is owner text: autoescaped, never |raw.
 #
 # Variables:
 #   request  PortalRequestPageBuilder::linkDetail()
 #
 # Behaviour: assets/js/pages/portal-requests.js — styles: assets/styles/pages/portal-requests.css
 #}
{% extends 'clinic/base.html.twig' %}

{% block page_body_class %}vt page-scroll{% endblock %}
{% block title %}{{ request.kindLabel }} — {{ request.ownerName }}{% endblock %}

{% block main %}
{% set r = request %}
<div class="prq prq-detail" data-page="clinic_portal_link_requests_show">
  <div class="pagehead">
    <h1>{{ r.kindLabel }} · compte Portal<small>Reçue le {{ r.submittedAt }} depuis le Portal</small></h1>
    <div class="right">
      <a class="btn" href="{{ path('clinic_portal_requests') }}">Toutes les demandes</a>
    </div>
  </div>

  <div class="prq-cards">
    <section class="prq-card">
      <div class="prq-head">
        <span class="prq-st submitted">À traiter</span>
      </div>
      <dl class="prq-dl">
        <dt>Profil Portal</dt><dd class="prq-text" data-owner-name>{{ r.ownerName }}</dd>
        <dt>Rapproché par</dt><dd>le numéro de mobile du dossier</dd>
      </dl>
      <table class="prq-table prq-files">
        <thead>
          <tr><th>Dossier client</th><th>Animaux</th><th>Vérifications</th></tr>
        </thead>
        <tbody>
          {% for f in r.files %}
            <tr data-client-id="{{ f.clientId }}">
              <td><a href="{{ f.url }}">{{ f.name }}</a><small>Profil Portal : {{ r.ownerName }}</small></td>
              <td>{{ f.petNames is empty ? '—' : f.petNames|join(', ') }}</td>
              <td>
                {% if f.mismatch %}<span class="prq-chip warn" data-badge="mismatch">Nom différent du profil Portal</span>{% endif %}
                {% if f.linkedElsewhere %}<span class="prq-chip warn" data-badge="linked-elsewhere">Déjà relié à un autre compte Portal</span>{% endif %}
                {% if not f.mismatch and not f.linkedElsewhere %}<span class="prq-chip">Nom identique</span>{% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      <p class="prq-hint">Le propriétaire ne voit encore aucune donnée de la clinique. Confirmez seulement si le profil Portal correspond bien à ce{{ r.files|length > 1 ? 's' }} dossier{{ r.files|length > 1 ? 's' }} (en cas de doute, appelez le client).</p>
    </section>

    <section class="prq-card">
      <h2>Répondre</h2>
      <div class="prq-actions prq-link-actions">
        <form method="post" action="{{ path('clinic_portal_link_requests_confirm', { userId: r.userId }) }}" data-turbo="false" data-prq-once id="prqLinkConfirm">
          <input type="hidden" name="_token" value="{{ csrf_token('portal_link_request') }}">
          {% for f in r.files %}<input type="hidden" name="client_ids[]" value="{{ f.clientId }}">{% endfor %}
          <button type="submit" class="btn primaire">Confirmer le rattachement</button>
        </form>
        <form method="post" action="{{ path('clinic_portal_link_requests_reject', { userId: r.userId }) }}" data-turbo="false" data-prq-once data-confirm-message="Refuser ce rattachement ? La clinique ne sera plus proposée à ce compte Portal." id="prqLinkReject">
          <input type="hidden" name="_token" value="{{ csrf_token('portal_link_request') }}">
          {% for f in r.files %}<input type="hidden" name="client_ids[]" value="{{ f.clientId }}">{% endfor %}
          <button type="submit" class="btn">Refuser</button>
        </form>
      </div>
    </section>
  </div>
</div>
{% endblock %}
