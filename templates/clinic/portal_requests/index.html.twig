{#
 # Kiveto — templates/clinic/portal_requests/index.html.twig
 # ────────────────────────────────────────────────────────
 # « Demandes »: what owners send from the Portal (pet file changes,
 # prescription renewals, « Rattachement » and « Nouveau client » requests).
 # Ported from docs/frontend-theme/kiveto-theme/responsive/demandes-v-topbar_1.html
 # (and its -busy / -vierge states), on the register kit of « Consultations »:
 # page head and its counters, filter bar (search, status segments, type
 # menu), the table and its pager, the side sheet of one request.
 #
 # The table and the sheet are drawn by the page module from the payload;
 # filters and pages are asked from clinic_portal_requests_search, a sheet
 # from clinic_portal_request_sheet, clinic_portal_link_request_sheet,
 # clinic_portal_link_decision_sheet or clinic_portal_booking_request_sheet. The answers are posted in the
 # background to their single-action controllers. Owner free text is written
 # as text by the module, never as HTML.
 #
 # Variables:
 #   payload  App\Presentation\Clinic\ViewModel\PortalRequest\PortalRequestPageBuilder::page()
 #
 # Behaviour: assets/js/pages/portal-requests.js — styles: assets/styles/pages/portal-requests.css
 #}
{% extends 'clinic/base.html.twig' %}

{% block page_body_class %}vt{% endblock %}
{% block title %}{{ payload.sheet ? payload.sheet.title : 'Demandes' }}{% endblock %}

{% set _vide = payload.register.head.blank %}

{% block main %}
<div class="reg dem{{ _vide ? ' vide' }}" data-page="clinic_portal_requests" data-payload="{{ payload|json_encode }}">

  <div class="pagehead">
    <h1>Demandes<small id="phSub">—</small></h1>
    <div class="phk" id="phk"></div>
  </div>

  <div class="cfil" id="cfil"{% if _vide %} style="display:none"{% endif %}>
    <div class="crech">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" placeholder="Animal, client, médicament, note…" autocomplete="off" aria-label="Rechercher une demande" value="{{ payload.filters.q }}">
    </div>
    <span class="lblf">Filtres</span>
    <div id="fdd" style="display:flex;gap:8px;align-items:center"></div>
  </div>

  <main class="czone{{ payload.sheet ? ' ouvert' }}" id="czone">
    <div class="ctw">
      <div class="cscroll scr"><table>
        <thead id="thead"></thead>
        <tbody id="tbody"></tbody>
      </table><div id="cempty"></div></div>
      <div class="cfoot" id="cfoot"></div>
    </div>
    <aside class="fiche" id="fiche"><div class="fi-in">
      <div class="fi-head" id="fiHead"></div>
      <div class="fi-body scr" id="fiBody"></div>
      <div class="fi-foot" id="fiFoot"></div>
    </div></aside>
  </main>
</div>
{% endblock %}
