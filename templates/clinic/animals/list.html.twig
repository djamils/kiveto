{#
 # Kiveto — templates/clinic/animals/list.html.twig
 # ─────────────────────────────────────────────────
 # Animal list page with Kiveto data table, search, and pagination.
 #
 # Variables:
 #   animals          Paginated result { items[], totalItems, currentPage,
 #                    totalPages, limit, hasPreviousPage, hasNextPage,
 #                    previousPage, nextPage }
 #   currentClinicName  string
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}Animaux - {{ currentClinicName }}{% endblock %}

{% block page_title %}Animaux{% endblock %}

{% block topbar_actions %}
  {{ include('components/ui/button.html.twig', {
    label: 'Nouvel animal',
    variant: 'primary',
    size: 'sm',
    href: path('clinic_animals_new'),
  }) }}
{% endblock %}

{% block content %}
  {# Data table card #}
  <div class="widget">
    {# Search bar #}
    <div class="widget-head">
      <div style="display:flex;align-items:center;gap:var(--space-2);">
        <div class="input-wrap">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/>
          </svg>
          <input
            type="search"
            class="form-input form-input-sm"
            placeholder="Rechercher animaux..."
            value="{{ app.request.query.get('search', '') }}"
            data-kt-filter="search"
            autocomplete="off"
          >
        </div>
      </div>
    </div>

    {# Table #}
    <div class="table-wrap" style="border:none;border-radius:0;">
      <table class="data-table">
        <thead>
          <tr>
            <th>Nom</th>
            <th>Espece</th>
            <th>Race</th>
            <th>Statut</th>
            <th>Date creation</th>
          </tr>
        </thead>
        <tbody>
          {% for animal in animals.items %}
            <tr>
              <td data-label="Nom">
                <a href="{{ path('clinic_animals_view', {id: animal.id}) }}">
                  {{ animal.name }}
                </a>
              </td>
              <td data-label="Espece">
                {# Map species enum to French label with color badge #}
                {% if animal.species == 'DOG' %}
                  <span class="badge b-dog">Chien</span>
                {% elseif animal.species == 'CAT' %}
                  <span class="badge b-cat">Chat</span>
                {% else %}
                  <span class="badge b-other">NAC</span>
                {% endif %}
              </td>
              <td data-label="Race">
                {% if animal.breedName %}
                  {{ animal.breedName }}
                {% else %}
                  &mdash;
                {% endif %}
              </td>
              <td data-label="Statut">
                {% if animal.status == 'active' %}
                  <span class="badge b-ok">Actif</span>
                {% else %}
                  <span class="badge b-grey">Archive</span>
                {% endif %}
              </td>
              <td data-label="Date creation">
                {{ animal.createdAt|date('d/m/Y H:i') }}
              </td>
            </tr>
          {% else %}
            <tr class="empty-row">
              <td colspan="5">Aucun animal trouve.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {# Pagination footer #}
    {% if animals.totalPages > 1 %}
      <div style="display:flex;align-items:center;justify-content:space-between;padding:var(--space-3) var(--space-4);border-top:1px solid var(--border-light);font-size:var(--text-sm);">
        <span style="color:var(--text-muted);">
          {{ ((animals.currentPage - 1) * animals.limit) + 1 }}
          &ndash; {{ min(animals.currentPage * animals.limit, animals.totalItems) }}
          sur {{ animals.totalItems }}
        </span>
        <div style="display:flex;align-items:center;gap:var(--space-2);">
          {% if animals.hasPreviousPage %}
            <a href="{{ path('clinic_animals_list', {page: animals.previousPage, search: app.request.query.get('search')}) }}"
               class="btn btn-ghost btn-sm">&laquo; Precedent</a>
          {% else %}
            <button class="btn btn-ghost btn-sm" disabled>&laquo; Precedent</button>
          {% endif %}

          <span style="color:var(--text-muted);">Page {{ animals.currentPage }} / {{ animals.totalPages }}</span>

          {% if animals.hasNextPage %}
            <a href="{{ path('clinic_animals_list', {page: animals.nextPage, search: app.request.query.get('search')}) }}"
               class="btn btn-ghost btn-sm">Suivant &raquo;</a>
          {% else %}
            <button class="btn btn-ghost btn-sm" disabled>Suivant &raquo;</button>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script data-turbo-temporary>
    // Debounced search: navigates with updated query after 500ms idle
    document.addEventListener('turbo:load', function() {
      var searchInput = document.querySelector('[data-kt-filter="search"]');
      if (!searchInput) return;

      var searchTimeout;
      var freshInput = searchInput.cloneNode(true);
      searchInput.replaceWith(freshInput);

      freshInput.addEventListener('input', function(e) {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(function() {
          var url = new URL(window.location.href);
          if (e.target.value) {
            url.searchParams.set('search', e.target.value);
          } else {
            url.searchParams.delete('search');
          }
          url.searchParams.set('page', '1');
          window.location.href = url.toString();
        }, 500);
      });
    });
  </script>
{% endblock %}
