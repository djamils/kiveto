{# Partial: "Documents" pane — reports, prescriptions and invoices produced for this animal. #}
{% import 'clinic/clients/view/_macros.html.twig' as ui %}
{% set kinds = {
  report:       {mark: 'CR', label: 'Compte rendu', tone: 'info'},
  prescription: {mark: '℞',  label: 'Ordonnance',   tone: 'rose'},
  invoice:      {mark: 'FA', label: 'Facture',      tone: 'ok'},
} %}
<section class="fc-card fc-c12" id="fc-s-doc">
  <div class="fc-card-h">
    <span class="fc-card-t">Documents</span>
    {% if sheet.documents|length > 0 %}<span class="fc-card-c">{{ sheet.documents|length }}</span>{% endif %}
  </div>
  <div class="fc-card-b fc-flush">
    {% if sheet.documents|length > 0 %}
      <div class="fc-table-wrap">
        <table class="fc-t fc-doc-t">
          <thead><tr><th></th><th>Document</th><th>Type</th><th>Référence</th><th class="fc-n">Date</th><th>Établi par</th><th class="fc-n">Actions</th></tr></thead>
          <tbody>
            {% for document in sheet.documents %}
              {% set kind = kinds[document.type] %}
              {% set page_url = document.type == 'report'
                ? path('clinic_consultation_details', {id: document.id})
                : (document.type == 'prescription'
                  ? path('clinic_prescription_details', {prescriptionId: document.id})
                  : path('clinic_invoice_details', {invoiceId: document.id})) %}
              {% set pdf_url = document.type == 'report'
                ? path('clinic_consultation_report_pdf', {consultationId: document.id})
                : (document.type == 'prescription'
                  ? path('clinic_prescription_pdf', {prescriptionId: document.id})
                  : path('clinic_invoice_pdf', {invoiceId: document.id})) %}
              <tr>
                <td><span class="fc-doc-ico fc-tone-{{ kind.tone }}">{{ kind.mark }}</span></td>
                <td><b>{{ document.title }}</b></td>
                <td><span class="fc-b-type fc-tone-{{ kind.tone }}">{{ kind.label }}</span></td>
                <td class="fc-num">{{ document.reference }}</td>
                <td class="fc-n">{{ document.date }}</td>
                <td>{{ document.author }}</td>
                <td class="fc-n">
                  <div class="fc-doc-act">
                    <a class="fc-btn fc-btn-ghost fc-btn-xs" href="{{ page_url }}">Ouvrir</a>
                    <a class="fc-btn fc-btn-ghost fc-btn-xs fc-btn-ico" href="{{ pdf_url }}" target="_blank" rel="noopener" data-turbo="false" title="Ouvrir le PDF" aria-label="Ouvrir le PDF de {{ document.reference }}">
                      <svg width="13" height="13" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.6v7.2M5 7l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M2.8 11.6v1.2a.9.9 0 00.9.9h8.6a.9.9 0 00.9-.9v-1.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </a>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      {{ ui.empty('Aucun document', 'Comptes rendus, ordonnances et factures s’ajouteront automatiquement à la clôture de chaque consultation.') }}
    {% endif %}
  </div>
</section>
