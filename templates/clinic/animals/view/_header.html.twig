{# Partial: compact identity header of the animal sheet. #}
{% import 'clinic/clients/view/_macros.html.twig' as ui %}
{% set owner = sheet.owner %}
<div class="fc-fh">
  <div class="fc-fh-av fc-a-{{ sheet.kind }}">{{ ui.species_icon(sheet.kind) }}</div>
  <div class="fc-fh-id">
    <h2 class="fc-fh-name">{{ animal.name }}</h2>
    <p class="fc-fh-sub">
      {{- sheet.subtitle -}}
      {%- if owner %}{{ sheet.subtitle ? ' — ' }}<a href="{{ path('clinic_clients_view', {id: owner.id}) }}">{{ owner.name }}</a>{% endif -%}
    </p>
    {% if sheet.alerts|length > 0 or sheet.deceased or sheet.archived %}
      <div class="fc-fh-badges">
        {% if sheet.deceased %}<span class="fc-badge fc-b-grey">Décédé</span>{% endif %}
        {% if sheet.archived %}<span class="fc-badge fc-b-grey">Fiche archivée</span>{% endif %}
        {% for alert in sheet.alerts %}
          <span class="fc-badge {{ alert.allergy ? 'fc-b-crit' : 'fc-b-warn' }}">{{ alert.allergy ? 'Allergie ' }}{{ alert.label }}</span>
        {% endfor %}
      </div>
    {% endif %}
    {% set calendar_icon %}<svg width="13" height="13" fill="none" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3.2" width="12" height="10.6" rx="1.8" stroke="currentColor" stroke-width="1.5"/><path d="M5 1.6v3M11 1.6v3M2 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>{% endset %}
    {% if sheet.openVisit %}
      <a class="fc-fh-next" href="{{ path('clinic_consultation_details', {id: sheet.openVisit.id}) }}">{{ calendar_icon }} {{ sheet.openVisit.label }}{% if sheet.openVisit.detail %} <span class="fc-q">· {{ sheet.openVisit.detail }}</span>{% endif %}</a>
    {% elseif sheet.appointments.next %}
      <div class="fc-fh-next">{{ calendar_icon }} Prochain rendez-vous — {{ sheet.appointments.next.when }}{% if sheet.appointments.next.detail %} <span class="fc-q">· {{ sheet.appointments.next.detail }}</span>{% endif %}</div>
    {% elseif sheet.editable %}
      <div class="fc-fh-next fc-soft">{{ calendar_icon }} Aucun rendez-vous programmé</div>
    {% endif %}
  </div>
  <div class="fc-fh-act">
    {% if sheet.editable %}
      <button class="fc-btn fc-btn-white" type="button" data-fc-open="fc-m-poids">Pesée</button>
      <button class="fc-btn fc-btn-white" type="button" data-fc-open="fc-m-edit-an">
        <svg width="13" height="13" fill="none" viewBox="0 0 16 16" aria-hidden="true"><path d="M11 2.5l2.5 2.5-8 8H3v-2.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
        Modifier
      </button>
      {% if sheet.openVisit %}
        <a class="fc-btn fc-btn-primary" href="{{ path('clinic_consultation_details', {id: sheet.openVisit.id}) }}">Reprendre la consultation</a>
      {% else %}
        <button class="fc-btn fc-btn-primary" type="button" data-fc-open="fc-m-rdv">
          <svg width="13" height="13" fill="none" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 2.5v9M2.5 7h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          Rendez-vous
        </button>
      {% endif %}
    {% endif %}
    <button class="fc-icon-btn" type="button" data-fc-open="fc-m-more" aria-label="Plus d’actions">
      <svg width="16" height="16" fill="none" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="3.5" r="1.2" fill="currentColor"/><circle cx="8" cy="8" r="1.2" fill="currentColor"/><circle cx="8" cy="12.5" r="1.2" fill="currentColor"/></svg>
    </button>
  </div>
</div>
