{#
 # Kiveto — templates/clinic/hospitalisations/index.html.twig
 # ──────────────────────────────────────────────────────────
 # Hospitalisation dashboard — VetSaaS design from vetos-hospitalisation.html mockup.
 # Left panel: patient list. Right panel: detail with tabs, widgets,
 # care checklist, evolution timeline, hydration gauge.
 #
 # Variables:
 #   currentClinicId    string   Active clinic UUID
 #   currentClinicName  string   Active clinic name
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}Hospitalisation - {{ currentClinicName }}{% endblock %}
{% block page_title %}Hospitalisation{% endblock %}
{% block page_subtitle %}Centre de contrôle{% endblock %}

{% block stylesheets %}
<style>
    /* Full-height layout overrides for panel-based page */
    .app-scroll{overflow:hidden !important;}
    .app-body{padding:0 !important;display:flex;flex-direction:column;flex:1;overflow:hidden;min-height:0;}
    .app-main-wrap{flex:1;overflow:hidden !important;min-height:0;}

    .page-body{flex:1;display:flex;overflow:hidden;}

    /* left panel */
    .hosp-panel{width:340px;flex-shrink:0;border-right:1px solid #e8edf2;display:flex;flex-direction:column;background:#fff;}
    .hp-head{padding:10px 14px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;gap:8px;flex-shrink:0;}
    .hp-list{flex:1;overflow-y:auto;}
    .hcard{padding:12px 14px;border-bottom:1px solid #f1f5f9;cursor:pointer;transition:background .12s;position:relative;}
    .hcard:hover{background:#f8fafc;}
    .hcard.active{background:#eef2ff;}
    .hcard.active::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:#4338ca;border-radius:0 2px 2px 0;}
    .hcard-row{display:flex;align-items:center;gap:9px;}
    .hcard-avatar{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0;}
    .severity-bar{height:3px;border-radius:2px;margin-top:8px;}

    /* right panel */
    .detail-panel{flex:1;display:flex;flex-direction:column;overflow:hidden;background:#f1f5f9;}
    .detail-header{background:#fff;border-bottom:1px solid #e8edf2;padding:14px 18px;flex-shrink:0;}
    .detail-tabs{background:#fff;border-bottom:1px solid #e8edf2;display:flex;padding:0 18px;flex-shrink:0;}
    .dtab{padding:10px 16px;font-size:13px;font-weight:500;color:#64748b;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .13s;white-space:nowrap;}
    .dtab:hover{color:#334155;}
    .dtab.active{color:#4338ca;border-bottom-color:#4338ca;}
    .detail-scroll{flex:1;overflow-y:auto;padding:16px 18px;}

    /* widgets */
    .widget{background:#fff;border:1px solid #e8edf2;border-radius:12px;overflow:hidden;margin-bottom:12px;}
    .wh{padding:11px 14px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;}
    .wt{font-size:10.5px;font-weight:500;color:#64748b;text-transform:uppercase;letter-spacing:.07em;}
    .wb{padding:12px 14px;}
    .w2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
    .w3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;}

    /* soin row */
    .soin-row{display:flex;align-items:center;gap:10px;padding:9px 14px;border-bottom:1px solid #f1f5f9;transition:background .12s;}
    .soin-row:last-child{border-bottom:none;}
    .soin-row:hover{background:#f5f3ff;}
    .soin-check{width:20px;height:20px;border-radius:6px;border:1.5px solid #e2e8f0;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;transition:all .15s;}
    .soin-check.done{background:#4338ca;border-color:#4338ca;}
    .soin-check.done svg{opacity:1;}
    .soin-check svg{opacity:0;transition:opacity .1s;}

    /* evolution entry */
    .evo-entry{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid #f1f5f9;}
    .evo-entry:last-child{border-bottom:none;}
    .evo-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;margin-top:3px;}
    .evo-line::after{content:'';display:block;width:1px;background:#e2e8f0;height:calc(100% + 10px);margin-left:4.5px;margin-top:6px;}

    /* hydra gauge */
    .hydra-bar{height:8px;border-radius:10px;background:#e2e8f0;overflow:hidden;}
    .hydra-fill{height:100%;border-radius:10px;transition:width .5s;}

    /* badges */
    .badge{font-size:10.5px;font-weight:500;padding:2px 8px;border-radius:20px;white-space:nowrap;display:inline-block;}
    .b-ok{background:#f0fdf4;color:#15803d;}
    .b-warn{background:#fff7ed;color:#c2410c;}
    .b-alert{background:#fef2f2;color:#b91c1c;}
    .b-blue{background:#eff6ff;color:#1d4ed8;}
    .b-purple{background:#f5f3ff;color:#7c3aed;}
    .b-grey{background:#f8fafc;color:#475569;border:1px solid #e2e8f0;}
    .b-teal{background:#f0fdfa;color:#0f766e;}

    /* buttons */
    .btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:8px;font-size:12.5px;font-weight:500;font-family:inherit;cursor:pointer;border:none;transition:all .13s;white-space:nowrap;text-decoration:none;}
    .btn-primary{background:#4338ca;color:#fff;}
    .btn-primary:hover{background:#3730a3;}
    .btn-secondary{background:#f8fafc;color:#374151;border:1px solid #e2e8f0;}
    .btn-secondary:hover{background:#f1f5f9;border-color:#cbd5e1;}
    .btn-green{background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;}
    .btn-green:hover{background:#dcfce7;}
    .btn-danger{background:#fef2f2;color:#dc2626;border:1px solid #fecaca;}
    .btn-xs{padding:4px 9px;font-size:11.5px;}
    .btn-icon{width:28px;height:28px;padding:0;justify-content:center;border-radius:7px;}

    /* info rows */
    .irow{display:flex;justify-content:space-between;align-items:center;padding:5px 0;border-bottom:1px solid #f8fafc;}
    .irow:last-child{border-bottom:none;}
    .il{font-size:11.5px;color:#94a3b8;}
    .iv{font-size:13px;font-weight:500;color:#0f172a;}

    /* modal */
    .modal-overlay{position:fixed;inset:0;background:rgba(15,23,42,.4);backdrop-filter:blur(3px);z-index:500;display:none;align-items:center;justify-content:center;}
    .modal-overlay.open{display:flex;}
    .modal-box{background:#fff;border-radius:14px;width:560px;max-width:calc(100vw - 24px);max-height:calc(100vh - 32px);overflow-y:auto;box-shadow:0 24px 64px rgba(0,0,0,.2);opacity:0;transform:scale(.97);transition:all .2s cubic-bezier(.34,1.56,.64,1);}
    .modal-overlay.open .modal-box{opacity:1;transform:scale(1);}
    .modal-head{padding:16px 20px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:#fff;z-index:1;}
    .modal-body{padding:16px 20px;}
    .modal-foot{padding:12px 20px 16px;border-top:1px solid #f1f5f9;display:flex;gap:8px;justify-content:flex-end;}
    .form-row{margin-bottom:12px;}
    .form-label{font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.07em;display:block;margin-bottom:5px;}
    .form-input{width:100%;font-size:13px;font-family:inherit;background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:8px;padding:7px 10px;outline:none;color:#0f172a;transition:all .15s;}
    .form-input:focus{border-color:#818cf8;background:#fff;}
    select.form-input{cursor:pointer;}
    textarea.form-input{resize:vertical;min-height:80px;}
    .form-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
    .form-grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;}

    #toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(8px);padding:8px 16px;border-radius:8px;font-size:13px;font-weight:500;color:#fff;opacity:0;transition:all .25s;pointer-events:none;z-index:999;}

    /* ── Burger ── */
    .btn-burger{display:none;width:34px;height:34px;border-radius:8px;border:1px solid #e2e8f0;background:#f8fafc;cursor:pointer;align-items:center;justify-content:center;color:#64748b;flex-shrink:0;}
    .btn-burger:hover{background:#f1f5f9;}

    /* ── Drawers ── */
    .drawer-overlay{display:none;position:fixed;inset:0;background:rgba(15,23,42,.25);z-index:80;backdrop-filter:blur(2px);}
    .drawer-overlay.open{display:block;}

    /* ── Slide detail (tablet) ── */
    .detail-slide{position:fixed;right:0;top:0;bottom:0;width:min(520px,100vw);background:#f1f5f9;z-index:90;transform:translateX(100%);transition:transform .28s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;overflow:hidden;}
    .detail-slide.open{transform:translateX(0);box-shadow:-4px 0 24px rgba(0,0,0,.12);}

    /* ── Bottom sheet (mobile) ── */
    #bs-overlay{display:none;position:fixed;inset:0;background:rgba(15,23,42,.3);z-index:100;}
    #bs{display:none;position:fixed;left:0;right:0;bottom:0;background:#fff;border-radius:16px 16px 0 0;box-shadow:0 -4px 24px rgba(0,0,0,.15);z-index:101;max-height:90vh;flex-direction:column;transform:translateY(100%);transition:transform .3s ease;}
    #bs-inner{flex:1;overflow-y:auto;}

    /* ── iPad portrait ── */
    @media(max-width:1024px){
      .btn-burger{display:flex;}
      .hosp-panel{width:100%;}
      .detail-panel{display:none;}
      .topbar-stats{display:none;}
    }

    /* ── Mobile ── */
    @media(max-width:640px){
      .topbar{padding:0 10px;gap:8px;flex-wrap:nowrap;}
      .topbar-title p:last-child{display:none;}
      .topbar-new-btn span{display:none;}
      .hosp-panel{width:100%;}
    }

    /* print */
    @media print{
      .sidebar,.topbar,.hp-head,.btn,.modal-overlay{display:none!important;}
      .page-body{display:block;}
      .hosp-panel{display:none!important;}
      .detail-panel{width:100%;}
      .detail-tabs{display:none!important;}
      .detail-scroll{overflow:visible;padding:0;}
      .widget{break-inside:avoid;margin-bottom:16px;}
    }
</style>
{% endblock %}

{% block topbar_actions %}
    {# Stats pills #}
    <div class="topbar-stats" style="display:flex;gap:6px;">
      <div style="display:flex;align-items:center;gap:5px;padding:4px 10px;border-radius:20px;background:#eff6ff;border:1px solid #bfdbfe;">
        <div style="width:6px;height:6px;border-radius:50%;background:#3b82f6;"></div>
        <span style="font-size:12px;font-weight:500;color:#2563eb;" id="stat-hosp">4</span>
        <span style="font-size:11.5px;color:#64748b;">hospitalisés</span>
      </div>
      <div style="display:flex;align-items:center;gap:5px;padding:4px 10px;border-radius:20px;background:#fef2f2;border:1px solid #fecaca;">
        <div style="width:6px;height:6px;border-radius:50%;background:#dc2626;"></div>
        <span style="font-size:12px;font-weight:500;color:#dc2626;" id="stat-critique">1</span>
        <span style="font-size:11.5px;color:#64748b;">critique</span>
      </div>
      <div style="display:flex;align-items:center;gap:5px;padding:4px 10px;border-radius:20px;background:#f0fdf4;border:1px solid #bbf7d0;">
        <div style="width:6px;height:6px;border-radius:50%;background:#16a34a;"></div>
        <span style="font-size:12px;font-weight:500;color:#059669;" id="stat-sortie-prev">2</span>
        <span style="font-size:11.5px;color:#64748b;">sorties prévues aujourd'hui</span>
      </div>
    </div>
    <button class="btn btn-primary btn-xs topbar-new-btn" onclick="openModal('modal-admission')">
      <svg width="11" height="11" fill="none" viewBox="0 0 12 12"><path d="M6 2v8M2 6h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <span>Nouvelle admission</span>
    </button>
{% endblock %}

{% block content %}
<div class="drawer-overlay" id="drawer-overlay" onclick="closeSidebar()"></div>
<div id="bs-overlay" onclick="closeBs()"></div>
<div id="bs">
  <div style="padding:8px;display:flex;justify-content:center;flex-shrink:0;">
    <div style="width:40px;height:4px;border-radius:2px;background:#e2e8f0;"></div>
  </div>
  <div id="bs-inner"></div>
</div>

<div class="page-body">

  {# ══ LEFT PANEL ══ #}
  <div class="hosp-panel">
    <div class="hp-head">
      <span style="font-size:13px;font-weight:500;color:#0f172a;">Patients hospitalisés</span>
      <span style="font-size:11px;color:#94a3b8;background:#f1f5f9;padding:2px 8px;border-radius:20px;margin-left:auto;" id="list-count"></span>
    </div>
    <div class="hp-list" id="hosp-list"></div>
  </div>

  {# ══ SLIDE (tablet) ══ #}
  <div class="detail-slide" id="detail-slide">
    <div id="slide-inner" style="display:flex;flex-direction:column;flex:1;overflow:hidden;"></div>
  </div>

  {# ══ RIGHT PANEL ══ #}
  <div class="detail-panel" id="detail-panel">
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:#94a3b8;">
      <div style="width:56px;height:56px;border-radius:14px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;margin-bottom:14px;">
        <svg width="26" height="26" fill="none" viewBox="0 0 32 32" style="color:#cbd5e1;"><rect x="2" y="8" width="28" height="20" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M16 14v6M13 17h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M8 8V6a8 8 0 0116 0v2" stroke="currentColor" stroke-width="1.6"/></svg>
      </div>
      <p style="font-size:14px;font-weight:500;color:#334155;margin-bottom:6px;">Sélectionnez un patient</p>
      <p style="font-size:13px;max-width:200px;text-align:center;line-height:1.5;">Cliquez sur un patient pour ouvrir sa fiche d'hospitalisation</p>
    </div>
  </div>

</div>

{# ══ MODAL : Admission ══ #}
<div class="modal-overlay" id="modal-admission" onclick="if(event.target===this)closeModal('modal-admission')">
  <div class="modal-box">
    <div class="modal-head">
      <p style="font-size:14px;font-weight:700;color:#0f172a;">Nouvelle admission</p>
      <button onclick="closeModal('modal-admission')" style="width:26px;height:26px;border-radius:7px;border:none;background:#f1f5f9;cursor:pointer;display:flex;align-items:center;justify-content:center;"><svg width="9" height="9" fill="none" viewBox="0 0 8 8"><path d="M1 1l6 6M7 1L1 7" stroke="#64748b" stroke-width="1.3" stroke-linecap="round"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="form-grid-2">
        <div class="form-row"><label class="form-label">Animal *</label><input class="form-input" placeholder="Rechercher un patient…"></div>
        <div class="form-row"><label class="form-label">Propriétaire</label><input class="form-input" placeholder="Nom du propriétaire"></div>
      </div>
      <div class="form-row"><label class="form-label">Motif d'hospitalisation *</label><input class="form-input" placeholder="Ex : Post-opératoire stérilisation, Insuffisance rénale aiguë…"></div>
      <div class="form-grid-3">
        <div class="form-row"><label class="form-label">Vétérinaire référent</label>
          <select class="form-input"><option>Dr. Rousseau</option><option>Dr. Martin</option><option>Dr. Dupont</option><option>Dr. Lambert</option></select>
        </div>
        <div class="form-row"><label class="form-label">Sévérité</label>
          <select class="form-input"><option>Stable</option><option>Surveillé</option><option>Critique</option></select>
        </div>
        <div class="form-row"><label class="form-label">Durée estimée</label>
          <select class="form-input"><option>24h</option><option>48h</option><option>72h</option><option>4–5 jours</option><option>1 semaine+</option></select>
        </div>
      </div>
      <div class="form-row"><label class="form-label">Protocole de soins initial</label><textarea class="form-input" placeholder="Médicaments, fréquence de surveillance, restrictions alimentaires…"></textarea></div>
      <div class="form-grid-2">
        <div class="form-row"><label class="form-label">Alimentation</label>
          <select class="form-input"><option>Ration normale</option><option>Ration réduite (50%)</option><option>Diète stricte</option><option>Gavage / sonde</option><option>Perfusion IV uniquement</option></select>
        </div>
        <div class="form-row"><label class="form-label">Accès eau</label>
          <select class="form-input"><option>Libre accès</option><option>Quantité limitée</option><option>Aucun accès (perfusion)</option></select>
        </div>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-secondary" onclick="closeModal('modal-admission')">Annuler</button>
      <button class="btn btn-primary" onclick="toast('Admission enregistrée','#059669');closeModal('modal-admission')">Admettre le patient</button>
    </div>
  </div>
</div>

{# ══ MODAL : Ajouter soin ══ #}
<div class="modal-overlay" id="modal-soin" onclick="if(event.target===this)closeModal('modal-soin')">
  <div class="modal-box" style="width:480px;">
    <div class="modal-head">
      <p style="font-size:14px;font-weight:700;color:#0f172a;" id="modal-soin-title">Ajouter un soin</p>
      <button onclick="closeModal('modal-soin')" style="width:26px;height:26px;border-radius:7px;border:none;background:#f1f5f9;cursor:pointer;display:flex;align-items:center;justify-content:center;"><svg width="9" height="9" fill="none" viewBox="0 0 8 8"><path d="M1 1l6 6M7 1L1 7" stroke="#64748b" stroke-width="1.3" stroke-linecap="round"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="form-row"><label class="form-label">Type de soin</label>
        <select class="form-input">
          <option>Médicament oral</option><option>Injection SC</option><option>Injection IM</option><option>Injection IV</option>
          <option>Perfusion</option><option>Pansement</option><option>Nettoyage plaie</option><option>Autre</option>
        </select>
      </div>
      <div class="form-grid-2">
        <div class="form-row"><label class="form-label">Produit / Médicament</label><input class="form-input" placeholder="Ex : Amoxicilline 250mg"></div>
        <div class="form-row"><label class="form-label">Dose</label><input class="form-input" placeholder="Ex : 1 comprimé, 5ml…"></div>
        <div class="form-row"><label class="form-label">Fréquence</label>
          <select class="form-input"><option>1×/jour</option><option>2×/jour</option><option>3×/jour</option><option>Toutes les 8h</option><option>Toutes les 6h</option><option>Au besoin</option><option>Unique</option></select>
        </div>
        <div class="form-row"><label class="form-label">Durée</label>
          <select class="form-input"><option>Jusqu'à la sortie</option><option>24h</option><option>48h</option><option>72h</option><option>5 jours</option><option>7 jours</option></select>
        </div>
      </div>
      <div class="form-row"><label class="form-label">Note / Instructions</label><input class="form-input" placeholder="Optionnel — observations particulières…"></div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-secondary" onclick="closeModal('modal-soin')">Annuler</button>
      <button class="btn btn-primary" onclick="toast('Soin ajouté au protocole','#059669');closeModal('modal-soin')">Ajouter</button>
    </div>
  </div>
</div>

{# ══ MODAL : Saisir évolution ══ #}
<div class="modal-overlay" id="modal-evo" onclick="if(event.target===this)closeModal('modal-evo')">
  <div class="modal-box" style="width:500px;">
    <div class="modal-head">
      <p style="font-size:14px;font-weight:700;color:#0f172a;">Saisir une évolution</p>
      <button onclick="closeModal('modal-evo')" style="width:26px;height:26px;border-radius:7px;border:none;background:#f1f5f9;cursor:pointer;display:flex;align-items:center;justify-content:center;"><svg width="9" height="9" fill="none" viewBox="0 0 8 8"><path d="M1 1l6 6M7 1L1 7" stroke="#64748b" stroke-width="1.3" stroke-linecap="round"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="form-grid-2">
        <div class="form-row"><label class="form-label">État général</label>
          <select class="form-input" id="evo-etat">
            <option value="ameliore">✅ Amélioré</option><option value="stable" selected>➡ Stable</option>
            <option value="surveille">⚠ À surveiller</option><option value="degrade">🔴 Dégradé</option>
          </select>
        </div>
        <div class="form-row"><label class="form-label">Heure</label><input class="form-input" type="time" id="evo-heure" value="10:30"></div>
      </div>
      <div class="form-row"><label class="form-label">Observation clinique *</label><textarea class="form-input" id="evo-note" placeholder="Décrivez l'état du patient, comportement, appétit, réaction aux traitements…" style="min-height:100px;"></textarea></div>
      <div class="form-grid-3">
        <div class="form-row"><label class="form-label">Température (°C)</label><input class="form-input" type="number" step="0.1" placeholder="38.5"></div>
        <div class="form-row"><label class="form-label">FC (bpm)</label><input class="form-input" type="number" placeholder="120"></div>
        <div class="form-row"><label class="form-label">FR (/min)</label><input class="form-input" type="number" placeholder="22"></div>
      </div>
      <div class="form-row"><label class="form-label">Vétérinaire</label>
        <select class="form-input"><option>Dr. Rousseau</option><option>Dr. Martin</option><option>Dr. Dupont</option><option>Dr. Lambert</option></select>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-secondary" onclick="closeModal('modal-evo')">Annuler</button>
      <button class="btn btn-primary" onclick="toast('Évolution enregistrée','#059669');closeModal('modal-evo')">Enregistrer</button>
    </div>
  </div>
</div>

{# ══ MODAL : Sortie ══ #}
<div class="modal-overlay" id="modal-sortie" onclick="if(event.target===this)closeModal('modal-sortie')">
  <div class="modal-box">
    <div class="modal-head">
      <p style="font-size:14px;font-weight:700;color:#0f172a;">Préparer la sortie</p>
      <button onclick="closeModal('modal-sortie')" style="width:26px;height:26px;border-radius:7px;border:none;background:#f1f5f9;cursor:pointer;display:flex;align-items:center;justify-content:center;"><svg width="9" height="9" fill="none" viewBox="0 0 8 8"><path d="M1 1l6 6M7 1L1 7" stroke="#64748b" stroke-width="1.3" stroke-linecap="round"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="form-grid-2">
        <div class="form-row"><label class="form-label">Date de sortie</label><input class="form-input" type="date" value="2026-03-23"></div>
        <div class="form-row"><label class="form-label">Heure de sortie</label><input class="form-input" type="time" value="11:00"></div>
      </div>
      <div class="form-row"><label class="form-label">Conclusion médicale *</label><textarea class="form-input" placeholder="Résumé de l'hospitalisation, évolution, état à la sortie…" style="min-height:90px;"></textarea></div>
      <div class="form-row"><label class="form-label">Traitement de sortie</label><textarea class="form-input" placeholder="Médicaments à domicile, dosage, durée…" style="min-height:70px;"></textarea></div>
      <div class="form-row"><label class="form-label">Instructions pour le propriétaire</label><textarea class="form-input" placeholder="Repos, alimentation, signes à surveiller, RDV de contrôle…" style="min-height:70px;"></textarea></div>
      <div class="form-row"><label class="form-label">Prochain RDV de contrôle</label><input class="form-input" type="date"></div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-secondary" onclick="closeModal('modal-sortie')">Annuler</button>
      <button class="btn btn-secondary" onclick="window.print();closeModal('modal-sortie')">
        <svg width="11" height="11" fill="none" viewBox="0 0 12 12"><path d="M3 1h6v3H3V1zM1 4h10v5H9v2H3V9H1V4z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
        Imprimer CR
      </button>
      <button class="btn btn-green" onclick="toast('Sortie validée — CR généré','#059669');closeModal('modal-sortie')">
        <svg width="11" height="11" fill="none" viewBox="0 0 12 12"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Valider la sortie
      </button>
    </div>
  </div>
</div>

<div id="toast"></div>
{% endblock %}

{% block javascripts %}
{% endblock %}
