{# Partial: modals — admission, soin, evolution, sortie #}

{# ══ MODAL : Admission ══ #}
<div class="modal-overlay hidden" id="modal-admission" onclick="if(event.target===this)closeModal('modal-admission')">
  <div class="modal">
    <div class="modal-head">
      <p class="hosp-modal-title">Nouvelle admission</p>
      <button onclick="closeModal('modal-admission')" class="hosp-modal-close"><svg width="9" height="9" fill="none" viewBox="0 0 8 8"><path d="M1 1l6 6M7 1L1 7" stroke="#64748b" stroke-width="1.3" stroke-linecap="round"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="form-grid-2">
        <div class="form-row"><label class="form-label">Animal *</label><input class="form-input" placeholder="Rechercher un patient…"></div>
        <div class="form-row"><label class="form-label">Propriétaire</label><input class="form-input" placeholder="Nom du propriétaire"></div>
      </div>
      <div class="form-row"><label class="form-label">Motif d'hospitalisation *</label><input class="form-input" placeholder="Ex : Post-opératoire stérilisation, Insuffisance rénale aiguë…"></div>
      <div class="form-grid-3">
        {# Referring vet select #}
        <div class="form-row"><label class="form-label">Vétérinaire référent</label>
          {{ include('components/ui/select.html.twig', {
            name: 'vet_select',
            value: 'rousseau',
            options: [
              { value: 'rousseau', label: 'Dr. Rousseau' },
              { value: 'martin', label: 'Dr. Martin' },
              { value: 'dupont', label: 'Dr. Dupont' },
              { value: 'lambert', label: 'Dr. Lambert' },
            ]
          }) }}
        </div>
        {# Severity select #}
        <div class="form-row"><label class="form-label">Sévérité</label>
          {{ include('components/ui/select.html.twig', {
            name: 'severity_select',
            value: 'stable',
            options: [
              { value: 'stable', label: 'Stable' },
              { value: 'surveille', label: 'Surveillé' },
              { value: 'critique', label: 'Critique' },
            ]
          }) }}
        </div>
        {# Estimated duration select #}
        <div class="form-row"><label class="form-label">Durée estimée</label>
          {{ include('components/ui/select.html.twig', {
            name: 'duration_estimate_select',
            value: '24h',
            options: [
              { value: '24h', label: '24h' },
              { value: '48h', label: '48h' },
              { value: '72h', label: '72h' },
              { value: '4-5j', label: '4–5 jours' },
              { value: '1sem+', label: '1 semaine+' },
            ]
          }) }}
        </div>
      </div>
      <div class="form-row"><label class="form-label">Protocole de soins initial</label><textarea class="form-input" placeholder="Médicaments, fréquence de surveillance, restrictions alimentaires…"></textarea></div>
      <div class="form-grid-2">
        {# Feeding plan select #}
        <div class="form-row"><label class="form-label">Alimentation</label>
          {{ include('components/ui/select.html.twig', {
            name: 'feeding_select',
            value: 'normale',
            options: [
              { value: 'normale', label: 'Ration normale' },
              { value: 'reduite', label: 'Ration réduite (50%)' },
              { value: 'diete', label: 'Diète stricte' },
              { value: 'gavage', label: 'Gavage / sonde' },
              { value: 'perfusion', label: 'Perfusion IV uniquement' },
            ]
          }) }}
        </div>
        {# Water access select #}
        <div class="form-row"><label class="form-label">Accès eau</label>
          {{ include('components/ui/select.html.twig', {
            name: 'water_access_select',
            value: 'libre',
            options: [
              { value: 'libre', label: 'Libre accès' },
              { value: 'limite', label: 'Quantité limitée' },
              { value: 'aucun', label: 'Aucun accès (perfusion)' },
            ]
          }) }}
        </div>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-secondary" onclick="closeModal('modal-admission')">Annuler</button>
      <button class="btn btn-primary" onclick="toast('Admission enregistrée','#059669');closeModal('modal-admission')">Admettre le patient</button>
    </div>
  </div>
</div>

{# ══ MODAL : Ajouter soin ══ #}
<div class="modal-overlay hidden" id="modal-soin" onclick="if(event.target===this)closeModal('modal-soin')">
  <div class="modal hosp-modal-sm">
    <div class="modal-head">
      <p class="hosp-modal-title" id="modal-soin-title">Ajouter un soin</p>
      <button onclick="closeModal('modal-soin')" class="hosp-modal-close"><svg width="9" height="9" fill="none" viewBox="0 0 8 8"><path d="M1 1l6 6M7 1L1 7" stroke="#64748b" stroke-width="1.3" stroke-linecap="round"/></svg></button>
    </div>
    <div class="modal-body">
      {# Care type select #}
      <div class="form-row"><label class="form-label">Type de soin</label>
        {{ include('components/ui/select.html.twig', {
          name: 'care_type_select',
          value: 'med_oral',
          options: [
            { value: 'med_oral', label: 'Médicament oral' },
            { value: 'inj_sc', label: 'Injection SC' },
            { value: 'inj_im', label: 'Injection IM' },
            { value: 'inj_iv', label: 'Injection IV' },
            { value: 'perfusion', label: 'Perfusion' },
            { value: 'pansement', label: 'Pansement' },
            { value: 'nettoyage', label: 'Nettoyage plaie' },
            { value: 'autre', label: 'Autre' },
          ]
        }) }}
      </div>
      <div class="form-grid-2">
        <div class="form-row"><label class="form-label">Produit / Médicament</label><input class="form-input" placeholder="Ex : Amoxicilline 250mg"></div>
        <div class="form-row"><label class="form-label">Dose</label><input class="form-input" placeholder="Ex : 1 comprimé, 5ml…"></div>
        {# Frequency select #}
        <div class="form-row"><label class="form-label">Fréquence</label>
          {{ include('components/ui/select.html.twig', {
            name: 'frequency_select',
            value: '1x_jour',
            options: [
              { value: '1x_jour', label: '1×/jour' },
              { value: '2x_jour', label: '2×/jour' },
              { value: '3x_jour', label: '3×/jour' },
              { value: '8h', label: 'Toutes les 8h' },
              { value: '6h', label: 'Toutes les 6h' },
              { value: 'besoin', label: 'Au besoin' },
              { value: 'unique', label: 'Unique' },
            ]
          }) }}
        </div>
        {# Treatment duration select #}
        <div class="form-row"><label class="form-label">Durée</label>
          {{ include('components/ui/select.html.twig', {
            name: 'treatment_duration_select',
            value: 'sortie',
            options: [
              { value: 'sortie', label: 'Jusqu\'à la sortie' },
              { value: '24h', label: '24h' },
              { value: '48h', label: '48h' },
              { value: '72h', label: '72h' },
              { value: '5j', label: '5 jours' },
              { value: '7j', label: '7 jours' },
            ]
          }) }}
        </div>
      </div>
      <div class="form-row"><label class="form-label">Note / Instructions</label><input class="form-input" placeholder="Optionnel — observations particulières…"></div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-secondary" onclick="closeModal('modal-soin')">Annuler</button>
      <button class="btn btn-primary" onclick="toast('Soin ajouté au protocole','#059669');closeModal('modal-soin')">Ajouter</button>
    </div>
  </div>
</div>

{# ══ MODAL : Saisir evolution ══ #}
<div class="modal-overlay hidden" id="modal-evo" onclick="if(event.target===this)closeModal('modal-evo')">
  <div class="modal hosp-modal-md">
    <div class="modal-head">
      <p class="hosp-modal-title">Saisir une évolution</p>
      <button onclick="closeModal('modal-evo')" class="hosp-modal-close"><svg width="9" height="9" fill="none" viewBox="0 0 8 8"><path d="M1 1l6 6M7 1L1 7" stroke="#64748b" stroke-width="1.3" stroke-linecap="round"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="form-grid-2">
        {# General condition select — pre-selected: stable #}
        <div class="form-row"><label class="form-label">État général</label>
          {{ include('components/ui/select.html.twig', {
            name: 'evo_etat',
            id: 'evo-etat',
            value: 'stable',
            options: [
              { value: 'ameliore', label: '✅ Amélioré' },
              { value: 'stable', label: '➡ Stable' },
              { value: 'surveille', label: '⚠ À surveiller' },
              { value: 'degrade', label: '🔴 Dégradé' },
            ]
          }) }}
        </div>
        <div class="form-row"><label class="form-label">Heure</label><input class="form-input" type="time" id="evo-heure" value="10:30"></div>
      </div>
      <div class="form-row"><label class="form-label">Observation clinique *</label><textarea class="form-input hosp-textarea-md" id="evo-note" placeholder="Décrivez l'état du patient, comportement, appétit, réaction aux traitements…"></textarea></div>
      <div class="form-grid-3">
        <div class="form-row"><label class="form-label">Température (°C)</label><input class="form-input" type="number" step="0.1" placeholder="38.5"></div>
        <div class="form-row"><label class="form-label">FC (bpm)</label><input class="form-input" type="number" placeholder="120"></div>
        <div class="form-row"><label class="form-label">FR (/min)</label><input class="form-input" type="number" placeholder="22"></div>
      </div>
      {# Vet select (evolution modal) #}
      <div class="form-row"><label class="form-label">Vétérinaire</label>
        {{ include('components/ui/select.html.twig', {
          name: 'evo_vet_select',
          value: 'rousseau',
          options: [
            { value: 'rousseau', label: 'Dr. Rousseau' },
            { value: 'martin', label: 'Dr. Martin' },
            { value: 'dupont', label: 'Dr. Dupont' },
            { value: 'lambert', label: 'Dr. Lambert' },
          ]
        }) }}
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-secondary" onclick="closeModal('modal-evo')">Annuler</button>
      <button class="btn btn-primary" onclick="toast('Évolution enregistrée','#059669');closeModal('modal-evo')">Enregistrer</button>
    </div>
  </div>
</div>

{# ══ MODAL : Sortie ══ #}
<div class="modal-overlay hidden" id="modal-sortie" onclick="if(event.target===this)closeModal('modal-sortie')">
  <div class="modal">
    <div class="modal-head">
      <p class="hosp-modal-title">Préparer la sortie</p>
      <button onclick="closeModal('modal-sortie')" class="hosp-modal-close"><svg width="9" height="9" fill="none" viewBox="0 0 8 8"><path d="M1 1l6 6M7 1L1 7" stroke="#64748b" stroke-width="1.3" stroke-linecap="round"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="form-grid-2">
        <div class="form-row"><label class="form-label">Date de sortie</label><input class="form-input" type="date" value="2026-03-23"></div>
        <div class="form-row"><label class="form-label">Heure de sortie</label><input class="form-input" type="time" value="11:00"></div>
      </div>
      <div class="form-row"><label class="form-label">Conclusion médicale *</label><textarea class="form-input hosp-textarea-conclusion"></textarea></div>
      <div class="form-row"><label class="form-label">Traitement de sortie</label><textarea class="form-input hosp-textarea-sm" placeholder="Médicaments à domicile, dosage, durée…"></textarea></div>
      <div class="form-row"><label class="form-label">Instructions pour le propriétaire</label><textarea class="form-input hosp-textarea-sm" placeholder="Repos, alimentation, signes à surveiller, RDV de contrôle…"></textarea></div>
      <div class="form-row"><label class="form-label">Prochain RDV de contrôle</label><input class="form-input" type="date"></div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-secondary" onclick="closeModal('modal-sortie')">Annuler</button>
      <button class="btn btn-secondary" onclick="window.print();closeModal('modal-sortie')">
        <svg width="11" height="11" fill="none" viewBox="0 0 12 12"><path d="M3 1h6v3H3V1zM1 4h10v5H9v2H3V9H1V4z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
        Imprimer CR
      </button>
      <button class="btn btn-success" onclick="toast('Sortie validée — CR généré','#059669');closeModal('modal-sortie')">
        <svg width="11" height="11" fill="none" viewBox="0 0 12 12"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Valider la sortie
      </button>
    </div>
  </div>
</div>
