{#
 # Kiveto -- templates/clinic/dashboard.html.twig
 # ───────────────────────────────────────────────
 # Dashboard page for the active clinic.
 # Extends clinic/base.html.twig (with sidebar + topbar).
 #
 # Variables from controller:
 #   currentClinicId    string (UUID)
 #   currentClinicName  string
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}Tableau de bord - {{ currentClinicName }}{% endblock %}

{% block page_title %}Tableau de bord{% endblock %}

{% block content %}
<div style="padding:var(--space-4);">

  {# ── Welcome message ── #}
  <div class="widget" style="padding:var(--space-4) var(--space-5);margin-bottom:var(--space-4);">
    <p style="font-size:var(--text-lg);font-weight:var(--weight-medium);color:var(--text-primary);margin-bottom:var(--space-1);">
      Bienvenue sur {{ currentClinicName }}
    </p>
    <p style="font-size:var(--text-md);color:var(--text-subtle);">
      Voici un apercu de l'activite de votre clinique.
    </p>
  </div>

  {# ── KPI stats grid ── #}
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-3);margin-bottom:var(--space-4);">

    {# Appointments today #}
    <div class="kpi-card k-blue">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-2);">
        <div class="kpi-icon" style="background:#dbeafe;">
          <svg width="14" height="14" fill="none" viewBox="0 0 16 16">
            <rect x="2" y="3" width="12" height="11" rx="1.5" stroke="#2563eb" stroke-width="1.3"/>
            <path d="M5 1v3M11 1v3M2 7h12" stroke="#2563eb" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
        </div>
        <span style="font-size:var(--text-xs);color:var(--text-subtle);">Aujourd'hui</span>
      </div>
      <p class="kpi-num">--</p>
      <p class="kpi-label">Rendez-vous</p>
    </div>

    {# Waiting room #}
    <div class="kpi-card k-amber">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-2);">
        <div class="kpi-icon" style="background:#fef9c3;">
          <svg width="14" height="14" fill="none" viewBox="0 0 16 16">
            <circle cx="8" cy="5" r="2.5" stroke="#d97706" stroke-width="1.3"/>
            <path d="M3 13c0-2.5 2.2-4 5-4s5 1.5 5 4" stroke="#d97706" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
        </div>
        <span style="font-size:var(--text-xs);color:var(--text-subtle);">En attente</span>
      </div>
      <p class="kpi-num">--</p>
      <p class="kpi-label">Salle d'attente</p>
    </div>

    {# Hospitalized #}
    <div class="kpi-card k-red">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-2);">
        <div class="kpi-icon" style="background:#fee2e2;">
          <svg width="14" height="14" fill="none" viewBox="0 0 16 16">
            <rect x="1" y="7" width="14" height="7" rx="1" stroke="#dc2626" stroke-width="1.3"/>
            <path d="M4 7V4a1 1 0 011-1h6a1 1 0 011 1v3" stroke="#dc2626" stroke-width="1.3"/>
            <path d="M8 9v3M6.5 10.5h3" stroke="#dc2626" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
        </div>
        <span style="font-size:var(--text-xs);color:var(--text-subtle);">Actifs</span>
      </div>
      <p class="kpi-num">--</p>
      <p class="kpi-label">Hospitalises</p>
    </div>

    {# Stock alerts #}
    <div class="kpi-card k-green">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-2);">
        <div class="kpi-icon" style="background:#dcfce7;">
          <svg width="14" height="14" fill="none" viewBox="0 0 16 16">
            <rect x="2" y="2" width="12" height="12" rx="2" stroke="#16a34a" stroke-width="1.3"/>
            <path d="M6 6h4M6 8.5h4M6 11h2" stroke="#16a34a" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
        </div>
        <span style="font-size:var(--text-xs);color:var(--text-subtle);">Stock</span>
      </div>
      <p class="kpi-num">--</p>
      <p class="kpi-label">Alertes stock</p>
    </div>

  </div>

  {# ── Quick actions ── #}
  <div style="margin-bottom:var(--space-4);">
    <p style="font-size:var(--text-xs);font-weight:var(--weight-medium);color:var(--text-subtle);text-transform:uppercase;letter-spacing:.08em;margin-bottom:var(--space-2);">Actions rapides</p>
    <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:var(--space-2);">

      <button class="qa-widget" type="button" aria-label="Nouveau patient">
        <div class="qa-widget-icon" style="background:#dbeafe;">
          <svg width="18" height="18" fill="none" viewBox="0 0 16 16">
            <circle cx="7" cy="5" r="2.5" stroke="#2563eb" stroke-width="1.2"/>
            <path d="M2.5 13c0-2.5 2-4 4.5-4s4.5 1.5 4.5 4" stroke="#2563eb" stroke-width="1.2" stroke-linecap="round"/>
            <path d="M13 6v4M11 8h4" stroke="#2563eb" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
        </div>
        <span class="qa-widget-label">Nouveau patient</span>
      </button>

      <button class="qa-widget" type="button" aria-label="Prise de RDV">
        <div class="qa-widget-icon" style="background:#dcfce7;">
          <svg width="18" height="18" fill="none" viewBox="0 0 16 16">
            <rect x="2" y="3" width="12" height="11" rx="1.5" stroke="#16a34a" stroke-width="1.2"/>
            <path d="M5 1v3M11 1v3M2 7h12" stroke="#16a34a" stroke-width="1.2" stroke-linecap="round"/>
            <path d="M10 10h2M10 10v2" stroke="#16a34a" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
        </div>
        <span class="qa-widget-label">Prise de RDV</span>
      </button>

      <button class="qa-widget" type="button" aria-label="Walk-in sans RDV">
        <div class="qa-widget-icon" style="background:#fef9c3;">
          <svg width="18" height="18" fill="none" viewBox="0 0 16 16">
            <path d="M8 2l1.5 3 3.5.5-2.5 2.5.5 3.5L8 10l-3 1.5.5-3.5L3 5.5l3.5-.5L8 2z" stroke="#d97706" stroke-width="1.2" stroke-linejoin="round"/>
          </svg>
        </div>
        <span class="qa-widget-label">Walk-in</span>
      </button>

      <button class="qa-widget" type="button" aria-label="Hospitaliser un patient">
        <div class="qa-widget-icon" style="background:#f3e8ff;">
          <svg width="18" height="18" fill="none" viewBox="0 0 16 16">
            <rect x="1" y="7" width="14" height="7" rx="1" stroke="#9333ea" stroke-width="1.2"/>
            <path d="M4 7V4a1 1 0 011-1h6a1 1 0 011 1v3" stroke="#9333ea" stroke-width="1.2"/>
            <path d="M8 9v3M6.5 10.5h3" stroke="#9333ea" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
        </div>
        <span class="qa-widget-label">Hospitaliser</span>
      </button>

      <button class="qa-widget" type="button" aria-label="Imprimer ordonnance">
        <div class="qa-widget-icon" style="background:#ffe4e6;">
          <svg width="18" height="18" fill="none" viewBox="0 0 16 16">
            <rect x="3" y="6" width="10" height="6" rx="1" stroke="#e11d48" stroke-width="1.2"/>
            <path d="M5 6V3h6v3M5 10h6v4H5v-4z" stroke="#e11d48" stroke-width="1.2"/>
          </svg>
        </div>
        <span class="qa-widget-label">Imprimer ordo.</span>
      </button>

    </div>
  </div>

  {# ── Info widget ── #}
  <div class="widget" style="padding:var(--space-4) var(--space-5);">
    <p class="widget-title">Informations</p>
    <p style="font-size:var(--text-md);color:var(--text-secondary);line-height:var(--lh-loose);">
      Les donnees en temps reel seront bientot disponibles.
      Les statistiques affichees ci-dessus sont des emplacements reserves
      qui se rempliront automatiquement une fois les modules connectes.
    </p>
  </div>

</div>
{% endblock %}
