{#
 # Kiveto -- templates/clinic/dashboard.html.twig
 # ───────────────────────────────────────────────
 # Dashboard page for the active clinic.
 # Extends clinic/base.html.twig (with sidebar + topbar).
 #
 # Variables from controller:
 #   currentClinicId    string (UUID)
 #   currentClinicName  string
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}Tableau de bord - {{ currentClinicName }}{% endblock %}

{% block page_title %}Vue d'ensemble{% endblock %}
{% block page_subtitle %}14 patients hospitalisés · 3 analyses en attente{% endblock %}

{% block topbar_actions %}
  <button class="btn-rpanel" onclick="document.getElementById('rpanel').classList.add('open');document.getElementById('rpanelOverlay').classList.add('is-open');" aria-label="Ouvrir le panneau latéral">
    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" d="M9 3h12v18H9M3 9h6M3 15h6"/></svg>
  </button>
{% endblock %}

{% block stylesheets %}
<script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
{% endblock %}

{% block content %}

  {# ── HEADER ROW : Clock + Compact KPIs ── #}
  <div class="dash-header-grid" style="display:grid;grid-template-columns:auto 1fr;gap:var(--space-3);margin-bottom:var(--space-4);align-items:stretch;">

    {# Clock — central element, vet glances at the time constantly #}
    <div class="widget" style="padding:var(--space-4) var(--space-5);display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:140px;">
      <p id="dash-clock" style="font-size:36px;font-weight:var(--weight-medium);color:var(--text-primary);letter-spacing:-2px;line-height:1;font-variant-numeric:tabular-nums;"></p>
      <p id="dash-date" style="font-size:var(--text-sm);color:var(--text-subtle);margin-top:4px;text-align:center;"></p>
    </div>

    {# 4 operational KPIs — real-time situation #}
    <div class="dash-kpi-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-3);">

      <div class="kpi-card k-blue" role="button" tabindex="0">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-2);">
          <div class="kpi-icon" style="background:#dbeafe;">
            <i data-lucide="calendar-check" style="width:14px;height:14px;color:#2563eb;"></i>
          </div>
          <span style="font-size:var(--text-xs);color:var(--text-subtle);">Aujourd'hui</span>
        </div>
        <p class="kpi-num">18</p>
        <p class="kpi-label">Rendez-vous</p>
        <p class="kpi-delta" style="color:#16a34a;"><i data-lucide="check-circle" style="width:10px;height:10px;"></i> 8 terminés · 6 en cours</p>
      </div>

      <div class="kpi-card k-amber" role="button" tabindex="0">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-2);">
          <div class="kpi-icon" style="background:#fef9c3;">
            <i data-lucide="users" style="width:14px;height:14px;color:#d97706;"></i>
          </div>
          <span style="font-size:var(--text-xs);color:var(--text-subtle);">En attente</span>
        </div>
        <p class="kpi-num">4</p>
        <p class="kpi-label">Salle d'attente</p>
        <p class="kpi-delta" style="color:#d97706;"><i data-lucide="clock" style="width:10px;height:10px;"></i> Moy. 18 min d'attente</p>
      </div>

      <div class="kpi-card k-red" role="button" tabindex="0">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-2);">
          <div class="kpi-icon" style="background:#fee2e2;">
            <i data-lucide="bed" style="width:14px;height:14px;color:#dc2626;"></i>
          </div>
          <span style="font-size:var(--text-xs);color:var(--color-danger-600);font-weight:var(--weight-medium);">2 critiques</span>
        </div>
        <p class="kpi-num">14</p>
        <p class="kpi-label">Hospitalisés</p>
        <p class="kpi-delta" style="color:var(--color-danger-600);"><i data-lucide="alert-triangle" style="width:10px;height:10px;"></i> Bruno &amp; Titan — urgents</p>
      </div>

      <div class="kpi-card k-green" role="button" tabindex="0">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-2);">
          <div class="kpi-icon" style="background:#dcfce7;">
            <i data-lucide="package-x" style="width:14px;height:14px;color:#16a34a;"></i>
          </div>
          <span style="font-size:var(--text-xs);color:var(--color-danger-600);font-weight:var(--weight-medium);">2 ruptures</span>
        </div>
        <p class="kpi-num">9</p>
        <p class="kpi-label">Alertes stock</p>
        <p class="kpi-delta" style="color:var(--color-danger-600);"><i data-lucide="x-circle" style="width:10px;height:10px;"></i> Gants chir. · Kétamine</p>
      </div>

    </div>
  </div>

  {# ── Quick actions — each button is an independent widget ── #}
  <div style="margin-bottom:var(--space-4);">
    <p style="font-size:var(--text-xs);font-weight:var(--weight-medium);color:var(--text-subtle);text-transform:uppercase;letter-spacing:.08em;margin-bottom:var(--space-2);">Actions rapides</p>
    <div class="qa-grid" style="display:grid;grid-template-columns:repeat(5,1fr);gap:var(--space-2);">

      <button class="qa-widget" type="button" aria-label="Nouveau patient">
        <div class="qa-widget-icon" style="background:#dbeafe;">
          <i data-lucide="user-plus" style="width:18px;height:18px;color:#2563eb;"></i>
        </div>
        <span class="qa-widget-label">Nouveau patient</span>
      </button>

      <button class="qa-widget" type="button" aria-label="Prise de RDV">
        <div class="qa-widget-icon" style="background:#dcfce7;">
          <i data-lucide="calendar-plus" style="width:18px;height:18px;color:#16a34a;"></i>
        </div>
        <span class="qa-widget-label">Prise de RDV</span>
      </button>

      <button class="qa-widget" type="button" aria-label="Walk-in sans RDV">
        <div class="qa-widget-icon" style="background:#fef9c3;">
          <i data-lucide="zap" style="width:18px;height:18px;color:#d97706;"></i>
        </div>
        <span class="qa-widget-label">Walk-in</span>
      </button>

      <button class="qa-widget" type="button" aria-label="Hospitaliser un patient">
        <div class="qa-widget-icon" style="background:#f3e8ff;">
          <i data-lucide="bed" style="width:18px;height:18px;color:#9333ea;"></i>
        </div>
        <span class="qa-widget-label">Hospitaliser</span>
      </button>

      <button class="qa-widget" type="button" aria-label="Imprimer ordonnance">
        <div class="qa-widget-icon" style="background:#ffe4e6;">
          <i data-lucide="printer" style="width:18px;height:18px;color:#e11d48;"></i>
        </div>
        <span class="qa-widget-label">Imprimer ordo.</span>
      </button>

    </div>
  </div>

  {# ── Hospitalizations — horizontal scroll, sorted critical -> stable ── #}
  <div style="margin-bottom:var(--space-4);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-2);">
      <div style="display:flex;align-items:center;gap:var(--space-2);">
        <p style="font-size:var(--text-xs);font-weight:var(--weight-medium);color:var(--text-subtle);text-transform:uppercase;letter-spacing:.08em;">Hospitalisations</p>
        <span style="font-size:var(--text-xs);font-weight:var(--weight-medium);background:var(--color-danger-bg);color:var(--color-danger-text);padding:1px 6px;border-radius:var(--radius-full);">8</span>
        <span style="font-size:var(--text-xs);color:var(--text-subtle);">· 2 critiques</span>
      </div>
      <button style="font-size:var(--text-sm);color:var(--brand-500);background:none;border:none;cursor:pointer;font-family:inherit;font-weight:var(--weight-medium);">Voir tout →</button>
    </div>
    <div style="display:flex;gap:var(--space-2);overflow-x:auto;padding-bottom:var(--space-2);scrollbar-width:thin;scrollbar-color:#e2e8f0 transparent;">

      {# Bruno — Critical #}
      <div class="hosp-inline crit">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:2px;">
          <div>
            <p style="font-size:var(--text-base);font-weight:var(--weight-medium);color:var(--text-primary);line-height:1.2;">Bruno</p>
            <p style="font-size:var(--text-xs);color:var(--text-subtle);margin-top:1px;">Canin · Boxer</p>
          </div>
          <span class="badge b-alert" style="font-size:10px;flex-shrink:0;">Critique</span>
        </div>
        <p style="font-size:var(--text-sm);color:var(--text-muted);margin-bottom:var(--space-1);border-bottom:1px solid var(--border-light);padding-bottom:var(--space-1);">Perfusion + Antibiotiques</p>
        <div class="hosp-next-soin urgent">
          <i data-lucide="clock" style="width:11px;height:11px;flex-shrink:0;"></i>
          <div style="min-width:0;">
            <p style="font-size:var(--text-sm);font-weight:var(--weight-medium);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Constantes — dans 28 min</p>
          </div>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:var(--space-1);">
          <span style="font-size:var(--text-xs);color:var(--text-subtle);display:flex;align-items:center;gap:3px;">
            <i data-lucide="user" style="width:9px;height:9px;"></i> Dr. Rousseau
          </span>
          <span style="font-size:var(--text-xs);font-weight:var(--weight-medium);color:var(--text-muted);background:var(--surface-hover);padding:1px 6px;border-radius:var(--radius-full);">J+2</span>
        </div>
      </div>

      {# Titan — Critical #}
      <div class="hosp-inline crit">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:2px;">
          <div>
            <p style="font-size:var(--text-base);font-weight:var(--weight-medium);color:var(--text-primary);line-height:1.2;">Titan</p>
            <p style="font-size:var(--text-xs);color:var(--text-subtle);margin-top:1px;">Canin · Rottweiler</p>
          </div>
          <span class="badge b-alert" style="font-size:10px;flex-shrink:0;">Critique</span>
        </div>
        <p style="font-size:var(--text-sm);color:var(--text-muted);margin-bottom:var(--space-1);border-bottom:1px solid var(--border-light);padding-bottom:var(--space-1);">Convalescence post-chirurgie</p>
        <div class="hosp-next-soin urgent">
          <i data-lucide="clock" style="width:11px;height:11px;flex-shrink:0;"></i>
          <div style="min-width:0;">
            <p style="font-size:var(--text-sm);font-weight:var(--weight-medium);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Morphine IV — 13h45</p>
          </div>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:var(--space-1);">
          <span style="font-size:var(--text-xs);color:var(--text-subtle);display:flex;align-items:center;gap:3px;">
            <i data-lucide="user" style="width:9px;height:9px;"></i> Dr. Rousseau
          </span>
          <span style="font-size:var(--text-xs);font-weight:var(--weight-medium);color:var(--text-muted);background:var(--surface-hover);padding:1px 6px;border-radius:var(--radius-full);">J+1</span>
        </div>
      </div>

      {# Mochi — Surveillance #}
      <div class="hosp-inline surv">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:2px;">
          <div>
            <p style="font-size:var(--text-base);font-weight:var(--weight-medium);color:var(--text-primary);line-height:1.2;">Mochi</p>
            <p style="font-size:var(--text-xs);color:var(--text-subtle);margin-top:1px;">Félin · Ragdoll</p>
          </div>
          <span class="badge b-warn" style="font-size:10px;flex-shrink:0;">Surveillance</span>
        </div>
        <p style="font-size:var(--text-sm);color:var(--text-muted);margin-bottom:var(--space-1);border-bottom:1px solid var(--border-light);padding-bottom:var(--space-1);">Insuffisance rénale — dialyse</p>
        <div class="hosp-next-soin soon">
          <i data-lucide="clock" style="width:11px;height:11px;flex-shrink:0;"></i>
          <div style="min-width:0;">
            <p style="font-size:var(--text-sm);font-weight:var(--weight-medium);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Analyses sang — 17h00</p>
          </div>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:var(--space-1);">
          <span style="font-size:var(--text-xs);color:var(--text-subtle);display:flex;align-items:center;gap:3px;">
            <i data-lucide="user" style="width:9px;height:9px;"></i> Dr. Patel
          </span>
          <span style="font-size:var(--text-xs);font-weight:var(--weight-medium);color:var(--text-muted);background:var(--surface-hover);padding:1px 6px;border-radius:var(--radius-full);">J+5</span>
        </div>
      </div>

      {# Rex — Surveillance #}
      <div class="hosp-inline surv">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:2px;">
          <div>
            <p style="font-size:var(--text-base);font-weight:var(--weight-medium);color:var(--text-primary);line-height:1.2;">Rex</p>
            <p style="font-size:var(--text-xs);color:var(--text-subtle);margin-top:1px;">Canin · Labrador</p>
          </div>
          <span class="badge b-warn" style="font-size:10px;flex-shrink:0;">Surveillance</span>
        </div>
        <p style="font-size:var(--text-sm);color:var(--text-muted);margin-bottom:var(--space-1);border-bottom:1px solid var(--border-light);padding-bottom:var(--space-1);">Soins de plaie</p>
        <div class="hosp-next-soin soon">
          <i data-lucide="clock" style="width:11px;height:11px;flex-shrink:0;"></i>
          <div style="min-width:0;">
            <p style="font-size:var(--text-sm);font-weight:var(--weight-medium);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Pansement — 16h00</p>
          </div>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:var(--space-1);">
          <span style="font-size:var(--text-xs);color:var(--text-subtle);display:flex;align-items:center;gap:3px;">
            <i data-lucide="user" style="width:9px;height:9px;"></i> Dr. Rousseau
          </span>
          <span style="font-size:var(--text-xs);font-weight:var(--weight-medium);color:var(--text-muted);background:var(--surface-hover);padding:1px 6px;border-radius:var(--radius-full);">J+3</span>
        </div>
      </div>

      {# Nala — Stable #}
      <div class="hosp-inline stable">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:2px;">
          <div>
            <p style="font-size:var(--text-base);font-weight:var(--weight-medium);color:var(--text-primary);line-height:1.2;">Nala</p>
            <p style="font-size:var(--text-xs);color:var(--text-subtle);margin-top:1px;">Félin · Persan</p>
          </div>
          <span class="badge b-ok" style="font-size:10px;flex-shrink:0;">Stable</span>
        </div>
        <p style="font-size:var(--text-sm);color:var(--text-muted);margin-bottom:var(--space-1);border-bottom:1px solid var(--border-light);padding-bottom:var(--space-1);">Surveillance post-op</p>
        <div class="hosp-next-soin normal">
          <i data-lucide="clock" style="width:11px;height:11px;flex-shrink:0;"></i>
          <div style="min-width:0;">
            <p style="font-size:var(--text-sm);font-weight:var(--weight-medium);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Médicaments — 14h00</p>
          </div>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:var(--space-1);">
          <span style="font-size:var(--text-xs);color:var(--text-subtle);display:flex;align-items:center;gap:3px;">
            <i data-lucide="user" style="width:9px;height:9px;"></i> Dr. Patel
          </span>
          <span style="font-size:var(--text-xs);font-weight:var(--weight-medium);color:var(--text-muted);background:var(--surface-hover);padding:1px 6px;border-radius:var(--radius-full);">J+4</span>
        </div>
      </div>

      {# Luna — Stable #}
      <div class="hosp-inline stable">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:2px;">
          <div>
            <p style="font-size:var(--text-base);font-weight:var(--weight-medium);color:var(--text-primary);line-height:1.2;">Luna</p>
            <p style="font-size:var(--text-xs);color:var(--text-subtle);margin-top:1px;">Félin · Siamois</p>
          </div>
          <span class="badge b-ok" style="font-size:10px;flex-shrink:0;">Stable</span>
        </div>
        <p style="font-size:var(--text-sm);color:var(--text-muted);margin-bottom:var(--space-1);border-bottom:1px solid var(--border-light);padding-bottom:var(--space-1);">Pancréatite — perfusion IV</p>
        <div class="hosp-next-soin normal">
          <i data-lucide="clock" style="width:11px;height:11px;flex-shrink:0;"></i>
          <div style="min-width:0;">
            <p style="font-size:var(--text-sm);font-weight:var(--weight-medium);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Contrôle perf. — 15h30</p>
          </div>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:var(--space-1);">
          <span style="font-size:var(--text-xs);color:var(--text-subtle);display:flex;align-items:center;gap:3px;">
            <i data-lucide="user" style="width:9px;height:9px;"></i> Dr. Patel
          </span>
          <span style="font-size:var(--text-xs);font-weight:var(--weight-medium);color:var(--text-muted);background:var(--surface-hover);padding:1px 6px;border-radius:var(--radius-full);">J+2</span>
        </div>
      </div>

      {# Pepper — Stable #}
      <div class="hosp-inline stable">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:2px;">
          <div>
            <p style="font-size:var(--text-base);font-weight:var(--weight-medium);color:var(--text-primary);line-height:1.2;">Pepper</p>
            <p style="font-size:var(--text-xs);color:var(--text-subtle);margin-top:1px;">Canin · Beagle</p>
          </div>
          <span class="badge b-ok" style="font-size:10px;flex-shrink:0;">Stable</span>
        </div>
        <p style="font-size:var(--text-sm);color:var(--text-muted);margin-bottom:var(--space-1);border-bottom:1px solid var(--border-light);padding-bottom:var(--space-1);">Fracture — plâtre et repos</p>
        <div class="hosp-next-soin normal">
          <i data-lucide="clock" style="width:11px;height:11px;flex-shrink:0;"></i>
          <div style="min-width:0;">
            <p style="font-size:var(--text-sm);font-weight:var(--weight-medium);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Surveillance · Radio demain</p>
          </div>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:var(--space-1);">
          <span style="font-size:var(--text-xs);color:var(--text-subtle);display:flex;align-items:center;gap:3px;">
            <i data-lucide="user" style="width:9px;height:9px;"></i> Dr. Rousseau
          </span>
          <span style="font-size:var(--text-xs);font-weight:var(--weight-medium);color:var(--text-muted);background:var(--surface-hover);padding:1px 6px;border-radius:var(--radius-full);">J+7</span>
        </div>
      </div>

      {# Simba — Observation #}
      <div class="hosp-inline obs">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:2px;">
          <div>
            <p style="font-size:var(--text-base);font-weight:var(--weight-medium);color:var(--text-primary);line-height:1.2;">Simba</p>
            <p style="font-size:var(--text-xs);color:var(--text-subtle);margin-top:1px;">Félin · Maine Coon</p>
          </div>
          <span class="badge b-purple" style="font-size:10px;flex-shrink:0;">Obs.</span>
        </div>
        <p style="font-size:var(--text-sm);color:var(--text-muted);margin-bottom:var(--space-1);border-bottom:1px solid var(--border-light);padding-bottom:var(--space-1);">Bilan neurologique</p>
        <div class="hosp-next-soin normal">
          <i data-lucide="clock" style="width:11px;height:11px;flex-shrink:0;"></i>
          <div style="min-width:0;">
            <p style="font-size:var(--text-sm);font-weight:var(--weight-medium);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Bilan neuro — 18h00</p>
          </div>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:var(--space-1);">
          <span style="font-size:var(--text-xs);color:var(--text-subtle);display:flex;align-items:center;gap:3px;">
            <i data-lucide="user" style="width:9px;height:9px;"></i> Dr. Patel
          </span>
          <span style="font-size:var(--text-xs);font-weight:var(--weight-medium);color:var(--text-muted);background:var(--surface-hover);padding:1px 6px;border-radius:var(--radius-full);">J+1</span>
        </div>
      </div>

    </div>
  </div>

  {# ── Kanban — centerpiece ── #}
  <div class="kanban">

    {# Column: Planned #}
    <div class="kol kol-planned">
      <div class="kol-head">
        <span class="kol-title">Planifié</span>
        <span class="kol-count">3</span>
      </div>
      <div class="kol-body">
        <div class="kcard">
          <p class="kcard-name">Bella</p>
          <p class="kcard-meta">Canin · Bouledogue français</p>
          <p class="kcard-reason">Suivi post-op (stérilisation)</p>
          <div class="kcard-time"><i data-lucide="clock" style="width:10px;height:10px;"></i>10h00 · Maria Torres</div>
        </div>
        <div class="kcard">
