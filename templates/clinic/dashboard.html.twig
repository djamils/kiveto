{#
 # Kiveto -- templates/clinic/dashboard.html.twig
 # ───────────────────────────────────────────────
 # Dashboard page for the active clinic.
 # Extends clinic/base.html.twig (with sidebar + topbar).
 #
 # Variables from controller:
 #   currentClinicId    string (UUID)
 #   currentClinicName  string
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}Tableau de bord - {{ currentClinicName }}{% endblock %}

{% block page_title %}Vue d'ensemble{% endblock %}
{% block page_subtitle %}14 patients hospitalisés · 3 analyses en attente{% endblock %}

{% block stylesheets %}
<style>
  /* ────────────────────────────────────
     DASHBOARD PAGE STYLES
  ──────────────────────────────────── */

  /* ── Pages ── */
  .page { display: none; }
  .page.active { display: block; }

  /* ── Page header ── */
  .page-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-5); }
  .page-head-title { font-size: var(--text-xl); font-weight: var(--weight-medium); color: var(--text-primary); letter-spacing: -.2px; }
  .page-head-sub { font-size: var(--text-md); color: var(--text-subtle); margin-top: 2px; }

  /* ────────────────────────────────────
     KPI STRIP — 4 metrics at top
     The zone the vet looks at first
     every morning.
  ──────────────────────────────────── */
  .kpi-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .kpi-card {
    background: var(--surface-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: var(--space-3) var(--space-3) var(--space-2);
    display: flex; flex-direction: column; gap: 2px;
    cursor: pointer; transition: box-shadow .15s, transform .1s;
    position: relative; overflow: hidden;
  }
  .kpi-card:hover { box-shadow: var(--shadow-sm); transform: translateY(-1px); }
  .kpi-card:active { transform: translateY(0); }

  /* Colored bar at bottom */
  .kpi-card::after {
    content: ''; position: absolute; bottom: 0; left: 0; right: 0;
    height: 3px; border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }
  .kpi-card.k-blue::after   { background: #3b82f6; }
  .kpi-card.k-amber::after  { background: #f59e0b; }
  .kpi-card.k-red::after    { background: var(--color-danger-600); }
  .kpi-card.k-green::after  { background: var(--color-success-600); }

  .kpi-icon {
    width: 28px; height: 28px; border-radius: var(--radius-sm);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 2px;
  }

  .kpi-num {
    font-size: 22px; font-weight: var(--weight-medium);
    letter-spacing: -.5px; line-height: 1; color: var(--text-primary);
  }

  .kpi-label {
    font-size: var(--text-sm); color: var(--text-subtle);
    font-weight: var(--weight-normal);
  }

  .kpi-delta {
    font-size: var(--text-xs); font-weight: var(--weight-normal);
    display: flex; align-items: center; gap: 3px; margin-top: 1px;
  }

  /* ────────────────────────────────────
     ROW 1 — Planning / Actions / Tasks
  ──────────────────────────────────── */
  .row1 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    align-items: stretch;
  }

  /* ── Widgets ── */
  .widget {
    background: var(--surface-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
  }
  .widget-pad { padding: var(--space-4) var(--space-4) var(--space-3); }

  .widget-title {
    font-size: var(--text-xs); font-weight: var(--weight-medium);
    color: var(--text-subtle); text-transform: uppercase;
    letter-spacing: .08em; margin-bottom: var(--space-3);
  }

  .widget-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-3) var(--space-4) var(--space-2);
    border-bottom: 1px solid var(--border-light); flex-shrink: 0;
  }

  /* Stat row (daily planning) */
  .stat-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 4px 0;
  }
  .stat-label { display: flex; align-items: center; gap: var(--space-1); font-size: var(--text-md); color: var(--text-muted); }
  .stat-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
  .stat-val { font-size: var(--text-md); font-weight: var(--weight-medium); }

  /* ── Quick Actions ── */
  .qa-list { display: flex; flex-direction: column; gap: 2px; }

  .qa-btn {
    display: flex; align-items: center; gap: var(--space-2);
    padding: 6px var(--space-2); border-radius: var(--radius-md);
    border: none; background: transparent; cursor: pointer;
    font-family: inherit; font-size: var(--text-md);
    color: var(--text-secondary); text-align: left;
    transition: var(--transition-fast); width: 100%;
  }
  .qa-btn:hover { background: var(--surface-subtle); }
  .qa-btn:active { transform: scale(.98); background: var(--surface-hover); }

  .qa-icon {
    width: 26px; height: 26px; border-radius: var(--radius-sm);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; transition: transform .15s;
  }
  .qa-btn:hover .qa-icon { transform: scale(1.06); }

  .qa-btn::before {
    content: ''; width: 3px; height: 16px; border-radius: 2px;
    flex-shrink: 0; margin-right: -4px; opacity: .55;
  }
  .qa-btn.c-blue   .qa-icon { background: #dbeafe; }
  .qa-btn.c-green  .qa-icon { background: #dcfce7; }
  .qa-btn.c-amber  .qa-icon { background: #fef9c3; }
  .qa-btn.c-purple .qa-icon { background: #f3e8ff; }
  .qa-btn.c-rose   .qa-icon { background: #ffe4e6; }
  .qa-btn.c-blue::before   { background: #3b82f6; }
  .qa-btn.c-green::before  { background: #22c55e; }
  .qa-btn.c-amber::before  { background: #f59e0b; }
  .qa-btn.c-purple::before { background: #a855f7; }
  .qa-btn.c-rose::before   { background: #f43f5e; }


  /* ── Quick Actions — independent widgets on page background ── */
  .qa-widget {
    display: flex; flex-direction: row; align-items: center;
    gap: var(--space-2); padding: var(--space-2) var(--space-3);
    background: var(--surface-card); border: 1px solid var(--border-light);
    border-radius: var(--radius-md); cursor: pointer; font-family: inherit;
    transition: box-shadow .15s, transform .1s, border-color .15s;
    text-align: left; width: 100%;
  }
  .qa-widget:hover {
    box-shadow: var(--shadow-sm); transform: translateY(-1px);
    border-color: var(--border-medium);
  }
  .qa-widget:active { transform: translateY(0); box-shadow: none; }

  .qa-widget-icon {
    width: 28px; height: 28px; border-radius: var(--radius-sm);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  .qa-widget-label {
    font-size: var(--text-md); font-weight: var(--weight-medium);
    color: var(--text-secondary); line-height: 1.2;
  }


  /* ── Hospitalizations inline — horizontal scroll ── */
  .hosp-inline {
    min-width: 220px; max-width: 220px; flex-shrink: 0;
    background: var(--surface-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    border-top: 3px solid transparent;
    padding: var(--space-2) var(--space-3) var(--space-2);
    cursor: pointer;
    transition: box-shadow .15s, transform .1s;
    display: flex; flex-direction: column; gap: 0;
  }
  .hosp-inline:hover { box-shadow: var(--shadow-sm); transform: translateY(-1px); }
  .hosp-inline:active { transform: translateY(0); box-shadow: none; }
  .hosp-inline.crit   { border-top-color: #f87171; }
  .hosp-inline.surv   { border-top-color: #fbbf24; }
  .hosp-inline.stable { border-top-color: #4ade80; }
  .hosp-inline.obs    { border-top-color: #a78bfa; }

  /* Next care / monitoring */
  .hosp-next-soin {
    display: flex; align-items: center; gap: var(--space-1);
    padding: 4px var(--space-2);
    border-radius: var(--radius-md);
    margin-top: var(--space-1);
    font-size: var(--text-sm); font-weight: var(--weight-medium);
  }
  .hosp-next-soin.urgent { background: #fff7ed; color: #c2410c; }
  .hosp-next-soin.soon   { background: #fffbeb; color: #b45309; }
  .hosp-next-soin.normal { background: var(--surface-subtle); color: var(--text-muted); }

  /* ── Tasks ── */
  .task-item {
    display: flex; align-items: flex-start; gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid #f8fafc;
    transition: var(--transition-fast); cursor: pointer;
  }
  .task-item:last-child { border-bottom: none; }
  .task-item:hover { background: var(--surface-subtle); }
  .task-item.urgent { background: #fffbfb; }
  .task-item.urgent:hover { background: var(--color-danger-bg); }

  .task-check {
    width: 14px; height: 14px;
    border: 1.5px solid var(--slate-300);
    border-radius: var(--radius-sm); margin-top: 2px; flex-shrink: 0;
    cursor: pointer; transition: border-color .1s;
    display: flex; align-items: center; justify-content: center;
  }
  .task-check:hover { border-color: var(--brand-400); }
  .task-check.urgent { border-color: #fca5a5; background: #fff; }
  .task-check.done { border-color: #4ade80; background: #f0fdf4; }

  .task-name { font-size: var(--text-md); font-weight: var(--weight-medium); color: var(--text-primary); line-height: var(--lh-normal); flex: 1; min-width: 0; }
  .task-name.done { color: var(--text-subtle); text-decoration: line-through; }
  .task-meta { font-size: var(--text-sm); color: var(--text-subtle); margin-top: 1px; }

  .task-tag {
    font-size: var(--text-xs); font-weight: var(--weight-medium);
    padding: 1px var(--space-1); border-radius: var(--radius-sm);
    white-space: nowrap; flex-shrink: 0;
  }

  /* ────────────────────────────────────
     KANBAN — columns with colored headers
  ──────────────────────────────────── */
  .kanban {
    display: grid; grid-template-columns: repeat(4,1fr);
    gap: var(--space-3);
  }

  .kol { background: var(--surface-subtle); border-radius: var(--radius-md); overflow: hidden; }

  .kol-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid rgba(0,0,0,.06);
  }
  /* Per-column colors */
  .kol-planned  .kol-head { background: #fff; border-bottom: 1px solid #e2e8f0; }
  .kol-waiting  .kol-head { background: #fff7ed; }
  .kol-consult  .kol-head { background: #eff6ff; }
  .kol-done     .kol-head { background: #f0fdf4; }

  .kol-title {
    font-size: var(--text-xs); font-weight: var(--weight-medium);
    text-transform: uppercase; letter-spacing: .06em;
  }
  .kol-planned .kol-title  { color: var(--slate-600); }
  .kol-waiting .kol-title  { color: #c2410c; }
  .kol-consult .kol-title  { color: #1d4ed8; }
  .kol-done    .kol-title  { color: #15803d; }

  .kol-count {
    font-size: var(--text-xs); font-weight: var(--weight-medium);
    width: 18px; height: 18px; border-radius: var(--radius-full);
    display: flex; align-items: center; justify-content: center;
    border: 1px solid rgba(0,0,0,.1);
  }
  .kol-planned .kol-count { background: #fff; color: var(--text-muted); }
  .kol-waiting .kol-count { background: #fed7aa; color: #c2410c; }
  .kol-consult .kol-count { background: #bfdbfe; color: #1d4ed8; }
  .kol-done    .kol-count { background: #bbf7d0; color: #15803d; }

  .kol-body { padding: var(--space-2); display: flex; flex-direction: column; gap: var(--space-2); }

  .kcard {
    background: var(--surface-card); border: 1px solid var(--border-light);
    border-radius: var(--radius-md); padding: var(--space-3);
    transition: box-shadow .15s, transform .12s; cursor: pointer;
  }
  .kcard:hover { box-shadow: var(--shadow-sm); transform: translateY(-1px); }
  .kcard:active { transform: translateY(0); box-shadow: none; }

  /* Left accent on waiting / consultation cards */
  .kcard-accent-orange { border-left: 2px solid #fb923c; }
  .kcard-accent-blue   { border-left: 2px solid #60a5fa; }
  .kcard-accent-green  { border-left: 2px solid #4ade80; }

  .kcard-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2px; }
  .kcard-name { font-size: var(--text-base); font-weight: var(--weight-medium); color: var(--text-primary); }
  .kcard-meta { font-size: var(--text-sm); color: var(--text-subtle); margin-bottom: var(--space-1); }
  .kcard-reason { font-size: var(--text-sm); color: var(--text-muted); margin-bottom: var(--space-2); }
  .kcard-time { display: flex; align-items: center; gap: 3px; font-size: var(--text-sm); color: var(--text-subtle); }

  .kcard-vitals {
    display: grid; grid-template-columns: repeat(3,1fr);
    gap: var(--space-1); border-top: 1px solid var(--border-light);
    padding-top: var(--space-2); margin-top: var(--space-2);
  }
  .vital-label { font-size: var(--text-xs); color: var(--text-subtle); }
  .vital-val { font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--text-primary); }

  .kcard-price {
    display: flex; justify-content: space-between; align-items: center;
    border-top: 1px solid var(--border-light);
    padding-top: var(--space-2); margin-top: var(--space-2);
  }

  /* ────────────────────────────────────
     BADGES
  ──────────────────────────────────── */
  .badge {
    font-size: var(--text-sm); font-weight: var(--weight-medium);
    padding: 2px var(--space-2); border-radius: var(--radius-full);
    white-space: nowrap; display: inline-flex; align-items: center; gap: 3px;
  }
  .b-wait  { background: var(--color-warning-bg);  color: var(--color-warning-text);  }
  .b-exam  { background: var(--color-info-bg);     color: var(--color-info-text);     }
  .b-out   { background: var(--color-success-bg);  color: var(--color-success-text);  }
  .b-hosp  { background: var(--color-danger-bg);   color: var(--color-danger-text);   }
  .b-sched { background: var(--surface-subtle); color: var(--text-muted); border: 1px solid var(--border-medium); }
  .b-ok    { background: var(--color-success-bg);  color: var(--color-success-text);  }
  .b-warn  { background: var(--color-warning-bg);  color: var(--color-warning-text);  }
  .b-alert { background: var(--color-danger-bg);   color: var(--color-danger-text);   }
  .b-purple { background: var(--color-purple-bg); color: var(--color-purple-text); }

  /* ────────────────────────────────────
     RIGHT PANEL
  ──────────────────────────────────── */
  .rpanel {
    width: 310px; flex-shrink: 0;
    background: var(--surface-card);
    border-left: 1px solid var(--border-light);
    display: flex; flex-direction: column; overflow: hidden;
  }

  /* rpanel drawer (<=1024px) */
  @media (max-width: 1024px) {
    .rpanel {
      position: fixed; right: 0; top: 0; bottom: 0;
      z-index: 50; width: 300px;
      transform: translateX(100%);
      transition: transform .25s cubic-bezier(.4,0,.2,1);
      box-shadow: none;
      border-left: none;
    }
    .rpanel.open {
      transform: translateX(0);
      box-shadow: -4px 0 24px rgba(0,0,0,.14);
    }
    .btn-rpanel { display: flex !important; }
  }

  .rp-section { display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden; }

  .rp-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-light); flex-shrink: 0;
  }
  .rp-head-left { display: flex; align-items: center; gap: var(--space-2); }
  .rp-head-title { font-size: var(--text-xs); font-weight: var(--weight-medium); color: var(--text-subtle); text-transform: uppercase; letter-spacing: .08em; }

  .rp-scroll { flex: 1; overflow-y: auto; min-height: 0; padding: 0; }

  /* ── Stock table in rpanel ── */
  .rp-table { width: 100%; border-collapse: collapse; font-size: var(--text-md); }
  .rp-table thead th {
    text-align: left; padding: 4px var(--space-4);
    font-size: var(--text-xs); font-weight: var(--weight-medium);
    color: var(--text-subtle); background: var(--surface-subtle);
    border-bottom: 1px solid var(--border-light);
    position: sticky; top: 0; z-index: 1;
  }
  .rp-table thead th:nth-child(2) { text-align: center; }
  .rp-table thead th:last-child { text-align: right; }
  .rp-table tbody tr { border-top: 1px solid #f8fafc; cursor: pointer; transition: background .1s; }
  .rp-table tbody tr:hover { background: var(--surface-subtle); }
  .rp-table tbody td { padding: 5px var(--space-4); color: var(--text-muted); vertical-align: middle; }
  .rp-table tbody td:first-child { color: var(--text-primary); font-weight: var(--weight-medium); max-width: 110px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rp-table tbody td:nth-child(2) { text-align: center; }
  .rp-table tbody td:last-child { text-align: right; padding-right: var(--space-4); }

  /* ── Hosp cards in rpanel ── */
  .hosp-card {
    margin: 0 var(--space-2) var(--space-1);
    background: var(--surface-subtle); border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    border-left: 3px solid transparent;
    transition: var(--transition-fast); cursor: pointer;
  }
  .hosp-card:first-child {
    margin-top: var(--space-2);
  }
  .hosp-card:hover { background: var(--surface-hover); }
  .hosp-card.crit  { border-left-color: #f87171; }
  .hosp-card.surv  { border-left-color: #fbbf24; }
  .hosp-card.stable { border-left-color: #4ade80; }
  .hosp-card.obs   { border-left-color: #a78bfa; }

  .hosp-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2px; }
  .hosp-name { font-size: var(--text-md); font-weight: var(--weight-medium); color: var(--text-primary); }
  .hosp-breed { font-size: var(--text-sm); color: var(--text-subtle); margin-left: var(--space-1); }
  .hosp-notes { font-size: var(--text-sm); color: var(--text-muted); margin-bottom: var(--space-1); }
  .hosp-foot { display: flex; align-items: center; justify-content: space-between; }
  .hosp-dr { font-size: var(--text-xs); color: var(--text-subtle); }
  .hosp-next { display: flex; align-items: center; gap: 3px; font-size: var(--text-xs); }

  /* ── Pulse ── */
  .pulse { animation: pls 2.2s ease-in-out infinite; }
  @keyframes pls { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.45;transform:scale(.8)} }

  /* ── Avatar ── */
  .av { width: 26px; height: 26px; border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; font-size: var(--text-xs); font-weight: var(--weight-medium); flex-shrink: 0; }

  /* ────────────────────────────────────
     RESPONSIVE
  ──────────────────────────────────── */
  @media (max-width: 1280px) {
    .kpi-strip { grid-template-columns: repeat(2, 1fr); }
    .kanban { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 1024px) {
    .row1 { grid-template-columns: 1fr; }
    .kpi-strip { grid-template-columns: repeat(2, 1fr); }
    .kanban { grid-template-columns: 1fr 1fr; }
    .dash-header-grid { grid-template-columns: 1fr !important; }
    .dash-kpi-grid { grid-template-columns: repeat(2, 1fr) !important; }
    .qa-grid { grid-template-columns: repeat(3, 1fr) !important; }
  }
  @media (max-width: 768px) {
    .row1 { grid-template-columns: 1fr; }
    .kanban { grid-template-columns: 1fr 1fr; }
    .kpi-strip { grid-template-columns: repeat(2, 1fr); }
    .qa-grid { grid-template-columns: repeat(3, 1fr) !important; }
  }
  @media (max-width: 480px) {
    .row1 { grid-template-columns: 1fr; }
    .row1 > :last-child { grid-column: auto; }
    .kanban { grid-template-columns: 1fr; }
    .kpi-strip { grid-template-columns: 1fr 1fr; }
    .dash-kpi-grid { grid-template-columns: 1fr 1fr !important; }
    .qa-grid { grid-template-columns: repeat(3, 1fr) !important; }
  }
</style>
{% endblock %}

{% block content %}

  {# ── HEADER ROW : Clock + Compact KPIs ── #}
  <div class="dash-header-grid" style="display:grid;grid-template-columns:auto 1fr;gap:var(--space-3);margin-bottom:var(--space-4);align-items:stretch;">

    {# Clock — central element, vet glances at the time constantly #}
    <div class="widget" style="padding:var(--space-4) var(--space-5);display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:140px;">
      <p id="dash-clock" style="font-size:36px;font-weight:var(--weight-medium);color:var(--text-primary);letter-spacing:-2px;line-height:1;font-variant-numeric:tabular-nums;"></p>
      <p id="dash-date" style="font-size:var(--text-sm);color:var(--text-subtle);margin-top:4px;text-align:center;"></p>
    </div>

    {# 4 operational KPIs — real-time situation #}
    <div class="dash-kpi-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-3);">

      <div class="kpi-card k-blue" role="button" tabindex="0">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-2);">
          <div class="kpi-icon" style="background:#dbeafe;">
            <i data-lucide="calendar-check" style="width:14px;height:14px;color:#2563eb;"></i>
          </div>
          <span style="font-size:var(--text-xs);color:var(--text-subtle);">Aujourd'hui</span>
        </div>
