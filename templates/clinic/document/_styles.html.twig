{#
 # Kiveto — templates/clinic/document/_styles.html.twig
 # ────────────────────────────────────────────────────
 # The stylesheet of the three client-facing documents, ported from
 # docs/frontend-theme/vetsaas-layouts/vetos-doc-*.html.
 #
 # The three layouts share it byte for byte, so it is declared once. Sizes are
 # in points and millimetres: this is printed matter, not a screen.
 #
 # The page margins are not set here — Gotenberg is given them, so the same HTML
 # comes out identical whatever a viewer makes of an `@page` rule.
 #}
@page { size: A4; }
* { box-sizing: border-box; margin: 0; padding: 0; }
html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
body {
  font-family: 'DM Sans', 'Carlito', 'Segoe UI', 'DejaVu Sans', sans-serif;
  font-size: 9.5pt; line-height: 1.45; color: #1f2937; background: #fff;
}

/* En-tête */
.lh { width: 100%; border-collapse: collapse; }
.lh td { vertical-align: top; }
.mark {
  width: 9mm; height: 9mm; background: #4338ca; border-radius: 2mm;
  color: #fff; font-size: 14pt; font-weight: 700; text-align: center; line-height: 9mm;
}
.mark-logo { width: 9mm; height: 9mm; object-fit: contain; display: block; }
.clinic-name { font-size: 13pt; font-weight: 700; color: #111827; letter-spacing: -.2px; line-height: 1.1; }
.clinic-sub { font-size: 8pt; color: #6b7280; line-height: 1.5; margin-top: 1.5mm; }
.doc-kind { font-size: 14pt; font-weight: 700; color: #4338ca; text-transform: uppercase; letter-spacing: .5px; line-height: 1.1; text-align: right; }
.doc-meta { font-size: 8pt; color: #6b7280; text-align: right; margin-top: 2mm; line-height: 1.65; }
.doc-meta b { color: #111827; font-weight: 600; }
.rule { height: 1.6mm; background: #4338ca; margin: 4mm 0 0; border-radius: 1mm; }
.rule.thin { height: .4mm; background: #d7dde5; }

/* Blocs identité */
.parties { width: 100%; border-collapse: separate; border-spacing: 3mm 0; margin: 3.5mm -3mm 0; }
.parties td { width: 50%; vertical-align: top; border: .3mm solid #dfe4ea; border-radius: 2mm; padding: 3mm 3.5mm; background: #fafbfc; }
.plabel { font-size: 7pt; font-weight: 700; text-transform: uppercase; letter-spacing: .6px; color: #8b93a1; }
.pname { font-size: 11pt; font-weight: 700; color: #111827; margin-top: 1mm; line-height: 1.2; }
.pname .pname-sub { font-size: 9pt; font-weight: 500; color: #6b7280; }
.pline { font-size: 8.5pt; color: #4b5563; line-height: 1.55; }
.pgrid { width: 100%; border-collapse: collapse; margin-top: 1.5mm; }
.pgrid td { font-size: 8.5pt; padding: .4mm 0; vertical-align: top; background: transparent; border: none; }
.pgrid td:first-child { color: #8b93a1; width: 26mm; }
.pgrid td:last-child { color: #1f2937; font-weight: 600; }

/* Sections */
table.h2 { width: 100%; border-collapse: collapse; margin: 4.5mm 0 2mm; page-break-after: avoid; page-break-inside: avoid; }
table.h2 td { padding-bottom: 1.2mm; border-bottom: .3mm solid #d7dde5; font-size: 8pt; font-weight: 700; text-transform: uppercase; letter-spacing: .8px; color: #4338ca; vertical-align: bottom; }
table.h2 td.r { text-align: right; font-weight: 500; color: #9aa2af; letter-spacing: 0; text-transform: none; }
h3 { font-size: 9pt; font-weight: 700; color: #111827; margin: 3.5mm 0 1mm; }
p { margin-bottom: 1.8mm; text-align: justify; }
ul { margin: 1mm 0 2mm 4.5mm; }
li { margin-bottom: .8mm; }
.muted { color: #6b7280; }

/* Tables de données */
table.data { width: 100%; border-collapse: collapse; margin-top: 2mm; font-size: 8.5pt; }
table.data th { text-align: left; font-size: 7pt; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #6b7280; background: #f3f5f8; padding: 1.8mm 2.5mm; border-bottom: .3mm solid #dfe4ea; }
table.data td { padding: 1.8mm 2.5mm; border-bottom: .25mm solid #eceff3; vertical-align: top; }
table.data tr:last-child td { border-bottom: none; }
table.data td.group { background: #f7f8fa; font-size: 7pt; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #6b7280; padding: 1.6mm 2.5mm; }
table.data .sub { display: block; font-size: 7.5pt; color: #6b7280; margin-top: .3mm; }
.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.ctr { text-align: center; }
.alert { color: #b91c1c; font-weight: 700; }
.okv { color: #15803d; font-weight: 600; }

/* Encadrés */
.box { border: .3mm solid #dfe4ea; border-radius: 2mm; padding: 2.5mm 3.5mm; background: #fafbfc; margin-top: 2.5mm; }
.box.warn { border-color: #f5c99b; background: #fffaf3; }
.box.crit { border-color: #f0b4b4; background: #fff7f7; }
.box-t { font-size: 7.5pt; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #8b93a1; margin-bottom: 1.5mm; }
.box.warn .box-t { color: #b45309; }
.box.crit .box-t { color: #b91c1c; }
.box p { margin: 0; font-size: 8.5pt; }

/* Constantes */
.vitals { width: 100%; border-collapse: separate; border-spacing: 2mm 0; margin: 2mm -2mm 0; table-layout: fixed; }
.vitals td { border: .3mm solid #dfe4ea; border-radius: 2mm; padding: 2.2mm 1mm; text-align: center; background: #fafbfc; }
.vn { font-size: 12pt; font-weight: 700; color: #111827; line-height: 1.1; }
.vl { font-size: 7pt; color: #8b93a1; margin-top: .8mm; text-transform: uppercase; letter-spacing: .4px; }

/* Ordonnance : lignes de prescription */
.rx { border: .3mm solid #dfe4ea; border-radius: 2mm; margin-top: 2.2mm; page-break-inside: avoid; }
.rx-h { padding: 2mm 3.5mm; border-bottom: .25mm solid #eceff3; background: #f7f8fa; border-radius: 2mm 2mm 0 0; }
.rx-n { font-size: 10.5pt; font-weight: 700; color: #111827; line-height: 1.25; }
.rx-f { font-size: 8pt; color: #6b7280; margin-top: .4mm; }
.rx-b { padding: 2mm 3.5mm; }
.rx-b table { width: 100%; border-collapse: collapse; font-size: 8.5pt; }
.rx-b td { padding: .35mm 0; vertical-align: top; }
.rx-b td:first-child { width: 30mm; color: #8b93a1; }
.rx-b td:last-child { font-weight: 600; color: #1f2937; }
.pill { display: inline-block; font-size: 7pt; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; padding: .6mm 2mm; border-radius: 6mm; border: .25mm solid; }
.pill.cascade { color: #b45309; border-color: #f5c99b; background: #fffaf3; }
.pill.abx { color: #b91c1c; border-color: #f0b4b4; background: #fff7f7; }

/* Facture */
.totals { width: 72mm; margin-left: auto; border-collapse: collapse; margin-top: 3mm; }
.totals td { padding: 1.4mm 0; font-size: 9pt; }
.totals td:last-child { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }
.totals tr.sep td { border-top: .3mm solid #d7dde5; padding-top: 2mm; }
.totals tr.grand td { font-size: 12pt; font-weight: 700; color: #111827; padding-top: 1mm; }
.stamp { display: inline-block; border: .6mm solid #15803d; color: #15803d; border-radius: 2mm; padding: 1.5mm 4mm; font-size: 11pt; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; transform: rotate(-3deg); }
.stamp.void { border-color: #b91c1c; color: #b91c1c; }

/* Signature */
.sign { width: 100%; border-collapse: collapse; margin-top: 5mm; page-break-inside: avoid; }
.sign td { vertical-align: bottom; }
.sign-box { border: .3mm dashed #cbd2db; border-radius: 2mm; height: 20mm; width: 58mm; margin-left: auto; position: relative; }
.sign-box i { position: absolute; bottom: 1.5mm; right: 2.5mm; font-size: 7pt; color: #aab1bc; font-style: normal; }
.sign-name { font-size: 9.5pt; font-weight: 700; color: #111827; margin-top: 3mm; }
.sign-qual { font-size: 8pt; color: #6b7280; }
.sign-place { font-size: 8.5pt; margin: 0; }

/* Mentions légales */
.legal { font-size: 6.8pt; color: #9aa2af; line-height: 1.42; margin-top: 3.5mm; margin-bottom: 2mm; text-align: left; }
.legal b { color: #6b7280; }
