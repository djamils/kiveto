{#
 # Kiveto — templates/clinic/document/credit_note.html.twig
 # ───────────────────────────────────────────────────────
 # The credit note (« avoir ») that corrects an issued invoice: its own number,
 # the invoice it refers to, the lines it cancels out (as negative amounts), and
 # what was given back to the client.
 #
 # Variables:
 #   note    CreditNoteDetails
 #   clinic  ClinicDto|null
 #}
{% extends 'clinic/document/_base.html.twig' %}
{% import 'clinic/document/_macros.html.twig' as doc %}

{% set letterhead = clinic is not null ? clinic.letterhead : null %}
{% set isProfessional = note.processingRule == 'B2B' %}
{% set hasAllowance = note.discountMinorUnits > 0 %}

{% block doc_title %}Avoir {{ note.number }}{% endblock %}

{% block doc_kind %}Avoir{% endblock %}

{% block doc_meta %}
  <b>N° {{ note.number }}</b><br/>
  Date d’émission : {{ doc.longDate(note.issuedAt) }}<br/>
  Avoir sur facture n° {{ note.invoiceNumber }}{% if note.invoiceIssuedAt %} du {{ note.invoiceIssuedAt|date('d/m/Y', 'Europe/Paris') }}{% endif %}
{% endblock %}

{% block content %}

  <table class="parties"><tr>
    <td>
      <p class="plabel">Client</p>
      <p class="pname">{{ note.payerName }}</p>
      {% if note.payerAttention %}
        <p class="pline">À l'attention de {{ note.payerAttention }}</p>
      {% endif %}
      {% if note.payerAddressLines is not empty %}
        <p class="pline">{{ note.payerAddressLines|map(l => l|e)|join('<br/>')|raw }}</p>
      {% endif %}
      {% if isProfessional and (note.payerSiren or note.payerVatNumber) %}
        <p class="pline">
          {%- if note.payerSiren %}SIREN {{ note.payerSiren|split('', 3)|join(' ') }}{% endif %}
          {%- if note.payerSiren and note.payerVatNumber %} · {% endif %}
          {%- if note.payerVatNumber %}TVA {{ note.payerVatNumber }}{% endif -%}
        </p>
      {% endif %}
    </td>
    <td>
      <p class="plabel">Récapitulatif</p>
      <p class="pname">− {{ note.totalGrossMinorUnits|money(note.currency) }}</p>
      <table class="pgrid">
        <tr><td>Motif</td><td>{{ note.reason }}</td></tr>
        <tr>
          <td>Remboursement</td>
          <td>
            {%- if note.refundedMinorUnits > 0 -%}
              {{ note.refundedMinorUnits|money(note.currency) }} · {{ note.refundMethodLabel|lower }}
            {%- else -%}
              déduit des prochaines factures
            {%- endif -%}
          </td>
        </tr>
      </table>
    </td>
  </tr></table>

  <table class="h2"><tr>
    <td>Lignes créditées</td>
    <td class="r">Montants en {{ note.currency }}</td>
  </tr></table>

  <table class="data">
    <thead><tr>
      <th>Désignation</th>
      <th class="num" style="width:16mm;">Qté</th>
      <th class="num" style="width:28mm;">P.U.</th>
      <th class="num" style="width:16mm;">TVA</th>
      <th class="num" style="width:26mm;">Total TTC</th>
    </tr></thead>
    <tbody>
      {% for line in note.lines %}
        <tr>
          <td>{{ line.label }}{% if line.code %}<span class="sub">{{ line.code }}</span>{% endif %}</td>
          <td class="num">{{ line.quantity }}</td>
          <td class="num">− {{ line.unitPriceMinorUnits|money(note.currency) }} {{ line.unitPriceMode == 'incl' ? 'TTC' : 'HT' }}</td>
          <td class="num">{{ line.taxRatePercent }} %</td>
          <td class="num" style="font-weight:600;">− {{ line.grossMinorUnits|money(note.currency) }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  <table style="width:100%;border-collapse:collapse;margin-top:4mm;"><tr>
    <td style="width:52%;vertical-align:top;padding-right:5mm;">
      {% if note.taxBreakdown is not empty %}
        <div class="box" style="margin-top:0;">
          <p class="box-t">Récapitulatif de TVA</p>
          <table class="data" style="margin-top:0;">
            <thead><tr>
              <th>Taux</th>
              {% if hasAllowance %}<th class="num">Remise</th>{% endif %}
              <th class="num">Base HT{% if hasAllowance %} après remise{% endif %}</th>
              <th class="num">TVA</th>
              <th class="num">Total TTC</th>
            </tr></thead>
            <tbody>
              {# Per rate, after the share of the invoice's discount given back: the rows add up to the totals. #}
              {% for rate in note.taxBreakdown %}
                <tr>
                  <td>{{ rate.ratePercent }} %</td>
                  {% if hasAllowance %}<td class="num">+ {{ rate.allowanceMinorUnits|money(note.currency) }}</td>{% endif %}
                  <td class="num">− {{ rate.netMinorUnits|money(note.currency) }}</td>
                  <td class="num">− {{ rate.taxMinorUnits|money(note.currency) }}</td>
                  <td class="num">− {{ rate.grossMinorUnits|money(note.currency) }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </td>
    <td style="vertical-align:top;">
      <table class="totals">
        {% if hasAllowance %}
          <tr>
            <td>Total HT avant remise</td>
            <td>− {{ (note.totalNetMinorUnits + note.discountMinorUnits)|money(note.currency) }}</td>
          </tr>
          <tr>
            <td>Remise de la facture</td>
            <td style="color:#b45309;">+ {{ note.discountMinorUnits|money(note.currency) }}</td>
          </tr>
        {% endif %}
        <tr class="sep"><td>Total HT</td><td>− {{ note.totalNetMinorUnits|money(note.currency) }}</td></tr>
        <tr><td>TVA</td><td>− {{ note.totalTaxMinorUnits|money(note.currency) }}</td></tr>
        <tr class="grand"><td>Total de l’avoir</td><td>− {{ note.totalGrossMinorUnits|money(note.currency) }}</td></tr>
      </table>
    </td>
  </tr></table>

  <p class="legal">
    {% if letterhead is not null and letterhead.legalSentence %}
      <b>Mentions légales.</b>
      {{ letterhead.legalName ?? (clinic is not null ? clinic.name : '') }}, {{ letterhead.legalSentence }}
      {%- if letterhead.formattedSiret %}, SIRET {{ letterhead.formattedSiret }}{% endif %}
      {%- if letterhead.vatNumber %}, TVA intracommunautaire {{ letterhead.vatNumber }}{% endif %}.<br/>
    {% endif %}
    <b>Avoir.</b> Le présent avoir annule, en tout ou partie, la facture {{ note.invoiceNumber }} : il en reprend
    les lignes créditées et porte son propre numéro dans une série continue. Motif : {{ note.reason }}.
    {% if note.refundedMinorUnits > 0 %}
      La somme de {{ note.refundedMinorUnits|money(note.currency) }} a été remboursée au client
      ({{ note.refundMethodLabel|lower }}).
    {% else %}
      Son montant est déduit de ce que le client doit, ou reste à valoir sur ses prochaines factures.
    {% endif %}
  </p>

{% endblock %}
