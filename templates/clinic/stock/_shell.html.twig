{#
 # Kiveto — templates/clinic/stock/_shell.html.twig
 # ───────────────────────────────────────────────
 # The shell the three stock tabs share: the topbar, the tab bar, and the slots
 # underneath.
 #
 # Variables:
 #   alertCount  int  How many alerts are open, shown on the tab
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}Stocks{% endblock %}
{% block show_topbar %}false{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('styles/pages/stock.css') }}"/>
{% endblock %}

{% block content %}
<div class="stk-root">

  <header class="topbar">
    <button class="tb-toggle show-mobile" type="button" aria-label="Menu" data-action="click->sidebar#toggle">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
    <div class="tb-title">
      <span class="topbar-icon" aria-hidden="true"><i data-lucide="boxes"></i></span>
      <h1 class="topbar-title">Stocks</h1>
      <span class="tb-title-count">{% block stock_count %}{% endblock %}</span>
    </div>
    <div class="tb-spacer"></div>
    {% block stock_search %}{% endblock %}
    {% block stock_actions %}{% endblock %}
  </header>

  <nav class="stk-tabs" aria-label="Vues du stock">
    <a class="stk-tab{{ app.request.attributes.get('_route') == 'clinic_stock' ? ' is-active' : '' }}"
       href="{{ path('clinic_stock') }}">
      État du stock
    </a>
    <a class="stk-tab{{ app.request.attributes.get('_route') == 'clinic_stock_movements' ? ' is-active' : '' }}"
       href="{{ path('clinic_stock_movements') }}">
      Mouvements
    </a>
    <a class="stk-tab{{ app.request.attributes.get('_route') == 'clinic_stock_alerts' ? ' is-active' : '' }}"
       href="{{ path('clinic_stock_alerts') }}">
      Alertes
      {% if alertCount is defined and alertCount > 0 %}
        <span class="stk-tab-count">{{ alertCount }}</span>
      {% endif %}
    </a>
  </nav>

  {% block stock_body %}{% endblock %}

</div>

{% block stock_modals %}{% endblock %}
{% endblock %}
