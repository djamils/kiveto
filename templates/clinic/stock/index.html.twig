{#
 # Kiveto — templates/clinic/stock/index.html.twig
 # ──────────────────────────────────────────────
 # Stocks — what the clinic holds, what moved and what needs attention. Ported
 # from docs/frontend-theme/kiveto-theme/stock-v-topbar_3.html: page header
 # (tabs « État du stock », « Mouvements », « Alertes » with their counters,
 # « Inventaire », « Commande », « Réceptionner une livraison »), filter bar,
 # the register band of controlled substances, the table with its pager, the
 # side sheet of an article, the alerts by severity, the bulk bar, the order
 # drawer, and the reception, withdrawal, count and recall windows.
 #
 # The three routes (clinic_stock, clinic_stock_movements, clinic_stock_alerts)
 # render this page on their tab. Everything below is drawn by the page module
 # from the payload; every change is posted in the background to its
 # single-action controller, then the module asks clinic_stock_data again.
 #
 # Variables:
 #   payload  App\Presentation\Clinic\ViewModel\Stock\StockPageBuilder::page()
 #
 # Behaviour: assets/js/pages/stock.js — styles: assets/styles/shell/register.css + assets/styles/pages/stock.css
 #}
{% extends 'clinic/base.html.twig' %}

{% block page_body_class %}vt{% endblock %}
{% block title %}Stocks{% endblock %}

{% block main %}
<div class="reg stock" data-page="{{ app.request.attributes.get('_route') }}" data-payload="{{ payload|json_encode }}">

  <div class="pagehead">
    <h1>Stocks<small id="phSub">—</small></h1>
    <div class="ctabs" id="tabs">
      <button type="button" data-t="etat"{{ payload.tab == 'etat' ? ' class="on"' }}>État du stock <span class="n" id="nEtat">0</span></button>
      <button type="button" data-t="mvts"{{ payload.tab == 'mvts' ? ' class="on"' }}>Mouvements</button>
      <button type="button" data-t="alertes"{{ payload.tab == 'alertes' ? ' class="on"' }}>Alertes <span class="n al" id="nAl">0</span></button>
    </div>
    <div class="right">
      <button type="button" class="btn" id="btnInv"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>Inventaire</button>
      <button type="button" class="btn" id="btnCmd"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>Commande<span class="bdg" id="cmdN"></span></button>
      <button type="button" class="btn primaire" id="btnRecep"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5Z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg>Réceptionner une livraison</button>
    </div>
  </div>

  <div class="cfil" id="cfil">
    <div class="crech">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" placeholder="Article, code, n° de lot…" autocomplete="off" aria-label="Rechercher">
    </div>
    <span class="lblf">Filtres</span>
    <div id="fdd" style="display:flex;gap:8px;align-items:center"></div>
  </div>
  <div class="regbar" id="regbar">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
    <span><b>Registre des stupéfiants</b> · entrées et sorties numérotées, solde après chaque mouvement, à conserver 10 ans.</span>
    <a class="btn" id="btnReg" href="{{ payload.urls.register }}" target="_blank" rel="noopener">Exporter le registre (PDF)</a>
  </div>

  <main class="czone" id="czone">
    <div class="ctw">
      <div class="cscroll scr"><table>
        <thead id="thead"></thead>
        <tbody id="tbody"></tbody>
      </table><div id="cempty"></div></div>
      <div class="cfoot" id="cfoot"></div>
    </div>
    <aside class="fiche" id="fiche"><div class="fi-in">
      <div class="fi-head" id="fiHead"></div>
      <div class="fi-body scr" id="fiBody"></div>
      <div class="fi-foot" id="fiFoot"></div>
    </div></aside>
  </main>
  <main class="azone scr" id="azone"></main>

  <div class="bulk" id="bulk" role="toolbar" aria-label="Actions groupées">
    <span class="bn" id="bulkN">0</span><span id="bulkL">sélectionnés</span>
    <span class="bdiv"></span>
    <button type="button" id="bkCmd"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>Ajouter à la commande</button>
    <button type="button" id="bkInv"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>Compter</button>
    <span class="bdiv"></span>
    <button type="button" id="bkX" data-tip="Désélectionner" aria-label="Désélectionner"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
  </div>

  <!-- Commande -->
  <div class="cmdv" id="cmdV"></div>
  <aside class="cmdp" id="cmdP">
    <div class="fi-head"><div class="fi-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg></div>
      <div class="fi-t"><b>Commande en cours</b><span id="cmdSub">—</span></div><button type="button" class="fi-x" id="cmdX" data-tip="Fermer · Échap" aria-label="Fermer"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div>
    <div class="fi-body scr" id="cmdBody"></div>
  </aside>

  <!-- Réception -->
  <div class="mveil" id="mRecep"><div class="mbox xl">
    <div class="mhead"><div class="mt"><b>Réceptionner une livraison</b><span>Chaque ligne crée un lot ; le stock sort ensuite par péremption la plus proche.</span></div><button type="button" class="mclose" data-close aria-label="Fermer"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div>
    <div class="mbody scr">
      <div class="g2">
        <div><label class="flbl">Fournisseur</label><div class="dd" id="rcFourn"></div></div>
        <div><label class="flbl">Bon de livraison <span class="opt">· facultatif</span></label><input class="finput" id="rcBl" placeholder="BL-{{ "now"|date("Y") }}-…" autocomplete="off"></div>
      </div>
      <div id="rcCmd" style="margin-top:12px"></div>
      <div class="scan" style="margin-top:12px">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M7 8v8M11 8v8M15 8v8M18 8v8"/></svg>
        <input id="rcScan" placeholder="Scannez le DataMatrix de chaque boîte : article, lot et péremption se remplissent seuls">
        <button type="button" class="btn" id="rcSim" disabled data-tip="Branchez une douchette : chaque scan remplit sa ligne">Simuler un scan</button>
      </div>
      <table class="rtab" id="rcTab"></table>
      <button type="button" class="addl" id="rcAdd"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Ajouter un article à la main</button>
    </div>
    <div class="mfoot"><span class="inv-tot" id="rcTot"></span><button type="button" class="btn" data-close>Annuler</button><button type="button" class="btn primaire" id="rcOk" disabled>Entrer en stock</button></div>
  </div></div>

  <!-- Sortie -->
  <div class="mveil" id="mSortie"><div class="mbox">
    <div class="mhead"><div class="mt"><b>Sortie de stock</b><span id="soSub">—</span></div><button type="button" class="mclose" data-close aria-label="Fermer"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div>
    <div class="mbody">
      <div class="frow"><label class="flbl">Motif</label><div class="motifs" id="soMotif"></div></div>
      <div class="g2">
        <div><label class="flbl">Quantité <span class="req">*</span></label><div class="inu"><input class="finput num" id="soQ" inputmode="decimal"><i id="soU">—</i></div></div>
        <div><label class="flbl">Lot</label><div class="dd" id="soLot"></div></div>
      </div>
      <div class="frow" id="soStupRow" style="margin-top:12px;display:none"><label class="flbl">Animal et prescripteur <span class="req">*</span></label><input class="finput" id="soStup" placeholder="Animal (propriétaire) · Dr …" autocomplete="off"><p class="hint">Inscrit au registre des stupéfiants avec le solde après sortie.</p></div>
      <div class="frow" style="margin-top:12px"><label class="flbl">Note <span class="opt">· facultatif</span></label><input class="finput" id="soNote"></div>
      <p class="hint">Les sorties des consultations et des factures se font d'elles-mêmes. Ici : ce qui sort sans passer par une facture.</p>
    </div>
    <div class="mfoot"><button type="button" class="btn" data-close>Annuler</button><button type="button" class="btn primaire" id="soOk" disabled>Enregistrer la sortie</button></div>
  </div></div>

  <!-- Inventaire -->
  <div class="mveil" id="mInv"><div class="mbox xl">
    <div class="mhead"><div class="mt"><b>Inventaire</b><span id="invSub">Comptez, l'écart avec le théorique devient un ajustement</span></div><button type="button" class="mclose" data-close aria-label="Fermer"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div>
    <div class="mbody scr">
      <div class="chips" id="invEmpl"></div>
      <table class="rtab" id="invTab"></table>
    </div>
    <div class="mfoot"><span class="inv-tot" id="invTot"></span><button type="button" class="btn" data-close>Annuler</button><button type="button" class="btn primaire" id="invOk" disabled>Valider</button></div>
  </div></div>

  <!-- Rappel -->
  <div class="mveil" id="mRappel"><div class="mbox">
    <div class="mhead"><div class="mt"><b>Rappeler le lot</b><span id="raSub">—</span></div><button type="button" class="mclose" data-close aria-label="Fermer"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div>
    <div class="mbody">
      <div class="frow"><label class="flbl">Motif du rappel <span class="req">*</span></label><input class="finput" id="raMotif" placeholder="Rappel laboratoire n° …"></div>
      <div id="raAni"></div>
      <p class="hint">La quantité restante sort du stock en « Retour fournisseur » et le lot ne peut plus être délivré.</p>
    </div>
    <div class="mfoot"><button type="button" class="btn" data-close>Annuler</button><button type="button" class="btn danger" id="raOk" disabled>Rappeler le lot</button></div>
  </div></div>

  <div class="pick" id="pick">
    <div class="crech"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input id="pickQ" autocomplete="off" placeholder="Rechercher un article…"></div>
    <div class="pick-l scr" id="pickL"></div>
  </div>

</div>
{% endblock %}
