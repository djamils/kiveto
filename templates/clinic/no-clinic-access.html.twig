{% extends 'security/_auth_layout.html.twig' %}

{% block title %}Aucune clinique accessible — Kiveto{% endblock %}

{% block screens %}
  <section class="ecran centre on" id="e-aucune" aria-labelledby="t-aucune">
    <div class="ok-rond ambre"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V8l7-5 7 5v13"/><path d="M10 21v-5h4v5"/></svg></div>
    <h1 class="titre" id="t-aucune">Aucune clinique accessible</h1>
    <p class="sous">Votre compte n'est rattaché à aucune clinique active. Demandez à l'administrateur de votre clinique de vous y donner accès.</p>
    <a class="btn s" href="{{ path('_logout_clinic') }}" data-turbo="false" style="margin-top:24px;width:100%">Se déconnecter</a>
  </section>
{% endblock %}
