{#
 # Kiveto — templates/clinic/clinical_care/consultation_details.html.twig
 # ─────────────────────────────────────────────────────────────────────
 # Consultation detail page — VetSaaS design from vetos-consultation.html mockup.
 # Patient banner, 2-column layout with vitals/diagnosis left, SOAP notes right,
 # acts, prescriptions, plan, history drawer, modals.
 #
 # Variables:
 #   consultation  ConsultationDto   The consultation data
 #   pageTitle     string            Page title (e.g. "Consultation")
 #}
{% extends 'clinic/base.html.twig' %}

{% block page_title %}Consultation{% endblock %}

{% block breadcrumb %}
  <a>Rendez-vous</a>
  <i data-lucide="chevron-right" style="width:10px;height:10px;color:var(--border-medium);"></i>
  <a class="bc-middle">19 mars 2026</a>
  <i data-lucide="chevron-right" style="width:10px;height:10px;color:var(--border-medium);"></i>
  <span>Luna — Consultation</span>
{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/vetos-design-system.css') }}"/>
<link rel="stylesheet" href="{{ asset('styles/pages/consultation.css') }}"/>
<script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
{% endblock %}

{% block topbar_actions %}
    <div style="display:flex;align-items:center;gap:var(--space-2);background:#fefce8;border:1px solid #fde68a;border-radius:var(--radius-md);padding:4px var(--space-3);">
        <div class="pulse-dot"></div>
        <span style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:#92400e;">En cours</span>
    </div>
    <div style="display:flex;align-items:center;gap:var(--space-2);" class="topbar-actions">
      <button class="btn btn-secondary btn-xs"><i data-lucide="x" style="width:10px;height:10px;"></i><span>Annuler</span></button>
      <button class="btn btn-primary btn-xs" onclick="closeConsult()"><i data-lucide="check" style="width:10px;height:10px;"></i><span>Clôturer la visite</span></button>
    </div>
{% endblock %}

{% block content %}
  {# ── PATIENT BANNER — desktop 2 lines ── #}
  <div class="patient-banner">
    <div class="banner-line1">
      <div style="width:40px;height:40px;border-radius:var(--radius-md);background:#f3e8ff;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;border:1px solid #e9d5ff;">🐱</div>
      <div>
        <div style="display:flex;align-items:center;gap:var(--space-2);margin-bottom:2px;">
          <span style="font-size:var(--text-xl);font-weight:var(--weight-medium);color:var(--text-primary);">Luna</span>
          <span class="badge b-feline">Félin</span>
          <span style="font-size:var(--text-md);color:var(--text-muted);">Persan · 4 ans · Femelle stérilisée</span>
        </div>
        <div style="display:flex;align-items:center;gap:var(--space-2);font-size:var(--text-sm);color:var(--text-subtle);">
          <span>#PAT-00412</span>
          <span style="color:#e9d5ff;">·</span>
          <span style="font-size:var(--text-xs);font-weight:var(--weight-medium);color:#7c3aed;background:#f3e8ff;padding:1px var(--space-1);border-radius:var(--radius-sm);border:1px solid #e9d5ff;">Visite #3</span>
          <span style="color:#e9d5ff;">·</span>
          <span>Dernière visite 12 jan. 2026</span>
        </div>
      </div>
      <button class="vax-btn" onclick="openVaxModal()" style="margin-left:var(--space-4);">
        <div class="pulse-dot" style="background:#f59e0b;"></div>
        <span style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:#92400e;">Rappel FeLV à faire</span>
        <i data-lucide="chevron-right" style="width:9px;height:9px;color:#b45309;"></i>
      </button>
      <div style="margin-left:auto;display:flex;gap:var(--space-2);">
        <button class="btn btn-secondary btn-xs"><i data-lucide="folder" style="width:10px;height:10px;"></i>Dossier</button>
        <button class="btn btn-secondary btn-xs" onclick="openDrawer()"><i data-lucide="clock" style="width:10px;height:10px;"></i>Historique</button>
      </div>
    </div>
    <div class="banner-line2">
      <i data-lucide="user" style="width:11px;height:11px;color:#c084fc;flex-shrink:0;"></i>
      <span style="font-size:var(--text-md);font-weight:var(--weight-medium);color:var(--text-secondary);">Mme Dubois</span>
      <div style="width:1px;height:12px;background:#e9d5ff;"></div>
      <span style="font-size:var(--text-md);color:#7c3aed;cursor:pointer;">+33 6 12 34 56 78</span>
      <div style="width:1px;height:12px;background:#e9d5ff;"></div>
      <span style="font-size:var(--text-sm);color:var(--text-subtle);">Allergie connue :</span>
      <span style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:#dc2626;background:#fef2f2;padding:1px var(--space-2);border-radius:var(--radius-sm);border:1px solid #fecaca;">⚠ Pénicilline</span>
    </div>
  </div>

  {# ── PATIENT BANNER — compact portrait ── #}
  <div class="banner-compact">
    <div style="font-size:20px;">🐱</div>
    <div style="flex:1;min-width:0;">
      <div style="display:flex;align-items:center;gap:var(--space-2);">
        <span style="font-size:var(--text-lg);font-weight:var(--weight-medium);color:var(--text-primary);">Luna</span>
        <span class="badge b-feline" style="font-size:10px;">Félin</span>
        <span style="font-size:var(--text-sm);color:var(--text-muted);">Persan · 4 ans</span>
        <span style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:#dc2626;background:#fef2f2;padding:1px var(--space-2);border-radius:var(--radius-sm);border:1px solid #fecaca;margin-left:auto;">⚠ Pénicilline</span>
      </div>
      <div style="font-size:var(--text-sm);color:var(--text-subtle);">Mme Dubois · Visite #3 · 19 mars 2026</div>
    </div>
    <button class="btn btn-secondary btn-xs" onclick="openDrawer()"><i data-lucide="clock" style="width:10px;height:10px;"></i></button>
    <button class="btn btn-primary btn-xs" onclick="closeConsult()"><i data-lucide="check" style="width:10px;height:10px;"></i>Clôturer</button>
  </div>

  {# ── DESKTOP SCROLL BODY ── #}
  <div class="scroll" id="desktop-scroll">
  <div class="body">
  <div class="consult-grid">

    {# ══ LEFT COLUMN: Clinical ══ #}
    <div class="col-left" id="col-clinique">

      {# Motif #}
      <div class="widget">
        <div class="w-head">
          <div style="display:flex;align-items:center;gap:var(--space-2);">
            <span class="w-title">Motif de consultation</span>
            <span style="font-size:10px;color:var(--text-subtle);background:var(--surface-subtle);padding:1px var(--space-2);border-radius:var(--radius-full);">ASV · 10h52</span>
          </div>
          <button class="btn btn-ghost btn-xs" onclick="toggleEditMotif()" id="motif-edit-btn"><i data-lucide="pencil" style="width:10px;height:10px;"></i>Modifier</button>
        </div>
        <div class="w-body" id="motif-view">
          <div style="display:flex;gap:var(--space-1);flex-wrap:wrap;margin-bottom:var(--space-2);">
            <span class="motif-tag" style="border-color:var(--brand-500);background:var(--brand-50);color:var(--brand-600);">✦ Suivi vaccinal</span>
            <span class="motif-tag" style="border-color:var(--brand-500);background:var(--brand-50);color:var(--brand-600);">Troubles digestifs</span>
          </div>
          <div class="field-readonly"><span style="font-size:var(--text-md);color:var(--text-muted);">Propriétaire signale une légère perte d'appétit depuis 2 jours. Luna est moins active. Pas de vomissements.</span></div>
        </div>
        <div class="w-body" id="motif-edit" style="display:none;">
          <div style="display:flex;gap:var(--space-1);flex-wrap:wrap;margin-bottom:var(--space-2);">
            <span class="motif-tag" style="border-color:var(--brand-500);background:var(--brand-50);color:var(--brand-600);cursor:pointer;" onclick="toggleMotif(this)">✦ Suivi vaccinal</span>
            <span class="motif-tag" style="border-color:var(--brand-500);background:var(--brand-50);color:var(--brand-600);cursor:pointer;" onclick="toggleMotif(this)">Troubles digestifs</span>
            <span class="motif-tag" style="cursor:pointer;" onclick="toggleMotif(this)">Dermatologie</span>
            <span class="motif-tag" style="cursor:pointer;" onclick="toggleMotif(this)">Bilan général</span>
            <span class="motif-tag" style="cursor:pointer;" onclick="toggleMotif(this)">+ Autre</span>
          </div>
          <textarea class="form-input" rows="2">Propriétaire signale une légère perte d'appétit depuis 2 jours. Luna est moins active. Pas de vomissements.</textarea>
        </div>
      </div>

      {# Vitals #}
      <div class="widget">
        <div class="w-head">
          <div style="display:flex;align-items:center;gap:var(--space-2);">
            <span class="w-title">Signes vitaux</span>
            <span style="font-size:10px;color:var(--text-subtle);background:var(--surface-subtle);padding:1px var(--space-2);border-radius:var(--radius-full);">ASV · 10h54</span>
          </div>
          <button class="btn btn-ghost btn-xs" onclick="toggleEditVitals()" id="vitals-edit-btn"><i data-lucide="pencil" style="width:10px;height:10px;"></i>Modifier</button>
        </div>
        <div id="vitals-view" style="padding:var(--space-2) var(--space-4) 0;">
          <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:var(--space-1);">
            <div class="vital-pill ok" data-vital="poids" onclick="selectVital(this,'poids')"><div class="vital-num">3.8 <span class="vital-unit">kg</span></div><div class="vital-lbl">Poids <span style="font-size:9px;color:#16a34a;">↓0.2</span></div></div>
            <div class="vital-pill alert" data-vital="temp" onclick="selectVital(this,'temp')"><div class="vital-num">39.6 <span class="vital-unit">°C</span></div><div class="vital-lbl">Temp. <span style="font-size:9px;color:#dc2626;">↑</span></div></div>
            <div class="vital-pill" data-vital="fc" onclick="selectVital(this,'fc')"><div class="vital-num">142 <span class="vital-unit">bpm</span></div><div class="vital-lbl">FC</div></div>
            <div class="vital-pill" data-vital="fr" onclick="selectVital(this,'fr')"><div class="vital-num">28 <span class="vital-unit">/min</span></div><div class="vital-lbl">FR</div></div>
            <div class="vital-pill" id="pain-card" data-vital="douleur" onclick="selectVital(this,'douleur')"><div class="vital-num" id="pain-card-val" style="font-size:var(--text-md);">—</div><div class="vital-lbl">Douleur</div></div>
          </div>
          <p style="font-size:10px;color:var(--text-subtle);margin-top:var(--space-1);padding:0 1px;">Cliquer pour afficher la courbe</p>
          <div id="charts-and-score" style="display:none;margin-top:var(--space-2);background:var(--surface-subtle);border:1px solid var(--border-medium);border-radius:var(--radius-md);padding:var(--space-2) var(--space-3);">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-1);">
              <span id="chart-label" style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:var(--text-primary);">Poids (kg)</span>
              <button onclick="closeChart()" style="font-size:10px;color:var(--text-subtle);background:none;border:none;cursor:pointer;">✕</button>
            </div>
            <div style="position:relative;height:72px;"><canvas id="vitals-chart"></canvas></div>
          </div>
        </div>
        <div id="vitals-edit" style="display:none;padding:var(--space-2) var(--space-4) 0;">
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:var(--space-2);margin-bottom:var(--space-3);">
            <div><label style="font-size:10px;color:var(--text-subtle);display:block;margin-bottom:2px;">Poids (kg)</label><input type="number" step="0.1" class="form-input" value="3.8" style="padding:var(--space-1) var(--space-2);font-size:var(--text-md);"></div>
            <div><label style="font-size:10px;color:var(--text-subtle);display:block;margin-bottom:2px;">Temp. (°C)</label><input type="number" step="0.1" class="form-input" value="39.6" style="padding:var(--space-1) var(--space-2);font-size:var(--text-md);"></div>
            <div><label style="font-size:10px;color:var(--text-subtle);display:block;margin-bottom:2px;">FC (bpm)</label><input type="number" class="form-input" value="142" style="padding:var(--space-1) var(--space-2);font-size:var(--text-md);"></div>
            <div><label style="font-size:10px;color:var(--text-subtle);display:block;margin-bottom:2px;">FR (/min)</label><input type="number" class="form-input" value="28" style="padding:var(--space-1) var(--space-2);font-size:var(--text-md);"></div>
          </div>
          <div style="background:var(--surface-subtle);border:1px solid var(--border-medium);border-radius:var(--radius-md);padding:var(--space-2) var(--space-3);margin-bottom:var(--space-2);">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-2);">
              <span style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:var(--text-primary);">Score douleur</span>
              <span id="pain-label" style="font-size:var(--text-md);font-weight:var(--weight-medium);color:var(--text-subtle);">Non évalué</span>
            </div>
            <div style="display:grid;grid-template-columns:repeat(11,1fr);gap:2px;">
              <div onclick="setPainScore(this,0)" data-score="0" style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-sm);font-size:10px;font-weight:var(--weight-medium);cursor:pointer;border:1px solid var(--border-medium);background:var(--surface-card);color:var(--text-subtle);transition:all .12s;">0</div>
              <div onclick="setPainScore(this,1)" data-score="1" style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-sm);font-size:10px;font-weight:var(--weight-medium);cursor:pointer;border:1px solid var(--border-medium);background:var(--surface-card);color:var(--text-muted);transition:all .12s;">1</div>
              <div onclick="setPainScore(this,2)" data-score="2" style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-sm);font-size:10px;font-weight:var(--weight-medium);cursor:pointer;border:1px solid var(--border-medium);background:var(--surface-card);color:var(--text-muted);transition:all .12s;">2</div>
              <div onclick="setPainScore(this,3)" data-score="3" style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-sm);font-size:10px;font-weight:var(--weight-medium);cursor:pointer;border:1px solid var(--border-medium);background:var(--surface-card);color:var(--text-muted);transition:all .12s;">3</div>
              <div onclick="setPainScore(this,4)" data-score="4" style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-sm);font-size:10px;font-weight:var(--weight-medium);cursor:pointer;border:1px solid var(--border-medium);background:var(--surface-card);color:var(--text-muted);transition:all .12s;">4</div>
              <div onclick="setPainScore(this,5)" data-score="5" style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-sm);font-size:10px;font-weight:var(--weight-medium);cursor:pointer;border:1px solid var(--border-medium);background:var(--surface-card);color:var(--text-muted);transition:all .12s;">5</div>
              <div onclick="setPainScore(this,6)" data-score="6" style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-sm);font-size:10px;font-weight:var(--weight-medium);cursor:pointer;border:1px solid var(--border-medium);background:var(--surface-card);color:var(--text-muted);transition:all .12s;">6</div>
              <div onclick="setPainScore(this,7)" data-score="7" style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-sm);font-size:10px;font-weight:var(--weight-medium);cursor:pointer;border:1px solid var(--border-medium);background:var(--surface-card);color:var(--text-muted);transition:all .12s;">7</div>
              <div onclick="setPainScore(this,8)" data-score="8" style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-sm);font-size:10px;font-weight:var(--weight-medium);cursor:pointer;border:1px solid var(--border-medium);background:var(--surface-card);color:var(--text-muted);transition:all .12s;">8</div>
              <div onclick="setPainScore(this,9)" data-score="9" style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-sm);font-size:10px;font-weight:var(--weight-medium);cursor:pointer;border:1px solid var(--border-medium);background:var(--surface-card);color:var(--text-muted);transition:all .12s;">9</div>
              <div onclick="setPainScore(this,10)" data-score="10" style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-sm);font-size:10px;font-weight:var(--weight-medium);cursor:pointer;border:1px solid var(--border-medium);background:var(--surface-card);color:var(--text-muted);transition:all .12s;">10</div>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:9px;color:var(--text-subtle);margin-top:var(--space-1);"><span>Aucune</span><span>Légère</span><span>Modérée</span><span>Intense</span></div>
          </div>
        </div>
        <div style="height:var(--space-2);"></div>
      </div>

      {# Acts & Billing #}
      <div class="widget">
        <div class="w-head"><span class="w-title">Actes &amp; Facturation</span></div>
        <div class="w-body" style="padding-top:var(--space-2);">
          <div id="actes-list" style="display:flex;flex-direction:column;gap:var(--space-1);margin-bottom:var(--space-3);">
            <div class="acte-row"><div style="flex:1;"><p style="font-size:var(--text-md);font-weight:var(--weight-medium);color:var(--text-primary);">Consultation</p></div><span style="font-size:var(--text-md);font-weight:var(--weight-medium);">35,00 €</span></div>
            <div class="acte-row"><div style="flex:1;"><p style="font-size:var(--text-md);font-weight:var(--weight-medium);color:var(--text-primary);">Vaccination FeLV</p></div><span style="font-size:var(--text-md);font-weight:var(--weight-medium);">18,00 €</span></div>
            <div class="acte-row"><div style="flex:1;"><p style="font-size:var(--text-md);font-weight:var(--weight-medium);color:var(--text-primary);">Smecta</p></div><span style="font-size:var(--text-md);font-weight:var(--weight-medium);">4,50 €</span></div>
            <div class="acte-row"><div style="flex:1;"><p style="font-size:var(--text-md);font-weight:var(--weight-medium);color:var(--text-primary);">NaCl 0,9% SC</p></div><span style="font-size:var(--text-md);font-weight:var(--weight-medium);">6,00 €</span></div>
            <div style="display:flex;align-items:center;justify-content:center;gap:var(--space-1);padding:var(--space-1);border:1px dashed var(--border-medium);border-radius:var(--radius-md);cursor:pointer;color:var(--text-subtle);font-size:var(--text-sm);transition:all .12s;" onmouseenter="this.style.borderColor='var(--brand-400)';this.style.color='var(--brand-600)'" onmouseleave="this.style.borderColor='var(--border-medium)';this.style.color='var(--text-subtle)'"><i data-lucide="plus" style="width:10px;height:10px;"></i>Ajouter</div>
          </div>
          <div style="border-top:1px solid var(--border-light);padding-top:var(--space-2);">
            <div style="display:flex;justify-content:space-between;font-size:var(--text-sm);color:var(--text-muted);margin-bottom:2px;"><span>Sous-total HT</span><span>52,92 €</span></div>
            <div style="display:flex;justify-content:space-between;font-size:var(--text-sm);color:var(--text-muted);margin-bottom:var(--space-2);"><span>TVA (20%)</span><span>10,58 €</span></div>
            <div style="display:flex;justify-content:space-between;font-size:var(--text-base);font-weight:var(--weight-medium);color:var(--text-primary);"><span>Total TTC</span><span id="actes-total">63,50 €</span></div>
          </div>
        </div>
      </div>

    </div>{# end left column #}

    {# ══ RIGHT COLUMN: Medical notes ══ #}
    <div style="display:flex;flex-direction:column;gap:var(--space-3);">

      {# SOAP #}
      <div class="widget">
        <div class="w-head">
          <span class="w-title">Notes SOAP</span>
          <span style="font-size:var(--text-sm);color:var(--text-subtle);">Note médicale de la consultation</span>
        </div>
        <div class="w-body" style="display:flex;flex-direction:column;gap:var(--space-3);padding-top:var(--space-4);">

          {# S — Subjective #}
          <div style="display:flex;gap:var(--space-3);">
            <div style="display:flex;flex-direction:column;align-items:center;gap:var(--space-1);flex-shrink:0;">
              <div class="soap-letter" style="background:#eff6ff;color:#1d4ed8;">S</div>
              <div style="flex:1;width:1.5px;background:var(--border-light);border-radius:1px;min-height:8px;"></div>
            </div>
            <div style="flex:1;min-width:0;">
              <p style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:#1d4ed8;margin-bottom:var(--space-1);">Subjectif — motif &amp; symptômes</p>
              <textarea class="form-input" rows="3" placeholder="Symptômes rapportés par le propriétaire…">Propriétaire rapporte une baisse d'appétit depuis 48h. Luna boit normalement. Légère léthargie. Pas de vomissement ni diarrhée. Aucun changement environnemental.</textarea>
            </div>
          </div>

          {# O — Objective #}
          <div style="display:flex;gap:var(--space-3);">
            <div style="display:flex;flex-direction:column;align-items:center;gap:var(--space-1);flex-shrink:0;">
              <div class="soap-letter" style="background:#f0fdf4;color:#15803d;">O</div>
              <div style="flex:1;width:1.5px;background:var(--border-light);border-radius:1px;min-height:8px;"></div>
            </div>
            <div style="flex:1;min-width:0;">
              <p style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:#15803d;margin-bottom:var(--space-1);">Objectif — observations cliniques</p>
