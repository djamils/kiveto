    <div class="tl-item"><div class="tl-dot" style="color:#ef4444;background:#fef2f2;"></div><div style="flex:1;"><p style="font-size:var(--text-md);font-weight:var(--weight-medium);">Sterilisation</p><p style="font-size:var(--text-sm);color:var(--text-muted);">Ovariectomie &middot; Anesthesie generale</p><p style="font-size:var(--text-xs);color:var(--text-subtle);">Dr. Rousseau &middot; 3 avr. 2024</p></div></div>
