    <div style="padding:var(--space-4) var(--space-5);display:flex;flex-direction:column;gap:var(--space-3);">
      <div style="background:#fef9c3;border:1px solid #fde68a;border-radius:var(--radius-md);padding:var(--space-3);"><p style="font-size:var(--text-md);font-weight:var(--weight-medium);color:#92400e;">Dernier rappel FeLV : 8 sept. 2025 — Dr. Rousseau</p><p style="font-size:var(--text-md);color:#b45309;margin-top:var(--space-1);">Prochain rappel recommandé : avant le 8 sept. 2026</p></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-2);">
        <div><label class="form-label">Date d'administration</label><input type="date" class="form-input" value="2026-03-19"></div>
        <div><label class="form-label">Lot vaccin</label><input type="text" class="form-input" placeholder="N° lot…"></div>
      </div>
      <div><label class="form-label">Prochain rappel</label><input type="date" class="form-input" value="2027-03-19"></div>
      <div style="display:flex;gap:var(--space-2);justify-content:flex-end;">
        <button class="btn btn-secondary" onclick="closeVaxModal()">Annuler</button>
        <button class="btn btn-primary" onclick="showToast('Vaccination FeLV enregistrée','#059669');closeVaxModal()"><i data-lucide="check" style="width:11px;height:11px;"></i>Administrer rappel FeLV</button>
      </div>
    </div>
  </div>
</div>
{% endblock %}

