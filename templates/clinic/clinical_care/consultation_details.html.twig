{#
 # Kiveto — templates/clinic/clinical_care/consultation_details.html.twig
 # ─────────────────────────────────────────────────────────────────────
 # Consultation detail page — VetSaaS design from vetos-consultation.html mockup.
 # Patient banner, 2-column layout with vitals/diagnosis left, SOAP notes right,
 # acts, prescriptions, plan, history drawer, modals.
 #
 # Variables:
 #   consultation  ConsultationDto   The consultation data
 #   pageTitle     string            Page title (e.g. "Consultation")
 #}
{% extends 'clinic/base.html.twig' %}

{% block page_title %}Consultation{% endblock %}

{% block breadcrumb %}
  <a>Rendez-vous</a>
  <i data-lucide="chevron-right" style="width:10px;height:10px;color:var(--border-medium);"></i>
  <a class="bc-middle">19 mars 2026</a>
  <i data-lucide="chevron-right" style="width:10px;height:10px;color:var(--border-medium);"></i>
  <span>Luna — Consultation</span>
{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/vetos-design-system.css') }}"/>
<script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
    /* Override base to allow full-height consultation layout */
    html,body{height:100%;overflow:hidden;}
    body{background:var(--surface-page);}
    *{scrollbar-width:thin;scrollbar-color:#cbd5e1 transparent;}
    ::-webkit-scrollbar{width:2px;height:2px;}
    ::-webkit-scrollbar-track{background:transparent;}
    ::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:2px;}
    ::-webkit-scrollbar-button{display:none;}

    /* Override base to allow full-height content */
    .app-scroll{overflow:hidden !important;display:flex;flex-direction:column;flex:1;}
    .app-body{padding:0 !important;flex:1;display:flex;flex-direction:column;overflow:hidden;}

    /* ── Patient banner ── */
    .patient-banner{flex-shrink:0;background:#fefcff;border-bottom:1px solid #ede9fe;border-left:3px solid #a855f7;}
    .banner-line1{display:flex;align-items:center;gap:var(--space-3);padding:var(--space-2) var(--space-4);border-bottom:1px solid #f5f0ff;}
    .banner-line2{display:flex;align-items:center;gap:var(--space-3);padding:var(--space-1) var(--space-4);background:#faf7ff;flex-wrap:wrap;}
    /* Banner compact — single line on tablet portrait */
    .banner-compact{display:none;align-items:center;gap:var(--space-3);padding:var(--space-2) var(--space-4);background:#fefcff;border-bottom:1px solid #ede9fe;border-left:3px solid #a855f7;}

    /* ── Scroll body ── */
    .scroll{flex:1;overflow-y:auto;}
    .body{padding:var(--space-4) var(--space-4) var(--space-8);}

    /* ── 2-col grid ── */
    .consult-grid{display:grid;grid-template-columns:360px 1fr;gap:var(--space-3);align-items:start;}
    .col-left{position:sticky;top:var(--space-4);display:flex;flex-direction:column;gap:var(--space-3);max-height:calc(100vh - 140px);overflow-y:auto;padding-right:2px;}

    /* ── Widgets ── */
    .widget{background:var(--surface-card);border:1px solid var(--border-light);border-radius:var(--radius-lg);overflow:hidden;}
    .w-head{display:flex;align-items:center;justify-content:space-between;padding:var(--space-3) var(--space-4);border-bottom:1px solid var(--border-light);}
    .w-title{font-size:var(--text-xs);font-weight:var(--weight-medium);color:var(--text-subtle);text-transform:uppercase;letter-spacing:.08em;}
    .w-body{padding:var(--space-3) var(--space-4);}

    /* ── Vitals ── */
    .vital-pill{display:flex;flex-direction:column;align-items:flex-start;padding:var(--space-2) var(--space-2);background:var(--surface-subtle);border:1px solid var(--border-medium);border-radius:var(--radius-md);gap:2px;cursor:pointer;transition:var(--transition-fast);}
    .vital-pill:hover{transform:translateY(-1px);}
    .vital-pill.alert{background:#fef2f2;border-color:#fecaca;}
    .vital-pill.ok{background:#f0fdf4;border-color:#bbf7d0;}
    .vital-pill.active-vital{box-shadow:0 0 0 2px var(--brand-400);}
    .vital-num{font-size:var(--text-lg);font-weight:var(--weight-medium);color:var(--text-primary);line-height:1;}
    .vital-pill.alert .vital-num{color:#dc2626;}
    .vital-pill.ok .vital-num{color:#16a34a;}
    .vital-unit{font-size:var(--text-xs);color:var(--text-subtle);}
    .vital-lbl{font-size:var(--text-xs);color:var(--text-muted);}

    /* ── Pain score ── */
    input[type=range]{-webkit-appearance:none;width:100%;height:3px;border-radius:2px;background:linear-gradient(to right,var(--brand-500) 0%,var(--brand-500) 40%,var(--border-medium) 40%,var(--border-medium) 100%);outline:none;}
    input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:13px;height:13px;border-radius:50%;background:var(--brand-500);cursor:pointer;box-shadow:0 0 0 3px rgba(99,102,241,.15);}

    /* ── Acts ── */
    .acte-row{display:flex;align-items:center;gap:var(--space-2);padding:var(--space-1) var(--space-2);background:var(--surface-subtle);border-radius:var(--radius-md);border:1px solid var(--border-light);}

    /* ── SOAP ── */
    .soap-letter{width:20px;height:20px;border-radius:var(--radius-sm);font-size:var(--text-xs);font-weight:var(--weight-medium);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .form-input{width:100%;font-size:var(--text-md);font-family:inherit;background:var(--surface-subtle);border:1px solid var(--border-medium);border-radius:var(--radius-md);padding:var(--space-2) var(--space-3);outline:none;color:var(--text-primary);transition:var(--transition-normal);resize:none;}
    .form-input:focus{border-color:var(--brand-400);background:var(--surface-card);box-shadow:var(--shadow-focus);}
    .form-input::placeholder{color:var(--text-subtle);}
    .form-label{font-size:var(--text-xs);font-weight:var(--weight-medium);color:var(--text-muted);text-transform:uppercase;letter-spacing:.07em;display:block;margin-bottom:var(--space-1);}

    /* ── Diag tags ── */
    .diag-tag{display:inline-flex;align-items:center;gap:var(--space-1);padding:3px var(--space-2);border-radius:var(--radius-md);font-size:var(--text-sm);font-weight:var(--weight-medium);cursor:pointer;border:1px solid var(--border-medium);background:var(--surface-subtle);color:var(--text-muted);transition:var(--transition-fast);}
    .diag-tag.confirmed{border-color:#16a34a;background:#f0fdf4;color:#15803d;box-shadow:0 0 0 2px #bbf7d0;}
    .diag-tag.suspected{border-color:#f59e0b;background:#fffbeb;color:#b45309;}
    .diag-tag.excluded{border-color:var(--border-light);background:var(--surface-subtle);color:var(--text-subtle);text-decoration:line-through;opacity:.6;}

    /* ── Plan lines ── */
    .plan-line{display:flex;align-items:center;gap:var(--space-2);padding:var(--space-1) var(--space-2);border-radius:var(--radius-md);background:var(--surface-subtle);border:1px solid var(--border-light);}
    .plan-actions{display:flex;align-items:center;gap:3px;opacity:0;transition:opacity .12s;flex-shrink:0;}
    .plan-line:hover .plan-actions{opacity:1;}

    /* ── Rx rows ── */
    .rx-row{display:flex;align-items:center;gap:var(--space-2);padding:var(--space-2) var(--space-2);background:var(--surface-subtle);border:1px solid var(--border-light);border-radius:var(--radius-md);margin-bottom:var(--space-1);transition:background .12s;}
    .rx-row:hover{background:var(--surface-hover);}

    /* ── Motif tags ── */
    .motif-tag{display:inline-flex;align-items:center;padding:3px var(--space-2);border-radius:var(--radius-full);font-size:var(--text-sm);font-weight:var(--weight-medium);border:1px solid var(--border-medium);background:var(--surface-subtle);color:var(--text-muted);}

    /* ── Field readonly ── */
    .field-readonly{background:var(--surface-subtle);border:1px solid var(--border-light);border-radius:var(--radius-md);padding:var(--space-2) var(--space-3);font-size:var(--text-md);color:var(--text-primary);}

    /* ── Badges ── */
    .badge{font-size:var(--text-sm);font-weight:var(--weight-medium);padding:2px var(--space-2);border-radius:var(--radius-full);white-space:nowrap;}
    .b-feline{background:#fdf4ff;color:#7e22ce;}

    /* ── Buttons ── */
    .btn{display:inline-flex;align-items:center;gap:var(--space-1);padding:6px var(--space-3);border-radius:var(--radius-md);font-size:var(--text-sm);font-weight:var(--weight-medium);font-family:inherit;cursor:pointer;border:none;transition:var(--transition-fast);white-space:nowrap;}
    .btn:active{transform:scale(.98);}
    .btn-primary{background:var(--brand-600);color:#fff;}
    .btn-primary:hover{background:var(--brand-700);}
    .btn-secondary{background:var(--surface-subtle);color:var(--text-secondary);border:1px solid var(--border-medium);}
    .btn-secondary:hover{background:var(--surface-hover);}
    .btn-ghost{background:transparent;color:var(--text-muted);border:none;padding:3px var(--space-2);font-size:var(--text-sm);}
    .btn-ghost:hover{background:var(--surface-subtle);color:var(--text-secondary);}
    .btn-danger-soft{background:#fef2f2;color:#dc2626;border:1px solid #fecaca;}
    .btn-danger-soft:hover{background:#fee2e2;}
    .btn-xs{padding:4px var(--space-2);font-size:var(--text-sm);}
    .btn-close{width:28px;height:28px;border-radius:var(--radius-md);border:none;background:var(--surface-hover);cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text-muted);transition:var(--transition-fast);}
    .btn-close:hover{background:var(--surface-subtle);}

    /* ── In progress badge ── */
    @keyframes pls{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.75)}}
    .pulse-dot{width:6px;height:6px;border-radius:50%;background:#f59e0b;animation:pls 2s infinite;}

    /* ── History drawer ── */
    .drawer-overlay{position:fixed;inset:0;background:rgba(15,23,42,.3);z-index:200;opacity:0;pointer-events:none;transition:opacity .25s;}
    .drawer-overlay.open{opacity:1;pointer-events:all;}
    .drawer{position:fixed;top:0;right:0;height:100vh;width:360px;background:var(--surface-card);border-left:1px solid var(--border-light);z-index:201;transform:translateX(100%);transition:transform .28s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;box-shadow:-8px 0 32px rgba(0,0,0,.1);}
    .drawer.open{transform:translateX(0);}
    .tl-item{display:flex;gap:var(--space-3);padding:var(--space-2) 0;position:relative;}
    .tl-item:not(:last-child)::before{content:'';position:absolute;left:6px;top:20px;bottom:-8px;width:1.5px;background:var(--border-light);}
    .tl-dot{width:13px;height:13px;border-radius:50%;flex-shrink:0;margin-top:3px;border:2.5px solid #fff;box-shadow:0 0 0 1.5px currentColor;}

    /* ── Toast ── */
    #toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(8px);padding:var(--space-2) var(--space-4);border-radius:var(--radius-md);font-size:var(--text-md);font-weight:var(--weight-medium);color:#fff;opacity:0;transition:all .25s cubic-bezier(.34,1.56,.64,1);pointer-events:none;z-index:999;}
    @keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}

    /* ── Modals ── */
    .modal-overlay{position:fixed;inset:0;background:rgba(15,23,42,.45);backdrop-filter:blur(3px);z-index:250;display:none;align-items:center;justify-content:center;}
    .modal-overlay.open{display:flex;}
    .modal-box{background:var(--surface-card);border-radius:var(--radius-lg);max-width:calc(100vw - 32px);max-height:calc(100vh - 48px);box-shadow:var(--shadow-lg);overflow:hidden;display:flex;flex-direction:column;transform:scale(.97);opacity:0;transition:all .2s cubic-bezier(.34,1.56,.64,1);}
    .modal-overlay.open .modal-box{transform:scale(1);opacity:1;}
    .modal-head{padding:var(--space-4) var(--space-5);border-bottom:1px solid var(--border-light);display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}

    /* ── Bottom tabs — portrait ── */
    .bottom-tabs{display:none;flex-shrink:0;background:var(--surface-card);border-top:1px solid var(--border-light);height:60px;}
    .bottom-tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;cursor:pointer;border:none;background:none;font-family:inherit;color:var(--text-subtle);transition:var(--transition-fast);}
    .bottom-tab.active{color:var(--brand-600);}
    .bottom-tab-label{font-size:var(--text-xs);font-weight:var(--weight-medium);}
    .tab-pane{display:none;flex:1;overflow:hidden;flex-direction:column;}
    .tab-pane.active{display:flex;}

    /* ── Interaction pill ── */
    .interaction-pill{display:flex;align-items:center;gap:var(--space-2);padding:var(--space-1) var(--space-2);background:#fff7ed;border:1px solid #fed7aa;border-radius:var(--radius-md);margin-top:var(--space-1);}

    /* ── Vaccine alert ── */
    .vax-btn{display:flex;align-items:center;gap:var(--space-2);padding:4px var(--space-3);background:#fef9c3;border:1px solid #f59e0b;border-radius:var(--radius-md);cursor:pointer;font-family:inherit;transition:all .13s;}
    .vax-btn:hover{background:#fde68a;}

    /* ── Selector tabs ── */
    .sel-tabs{display:flex;gap:2px;background:var(--surface-subtle);border-radius:var(--radius-md);padding:2px;}
    .sel-tab{padding:4px var(--space-3);border-radius:var(--radius-sm);font-size:var(--text-sm);font-weight:var(--weight-medium);color:var(--text-muted);cursor:pointer;transition:var(--transition-fast);border:none;background:transparent;font-family:inherit;}
    .sel-tab.active{background:var(--surface-card);color:var(--text-primary);box-shadow:0 1px 3px rgba(0,0,0,.08);}

    /* ── Responsive ── */
    @media(max-width:1280px){
      .consult-grid{grid-template-columns:320px 1fr;}
    }
    @media(max-width:1024px){
      .banner-line1,.banner-line2{display:none;}
      .banner-compact{display:flex;}
      .scroll{display:none;}
      .bottom-tabs{display:flex;}
      .tab-body{flex:1;overflow:hidden;display:flex;flex-direction:column;}
    }
    @media(max-width:640px){
      .breadcrumb .bc-middle{display:none;}
      .topbar-actions .btn span{display:none;}
    }
</style>
{% endblock %}

{% block topbar_actions %}
    <div style="display:flex;align-items:center;gap:var(--space-2);background:#fefce8;border:1px solid #fde68a;border-radius:var(--radius-md);padding:4px var(--space-3);">
        <div class="pulse-dot"></div>
        <span style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:#92400e;">En cours</span>
    </div>
    <div style="display:flex;align-items:center;gap:var(--space-2);" class="topbar-actions">
      <button class="btn btn-secondary btn-xs"><i data-lucide="x" style="width:10px;height:10px;"></i><span>Annuler</span></button>
      <button class="btn btn-primary btn-xs" onclick="closeConsult()"><i data-lucide="check" style="width:10px;height:10px;"></i><span>Clôturer la visite</span></button>
    </div>
{% endblock %}

{% block content %}
  {# ── PATIENT BANNER — desktop 2 lines ── #}
  <div class="patient-banner">
    <div class="banner-line1">
      <div style="width:40px;height:40px;border-radius:var(--radius-md);background:#f3e8ff;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;border:1px solid #e9d5ff;">🐱</div>
      <div>
        <div style="display:flex;align-items:center;gap:var(--space-2);margin-bottom:2px;">
          <span style="font-size:var(--text-xl);font-weight:var(--weight-medium);color:var(--text-primary);">Luna</span>
          <span class="badge b-feline">Félin</span>
          <span style="font-size:var(--text-md);color:var(--text-muted);">Persan · 4 ans · Femelle stérilisée</span>
        </div>
        <div style="display:flex;align-items:center;gap:var(--space-2);font-size:var(--text-sm);color:var(--text-subtle);">
          <span>#PAT-00412</span>
          <span style="color:#e9d5ff;">·</span>
          <span style="font-size:var(--text-xs);font-weight:var(--weight-medium);color:#7c3aed;background:#f3e8ff;padding:1px var(--space-1);border-radius:var(--radius-sm);border:1px solid #e9d5ff;">Visite #3</span>
          <span style="color:#e9d5ff;">·</span>
          <span>Dernière visite 12 jan. 2026</span>
        </div>
      </div>
      <button class="vax-btn" onclick="openVaxModal()" style="margin-left:var(--space-4);">
        <div class="pulse-dot" style="background:#f59e0b;"></div>
        <span style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:#92400e;">Rappel FeLV à faire</span>
        <i data-lucide="chevron-right" style="width:9px;height:9px;color:#b45309;"></i>
      </button>
      <div style="margin-left:auto;display:flex;gap:var(--space-2);">
        <button class="btn btn-secondary btn-xs"><i data-lucide="folder" style="width:10px;height:10px;"></i>Dossier</button>
        <button class="btn btn-secondary btn-xs" onclick="openDrawer()"><i data-lucide="clock" style="width:10px;height:10px;"></i>Historique</button>
      </div>
    </div>
    <div class="banner-line2">
      <i data-lucide="user" style="width:11px;height:11px;color:#c084fc;flex-shrink:0;"></i>
      <span style="font-size:var(--text-md);font-weight:var(--weight-medium);color:var(--text-secondary);">Mme Dubois</span>
      <div style="width:1px;height:12px;background:#e9d5ff;"></div>
      <span style="font-size:var(--text-md);color:#7c3aed;cursor:pointer;">+33 6 12 34 56 78</span>
      <div style="width:1px;height:12px;background:#e9d5ff;"></div>
      <span style="font-size:var(--text-sm);color:var(--text-subtle);">Allergie connue :</span>
      <span style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:#dc2626;background:#fef2f2;padding:1px var(--space-2);border-radius:var(--radius-sm);border:1px solid #fecaca;">⚠ Pénicilline</span>
    </div>
  </div>

  {# ── PATIENT BANNER — compact portrait ── #}
  <div class="banner-compact">
    <div style="font-size:20px;">🐱</div>
    <div style="flex:1;min-width:0;">
      <div style="display:flex;align-items:center;gap:var(--space-2);">
        <span style="font-size:var(--text-lg);font-weight:var(--weight-medium);color:var(--text-primary);">Luna</span>
        <span class="badge b-feline" style="font-size:10px;">Félin</span>
        <span style="font-size:var(--text-sm);color:var(--text-muted);">Persan · 4 ans</span>
        <span style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:#dc2626;background:#fef2f2;padding:1px var(--space-2);border-radius:var(--radius-sm);border:1px solid #fecaca;margin-left:auto;">⚠ Pénicilline</span>
      </div>
      <div style="font-size:var(--text-sm);color:var(--text-subtle);">Mme Dubois · Visite #3 · 19 mars 2026</div>
    </div>
    <button class="btn btn-secondary btn-xs" onclick="openDrawer()"><i data-lucide="clock" style="width:10px;height:10px;"></i></button>
    <button class="btn btn-primary btn-xs" onclick="closeConsult()"><i data-lucide="check" style="width:10px;height:10px;"></i>Clôturer</button>
  </div>

  {# ── DESKTOP SCROLL BODY ── #}
  <div class="scroll" id="desktop-scroll">
  <div class="body">
  <div class="consult-grid">

    {# ══ LEFT COLUMN: Clinical ══ #}
    <div class="col-left" id="col-clinique">

      {# Motif #}
      <div class="widget">
        <div class="w-head">
          <div style="display:flex;align-items:center;gap:var(--space-2);">
            <span class="w-title">Motif de consultation</span>
            <span style="font-size:10px;color:var(--text-subtle);background:var(--surface-subtle);padding:1px var(--space-2);border-radius:var(--radius-full);">ASV · 10h52</span>
          </div>
          <button class="btn btn-ghost btn-xs" onclick="toggleEditMotif()" id="motif-edit-btn"><i data-lucide="pencil" style="width:10px;height:10px;"></i>Modifier</button>
        </div>
        <div class="w-body" id="motif-view">
          <div style="display:flex;gap:var(--space-1);flex-wrap:wrap;margin-bottom:var(--space-2);">
            <span class="motif-tag" style="border-color:var(--brand-500);background:var(--brand-50);color:var(--brand-600);">✦ Suivi vaccinal</span>
            <span class="motif-tag" style="border-color:var(--brand-500);background:var(--brand-50);color:var(--brand-600);">Troubles digestifs</span>
          </div>
          <div class="field-readonly"><span style="font-size:var(--text-md);color:var(--text-muted);">Propriétaire signale une légère perte d'appétit depuis 2 jours. Luna est moins active. Pas de vomissements.</span></div>
        </div>
        <div class="w-body" id="motif-edit" style="display:none;">
          <div style="display:flex;gap:var(--space-1);flex-wrap:wrap;margin-bottom:var(--space-2);">
            <span class="motif-tag" style="border-color:var(--brand-500);background:var(--brand-50);color:var(--brand-600);cursor:pointer;" onclick="toggleMotif(this)">✦ Suivi vaccinal</span>
            <span class="motif-tag" style="border-color:var(--brand-500);background:var(--brand-50);color:var(--brand-600);cursor:pointer;" onclick="toggleMotif(this)">Troubles digestifs</span>
            <span class="motif-tag" style="cursor:pointer;" onclick="toggleMotif(this)">Dermatologie</span>
            <span class="motif-tag" style="cursor:pointer;" onclick="toggleMotif(this)">Bilan général</span>
            <span class="motif-tag" style="cursor:pointer;" onclick="toggleMotif(this)">+ Autre</span>
          </div>
          <textarea class="form-input" rows="2">Propriétaire signale une légère perte d'appétit depuis 2 jours. Luna est moins active. Pas de vomissements.</textarea>
        </div>
      </div>

      {# Vitals #}
      <div class="widget">
        <div class="w-head">
