{#
 # Kiveto — templates/clinic/consultation/detail/index.html.twig
 # ─────────────────────────────────────────────────────────────
 # Consultation detail — cockpit single-viewport.
 # Rail sidebar, topbar inline, patient-bar, summary strip, SOAP 2×2 grid,
 # right panel (ordonnance + facturation + mémo équipe).
 #
 # Variables:
 #   consultation  ConsultationDto   The consultation data
 #}
{% extends 'clinic/base.html.twig' %}

{% block page_title %}Consultation{% endblock %}
{% block show_topbar %}false{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/pages/consultation.css') }}"/>
{% endblock %}

{% block content %}

  {# ── Topbar cockpit ── #}
  <header class="topbar consult-topbar">
    <button class="btn btn-ghost btn-icon btn-sm consult-tb-toggle" type="button" aria-label="Plier la barre latérale" data-action="click->sidebar#toggle">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="2" y="2.5" width="12" height="11" rx="1.5"/>
        <path d="M6.5 2.5v11"/>
        <path d="M9 6l1.5 2L9 10" stroke-width="1.3"/>
      </svg>
    </button>
    <nav class="consult-crumb" aria-label="Fil d'Ariane">
      <a href="{{ path('clinic_consultations') }}">Consultations</a>
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg>
      <span class="consult-crumb-current">Luna · Lambert</span>
    </nav>
    <div style="flex:1"></div>
    <span class="consult-save-state">
      <span class="live-pulse" aria-hidden="true"></span>
      Brouillon · auto-sauvé
    </span>
    <span class="sep-v" aria-hidden="true"></span>
    <button class="btn btn-ghost btn-sm" onclick="openDrawer()">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M8 5v3.5l2 1.5"/></svg>
      Historique
    </button>
    <button class="btn btn-secondary btn-sm">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 13V3l5 4 5-4v10"/></svg>
      Imprimer
    </button>
  </header>

  {# ── Patient bar ── #}
  {% include 'clinic/consultation/detail/_patient_banner.html.twig' %}

  {# ── Summary strip (motif + constantes) ── #}
  {% include 'clinic/consultation/detail/_sidebar_vitals.html.twig' %}

  {# ── SOAP 2×2 grid ── #}
  {% include 'clinic/consultation/detail/_soap_notes.html.twig' %}

{% endblock %}

{% block rpanel %}
<aside class="app-rpanel consult-rpanel">

  <div class="rp-head">
    <div class="rp-title">
      <span class="live-pulse" aria-hidden="true"></span>
      Sortie consultation
    </div>
    <div class="rp-sub">Mise à jour automatique au fil du Plan.</div>
  </div>

  <div class="rp-scroll">

    {# ── Ordonnance ── #}
    <div class="rp-block">
      <div class="rp-block-head">
        <span class="rp-block-title">Ordonnance · 2 médicaments</span>
        <button class="btn btn-ghost btn-icon btn-xs" type="button" title="Voir / imprimer" aria-label="Imprimer l'ordonnance">
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M11 3H5L3 5v8h10V5z"/><path d="M5 8h6M5 10.5h4"/></svg>
        </button>
      </div>
      <div class="rp-rx-warning">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 1.5L14.5 13h-13z"/><path d="M8 6v3M8 11h.01" stroke-width="2"/></svg>
        <span><strong>Pénicilline allergique</strong> — molécules incompatibles filtrées.</span>
      </div>
      <div class="rx-list">
        <div class="rx-item has-row-x">
          <div class="rx-item-row">
            <span class="rx-name">Smecta poudre orale</span>
            <span class="rx-price">4,50 €</span>
            <button class="row-x" type="button" aria-label="Retirer ce médicament">
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3l10 10M13 3L3 13"/></svg>
            </button>
          </div>
          <div class="rx-poso">1 sachet · 3×/j · 3 j · per os</div>
        </div>
        <div class="rx-item has-row-x">
          <div class="rx-item-row">
            <span class="rx-name">NaCl 0,9% SC</span>
            <span class="rx-price">6,00 €</span>
            <button class="row-x" type="button" aria-label="Retirer ce médicament">
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3l10 10M13 3L3 13"/></svg>
            </button>
          </div>
          <div class="rx-poso">10 mL/kg · SC · 1×/j · 2 j</div>
        </div>
      </div>
      <button class="add-row" type="button">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M8 5v6M5 8h6"/></svg>
        Ajouter un médicament
      </button>
    </div>

    {# ── Facturation ── #}
    <div class="rp-block">
      <div class="rp-block-head">
        <span class="rp-block-title">Facturation</span>
        <span class="badge" style="font-size:var(--text-xs);background:var(--surface-subtle);color:var(--text-muted);">brouillon</span>
      </div>
      <div style="font-size:var(--text-xs);color:var(--text-subtle);margin-bottom:var(--space-2);line-height:1.5">
        Lignes générées depuis le plan et l'ordonnance · modifiez à la source
      </div>
      <div class="bill-list">
        <div class="bill-row">
          <div class="bill-name">Consultation standard<span class="bill-qty">CONS · 20 min</span></div>
          <div class="bill-price">35,00 €</div>
        </div>
        <div class="bill-row">
          <div class="bill-name">Vaccin FeLV<span class="bill-qty">VAC.FeLV · ×1</span></div>
          <div class="bill-price">18,00 €</div>
        </div>
        <div class="bill-row">
          <div class="bill-name">Smecta<span class="bill-qty">MED · ×3</span></div>
          <div class="bill-price">4,50 €</div>
        </div>
        <div class="bill-row">
          <div class="bill-name">NaCl 0,9% SC<span class="bill-qty">MED · 20 mL</span></div>
          <div class="bill-price">6,00 €</div>
        </div>
      </div>
      <div class="bill-total">
        <div>
          <div style="font-size:var(--text-md);font-weight:var(--weight-medium,500);color:var(--text-secondary)">Total TTC</div>
          <div style="font-size:var(--text-xs);color:var(--text-subtle);margin-top:2px">HT 52,92 € · TVA 10,58 €</div>
        </div>
        <div class="bill-total-amount">63,50 €</div>
      </div>
    </div>

    {# ── Mémo équipe ── #}
    <div class="rp-block">
      <div class="rp-block-head">
        <span class="rp-block-title">Mémo équipe</span>
      </div>
      <textarea class="quad-textarea" rows="2" placeholder="Note interne (non visible propriétaire)…" style="font-size:var(--text-md);min-height:auto;padding:var(--space-2);background:var(--surface-subtle);border:1px solid var(--border-medium);border-radius:var(--radius-md);"></textarea>
    </div>

  </div>

  <div class="rp-foot">
    <div class="rp-foot-row">
      <button class="btn btn-ghost btn-sm" type="button">Pause</button>
      <button class="btn btn-secondary btn-sm" type="button">Plus tard</button>
    </div>
    <button class="btn btn-primary btn-lg" type="button" onclick="closeConsult()" style="width:100%;justify-content:center;">
      Clôturer la consultation
    </button>
  </div>

</aside>
{% endblock %}

{% block drawers %}
  {% include 'clinic/consultation/detail/_drawer_history.html.twig' %}
{% endblock %}

{% block modals %}
  {% include 'clinic/consultation/detail/_modals.html.twig' %}
{% endblock %}
