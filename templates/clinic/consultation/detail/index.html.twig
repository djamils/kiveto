{#
 # Kiveto — templates/clinic/consultation/detail/index.html.twig
 # Consultation cockpit — single-viewport, ported from
 # docs/frontend-theme/vetsaas-layouts/vetos-consultation.html.
 #
 # Variables:
 #   consultation  ConsultationDto   The consultation data
 #}
{% extends 'clinic/base.html.twig' %}

{% block page_title %}Consultation{% endblock %}
{% block show_topbar %}false{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/pages/consultation.css') }}"/>
{% endblock %}

{% block content %}

  {# ── Topbar cockpit ── #}
  <header class="topbar">
    <button class="tb-toggle" id="sidebar-toggle" title="Réduire / agrandir la sidebar" data-action="click->sidebar#toggle">
      <svg class="icon-16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="2" y="2.5" width="12" height="11" rx="1.5"/>
        <path d="M6.5 2.5v11"/>
        <path d="M9 6l1.5 2L9 10" stroke-width="1.3"/>
      </svg>
    </button>
    <div class="crumb">
      <a href="{{ path('clinic_consultations') }}">Consultations</a>
      <svg class="icon-12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 3l5 5-5 5"/></svg>
      <span class="crumb-current">Luna · Lambert</span>
    </div>

    <div class="topbar-right">
      <span class="save-state">
        <span class="live-pulse"></span>
        Brouillon · 4 s
      </span>
      <span class="sep-v"></span>
      <button class="btn btn-ghost btn-sm">
        <svg class="icon-14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6"/><path d="M8 5v3.5l2 1.5"/></svg>
        Historique
      </button>
      <button class="btn btn-secondary btn-sm">
        <svg class="icon-14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 13V3l5 4 5-4v10"/></svg>
        Imprimer
      </button>
    </div>
  </header>

  {# ── Patient bar ── #}
  {% include 'clinic/consultation/detail/_patient_banner.html.twig' %}

  {# ── Summary strip (motif + constantes) ── #}
  {% include 'clinic/consultation/detail/_sidebar_vitals.html.twig' %}

  {# ── SOAP 2×2 grid ── #}
  {% include 'clinic/consultation/detail/_soap_notes.html.twig' %}

{% endblock %}

{% block rpanel %}
<aside class="app-rpanel">

  <div class="rp-head">
    <div class="rp-title">
      <span class="live-pulse"></span>
      Sortie consultation
    </div>
    <div class="rp-sub">Mise à jour automatique au fil du Plan.</div>
  </div>

  <div class="rp-scroll">

    {# ── Ordonnance ── #}
    <div class="rp-block">
      <div class="rp-block-head">
        <span class="rp-block-title">Ordonnance · 2 médicaments</span>
        <button class="btn btn-ghost btn-icon btn-xs" title="Voir / imprimer">
          <svg class="icon-12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 3H5L3 5v8h10V5z"/><path d="M5 8h6M5 10.5h4"/></svg>
        </button>
      </div>

      <div class="rx-warning">
        <svg class="icon-14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 1.5L14.5 13h-13z"/><path d="M8 6v3M8 11h.01" stroke-width="2"/></svg>
        <span><strong style="font-weight:var(--weight-medium)">Pénicilline allergique</strong> — molécules incompatibles filtrées du catalogue.</span>
      </div>

      <div class="rx-list">
        <div class="rx-item has-row-x" data-code="MED-001">
          <div class="rx-item-row">
            <span class="rx-name">Méloxicam 1,5 mg/mL</span>
            <span class="rx-price">14,80 €</span>
            <button class="row-x" title="Retirer ce médicament" aria-label="Retirer ce médicament">
              <svg class="icon-12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3l10 10M13 3L3 13"/></svg>
            </button>
          </div>
          <div class="rx-poso">0,1 mg/kg · 1×/j · 7 j · per os</div>
        </div>

        <div class="rx-item has-row-x" data-code="MED-003">
          <div class="rx-item-row">
            <span class="rx-name">Cartrophen Vet 100 mg/mL</span>
            <span class="rx-price">38,50 €</span>
            <button class="row-x" title="Retirer ce médicament" aria-label="Retirer ce médicament">
              <svg class="icon-12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3l10 10M13 3L3 13"/></svg>
            </button>
          </div>
          <div class="rx-poso">3 mg/kg · SC · 1×/sem · 4 sem</div>
        </div>
      </div>

      <button class="add-row">
        <svg class="icon-12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6"/><path d="M8 5v6M5 8h6"/></svg>
        Ajouter un médicament
      </button>
    </div>

    {# ── Facturation ── #}
    <div class="rp-block">
      <div class="rp-block-head">
        <span class="rp-block-title">Facturation</span>
        <span class="badge b-grey" style="font-size:var(--text-xs)">brouillon</span>
      </div>
      <div style="font-size:var(--text-xs);color:var(--text-subtle);margin-bottom:var(--space-2);line-height:var(--lh-normal)">
        Lignes générées depuis le plan et l'ordonnance · modifiez à la source
      </div>

      <div class="bill-list">
        <div class="bill-row">
          <div class="bill-name">
            Consultation standard
            <span class="bill-qty">CONS · 30 min</span>
          </div>
          <div class="bill-price">42,00 €</div>
        </div>
        <div class="bill-row">
          <div class="bill-name">
            Vaccin CHPLR
            <span class="bill-qty">VAC.CHPLR · ×1</span>
          </div>
          <div class="bill-price">38,00 €</div>
        </div>
        <div class="bill-row">
          <div class="bill-name">
            Radio grasset (×2)
            <span class="bill-qty">IMG.RX · ×2</span>
          </div>
          <div class="bill-price">68,00 €</div>
        </div>
        <div class="bill-row" data-code="MED-001">
          <div class="bill-name">
            Méloxicam
            <span class="bill-qty">MED · 32 mL</span>
          </div>
          <div class="bill-price">14,80 €</div>
        </div>
        <div class="bill-row" data-code="MED-003">
          <div class="bill-name">
            Cartrophen Vet
            <span class="bill-qty">MED · 20 mL</span>
          </div>
          <div class="bill-price">38,50 €</div>
        </div>
      </div>

      <div class="bill-total">
        <div>
          <div style="font-size:var(--text-md);font-weight:var(--weight-medium);color:var(--text-secondary)">Total TTC</div>
          <div style="font-size:var(--text-xs);color:var(--text-subtle);font-family:'DM Mono',monospace;margin-top:2px">HT 167,77 € · TVA 33,55 €</div>
        </div>
        <div class="bill-total-amount">201,30 €</div>
      </div>
    </div>

    {# ── Mémo équipe ── #}
    <div class="rp-block">
      <div class="rp-block-head">
        <span class="rp-block-title">Mémo équipe</span>
      </div>
      <textarea class="quad-textarea" rows="2" placeholder="Note interne (non visible propriétaire)…" style="font-size:var(--text-md);min-height:auto;padding:var(--space-2);background:var(--surface-subtle);border:1px solid var(--border-medium)">Prévoir rappel SMS J+13 pour proposer recontrôle.</textarea>
    </div>

  </div>

  <div class="rp-foot">
    <div class="rp-foot-row">
      <button class="btn btn-ghost btn-sm">Pause</button>
      <button class="btn btn-secondary btn-sm">Plus tard</button>
    </div>
    <button class="btn btn-primary btn-lg">
      Clôturer la consultation
    </button>
  </div>

</aside>
{% endblock %}

{% block modals %}
  {% include 'clinic/consultation/detail/_modals.html.twig' %}
{% endblock %}
