{#
 # Kiveto — templates/clinic/consultation/detail/index.html.twig
 # ─────────────────────────────────────────────────────────────
 # Consultation cockpit, ported from
 # docs/frontend-theme/kiveto-theme/consultation-v-topbar_8.html (and its
 # -vierge / -cloturee variants: a consultation just started, and a closed one
 # read only, with its addenda). No sidebar: the « K » square of the topbar and
 # the arrow of the patient bar are the ways out.
 #
 # Layout: patient bar, then the work area — motif and vitals cards, the S·O·A
 # column and the P column — next to the « Sortie consultation » panel. The
 # page module (assets/js/pages/consultation.js) renders every block from the
 # #consultation-data payload, as the mock-up renders from its demo state, and
 # re-renders from the refreshed state every cockpit endpoint answers with.
 #
 # Variables:
 #   consultation  ConsultationDetailsDTO
 #   patient       array   CockpitPatientBuilder patient payload
 #   owner         array|null
 #   hydration     array   server → JS payload
 #
 # Styles: assets/styles/pages/consultation.css (scoped under `.cs`).
 #}
{% extends 'clinic/base.html.twig' %}

{% block sidebar_mode %}none{% endblock %}
{% block page_body_class %}vt{% endblock %}
{% block title %}{{ consultation.isClosed ? 'Consultation clôturée' : 'Consultation' }} · {{ patient.name }} — Kiveto{% endblock %}

{% set closed = consultation.isClosed %}
{% set ctx = hydration.context %}
{% set x14 = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>' %}
{% set species_emoji = { dog: '🐕', cat: '🐈', rabbit: '🐇', nac: '🐇', bird: '🦜', reptile: '🦎', horse: '🐴', ferret: '🦦', rodent: '🐹' } %}

{% block main %}
<div class="cs{{ closed ? ' cs-closed' }}" data-page="{{ app.request.attributes.get('_route') }}">

  <input type="hidden" id="consultation-csrf" value="{{ csrf_token('consultation_edit') }}">
  {# JSON_HEX_TAG keeps "<" escaped so free text can never break out of the script tag #}
  <script type="application/json" id="consultation-data">{{ hydration|json_encode(constant('JSON_HEX_TAG'))|raw }}</script>

  {# ── Patient bar ── #}
  <div class="pbar">
    <a class="pb-back" href="{{ ctx.urls.flux }}" data-tip="Retour au flux"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5m6-6-6 6 6 6"/></svg></a>
    {% if patient.photoUrl %}
      <div class="pb-photo" style="background:center/cover no-repeat url('{{ patient.photoUrl }}')"></div>
    {% else %}
      <div class="pb-photo">{{ species_emoji[patient.species ?? '']|default('🐾') }}</div>
    {% endif %}
    <div class="pb-id">
      <div class="pb-name">
        {% if ctx.urls.animal %}<a href="{{ ctx.urls.animal }}" style="color:inherit;text-decoration:none" data-tip="Ouvrir le dossier">{{ patient.name }}</a>{% else %}{{ patient.name }}{% endif %}
        {% if patient.sexLabel %}
          {% set female = patient.sexLabel == '♀' %}
          <span class="puce" style="background:{{ female ? '#fdf2f8' : '#eff6ff' }};color:{{ female ? '#be185d' : '#1d4ed8' }}">{{ patient.sexLabel }} {{ patient.sterilized ? (female ? 'stérilisée' : 'castré') : (female ? 'entière' : 'entier') }}</span>
        {% endif %}
        {% if ctx.origin.type == 'urgence' %}<span class="puce" style="background:#fef2f2;color:#b91c1c"><span class="pdot" style="background:#dc2626"></span>Urgence</span>{% endif %}
      </div>
      <div class="pb-meta">
        <span>{{ [patient.speciesLabel, patient.breed, patient.color, patient.ageLabel]|filter(v => v)|join(' · ') ?: 'Espèce non renseignée' }}</span>
        {% if patient.microchip %}<span class="sep-v"></span><span class="mono">{{ patient.microchip }}</span>{% endif %}
        {% if owner %}<span class="sep-v"></span>{% if ctx.urls.client %}<a class="pb-owner" id="pbOwner" href="{{ ctx.urls.client }}">{{ owner.fullName }}</a>{% else %}<span class="pb-owner" id="pbOwner">{{ owner.fullName }}</span>{% endif %}{% endif %}
      </div>
    </div>
    <div class="pb-actions">
      <span class="timer" data-tip="Durée de la consultation"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2M10 2h4"/></svg><span id="timer">00:00</span></span>
      <span class="save" id="save" data-s="{{ closed ? 'closed' : 'idle' }}"><span class="pulse"></span><span id="saveLbl">{{ closed ? 'Clôturée' : 'Brouillon' }}</span></span>
      <span class="sep-v"></span>
      <button type="button" class="pbtn" id="btnHisto" data-menu><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5M12 7v5l4 2"/></svg>Historique</button>
      <button type="button" class="pbtn" id="btnNotes" data-tip="Notes internes de l'équipe"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>Notes<span class="pcnt" id="pcNotes">0</span></button>
      <button type="button" class="pbtn" id="btnFiles" data-tip="Radios, échos, analyses, photos"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>Fichiers<span class="pcnt" id="pcFiles">0</span></button>
      <button type="button" class="pbtn" id="btnDocs"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 9V3h12v6"/><rect x="6" y="14" width="12" height="8" rx="1"/></svg>Documents</button>
      {% if ctx.urls.animal %}
        <a class="pbtn" href="{{ ctx.urls.animal }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h4"/></svg>Dossier complet</a>
      {% endif %}
      <button type="button" class="pbtn ic" id="btnPlus" data-menu data-tip="Plus d'actions"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8"/></svg></button>
    </div>
  </div>

  <div class="cs-wrap">
    <main class="cs-main scr">
      <div class="closed-ban{{ closed ? ' on' }}" id="closedBan"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span id="closedTxt">Consultation clôturée</span><button type="button" id="btnAvenant">Ajouter un avenant</button></div>
      <div class="av-box" id="avBox"><textarea id="avIn" placeholder="Correction ou complément — daté et signé, la consultation d'origine reste intacte"></textarea><div class="av-act"><button type="button" class="btn" id="avAnnuler">Annuler</button><button type="button" class="btn primaire" id="avOk">Signer l'avenant</button></div></div>
      <div id="avList"></div>

      <div class="sumrow">
        <div class="wcard">
          <p class="wcard-t">Motif de consultation<span class="orig" id="motifOrig"></span></p>
          <div class="strip" id="motifStrip"><input class="motif-free" id="motifFree" maxlength="255" placeholder="Préciser le motif en une phrase…" value="{{ consultation.chiefComplaint }}"{{ closed ? ' readonly' }}></div>
        </div>
        <div class="wcard">
          <p class="wcard-t">Constantes &amp; vigilances</p>
          <div class="strip" id="vitStrip"></div>
        </div>
      </div>

      <div class="soap">
        <div class="soap-col">
        <section class="quad">
          <div class="qh"><span class="ql" style="background:#1d4ed8">S</span><span class="qt">Subjectif</span><span class="qs">— motif &amp; symptômes</span>
            <div class="qa"><button type="button" class="qbtn edit-only" id="btnDicter"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v3"/></svg><span>Dicter</span></button></div>
          </div>
          <div class="qb"><textarea class="qta" id="qS" placeholder="Ce que rapporte le propriétaire…" style="min-height:120px"{{ closed ? ' readonly' }}>{{ consultation.subjectiveText }}</textarea></div>
        </section>

        <section class="quad" id="quadO">
          <div class="qh"><span class="ql" style="background:#16a34a">O</span><span class="qt">Objectif</span><span class="qc" id="oCount">—</span><span class="qs">— examen</span>
            <div class="qa edit-only">
              <button type="button" class="qbtn" id="btnRas">Tout RAS</button>
              <div class="dd" id="ddTpl"></div>
            </div>
          </div>
          <div class="qb scr">
            <div id="sysList"></div>
            <div><p class="qlbl" style="margin-bottom:6px">Observations détaillées</p>
            <textarea class="qta" id="qO" placeholder="État général, démarche, comportement, contexte…"{{ closed ? ' readonly' }}>{{ consultation.objectiveObservations }}</textarea></div>
          </div>
        </section>

        <section class="quad" id="quadA">
          <div class="qh"><span class="ql" style="background:#d97706">A</span><span class="qt">Diagnostic</span><span class="qc" id="aCount">0 dx</span>
            <div class="qa edit-only">
              <button type="button" class="qbtn ia" id="btnIA" data-tip="Pistes tirées des anomalies de l'examen et du dossier"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/></svg>Suggérer (IA)</button>
              <button type="button" class="qbtn ic" id="btnAddDx" data-tip="Ajouter un diagnostic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button>
            </div>
          </div>
          <div class="qb scr" id="aBody"></div>
        </section>
        </div>

        <div class="soap-col">
        <section class="quad" id="quadP">
          <div class="qh"><span class="ql" style="background:#4338ca">P</span><span class="qt">Plan</span><span class="qc" id="pCount">0 actions</span>
            <div class="qa edit-only">
              <div class="dd" id="ddPlanTpl"></div>
              <button type="button" class="qbtn ic" id="btnAddPlan" data-tip="Ajouter au plan"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button>
            </div>
          </div>
          <div class="qb scr" id="pBody"></div>
        </section>
        </div>
      </div>
    </main>

    <aside class="rpanel">
      <div class="rp-head">
        <div class="rp-title"><span class="live"></span>Sortie consultation</div>
        <div class="rp-sub">{{ closed ? 'Figée à la clôture — modifications par avenant.' : 'Mise à jour automatique au fil du plan.' }}</div>
      </div>
      <div class="rp-scroll">
        <div>
          <div class="rp-bh"><span class="rp-bt">Ce qui sort de la consultation</span><span class="puce" id="billBadge" style="margin-left:auto">brouillon</span></div>
          <div class="rp-in scr" id="outList"></div>
        </div>
      </div>
      <div class="rp-foot">
        <div class="tot"><div class="l"><b>Total TTC</b><small id="totHt">—</small></div><div class="a" id="totTtc">—</div></div>
        <div class="chk" id="chk"></div>
        <button type="button" class="btn primaire btn-close" id="btnClore">Clôturer la consultation</button>
      </div>
    </aside>
  </div>

  <div class="menu-pop scr" id="menuPop"></div>

  {# ── Drawer: team notes, files, documents ── #}
  <div class="dw-veil" id="dwVeil"></div>
  <aside class="drawer" id="drawer" aria-label="Dossier de la consultation">
    <div class="dw-head">
      <div class="seg dw-tabs" id="dwTabs">
        <button type="button" data-t="notes">Notes <span class="pcnt" id="tcNotes">0</span></button>
        <button type="button" data-t="files">Fichiers <span class="pcnt" id="tcFiles">0</span></button>
        <button type="button" data-t="docs">Documents</button>
      </div>
      <button type="button" class="mclose" id="dwX" aria-label="Fermer">{{ x14|raw }}</button>
    </div>
    <p class="dw-sub" id="dwSub"></p>
    <div class="dw-body scr" id="dwBody"></div>
    <div class="dw-foot" id="dwFoot"></div>
  </aside>

  {# ── Plan line editor ── #}
  <div class="mveil" id="edVeil" role="dialog" aria-modal="true" aria-label="Ligne de plan">
    <div class="mbox ed" style="width:min(660px,95vw)">
      <div class="mhead"><div class="mt" style="flex:1;min-width:0"><b id="edTitre">Ajouter au plan</b><span id="edSous"></span></div>
        <button type="button" class="mclose" id="edX" aria-label="Fermer">{{ x14|raw }}</button></div>
      <div class="mbody">
        <div class="seg ed-kinds" id="edKinds"></div>
        <div id="edPick"></div>
        <div id="edForm"></div>
      </div>
      <div class="mfoot">
        <div class="ed-tot" id="edTot"></div>
        <button type="button" class="btn ghost-danger" id="edSuppr">Retirer</button>
        <button type="button" class="btn" id="edAnnuler">Annuler</button>
        <button type="button" class="btn primaire" id="edOk">Ajouter au plan</button>
      </div>
    </div>
  </div>

  {# ── Paper previews ── #}
  <div class="mveil" id="prevVeil" role="dialog" aria-modal="true" aria-label="Aperçu">
    <div class="mbox prev" style="width:min(720px,95vw)">
      <div class="mhead"><div class="mt" style="flex:1;min-width:0"><b id="prevTitre">Aperçu</b><span id="prevSous">—</span></div>
        <button type="button" class="mclose" id="prevX" aria-label="Fermer">{{ x14|raw }}</button></div>
      <div class="mbody scr"><div class="paper" id="paper"></div></div>
      <div class="mfoot"><button type="button" class="btn" id="prevFermer">Fermer</button><a class="btn" id="prevPdf" target="_blank" rel="noopener" data-turbo="false">Télécharger le PDF</a><button type="button" class="btn primaire" id="prevPrint">Imprimer</button></div>
    </div>
  </div>

  {# ── Closing confirmation (the only confirmation of the page) ── #}
  <div class="mveil" id="cloVeil" role="dialog" aria-modal="true" aria-label="Clôturer la consultation">
    <div class="mbox" style="width:min(500px,95vw)">
      <div class="mhead"><div class="mt"><b>Clôturer la consultation de {{ patient.name }} ?</b><span>Ce qui va se passer :</span></div>
        <button type="button" class="mclose" id="cloX" aria-label="Fermer">{{ x14|raw }}</button></div>
      <div class="mbody"><div class="conseq" id="conseq"></div></div>
      <form class="mfoot" method="post" action="{{ hydration.endpoints.close }}" id="cloForm" data-turbo="false">
        <input type="hidden" name="_token" value="{{ csrf_token('consultation_edit') }}">
        <button type="button" class="btn" id="cloAnnuler">Continuer la consultation</button>
        <button type="submit" class="btn primaire" id="cloOk">Clôturer</button>
      </form>
    </div>
  </div>
</div>
{% endblock %}
