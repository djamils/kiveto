{#
 # Kiveto — templates/clinic/consultation/detail/index.html.twig
 # Consultation cockpit — single-viewport, ported from
 # docs/frontend-theme/vetsaas-layouts/vetos-consultation.html.
 #
 # Variables:
 #   consultation  ConsultationDetailsDTO  The consultation read model
 #   patient       array                   Patient banner payload
 #   owner         array|null              Primary owner payload
 #   hydration     array                   Server → JS payload (see #consultation-data)
 #}
{% extends 'clinic/base.html.twig' %}

{% block page_title %}Consultation{% endblock %}
{% block show_topbar %}false{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/pages/consultation.css') }}"/>
{% endblock %}

{% block content %}

  {# Page-level CSRF token shared by all cockpit mutation endpoints #}
  <input type="hidden" id="consultation-csrf" value="{{ csrf_token('consultation_edit') }}">

  {#
   # Server → JS hydration payload (agenda pattern). Parsed once by
   # assets/js/pages/consultation.js at init(); the same shape comes back from
   # every mutation endpoint.
   #}
  {# JSON_HEX_TAG keeps "<" escaped so free text can never break out of the script tag #}
  <script type="application/json" id="consultation-data">
  {{ hydration|json_encode(constant('JSON_HEX_TAG'))|raw }}
  </script>

  {# ── Topbar cockpit ── #}
  <header class="topbar">
    <button class="tb-toggle" id="sidebar-toggle" title="Réduire / agrandir la sidebar" data-action="click->sidebar#toggle">
      <svg class="icon-16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="2" y="2.5" width="12" height="11" rx="1.5"/>
        <path d="M6.5 2.5v11"/>
        <path d="M9 6l1.5 2L9 10" stroke-width="1.3"/>
      </svg>
    </button>
    <div class="crumb">
      <a href="{{ path('clinic_consultations') }}">Consultations</a>
      <svg class="icon-12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 3l5 5-5 5"/></svg>
      <span class="crumb-current">{{ patient.name }}{% if owner %} · {{ owner.fullName }}{% endif %}</span>
    </div>

    <div class="topbar-right">
      <span class="tb-timer" id="consultation-timer" title="Durée de la consultation">--:--</span>
      <span class="sep-v"></span>
      <span class="save-state" id="save-state" data-state="idle">
        <span class="live-pulse"></span>
        <span class="save-state-label">Brouillon</span>
      </span>
      <span class="sep-v"></span>
      <button class="btn btn-ghost btn-sm" id="btn-history">
        <svg class="icon-14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6"/><path d="M8 5v3.5l2 1.5"/></svg>
        Historique
      </button>
      <button class="btn btn-secondary btn-sm" id="btn-print">
        <svg class="icon-14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 13V3l5 4 5-4v10"/></svg>
        Imprimer
      </button>
    </div>
  </header>

  {% if consultation.isClosed %}
    <div class="closed-banner" id="closed-banner" role="status">
      <svg class="icon-14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="7" width="10" height="6.5" rx="1.5"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"/>
      </svg>
      <span><strong>Consultation clôturée</strong> — lecture seule. Aucune modification n'est possible.</span>
    </div>
  {% endif %}

  {# ── Patient bar ── #}
  {% include 'clinic/consultation/detail/_patient_banner.html.twig' %}

  {# ── Summary strip (motif + constantes) ── #}
  {% include 'clinic/consultation/detail/_sidebar_vitals.html.twig' %}

  {# ── SOAP 2×2 grid ── #}
  {% include 'clinic/consultation/detail/_soap_notes.html.twig' %}

{% endblock %}

{% block rpanel %}
<aside class="app-rpanel">

  <div class="rp-head">
    <div class="rp-title">
      <span class="live-pulse"></span>
      Sortie consultation
    </div>
    <div class="rp-sub">Mise à jour automatique au fil du Plan.</div>
  </div>

  <div class="rp-scroll">

    {# ── Ordonnance ── #}
    <div class="rp-block">
      <div class="rp-block-head">
        <span class="rp-block-title">Ordonnance</span>
        <button class="btn btn-ghost btn-icon btn-xs" id="btn-rx-print" title="Voir / imprimer">
          <svg class="icon-12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 3H5L3 5v8h10V5z"/><path d="M5 8h6M5 10.5h4"/></svg>
        </button>
      </div>

      {# Allergy banner and prescription rows are rendered by assets/js/pages/consultation.js #}
      <div class="rx-warning" style="display:none"></div>

      <div class="rx-list"></div>

      <button class="add-row" id="btn-add-medication">
        <svg class="icon-12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6"/><path d="M8 5v6M5 8h6"/></svg>
        Ajouter un médicament
      </button>
    </div>

    {# ── Facturation ── #}
    <div class="rp-block">
      <div class="rp-block-head">
        <span class="rp-block-title">Facturation</span>
        <span class="badge b-grey" id="bill-status-badge" style="font-size:var(--text-xs)">brouillon</span>
      </div>
      <div style="font-size:var(--text-xs);color:var(--text-subtle);margin-bottom:var(--space-2);line-height:var(--lh-normal)">
        Lignes générées depuis le plan et l'ordonnance · modifiez à la source
      </div>

      {# Billing rows are derived server-side and rendered by the page module #}
      <div class="bill-list"></div>

      <div class="bill-total">
        <div>
          <div style="font-size:var(--text-md);font-weight:var(--weight-medium);color:var(--text-secondary)">Total TTC</div>
          <div style="font-size:var(--text-xs);color:var(--text-subtle);font-family:'DM Mono',monospace;margin-top:2px"></div>
        </div>
        <div class="bill-total-amount">—</div>
      </div>
    </div>

    {# ── Mémo équipe ── #}
    <div class="rp-block">
      <div class="rp-block-head">
        <span class="rp-block-title">Mémo équipe</span>
      </div>
      <textarea class="quad-textarea" id="team-memo" rows="2" placeholder="Note interne (non visible propriétaire)…" style="font-size:var(--text-md);min-height:auto;padding:var(--space-2);background:var(--surface-subtle);border:1px solid var(--border-medium)">{{ consultation.teamMemo }}</textarea>
    </div>

  </div>

  <div class="rp-foot">
    <div class="rp-foot-row">
      <button class="btn btn-ghost btn-sm" id="btn-pause">Pause</button>
      <button class="btn btn-secondary btn-sm" id="btn-later">Plus tard</button>
    </div>
    <button class="btn btn-primary btn-lg" id="btn-close-consultation">
      Clôturer la consultation
    </button>
  </div>

</aside>
{% endblock %}

{% block modals %}
  {% include 'clinic/consultation/detail/_modals.html.twig' %}
{% endblock %}
