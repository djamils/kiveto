{#
 # Motif de consultation · Constantes & vigilances — two cards side by side.
 #
 # Both are filled by assets/js/pages/consultation.js from the hydration
 # payload: the motif chips before "+ ajouter", the vital pills before the
 # compact add button, and the vigilances after the separator. The server
 # renders the shell and the free-text motif, which is a plain field.
 #}
<div class="summary cards-row">

  <div class="strip wcard wcard-motif">
    <div class="wcard-head"><span class="wcard-title">Motif de consultation</span></div>
    <div class="strip-content">
      <button class="chip chip-add">+ ajouter</button>
      <input type="text" class="motif-free" id="motif-free" value="{{ consultation.chiefComplaint }}"
             maxlength="255" placeholder="Préciser le motif en une phrase…"
             {% if consultation.isClosed %}readonly{% endif %}>
    </div>
  </div>

  <div class="strip wcard wcard-etat">
    <div class="wcard-head"><span class="wcard-title">Constantes &amp; vigilances</span></div>
    <div class="vitals-strip">

      {# Vital pills — recorded ones then the empty slots — go before this button #}
      <button class="chip chip-add chip-add-compact" id="constante-add"
              title="Ajouter une constante" aria-label="Ajouter une constante">
        <svg class="icon-12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3v10M3 8h10"/></svg>
      </button>

      <span class="vg-sep" id="vigilance-sep" aria-hidden="true"></span>
      <span class="vg-group is-empty" id="vigilance-list"></span>

    </div>
  </div>

</div>
