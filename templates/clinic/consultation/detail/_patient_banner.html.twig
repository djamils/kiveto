{# Patient bar — single-row compact, cockpit design #}
<div class="patient-bar">
  <div class="pb-row">

    <div class="pb-photo" title="Voir le dossier patient">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-label="Félin">
        <path d="M12 5C8.5 5 5.5 7.5 5 11c-.3 1.5-.5 4 1 6h12c1.5-2 1.3-4.5 1-6C18.5 7.5 15.5 5 12 5z"/>
        <path d="M8 5 6 2M16 5l2-2"/>
        <path d="M9.5 14v.5M14.5 14v.5M10.5 17h3"/>
      </svg>
    </div>

    <div class="pb-id">
      <div class="pb-name">
        Luna
        <span class="badge b-feline" style="font-size:var(--text-xs)">♀ stérilisée</span>
      </div>
      <div class="pb-meta">
        <span>Persan</span>
        <span class="sep-v" aria-hidden="true"></span>
        <span>4 ans</span>
        <span class="sep-v" aria-hidden="true"></span>
        <span class="mono" style="font-size:var(--text-sm)">#PAT-00412</span>
        <span class="sep-v" aria-hidden="true"></span>
        <span class="pb-owner">
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="5.5" r="2.5"/><path d="M2.5 13.5c.5-2.5 3-4 5.5-4s5 1.5 5.5 4"/></svg>
          Mme Dubois
        </span>
      </div>
    </div>

    <div class="pb-warnings">
      <span class="pb-warn">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 1.5L14.5 13h-13z"/><path d="M8 6v3M8 11h.01" stroke-width="2"/></svg>
        Allergie pénicilline
      </span>
      <span class="pb-warn is-info">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M8 5v3.5l2 1.5"/></svg>
        Rappel FeLV à faire
      </span>
    </div>

    <div class="pb-actions">
      <button class="btn btn-ghost btn-sm">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2.5" y="2.5" width="11" height="11" rx="1"/><path d="M5 6h6M5 9h4"/></svg>
        Dossier complet
      </button>
      <button class="btn btn-ghost btn-icon btn-sm" title="Plus d'options" aria-label="Plus d'options">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="3" cy="8" r="1.2"/><circle cx="8" cy="8" r="1.2"/><circle cx="13" cy="8" r="1.2"/></svg>
      </button>
    </div>

  </div>
</div>
