{# Patient bar — single-row compact, ported from layout #}
<div class="patient-bar">
  <div class="pb-row">

    <div class="pb-photo" title="Modifier la photo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-label="{{ patient.speciesLabel|default('Patient') }}">
        <path d="M10 5.172A4 4 0 0 1 14 5l3 1.5"/>
        <path d="M5.5 9.172a3 3 0 0 1 0-4 3 3 0 0 1 4.5 0L11 6.5"/>
        <path d="M19 9.172a3 3 0 0 0 0-4 3 3 0 0 0-4.5 0L13 6.5"/>
        <path d="M4.42 11.247A13.152 13.152 0 0 0 4 14.556C4 18.728 7.582 21 12 21s8-2.272 8-6.444a11.702 11.702 0 0 0-.493-3.309"/>
        <path d="M8 14v.5"/>
        <path d="M16 14v.5"/>
        <path d="M11.25 16.25h1.5L12 17z"/>
      </svg>
    </div>

    <div class="pb-id">
      <div class="pb-name">
        {{ patient.name }}
        {% if patient.isIdentified and patient.sexLabel %}
          <span class="badge b-feline" style="font-size:var(--text-xs)">{{ patient.sexLabel }}{% if patient.sterilized %} stérilisé{% if patient.sexLabel == '♀' %}e{% endif %}{% endif %}</span>
        {% elseif not patient.isIdentified %}
          <span class="badge b-grey" style="font-size:var(--text-xs)">Patient non identifié</span>
        {% endif %}
      </div>
      <div class="pb-meta">
        {% if patient.breed %}<span>{{ patient.breed }}</span>{% elseif patient.speciesLabel %}<span>{{ patient.speciesLabel }}</span>{% endif %}
        {% if patient.ageLabel %}
          <span class="sep-v"></span>
          <span>{{ patient.ageLabel }}</span>
        {% endif %}
        {% if patient.microchip %}
          <span class="sep-v"></span>
          <span class="mono" style="font-size:var(--text-sm)">{{ patient.microchip }}</span>
        {% endif %}
        {% if owner %}
          <span class="sep-v"></span>
          <span class="pb-owner">
            <svg class="icon-12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="5.5" r="2.5"/><path d="M2.5 13.5c.5-2.5 3-4 5.5-4s5 1.5 5.5 4"/></svg>
            {{ owner.fullName }}
          </span>
        {% endif %}
      </div>
    </div>

    {# Medical-alert badges are rendered by assets/js/pages/consultation.js #}
    <div class="pb-warnings"></div>

    <div class="pb-actions">
      <button class="btn btn-ghost btn-sm" id="btn-patient-file"{% if not patient.isIdentified %} disabled{% endif %}>
        <svg class="icon-14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2.5" y="2.5" width="11" height="11" rx="1"/><path d="M5 6h6M5 9h4"/></svg>
        Dossier complet
      </button>
      <button class="btn btn-ghost btn-icon btn-sm" id="btn-patient-more" title="Plus">
        <svg class="icon-14" viewBox="0 0 16 16" fill="currentColor"><circle cx="3" cy="8" r="1.2"/><circle cx="8" cy="8" r="1.2"/><circle cx="13" cy="8" r="1.2"/></svg>
      </button>
    </div>

  </div>
</div>
