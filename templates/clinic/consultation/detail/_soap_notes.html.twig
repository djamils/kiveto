{# SOAP grid 2×2 — S Subjectif · O Objectif · A Analyse · P Plan #}
<div class="soap-grid">

  {# ── S — Subjectif ── #}
  <div class="quad" data-letter="S">
    <div class="quad-head">
      <span class="quad-letter">S</span>
      <span class="quad-title">Subjectif</span>
      <span class="quad-sub">— motif &amp; symptômes</span>
      <span class="quad-action" title="Dicter">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="6" y="2" width="4" height="8" rx="2"/><path d="M3.5 8c0 2.5 2 4.5 4.5 4.5s4.5-2 4.5-4.5M8 12.5v2"/></svg>
        dicter
      </span>
    </div>
    <div class="quad-body">
      <textarea class="quad-textarea" placeholder="Ce que rapporte le propriétaire…">Propriétaire signale une légère perte d'appétit depuis 2 jours. Luna est moins active. Pas de vomissements identifiés.</textarea>
    </div>
  </div>

  {# ── O — Objectif ── #}
  <div class="quad" data-letter="O">
    <div class="quad-head">
      <span class="quad-letter">O</span>
      <span class="quad-title">Objectif</span>
      <span class="quad-sub">— observations cliniques</span>
      <span class="quad-action">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h10M8 3v10"/></svg>
        tout RAS
      </span>
    </div>
    <div class="quad-body">
      <div class="exam-grid">
        <div class="exam-cell is-normal"><span class="exam-name">Cardiovasculaire</span><span class="exam-status">RAS</span></div>
        <div class="exam-cell is-normal"><span class="exam-name">Respiratoire</span><span class="exam-status">RAS</span></div>
        <div class="exam-cell is-normal"><span class="exam-name">Digestif</span><span class="exam-status">RAS</span></div>
        <div class="exam-cell is-normal"><span class="exam-name">Urogénital</span><span class="exam-status">RAS</span></div>
        <div class="exam-cell is-normal"><span class="exam-name">Locomoteur</span><span class="exam-status">RAS</span></div>
        <div class="exam-cell is-normal"><span class="exam-name">Neurologique</span><span class="exam-status">RAS</span></div>
        <div class="exam-cell is-normal"><span class="exam-name">Cutané</span><span class="exam-status">RAS</span></div>
        <div class="exam-cell is-untested"><span class="exam-name">Ophtalmo</span><span class="exam-status">— non testé</span></div>
      </div>
      <textarea class="quad-textarea" placeholder="Observations détaillées…" style="min-height:50px"></textarea>
    </div>
  </div>

  {# ── A — Analyse & Diagnostic ── #}
  <div class="quad" data-letter="A">
    <div class="quad-head">
      <span class="quad-letter">A</span>
      <span class="quad-title">Analyse &amp; Diagnostic</span>
      <span class="quad-sub">— différentiel</span>
      <span class="quad-action" title="Suggestions IA">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 2v3M8 11v3M2 8h3M11 8h3M3.8 3.8l2 2M10.2 10.2l2 2M3.8 12.2l2-2M10.2 5.8l2-2"/></svg>
        suggérer
      </span>
    </div>
    <div class="quad-body">
      <div class="dx-list">
        <div class="dx-item" data-confidence="probable">
          <span class="dx-code">M.DIG.05</span>
          <span class="dx-label">Gastro-entérite aiguë</span>
          <span class="dx-confidence" data-confidence="probable">probable</span>
          <button class="dx-remove" type="button" title="Retirer" aria-label="Retirer ce diagnostic">
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3l10 10M13 3L3 13"/></svg>
          </button>
        </div>
      </div>
      <button class="add-row" type="button">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M8 5v6M5 8h6"/></svg>
        Ajouter un diagnostic
      </button>
    </div>
  </div>

  {# ── P — Plan ── #}
  <div class="quad" data-letter="P">
    <div class="quad-head">
      <span class="quad-letter">P</span>
      <span class="quad-title">Plan</span>
      <span class="quad-sub">— traitement &amp; suivi</span>
      <span class="quad-action">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 4.5h10M3 8h10M3 11.5h6"/></svg>
        templates
      </span>
    </div>
    <div class="quad-body">
      <div class="plan-list">
        <div class="plan-item has-row-x is-done">
          <span class="plan-checkbox">
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="white" stroke-width="2" aria-hidden="true"><path d="M3.5 8l3 3 6-6"/></svg>
          </span>
          <span class="plan-text">Vaccination FeLV sous-cutanée</span>
          <span class="plan-meta">facturé</span>
          <button class="row-x" type="button" title="Retirer" aria-label="Retirer du plan">
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3l10 10M13 3L3 13"/></svg>
          </button>
        </div>
        <div class="plan-item has-row-x">
          <span class="plan-checkbox"></span>
          <span class="plan-text">Smecta 3 j + régime digestible 5 j</span>
          <span class="plan-meta">→ ordonnance</span>
          <button class="row-x" type="button" title="Retirer" aria-label="Retirer du plan">
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3l10 10M13 3L3 13"/></svg>
          </button>
        </div>
        <div class="plan-item has-row-x">
          <span class="plan-checkbox"></span>
          <span class="plan-text">Recontrôle J+7 si persistance</span>
          <span class="plan-meta">RDV</span>
          <button class="row-x" type="button" title="Retirer" aria-label="Retirer du plan">
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3l10 10M13 3L3 13"/></svg>
          </button>
        </div>
      </div>
      <button class="add-row" type="button">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M8 5v6M5 8h6"/></svg>
        Ajouter une action
      </button>
    </div>
  </div>

</div>
