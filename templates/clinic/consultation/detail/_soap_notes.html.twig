{#
 # SOAP grid 2×2 — S Subjectif · O Objectif · A Diagnostic · P Plan.
 # Textareas and lists are filled client-side from the hydration payload.
 #}
<div class="soap-grid">

  {# ── S — Subjectif ── #}
  <div class="quad" data-letter="S">
    <div class="quad-head">
      <span class="quad-letter">S</span>
      <span class="quad-title">Subjectif</span>
      <span class="quad-sub">— motif &amp; symptômes</span>
      <span class="quad-action" id="qS-dictate" title="Dicter">
        <svg class="icon-12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="6" y="2" width="4" height="8" rx="2"/><path d="M3.5 8c0 2.5 2 4.5 4.5 4.5s4.5-2 4.5-4.5M8 12.5v2"/></svg>
        dicter
      </span>
    </div>
    <div class="quad-body">
      <textarea class="quad-textarea" id="q-subjective" placeholder="Ce que rapporte le propriétaire…"></textarea>
    </div>
  </div>

  {# ── O — Objectif (examen clinique) ── #}
  <div class="quad" data-letter="O">
    <div class="quad-head">
      <span class="quad-letter">O</span>
      <span class="quad-title">Objectif</span>
      <span class="quad-sub">— examen clinique</span>
      <div class="quad-actions">
        <button class="quad-action-btn" id="qO-ras-all">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8l3 3 7-7"/></svg>
          Tout RAS
        </button>
        <button class="template-btn" id="qO-template-btn">
          <span class="template-btn-label">Template :</span>
          <span class="template-btn-name" id="qO-template-btn-name">Chien standard</span>
          <svg class="template-btn-chev" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 6l3 3 3-3"/></svg>
        </button>
      </div>
    </div>

    <div class="quad-body">
      <div class="listF" id="qO-listF"></div>
      <div class="observations-block">
        <span class="observations-label">Observations détaillées</span>
        <textarea class="quad-textarea" id="q-objective" placeholder="État général, démarche, comportement, contexte, observations libres du vet…"></textarea>
      </div>
    </div>
  </div>

  {# ── A — Diagnostic ── #}
  <div class="quad" data-letter="A">
    <div class="quad-head">
      <span class="quad-letter">A</span>
      <span class="quad-title">Diagnostic</span>
      <span class="quad-count" id="qA-dx-count">0 dx</span>
      <span class="quad-sub">— différentiel</span>
      <div class="quad-actions">
        <button class="suggest-btn" id="qA-suggest-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>
          Suggérer (IA)
        </button>
        <button class="header-add-btn" id="qA-add-btn" type="button" title="Ajouter des diagnostics" aria-label="Ajouter des diagnostics">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3v10M3 8h10"/></svg>
        </button>
      </div>
    </div>

    <div class="quad-body">
      <div class="dx-list" id="qA-dx-list"></div>
    </div>
  </div>

  {# ── P — Plan ── #}
  <div class="quad" data-letter="P">
    <div class="quad-head">
      <span class="quad-letter">P</span>
      <span class="quad-title">Plan</span>
      <span class="quad-count" id="qP-plan-count">0 actions</span>
      <span class="quad-sub">— traitement &amp; suivi</span>
      <div class="quad-actions">
        <button class="template-btn" id="qP-template-btn">
          <svg class="template-btn-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 4.5h10M3 8h10M3 11.5h6"/></svg>
          Template
          <svg class="template-btn-chev" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 6l3 3 3-3"/></svg>
        </button>
        <button class="header-add-btn" id="qP-add-btn" type="button" title="Ajouter des actions" aria-label="Ajouter des actions">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3v10M3 8h10"/></svg>
        </button>
      </div>
    </div>

    <div class="quad-body">
      <div class="plan-list" id="qP-plan-list"></div>
    </div>
  </div>

</div>
