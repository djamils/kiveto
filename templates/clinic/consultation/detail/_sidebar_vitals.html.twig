{# Summary strip — motif chips + constantes vitales (ported from layout) #}
<div class="summary">

  <div class="strip">
    <span class="strip-label">Motif</span>
    <div class="strip-content">
      {# Motif chips are inserted before "+ ajouter" by assets/js/pages/consultation.js #}
      <button class="chip chip-add">+ ajouter</button>
      <span class="strip-text" style="margin-left:var(--space-2)">{{ consultation.chiefComplaint }}</span>
    </div>
  </div>

  <div class="strip">
    <span class="strip-label">Constantes</span>
    <div class="vitals-strip">

      {# Vital pills are inserted before "+ ajouter" by assets/js/pages/consultation.js #}
      <button class="chip chip-add">
        <svg class="icon-12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3v10M3 8h10"/></svg>
        ajouter une constante
      </button>

      <span class="strip-text" style="margin-left:auto;color:var(--text-subtle);font-size:var(--text-sm)"></span>

    </div>
  </div>

</div>
