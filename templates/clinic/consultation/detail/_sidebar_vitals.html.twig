{#
 # Summary strip — motif chips + constantes vitales.
 # Both strips are rendered client-side from the hydration payload.
 #}
<div class="summary">

  <div class="strip">
    <span class="strip-label">Motif</span>
    <div class="strip-content">
      {#
       # Chips are re-rendered on every save; the free-text input lives outside
       # that container so a repaint never destroys what is being typed.
       #}
      <span id="motif-strip"></span>
      <input class="strip-text" id="motif-free-text" autocomplete="off"
             placeholder="Précisions sur le motif…"
             value="{{ consultation.chiefComplaint }}">
    </div>
  </div>

  <div class="strip">
    <span class="strip-label">Constantes</span>
    <div class="vitals-strip" id="vitals-strip"></div>
  </div>

</div>
