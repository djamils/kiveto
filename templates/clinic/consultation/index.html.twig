{#
 # Kiveto — templates/clinic/consultation/index.html.twig
 # ─────────────────────────────────────────────────────
 # Consultations — the clinic's register of consultations. Ported from
 # docs/frontend-theme/kiveto-theme/consultations-v-topbar.html: page header
 # (counters of what asks for an action, exports menu, « Nouvelle
 # consultation »), filter bar, the table and its pager, the bulk bar, the
 # reading sheet of one consultation and the new-consultation window.
 #
 # The table, the sheet and the window are drawn by the page module from the
 # payload; filters and pages are asked from clinic_consultations_search, a
 # sheet from clinic_consultation_sheet. Taking a waiting patient in charge
 # posts #startForm to clinic_consultation_start_from_admission.
 #
 # Variables:
 #   payload  App\Presentation\Clinic\ViewModel\Consultation\ConsultationRegisterPageBuilder::page()
 #
 # Behaviour: assets/js/pages/consultations.js — styles: assets/styles/pages/consultations.css
 #}
{% extends 'clinic/base.html.twig' %}

{% block page_body_class %}vt{% endblock %}
{% block title %}Consultations{% endblock %}

{% set _x = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>' %}
{% set _vide = payload.register.counts.recorded == 0 %}

{% block main %}
<div class="reg cons{{ _vide ? ' co-vide' }}" data-page="{{ app.request.attributes.get('_route') }}" data-payload="{{ payload|json_encode }}">

  <div class="pagehead">
    <h1>Consultations<small id="phSub">—</small></h1>
    <div class="phk" id="phk"></div>
    <div class="right">
      <div class="hmenu" id="hmenu">
        <button type="button" class="btn" id="hmenuBtn" data-tip="Exports" aria-label="Exports"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></svg></button>
        <div class="dd-menu">
          <button type="button" class="dd-it" disabled data-tip="L'export du registre des actes arrive bientôt"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m17 8-5-5-5 5M12 3v12"/></svg><span>Exporter la liste<small>CSV, avec la période et les filtres en cours — bientôt disponible</small></span></button>
          <button type="button" class="dd-it" disabled data-tip="Les rapports d'activité arrivent bientôt"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m7 14 4-4 4 4 5-5"/></svg><span>Activité par praticien<small>Nombre d'actes et chiffre d'affaires du mois — bientôt disponible</small></span></button>
        </div>
      </div>
      <button type="button" class="btn primaire" id="btnNew"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Nouvelle consultation</button>
    </div>
  </div>

  <div class="cfil" id="cfil"{% if _vide %} style="display:none"{% endif %}>
    <div class="crech">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" placeholder="Animal, propriétaire, motif, diagnostic…" autocomplete="off" value="{{ payload.filters.q }}">
    </div>
    <span class="lblf">Filtres</span>
    <div id="fdd" style="display:flex;gap:8px;align-items:center"></div>
  </div>

  <main class="czone{{ payload.sheet ? ' ouvert' }}" id="czone">
    <div class="ctw">
      <div class="cscroll scr"><table>
        <thead id="thead"></thead>
        <tbody id="tbody"></tbody>
      </table><div id="cempty"></div></div>
      <div class="cfoot" id="cfoot"></div>
    </div>
    <aside class="fiche" id="fiche"><div class="fi-in">
      <div class="fi-head" id="fiHead"></div>
      <div class="fi-body scr" id="fiBody"></div>
      <div class="fi-foot" id="fiFoot"></div>
    </div></aside>
  </main>

  <div class="bulk" id="bulk" role="toolbar" aria-label="Actions groupées">
    <span class="bn" id="bulkN">0</span><span id="bulkL">sélectionnées</span>
    <span class="bdiv"></span>
    <button type="button" id="bkCr" disabled data-tip="L'envoi des comptes rendus par e-mail arrive bientôt"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>Envoyer les comptes rendus</button>
    <button type="button" id="bkPdf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5M12 15V3"/></svg>Télécharger les PDF</button>
    <span class="bdiv"></span>
    <button type="button" id="bkX" data-tip="Désélectionner" aria-label="Désélectionner"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
  </div>

  {# Nouvelle consultation #}
  <div class="mveil" id="mNew"><div class="mbox" style="width:min(600px,94vw)">
    <div class="mhead"><div class="mt"><b>Nouvelle consultation</b><span>Pour un patient sur place, ou hors flux (visite, téléconsultation)</span></div><button type="button" class="mclose" data-close aria-label="Fermer">{{ _x|raw }}</button></div>
    <div class="mbody">
      <div class="crech" style="max-width:none"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input id="nwQ" placeholder="Animal, propriétaire, téléphone, puce…" autocomplete="off"></div>
      <div class="clist scr" id="nwList"></div>
    </div>
  </div></div>

  {# Taking a waiting patient in charge opens their consultation #}
  <form id="startForm" method="post" hidden>
    <input type="hidden" name="_token" value="{{ payload.token }}">
  </form>
</div>
{% endblock %}
