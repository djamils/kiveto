{#
 # Kiveto — templates/clinic/search/_consultations_results.html.twig
 # ──────────────────────────────────────────────────────────────────
 # « Hors flux » rows of the consultations register's « Nouvelle
 # consultation » window (consultations-v-topbar `.citem`). A consultation
 # always belongs to a visit: the row opens the flow board's arrival window
 # with the animal already searched.
 #}
{%- set _emoji = { dog: '🐕', cat: '🐈', nac: '🐇' } -%}
{%- set _species = { dog: 'Chien', cat: 'Chat', nac: 'NAC', other: 'Animal' } -%}
{%- for bucket in buckets -%}
  {%- for hit in bucket.hits|slice(0, 6) -%}
    {%- set _sp = hit.metadata.species ?? 'other' -%}
    {%- set _parts = (hit.subtitle ?? '')|split(' · ') -%}
    {%- set _breed = _parts|length > 1 ? _parts|slice(1)|join(' · ') : (_species[_sp] ?? 'Animal') -%}
    {%- set _owner = hit.context and hit.context != 'Sans propriétaire' ? hit.context : 'Sans propriétaire' -%}
    <a class="citem" href="{{ path('clinic_admission_queue', { arrivee: 1, patient: hit.title }) }}" data-id="{{ hit.resourceId }}"><span class="h"></span><span class="e">{{ _emoji[_sp] ?? '🐾' }}</span><span class="lt"><b>{{ hit.title }}</b><span>{{ _breed }} · {{ _owner }}</span></span><span class="go">Ouvrir →</span></a>
  {%- endfor -%}
{%- endfor -%}
