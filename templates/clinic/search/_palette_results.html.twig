{#
 # Results of the shell search palette (« Centre de recherche »), one section
 # per bucket, in the v-topbar mock-up markup (.srch-sec / .srch-res).
 #}
{%- set _icons = {
  client: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
  animal: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="20" cy="16" r="2"/><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/></svg>',
} -%}
{%- set _heads = {
  client: '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/></svg>',
  animal: _icons.animal|replace({'width="15" height="15"': 'width="13" height="13"'}),
} -%}
{%- set _tones = { client: 'brand', animal: 'vert' } -%}
{%- set _types = { client: 'Client', animal: 'Animal' } -%}
{%- set _labels = { client: 'Clients', animal: 'Animaux' } -%}
{%- set _hasHits = false -%}
{%- for bucket in buckets -%}{%- if bucket.hits is not empty -%}{%- set _hasHits = true -%}{%- endif -%}{%- endfor -%}
{%- if _hasHits -%}
  {%- for bucket in buckets -%}
    {%- if bucket.hits is not empty -%}
      <div class="srch-sec" data-bucket-type="{{ bucket.type }}">
        <div class="srch-sec-head">{{ (_heads[bucket.type] ?? '')|raw }}<span>{{ _labels[bucket.type] ?? bucket.type }}</span></div>
        {%- for hit in bucket.hits -%}
          <a class="srch-res" href="{{ path(routeMap[bucket.type], {id: hit.resourceId}) }}">
            <span class="srch-ico {{ _tones[bucket.type] ?? 'brand' }}">{{ (_icons[bucket.type] ?? '')|raw }}</span>
            <span class="rb">
              <span class="rt">{{ hit.title }}</span>
              {%- set _sub = [hit.subtitle, hit.context and hit.context != 'Sans propriétaire' ? hit.context : null]|filter(v => v) -%}
              {%- if _sub is not empty -%}<span class="rs">{{ _sub|join(' · ') }}</span>{%- endif -%}
            </span>
            <span class="srch-type">{{ _types[bucket.type] ?? bucket.type }}</span>
          </a>
        {%- endfor -%}
        {%- if bucket.hasMore -%}
          <div class="srch-more">D'autres résultats existent — affinez la recherche.</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  <div class="srch-empty on">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m13.5 8.5-5 5"/><path d="m8.5 8.5 5 5"/><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <b>Aucun résultat</b>
    <span>Essayez une autre recherche ou changez de filtre.</span>
  </div>
{%- endif -%}
