{#
 # Kiveto — templates/clinic/prescription/list/index.html.twig
 # ──────────────────────────────────────────────────────────
 # Ordonnances — the clinic's prescriptions.
 #
 # Filtering, sorting and pagination are server-side: every control is a link
 # carrying the current query string, so Turbo navigation keeps the URL
 # shareable and the back button meaningful.
 #
 # Variables:
 #   prescriptions  PrescriptionListRow[]   One page of rows
 #   statuses       PrescriptionStatus[]    Every status, for the filter menu
 #   now            DateTimeImmutable       Clock, to decide what has expired
 #   pagination     array                   Page view model
 #   filters        array                   Active filter values
 #   sort, direction string                 Active sort
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}Ordonnances{% endblock %}
{% block show_topbar %}false{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('styles/pages/prescription.css') }}"/>
{% endblock %}

{% set PERIOD_LABELS = { 'today': "Aujourd'hui", 'week': 'Cette semaine', 'month': 'Ce mois', 'year': 'Cette année' } %}
{% set SPECIES_ICONS = { 'dog': '🐕', 'cat': '🐈', 'nac': '🐇', 'other': '🐾' } %}
{% set MONTHS = ['janv', 'févr', 'mars', 'avr', 'mai', 'juin', 'juil', 'août', 'sept', 'oct', 'nov', 'déc'] %}

{# Current query string, rebuilt for every link so filters compose #}
{% set qs = {} %}
{% if filters.q %}{% set qs = qs|merge({ q: filters.q }) %}{% endif %}
{% if filters.period %}{% set qs = qs|merge({ period: filters.period }) %}{% endif %}
{% if filters.status %}{% set qs = qs|merge({ status: filters.status }) %}{% endif %}
{% if filters.controlled %}{% set qs = qs|merge({ controlled: 1 }) %}{% endif %}
{% if sort != 'date' or direction != 'desc' %}{% set qs = qs|merge({ sort: sort, dir: direction }) %}{% endif %}
{% if pagination.limit != 25 %}{% set qs = qs|merge({ per_page: pagination.limit }) %}{% endif %}

{# Sortable column header: clicking flips the direction, or starts a new sort #}
{% macro sortHead(column, label, cssClass, sort, direction, qs) %}
  {% set active = sort == column %}
  {% set nextDir = active and direction == 'desc' ? 'asc' : (active ? 'desc' : (column in ['status', 'patient', 'number'] ? 'asc' : 'desc')) %}
  <th class="{{ cssClass }} sortable{{ active ? (direction == 'asc' ? ' is-sorted-asc' : ' is-sorted-desc') : '' }}">
    <a href="{{ path('clinic_prescriptions', qs|merge({ sort: column, dir: nextDir })) }}">
      {{ label }} <span class="sort-icon">▼</span>
    </a>
  </th>
{% endmacro %}

{% block content %}
<div class="pl-root">

  {# ── Topbar ── #}
  <header class="topbar">
    <button class="tb-toggle show-mobile" type="button" aria-label="Menu" data-action="click->sidebar#toggle">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
    <div class="tb-title">
      <span class="topbar-icon" aria-hidden="true"><i data-lucide="pill"></i></span>
      <h1 class="topbar-title">Ordonnances</h1>
      <span class="tb-title-count">{{ pagination.totalItems }}</span>
    </div>
    <div class="tb-spacer"></div>
    <form class="tb-search" method="GET" action="{{ path('clinic_prescriptions') }}" role="search"
          data-turbo-frame="prescriptions-results" data-live-search>
      <svg class="tb-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" name="q" id="search-input" value="{{ filters.q }}"
             placeholder="Rechercher un numéro, un patient, un propriétaire…" autocomplete="off">
      {% for key, value in qs %}
        {% if key != 'q' %}
          {% if value is iterable %}
            {% for item in value %}<input type="hidden" name="{{ key }}[]" value="{{ item }}" data-search-carry>{% endfor %}
          {% else %}
            <input type="hidden" name="{{ key }}" value="{{ value }}" data-search-carry>
          {% endif %}
        {% endif %}
      {% endfor %}
    </form>
    <a class="btn btn-primary btn-sm" href="{{ path('clinic_consultations') }}"
       title="Une ordonnance naît d'une consultation">
      <i data-lucide="plus"></i>
      Depuis une consultation
    </a>
  </header>

  <turbo-frame id="prescriptions-results" data-turbo-action="advance">

  {# Read back by the page module to keep the topbar counter in sync #}
  <span hidden data-results-total>{{ pagination.totalItems }}</span>

  {# ── Filters ── #}
  <section class="filters">
    <span class="filter-label">Filtres</span>

    {% if filters.period %}
      <span class="filter-chip">
        <span class="chip-key">Période :</span>
        <span>{{ PERIOD_LABELS[filters.period] }}</span>
        <a class="chip-x" href="{{ path('clinic_prescriptions', qs|merge({ period: null })) }}" aria-label="Retirer">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 3l10 10M13 3L3 13"/></svg>
        </a>
      </span>
    {% endif %}
    {% for value in filters.status %}
      {% set label = value %}
      {% for status in statuses %}{% if status.value == value %}{% set label = status.label %}{% endif %}{% endfor %}
      <span class="filter-chip">
        <span class="chip-key">Statut :</span>
        <span>{{ label }}</span>
        <a class="chip-x" href="{{ path('clinic_prescriptions', qs|merge({ status: filters.status|filter(v => v != value) })) }}" aria-label="Retirer">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 3l10 10M13 3L3 13"/></svg>
        </a>
      </span>
    {% endfor %}
    {% if filters.controlled %}
      <span class="filter-chip is-controlled">
        <span class="chip-key">Substances :</span>
        <span>Contrôlées</span>
        <a class="chip-x" href="{{ path('clinic_prescriptions', qs|merge({ controlled: null })) }}" aria-label="Retirer">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 3l10 10M13 3L3 13"/></svg>
        </a>
      </span>
    {% endif %}

    {# Période #}
    <span class="filter-add-wrap">
      <button class="filter-add{{ filters.period ? ' is-active' : '' }}" type="button" data-filter-toggle="period">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Période
      </button>
      <div class="filter-menu" data-filter-menu="period">
        <div class="filter-menu-title">Période</div>
        {% for value, label in PERIOD_LABELS %}
          <a class="filter-menu-item{{ filters.period == value ? ' is-checked' : '' }}"
             href="{{ path('clinic_prescriptions', qs|merge({ period: filters.period == value ? null : value })) }}">
            <span style="flex:1">{{ label }}</span>
            <svg class="check-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8l3 3 7-7"/></svg>
          </a>
        {% endfor %}
      </div>
    </span>

    {# Statut #}
    <span class="filter-add-wrap">
      <button class="filter-add{{ filters.status ? ' is-active' : '' }}" type="button" data-filter-toggle="status">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Statut
      </button>
      <div class="filter-menu" data-filter-menu="status">
        <div class="filter-menu-title">Statut</div>
        {% for status in statuses %}
          {% set checked = status.value in filters.status %}
          <a class="filter-menu-item{{ checked ? ' is-checked' : '' }}"
             href="{{ path('clinic_prescriptions', qs|merge({ status: checked ? filters.status|filter(v => v != status.value) : filters.status|merge([status.value]) })) }}">
            <span style="flex:1">{{ status.label }}</span>
            <svg class="check-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8l3 3 7-7"/></svg>
          </a>
        {% endfor %}
      </div>
    </span>

    {# Substances contrôlées #}
    <a class="filter-add{{ filters.controlled ? ' is-active' : '' }}"
       href="{{ path('clinic_prescriptions', qs|merge({ controlled: filters.controlled ? null : 1 })) }}">
      <i data-lucide="shield-alert"></i>
      Substances contrôlées
    </a>

    {% if filters.q or filters.period or filters.status or filters.controlled %}
      <a class="filter-clear" href="{{ path('clinic_prescriptions') }}">Tout effacer</a>
    {% endif %}
  </section>

  {# ── Table ── #}
  <section class="table-wrapper">
    {% if prescriptions|length > 0 %}
      <table class="prescription-table">
        <thead>
          <tr>
            {{ _self.sortHead('date', 'Date', 'col-date', sort, direction, qs) }}
            {{ _self.sortHead('number', 'Numéro', 'col-number', sort, direction, qs) }}
            {{ _self.sortHead('patient', 'Patient', 'col-patient', sort, direction, qs) }}
            <th class="col-owner">Propriétaire</th>
            <th class="col-prescriber">Prescripteur</th>
            <th class="col-meds">Médicaments</th>
            {{ _self.sortHead('status', 'Statut', 'col-status', sort, direction, qs) }}
            <th class="col-validity">Validité</th>
            <th class="col-actions"></th>
          </tr>
        </thead>
        <tbody>
          {% for p in prescriptions %}
            {% set shownAt = p.issuedAt ?? p.createdAt %}
            {% set localDay = shownAt|date('Y-m-d', 'Europe/Paris') %}
            {% set days = date('today', 'Europe/Paris').diff(date(localDay ~ ' 00:00:00', 'Europe/Paris')).days %}
            {% if days == 0 %}
              {% set datePrimary = "Aujourd'hui" %}
            {% elseif days == 1 %}
              {% set datePrimary = 'Hier' %}
            {% elseif days < 7 %}
              {% set datePrimary = 'il y a ' ~ days ~ ' j' %}
            {% else %}
              {% set datePrimary = shownAt|date('d', 'Europe/Paris') ~ ' ' ~ MONTHS[shownAt|date('n', 'Europe/Paris') - 1] %}
            {% endif %}
            {% set expired = p.isExpiredAt(now) %}
            <tr data-url="{{ path('clinic_prescription_details', { prescriptionId: p.id }) }}">
              <td class="col-date">
                <div class="cell-date">
                  <span class="cell-date-primary">{{ datePrimary }}</span>
                  <span class="cell-date-secondary">{{ shownAt|date('H:i', 'Europe/Paris') }}</span>
                </div>
              </td>
              <td class="col-number"><span class="cell-number">{{ p.number ?? '—' }}</span></td>
              <td class="col-patient">
                <div class="cell-patient">
                  <div class="patient-avatar">{{ SPECIES_ICONS[p.patientSpecies] ?? '🐾' }}</div>
                  <span class="patient-name">{{ p.patientName }}</span>
                </div>
              </td>
              <td class="col-owner"><span class="cell-owner">{{ p.ownerName }}</span></td>
              <td class="col-prescriber"><span class="cell-owner">{{ p.prescriberName }}</span></td>
              <td class="col-meds">
                <span class="med-count">{{ p.lineCount }}</span>
                {% if p.carriesControlledSubstance %}
                  <span class="controlled-badge" title="Contient une substance contrôlée">
                    <i data-lucide="shield-alert"></i>
                  </span>
                {% endif %}
              </td>
              <td class="col-status">
                {% if expired %}
                  <span class="status-badge status-EXPIRED"><span class="status-dot"></span>Expirée</span>
                {% else %}
                  <span class="status-badge status-{{ p.status }}">
                    <span class="status-dot"></span>
                    {% for status in statuses %}{% if status.value == p.status %}{{ status.label }}{% endif %}{% endfor %}
                  </span>
                {% endif %}
              </td>
              <td class="col-validity">
                {% if p.validUntil %}
                  <span class="cell-validity{{ expired ? ' is-expired' : '' }}">
                    jusqu'au {{ p.validUntil|date('d/m/Y', 'Europe/Paris') }}
                  </span>
                  {% if p.renewalsRemaining > 0 %}
                    <span class="renewal-badge">{{ p.renewalsRemaining }} renouv.</span>
                  {% endif %}
                {% else %}
                  <span class="cell-validity">—</span>
                {% endif %}
              </td>
              <td class="col-actions" style="position:relative">
                <button class="row-actions-btn" type="button" data-row-menu-toggle title="Actions" aria-label="Actions">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                </button>
                <div class="row-menu" data-row-menu>
                  <a class="row-menu-item" data-turbo-frame="_top"
                     href="{{ path('clinic_prescription_details', { prescriptionId: p.id }) }}">
                    <i data-lucide="external-link"></i> Ouvrir
                  </a>
                  {% if p.number %}
                    <a class="row-menu-item" data-turbo-frame="_top" target="_blank" rel="noopener"
                       href="{{ path('clinic_prescription_print', { prescriptionId: p.id }) }}">
                      <i data-lucide="printer"></i> Imprimer
                    </a>
                  {% endif %}
                  <div class="row-menu-sep"></div>
                  <a class="row-menu-item" data-turbo-frame="_top"
                     href="{{ path('clinic_consultation_details', { id: p.consultationId }) }}">
                    <i data-lucide="stethoscope"></i> Voir la consultation
                  </a>
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <div class="empty">
        <div class="empty-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h14a1 1 0 011 1v17l-3-2-3 2-3-2-3 2-3-2V4a1 1 0 011-1z"/><path d="M9 9h6M9 13h6"/></svg>
        </div>
        <div class="empty-title">Aucune ordonnance</div>
        <div class="empty-sub">Les ordonnances naissent d'une consultation, depuis le bloc Ordonnance du cockpit.</div>
        <a class="btn btn-primary btn-sm" data-turbo-frame="_top"
           href="{{ path('clinic_consultations') }}" style="margin-top:12px">
          <i data-lucide="arrow-right"></i>
          Aller aux consultations
        </a>
      </div>
    {% endif %}
  </section>

  {# ── Pagination ── #}
  <footer class="pagination">
    <span class="pag-info">
      {% if pagination.totalItems == 0 %}
        Aucun résultat
      {% else %}
        {{ pagination.firstItem }}–{{ pagination.lastItem }} sur {{ pagination.totalItems }}
      {% endif %}
    </span>
    <div class="pag-spacer"></div>
    <form class="pag-size" method="GET" action="{{ path('clinic_prescriptions') }}">
      <span>Par page :</span>
      <select name="per_page" data-auto-submit>
        {% for size in pageSizes %}
          <option value="{{ size }}"{{ size == pagination.limit ? ' selected' : '' }}>{{ size }}</option>
        {% endfor %}
      </select>
      {% for key, value in qs %}
        {% if key != 'per_page' %}
          {% if value is iterable %}
            {% for item in value %}<input type="hidden" name="{{ key }}[]" value="{{ item }}">{% endfor %}
          {% else %}
            <input type="hidden" name="{{ key }}" value="{{ value }}">
          {% endif %}
        {% endif %}
      {% endfor %}
    </form>
    <div class="pag-controls">
      {% if pagination.page > 1 %}
        <a class="pag-btn" href="{{ path('clinic_prescriptions', qs|merge({ page: pagination.page - 1 })) }}" aria-label="Précédent">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
        </a>
      {% else %}
        <button class="pag-btn" type="button" disabled aria-label="Précédent">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
      {% endif %}

      {# First, last and the current page's neighbours, with gaps collapsed to an ellipsis #}
      {% set shown = [1, pagination.pageCount, pagination.page, pagination.page - 1, pagination.page + 1]|filter(p => p >= 1 and p <= pagination.pageCount)|sort %}
      {% for p in shown %}
        {% set previous = loop.first ? 0 : shown[loop.index0 - 1] %}
        {% if p != previous %}
          {% if p - previous > 1 and not loop.first %}<span class="pag-ellipsis">…</span>{% endif %}
          {% if p == pagination.page %}
            <span class="pag-btn is-active">{{ p }}</span>
          {% else %}
            <a class="pag-btn" href="{{ path('clinic_prescriptions', qs|merge({ page: p })) }}">{{ p }}</a>
          {% endif %}
        {% endif %}
      {% endfor %}

      {% if pagination.page < pagination.pageCount %}
        <a class="pag-btn" href="{{ path('clinic_prescriptions', qs|merge({ page: pagination.page + 1 })) }}" aria-label="Suivant">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      {% else %}
        <button class="pag-btn" type="button" disabled aria-label="Suivant">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      {% endif %}
    </div>
  </footer>

  </turbo-frame>
</div>
{% endblock %}
