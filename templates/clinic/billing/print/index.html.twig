{#
 # Kiveto — templates/clinic/billing/print/index.html.twig
 # ──────────────────────────────────────────────────────
 # The printable invoice: a bare A4 page, no shell, no sidebar.
 #
 # Variables:
 #   invoice  InvoiceDetails  The invoice to print
 #   clinic   ClinicDto|null  The issuing clinic
 #}
{% extends 'base.html.twig' %}

{% block title %}{{ invoice.number ?? 'Facture' }}{% endblock %}
{% block show_sidebar %}false{% endblock %}
{% block show_topbar %}false{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('styles/pages/billing.css') }}"/>
{% endblock %}

{% block body %}
<div class="pr-page" data-page="clinic_invoice_print">

  <div class="pr-toolbar no-print">
    <a class="btn btn-ghost btn-sm" href="{{ path('clinic_invoice_details', { invoiceId: invoice.id }) }}">
      <i data-lucide="arrow-left"></i> Retour
    </a>
    <button class="btn btn-primary btn-sm" type="button" onclick="window.print()">
      <i data-lucide="printer"></i> Imprimer
    </button>
  </div>

  <article class="pr-sheet">

    <header class="pr-head">
      <div class="pr-issuer">
        <span class="pr-issuer-name">{{ clinic ? clinic.name : 'Clinique vétérinaire' }}</span>
        {# The Clinic BC carries no postal address yet — only identity and locale. #}
      </div>
      <div class="pr-doc">
        <span class="pr-doc-kind">Facture</span>
        <span class="pr-doc-number">{{ invoice.number ?? 'Brouillon' }}</span>
        <span class="pr-doc-date">
          {% if invoice.issuedAt %}
            Émise le {{ invoice.issuedAt|date('d/m/Y', 'Europe/Paris') }}
          {% else %}
            Créée le {{ invoice.createdAt|date('d/m/Y', 'Europe/Paris') }}
          {% endif %}
        </span>
        {% if invoice.status == 'CANCELLED' %}<span class="pr-void">ANNULÉE</span>{% endif %}
      </div>
    </header>

    <section class="pr-payer">
      <span class="pr-payer-label">Facturé à</span>
      <span class="pr-payer-name">{{ invoice.payerName }}</span>
      {% for line in invoice.payerAddressLines %}<span>{{ line }}</span>{% endfor %}
    </section>

    <table class="pr-lines">
      <thead>
        <tr>
          <th class="col-label">Désignation</th>
          <th class="col-qty">Qté</th>
          <th class="col-unit">P.U. HT</th>
          <th class="col-vat">TVA</th>
          <th class="col-total">Total HT</th>
        </tr>
      </thead>
      <tbody>
        {% for line in invoice.lines %}
          <tr>
            <td class="col-label">
              {{ line.label }}{% if line.code %} <span class="pr-code">({{ line.code }})</span>{% endif %}
            </td>
            <td class="col-qty">{{ line.quantity|number_format(line.quantity == line.quantity|round ? 0 : 2, ',', ' ') }}</td>
            <td class="col-unit">{{ line.unitPriceMinorUnits|money(invoice.currency) }}</td>
            <td class="col-vat">{{ line.taxRatePercent|number_format(1, ',', ' ') }} %</td>
            <td class="col-total">{{ line.netMinorUnits|money(invoice.currency) }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    <section class="pr-foot">
      {% if invoice.taxBreakdown|length > 0 %}
        <table class="pr-vat">
          <thead><tr><th>Taux</th><th>Base HT</th><th>TVA</th></tr></thead>
          <tbody>
            {% for row in invoice.taxBreakdown %}
              <tr>
                <td>{{ row.ratePercent|number_format(1, ',', ' ') }} %</td>
                <td>{{ row.netMinorUnits|money(invoice.currency) }}</td>
                <td>{{ row.taxMinorUnits|money(invoice.currency) }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}

      <div class="pr-totals">
        {% if invoice.discountMinorUnits > 0 %}
          <div class="pr-total-row">
            <span>Sous-total HT</span>
            <span>{{ invoice.totalNetBeforeDiscountMinorUnits|money(invoice.currency) }}</span>
          </div>
          <div class="pr-total-row">
            <span>Remise{% if invoice.discountKind == 'PERCENTAGE' %} ({{ invoice.discountValue }} %){% endif %}</span>
            <span>−{{ invoice.discountMinorUnits|money(invoice.currency) }}</span>
          </div>
        {% endif %}
        <div class="pr-total-row"><span>Total HT</span><span>{{ invoice.totalNetMinorUnits|money(invoice.currency) }}</span></div>
        <div class="pr-total-row"><span>TVA</span><span>{{ invoice.totalTaxMinorUnits|money(invoice.currency) }}</span></div>
        <div class="pr-total-row is-grand"><span>Total TTC</span><span>{{ invoice.totalGrossMinorUnits|money(invoice.currency) }}</span></div>
        {% if invoice.amountPaidMinorUnits > 0 %}
          <div class="pr-total-row"><span>Réglé</span><span>{{ invoice.amountPaidMinorUnits|money(invoice.currency) }}</span></div>
          <div class="pr-total-row"><span>Reste dû</span><span>{{ invoice.balanceDueMinorUnits|money(invoice.currency) }}</span></div>
        {% endif %}
      </div>
    </section>

    {% if invoice.payments|length > 0 %}
      <section class="pr-payments">
        <span class="pr-payments-title">Règlements</span>
        {% for payment in invoice.payments %}
          <div class="pr-payment">
            <span>{{ payment.receivedAt|date('d/m/Y', 'Europe/Paris') }} · {{ payment.methodLabel }}{% if payment.reference %} · {{ payment.reference }}{% endif %}</span>
            <span>{{ payment.amountMinorUnits|money(invoice.currency) }}</span>
          </div>
        {% endfor %}
      </section>
    {% endif %}

    {% if invoice.notes %}
      <section class="pr-notes">{{ invoice.notes|nl2br }}</section>
    {% endif %}

  </article>
</div>
{% endblock %}
