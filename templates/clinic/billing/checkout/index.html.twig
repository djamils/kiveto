{#
 # Kiveto — templates/clinic/billing/checkout/index.html.twig
 # ─────────────────────────────────────────────────────────
 # The counter screen: what the visit comes to, and taking the money for it.
 #
 # One form does everything — an optional discount, the method, the amount —
 # because that is one gesture at the desk, not three.
 #
 # Variables:
 #   invoice      InvoiceDetails   The prepared invoice
 #   admissionId  string           The visit being closed
 #   methods      PaymentMethod[]  Payment methods offered
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}Encaissement{% endblock %}
{% block show_topbar %}false{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('styles/pages/billing.css') }}"/>
{% endblock %}

{% block content %}
<div class="ck-root">

  <header class="topbar">
    <a class="tb-back" href="{{ path('clinic_admission_queue') }}" aria-label="Retour au flux du jour">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
    </a>
    <div class="tb-title">
      <span class="topbar-icon" aria-hidden="true"><i data-lucide="banknote"></i></span>
      <h1 class="topbar-title">Encaissement</h1>
    </div>
    <div class="tb-spacer"></div>
    <span class="tb-payer">{{ invoice.payerName }}</span>
  </header>

  <div class="ck-body">

    {# ── What is being charged ── #}
    <section class="ck-main">
      <div class="card">
        <div class="card-head">
          <span class="card-title">Prestations de la visite</span>
          <span class="card-meta">{{ invoice.lines|length }} ligne{{ invoice.lines|length > 1 ? 's' : '' }}</span>
        </div>

        {% if invoice.lines|length > 0 %}
          <table class="lines-table">
            <thead>
              <tr>
                <th class="col-label">Prestation</th>
                <th class="col-qty">Qté</th>
                <th class="col-unit">P.U. HT</th>
                <th class="col-vat">TVA</th>
                <th class="col-total">Total TTC</th>
              </tr>
            </thead>
            <tbody>
              {% for line in invoice.lines %}
                <tr>
                  <td class="col-label">
                    <span class="line-label">{{ line.label }}</span>
                    {% if line.code %}<span class="line-code">{{ line.code }}</span>{% endif %}
                  </td>
                  <td class="col-qty">{{ line.quantity|number_format(line.quantity == line.quantity|round ? 0 : 2, ',', ' ') }}</td>
                  <td class="col-unit">{{ line.unitPriceMinorUnits|money(invoice.currency) }}</td>
                  <td class="col-vat">{{ line.taxRatePercent|number_format(1, ',', ' ') }} %</td>
                  <td class="col-total">{{ line.grossMinorUnits|money(invoice.currency) }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <div class="lines-empty">
            Cette visite n'a aucun acte facturable. Rien n'a été relevé au plan de la consultation.
          </div>
        {% endif %}
      </div>
    </section>

    {# ── Taking the money ── #}
    <aside class="ck-side">
      <form class="card ck-form" method="POST" action="{{ path('clinic_checkout_submit', { admissionId: admissionId }) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('checkout_' ~ admissionId) }}">
        <input type="hidden" name="invoice_id" value="{{ invoice.id }}">

        <div class="ck-total">
          <span class="ck-total-label">Total à encaisser</span>
          <span class="ck-total-value" data-checkout-total="{{ invoice.balanceDueMinorUnits }}">
            {{ invoice.balanceDueMinorUnits|money(invoice.currency) }}
          </span>
          <span class="ck-total-sub">
            {{ invoice.totalNetMinorUnits|money(invoice.currency) }} HT ·
            {{ invoice.totalTaxMinorUnits|money(invoice.currency) }} de TVA
          </span>
        </div>

        {% if invoice.status == 'DRAFT' %}
          <details class="ck-discount">
            <summary>Appliquer une remise</summary>
            <label class="field">
              <span class="field-label">Remise (%)</span>
              <input class="form-input" type="text" name="discount_percent" inputmode="decimal"
                     placeholder="0" data-checkout-discount>
            </label>
            <label class="field">
              <span class="field-label">Motif <span class="field-optional">(facultatif)</span></span>
              <input class="form-input" type="text" name="discount_reason" placeholder="Geste commercial, fidélité…">
            </label>
          </details>
        {% endif %}

        <div class="ck-methods">
          <span class="field-label">Moyen de paiement</span>
          <div class="method-grid">
            {% for method in methods %}
              <label class="method-chip">
                <input type="radio" name="method" value="{{ method.value }}"{{ method.value == 'CARD' ? ' checked' : '' }} required>
                <span>{{ method.label }}</span>
              </label>
            {% endfor %}
          </div>
        </div>

        <label class="field">
          <span class="field-label">Montant encaissé</span>
          <input class="form-input ck-amount" type="text" name="amount" inputmode="decimal" required
                 data-checkout-amount
                 value="{{ (invoice.balanceDueMinorUnits / 100)|number_format(2, ',', '') }}">
          <span class="field-hint">
            Un montant inférieur au total laisse la facture partiellement réglée et la visite ouverte.
          </span>
        </label>

        <label class="field">
          <span class="field-label">Référence <span class="field-optional">(facultatif)</span></span>
          <input class="form-input" type="text" name="reference" placeholder="N° de chèque, transaction…">
        </label>

        <button class="btn btn-primary btn-block btn-lg" type="submit"
                {{ invoice.lines|length == 0 ? 'disabled' : '' }}>
          <i data-lucide="check"></i>
          Encaisser et clôturer la visite
        </button>

        <a class="ck-cancel" href="{{ path('clinic_admission_queue') }}">Revenir sans encaisser</a>
      </form>
    </aside>
  </div>
</div>
{% endblock %}
