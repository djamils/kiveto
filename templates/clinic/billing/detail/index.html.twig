{#
 # Kiveto — templates/clinic/billing/detail/index.html.twig
 # ───────────────────────────────────────────────────────
 # One invoice: what it charges, what has been paid against it, and the two
 # actions that remain open on it — take a payment, or cancel it.
 #
 # Variables:
 #   invoice  InvoiceDetails   The invoice, lines, payments and totals
 #   methods  PaymentMethod[]  Payment methods offered
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}{{ invoice.number ?? 'Facture' }}{% endblock %}
{% block show_topbar %}false{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('styles/pages/billing.css') }}"/>
{% endblock %}

{% block content %}
<div class="bd-root">

  {# ── Topbar ── #}
  <header class="topbar">
    <a class="tb-back" href="{{ path('clinic_invoices') }}" aria-label="Retour aux factures">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
    </a>
    <div class="tb-title">
      <span class="topbar-icon" aria-hidden="true"><i data-lucide="receipt"></i></span>
      <h1 class="topbar-title">{{ invoice.number ?? 'Brouillon' }}</h1>
      <span class="status-badge status-{{ invoice.status }}">
        <span class="status-dot"></span>{{ invoice.statusLabel }}
      </span>
    </div>
    <div class="tb-spacer"></div>
    {% if invoice.number %}
      <a class="btn btn-secondary btn-sm" target="_blank" rel="noopener"
         href="{{ path('clinic_invoice_pdf', { invoiceId: invoice.id }) }}">
        <i data-lucide="printer"></i>
        Imprimer
      </a>
    {% endif %}
    {% if invoice.admissionId %}
      <a class="btn btn-ghost btn-sm" href="{{ path('clinic_admission_queue') }}">
        <i data-lucide="activity"></i>
        Flux du jour
      </a>
    {% endif %}
  </header>

  <div class="bd-body">

    {# ── Left column: the invoice itself ── #}
    <section class="bd-main">

      <div class="card">
        <div class="card-head">
          <span class="card-title">Détail</span>
          <span class="card-meta">
            {% if invoice.issuedAt %}
              Émise le {{ invoice.issuedAt|date('d/m/Y à H:i', 'Europe/Paris') }}
            {% else %}
              Créée le {{ invoice.createdAt|date('d/m/Y à H:i', 'Europe/Paris') }}
            {% endif %}
          </span>
        </div>

        <div class="payer-block">
          <span class="payer-label">Facturé à</span>
          <span class="payer-name">{{ invoice.payerName }}</span>
          {% for line in invoice.payerAddressLines %}
            <span class="payer-address">{{ line }}</span>
          {% endfor %}
        </div>

        {% if invoice.lines|length > 0 %}
          <table class="lines-table">
            <thead>
              <tr>
                <th class="col-label">Prestation</th>
                <th class="col-qty">Qté</th>
                <th class="col-unit">P.U. HT</th>
                <th class="col-vat">TVA</th>
                <th class="col-total">Total HT</th>
              </tr>
            </thead>
            <tbody>
              {% for line in invoice.lines %}
                <tr>
                  <td class="col-label">
                    <span class="line-label">{{ line.label }}</span>
                    {% if line.code %}<span class="line-code">{{ line.code }}</span>{% endif %}
                  </td>
                  <td class="col-qty">{{ line.quantity|number_format(line.quantity == line.quantity|round ? 0 : 2, ',', ' ') }}</td>
                  <td class="col-unit">{{ line.unitPriceMinorUnits|money(invoice.currency) }}</td>
                  <td class="col-vat">{{ line.taxRatePercent|number_format(1, ',', ' ') }} %</td>
                  <td class="col-total">{{ line.netMinorUnits|money(invoice.currency) }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <div class="lines-empty">Cette facture ne porte aucune ligne.</div>
        {% endif %}

        {# ── VAT breakdown, as an invoice must legally print it ── #}
        {% if invoice.taxBreakdown|length > 0 %}
          <table class="vat-table">
            <thead>
              <tr><th>Taux</th><th>Base HT</th><th>TVA</th></tr>
            </thead>
            <tbody>
              {% for row in invoice.taxBreakdown %}
                <tr>
                  <td>{{ row.ratePercent|number_format(1, ',', ' ') }} %</td>
                  <td>{{ row.netMinorUnits|money(invoice.currency) }}</td>
                  <td>{{ row.taxMinorUnits|money(invoice.currency) }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% endif %}

        {# ── Totals ── #}
        <div class="totals">
          {% if invoice.discountMinorUnits > 0 %}
            <div class="total-row">
              <span>Sous-total HT</span>
              <span>{{ invoice.totalNetBeforeDiscountMinorUnits|money(invoice.currency) }}</span>
            </div>
            <div class="total-row is-discount">
              <span>
                Remise
                {% if invoice.discountKind == 'PERCENTAGE' %}({{ invoice.discountValue }} %){% endif %}
                {% if invoice.discountReason %}<em>· {{ invoice.discountReason }}</em>{% endif %}
              </span>
              <span>−{{ invoice.discountMinorUnits|money(invoice.currency) }}</span>
            </div>
          {% endif %}
          <div class="total-row">
            <span>Total HT</span>
            <span>{{ invoice.totalNetMinorUnits|money(invoice.currency) }}</span>
          </div>
          <div class="total-row">
            <span>TVA</span>
            <span>{{ invoice.totalTaxMinorUnits|money(invoice.currency) }}</span>
          </div>
          <div class="total-row is-grand">
            <span>Total TTC</span>
            <span>{{ invoice.totalGrossMinorUnits|money(invoice.currency) }}</span>
          </div>
        </div>
      </div>

      {% if invoice.notes %}
        <div class="card">
          <div class="card-head"><span class="card-title">Notes</span></div>
          <p class="notes-text">{{ invoice.notes|nl2br }}</p>
        </div>
      {% endif %}
    </section>

    {# ── Right column: money in, and what is left ── #}
    <aside class="bd-side">

      <div class="card balance-card{{ invoice.balanceDueMinorUnits > 0 ? ' is-due' : ' is-settled' }}">
        <span class="balance-label">
          {% if invoice.status == 'CANCELLED' %}Facture annulée
          {% elseif invoice.balanceDueMinorUnits > 0 %}Reste à payer
          {% else %}Soldée{% endif %}
        </span>
        <span class="balance-value">{{ invoice.balanceDueMinorUnits|money(invoice.currency) }}</span>
        <span class="balance-sub">
          {{ invoice.amountPaidMinorUnits|money(invoice.currency) }} réglé sur
          {{ invoice.totalGrossMinorUnits|money(invoice.currency) }}
        </span>
      </div>

      <div class="card">
        <div class="card-head"><span class="card-title">Paiements</span></div>
        {% if invoice.payments|length > 0 %}
          <ul class="payment-list">
            {% for payment in invoice.payments %}
              <li class="payment-row">
                <span class="payment-method">{{ payment.methodLabel }}</span>
                <span class="payment-meta">
                  {{ payment.receivedAt|date('d/m/Y H:i', 'Europe/Paris') }}
                  {% if payment.reference %} · {{ payment.reference }}{% endif %}
                </span>
                <span class="payment-amount">{{ payment.amountMinorUnits|money(invoice.currency) }}</span>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <p class="side-empty">Aucun paiement enregistré.</p>
        {% endif %}
      </div>

      {% if invoice.balanceDueMinorUnits > 0 and invoice.status != 'CANCELLED' and invoice.status != 'DRAFT' %}
        <div class="card" id="payment">
          <div class="card-head"><span class="card-title">Encaisser</span></div>
          <form class="pay-form" method="POST" action="{{ path('clinic_invoice_pay', { invoiceId: invoice.id }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('invoice_pay_' ~ invoice.id) }}">

            <label class="field">
              <span class="field-label">Moyen de paiement</span>
              <select class="form-input" name="method" required>
                {% for method in methods %}
                  <option value="{{ method.value }}"{{ method.value == 'CARD' ? ' selected' : '' }}>{{ method.label }}</option>
                {% endfor %}
              </select>
            </label>

            <label class="field">
              <span class="field-label">Montant</span>
              <input class="form-input" type="text" name="amount" inputmode="decimal" required
                     value="{{ (invoice.balanceDueMinorUnits / 100)|number_format(2, ',', '') }}">
            </label>

            <label class="field">
              <span class="field-label">Référence <span class="field-optional">(facultatif)</span></span>
              <input class="form-input" type="text" name="reference" placeholder="N° de chèque, transaction…">
            </label>

            <button class="btn btn-primary btn-block" type="submit">
              <i data-lucide="banknote"></i>
              Enregistrer le paiement
            </button>
          </form>
        </div>
      {% endif %}

      {% if invoice.status != 'CANCELLED' and invoice.payments|length == 0 %}
        <div class="card">
          <div class="card-head"><span class="card-title">Annuler</span></div>
          <p class="side-empty">
            Une facture sans paiement peut être annulée. Une fois un règlement enregistré,
            elle ne peut plus l'être — il faudrait un avoir.
          </p>
          <form method="POST" action="{{ path('clinic_invoice_cancel', { invoiceId: invoice.id }) }}"
                data-confirm="Annuler définitivement cette facture ?">
            <input type="hidden" name="_token" value="{{ csrf_token('invoice_cancel_' ~ invoice.id) }}">
            <input class="form-input" type="text" name="reason" placeholder="Motif de l'annulation" required>
            <button class="btn btn-danger btn-block" type="submit" style="margin-top:var(--space-3)">
              <i data-lucide="x-circle"></i>
              Annuler la facture
            </button>
          </form>
        </div>
      {% elseif invoice.cancellationReason %}
        <div class="card">
          <div class="card-head"><span class="card-title">Annulation</span></div>
          <p class="side-empty">
            {{ invoice.cancellationReason }}
            {% if invoice.cancelledAt %}<br>Le {{ invoice.cancelledAt|date('d/m/Y à H:i', 'Europe/Paris') }}{% endif %}
          </p>
        </div>
      {% endif %}
    </aside>
  </div>
</div>
{% endblock %}
