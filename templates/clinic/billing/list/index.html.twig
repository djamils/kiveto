{#
 # Kiveto — templates/clinic/billing/list/index.html.twig
 # ─────────────────────────────────────────────────────
 # Facturation — the clinic's invoices.
 #
 # Filtering, sorting and pagination are server-side: every control is a link
 # carrying the current query string, so Turbo navigation keeps the URL
 # shareable and the back button meaningful.
 #
 # Variables:
 #   invoices    InvoiceListRow[]  One page of rows
 #   stats       BillingStats      Today's takings and what is still owed
 #   statuses    InvoiceStatus[]   Every status, for the filter menu
 #   pagination  array             Page view model
 #   filters     array             Active filter values
 #   sort, direction string        Active sort
 #}
{% extends 'clinic/base.html.twig' %}

{% block title %}Facturation{% endblock %}
{% block show_topbar %}false{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('styles/pages/billing.css') }}"/>
{% endblock %}

{% set PERIOD_LABELS = { 'today': "Aujourd'hui", 'week': 'Cette semaine', 'month': 'Ce mois', 'year': 'Cette année' } %}
{% set MONTHS = ['janv', 'févr', 'mars', 'avr', 'mai', 'juin', 'juil', 'août', 'sept', 'oct', 'nov', 'déc'] %}

{# Current query string, rebuilt for every link so filters compose #}
{% set qs = {} %}
{% if filters.q %}{% set qs = qs|merge({ q: filters.q }) %}{% endif %}
{% if filters.period %}{% set qs = qs|merge({ period: filters.period }) %}{% endif %}
{% if filters.status %}{% set qs = qs|merge({ status: filters.status }) %}{% endif %}
{% if sort != 'date' or direction != 'desc' %}{% set qs = qs|merge({ sort: sort, dir: direction }) %}{% endif %}
{% if pagination.limit != 25 %}{% set qs = qs|merge({ per_page: pagination.limit }) %}{% endif %}

{# Sortable column header: clicking flips the direction, or starts a new sort #}
{% macro sortHead(column, label, cssClass, sort, direction, qs, align) %}
  {% set active = sort == column %}
  {% set nextDir = active and direction == 'desc' ? 'asc' : (active ? 'desc' : (column in ['status', 'payer', 'number'] ? 'asc' : 'desc')) %}
  <th class="{{ cssClass }} sortable{{ active ? (direction == 'asc' ? ' is-sorted-asc' : ' is-sorted-desc') : '' }}"{% if align %} style="text-align:{{ align }}"{% endif %}>
    <a href="{{ path('clinic_invoices', qs|merge({ sort: column, dir: nextDir })) }}">
      {{ label }} <span class="sort-icon">▼</span>
    </a>
  </th>
{% endmacro %}

{% block content %}
<div class="bl-root">

  {# ── Topbar ── #}
  <header class="topbar">
    <button class="tb-toggle show-mobile" type="button" aria-label="Menu" data-action="click->sidebar#toggle">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
    <div class="tb-title">
      <span class="topbar-icon" aria-hidden="true"><i data-lucide="receipt"></i></span>
      <h1 class="topbar-title">Facturation</h1>
      <span class="tb-title-count">{{ pagination.totalItems }}</span>
    </div>
    <div class="tb-spacer"></div>
    {#
     # The input lives outside the frame on purpose: only the results are
     # swapped, so the caret and focus survive every keystroke.
     #}
    <form class="tb-search" method="GET" action="{{ path('clinic_invoices') }}" role="search"
          data-turbo-frame="invoices-results" data-live-search>
      <svg class="tb-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" name="q" id="search-input" value="{{ filters.q }}"
             placeholder="Rechercher un numéro, un client…" autocomplete="off">
      {% for key, value in qs %}
        {% if key != 'q' %}
          {% if value is iterable %}
            {% for item in value %}<input type="hidden" name="{{ key }}[]" value="{{ item }}" data-search-carry>{% endfor %}
          {% else %}
            <input type="hidden" name="{{ key }}" value="{{ value }}" data-search-carry>
          {% endif %}
        {% endif %}
      {% endfor %}
    </form>
    <button class="btn btn-ghost btn-sm" type="button" disabled title="Export comptable — bientôt disponible">
      <i data-lucide="download"></i>
      Exporter
    </button>
    <a class="btn btn-primary btn-sm" href="{{ path('clinic_admission_queue') }}"
       title="Une facture naît d'une visite encaissée depuis le Flux du jour">
      <i data-lucide="plus"></i>
      Encaisser une visite
    </a>
  </header>

  <turbo-frame id="invoices-results" data-turbo-action="advance">

  {# Read back by the page module to keep the topbar counter in sync #}
  <span hidden data-results-total>{{ pagination.totalItems }}</span>

  {# ── Headline figures ── #}
  <section class="bl-stats">
    <div class="stat-card">
      <span class="stat-label">Encaissé aujourd'hui</span>
      <span class="stat-value">{{ stats.collectedMinorUnits|money(stats.currency) }}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Factures émises aujourd'hui</span>
      <span class="stat-value">{{ stats.issuedCount }}</span>
    </div>
    <div class="stat-card{{ stats.outstandingMinorUnits > 0 ? ' is-warning' : '' }}">
      <span class="stat-label">Reste à encaisser</span>
      <span class="stat-value">{{ stats.outstandingMinorUnits|money(stats.currency) }}</span>
      <span class="stat-sub">{{ stats.outstandingCount }} facture{{ stats.outstandingCount > 1 ? 's' : '' }}</span>
    </div>
  </section>

  {# ── Filters ── #}
  <section class="filters">
    <span class="filter-label">Filtres</span>

    {% if filters.period %}
      <span class="filter-chip">
        <span class="chip-key">Période :</span>
        <span>{{ PERIOD_LABELS[filters.period] }}</span>
        <a class="chip-x" href="{{ path('clinic_invoices', qs|merge({ period: null })) }}" aria-label="Retirer">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 3l10 10M13 3L3 13"/></svg>
        </a>
      </span>
    {% endif %}
    {% for value in filters.status %}
      {% set label = value %}
      {% for status in statuses %}{% if status.value == value %}{% set label = status.label %}{% endif %}{% endfor %}
      <span class="filter-chip">
        <span class="chip-key">Statut :</span>
        <span>{{ label }}</span>
        <a class="chip-x" href="{{ path('clinic_invoices', qs|merge({ status: filters.status|filter(v => v != value) })) }}" aria-label="Retirer">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 3l10 10M13 3L3 13"/></svg>
        </a>
      </span>
    {% endfor %}

    {# Période #}
    <span class="filter-add-wrap">
      <button class="filter-add{{ filters.period ? ' is-active' : '' }}" type="button" data-filter-toggle="period">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Période
      </button>
      <div class="filter-menu" data-filter-menu="period">
        <div class="filter-menu-title">Période</div>
        {% for value, label in PERIOD_LABELS %}
          <a class="filter-menu-item{{ filters.period == value ? ' is-checked' : '' }}"
             href="{{ path('clinic_invoices', qs|merge({ period: filters.period == value ? null : value })) }}">
            <span style="flex:1">{{ label }}</span>
            <svg class="check-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8l3 3 7-7"/></svg>
          </a>
        {% endfor %}
      </div>
    </span>

    {# Statut #}
    <span class="filter-add-wrap">
      <button class="filter-add{{ filters.status ? ' is-active' : '' }}" type="button" data-filter-toggle="status">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Statut
      </button>
      <div class="filter-menu" data-filter-menu="status">
        <div class="filter-menu-title">Statut</div>
        {% for status in statuses %}
          {% set checked = status.value in filters.status %}
          <a class="filter-menu-item{{ checked ? ' is-checked' : '' }}"
             href="{{ path('clinic_invoices', qs|merge({ status: checked ? filters.status|filter(v => v != status.value) : filters.status|merge([status.value]) })) }}">
            <span style="flex:1">{{ status.label }}</span>
            <svg class="check-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8l3 3 7-7"/></svg>
          </a>
        {% endfor %}
      </div>
    </span>

    {% if filters.q or filters.period or filters.status %}
      <a class="filter-clear" href="{{ path('clinic_invoices') }}">Tout effacer</a>
    {% endif %}
  </section>

  {# ── Table ── #}
  <section class="table-wrapper">
    {% if invoices|length > 0 %}
      <table class="invoice-table">
        <thead>
          <tr>
            {{ _self.sortHead('date', 'Date', 'col-date', sort, direction, qs, null) }}
            {{ _self.sortHead('number', 'Numéro', 'col-number', sort, direction, qs, null) }}
            {{ _self.sortHead('payer', 'Client', 'col-payer', sort, direction, qs, null) }}
            {{ _self.sortHead('status', 'Statut', 'col-status', sort, direction, qs, null) }}
            <th class="col-paid" style="text-align:right">Réglé</th>
            {{ _self.sortHead('amount', 'Total TTC', 'col-amount', sort, direction, qs, 'right') }}
            <th class="col-actions"></th>
          </tr>
        </thead>
        <tbody>
          {% for invoice in invoices %}
            {% set shownAt = invoice.issuedAt ?? invoice.createdAt %}
            {% set localDay = shownAt|date('Y-m-d', 'Europe/Paris') %}
            {% set days = date('today', 'Europe/Paris').diff(date(localDay ~ ' 00:00:00', 'Europe/Paris')).days %}
            {% if days == 0 %}
              {% set datePrimary = "Aujourd'hui" %}
            {% elseif days == 1 %}
              {% set datePrimary = 'Hier' %}
            {% elseif days < 7 %}
              {% set datePrimary = 'il y a ' ~ days ~ ' j' %}
            {% else %}
              {% set datePrimary = shownAt|date('d', 'Europe/Paris') ~ ' ' ~ MONTHS[shownAt|date('n', 'Europe/Paris') - 1] %}
            {% endif %}
            <tr data-url="{{ path('clinic_invoice_details', { invoiceId: invoice.id }) }}">
              <td class="col-date">
                <div class="cell-date">
                  <span class="cell-date-primary">{{ datePrimary }}</span>
                  <span class="cell-date-secondary">{{ shownAt|date('H:i', 'Europe/Paris') }}</span>
                </div>
              </td>
              <td class="col-number">
                <span class="cell-number">{{ invoice.number ?? '—' }}</span>
              </td>
              <td class="col-payer"><span class="cell-payer">{{ invoice.payerName }}</span></td>
              <td class="col-status">
                <span class="status-badge status-{{ invoice.status }}">
                  <span class="status-dot"></span>
                  {% for status in statuses %}{% if status.value == invoice.status %}{{ status.label }}{% endif %}{% endfor %}
                </span>
              </td>
              <td class="col-paid">
                <span class="cell-paid{{ invoice.balanceDueMinorUnits > 0 ? ' is-due' : '' }}">
                  {{ invoice.amountPaidMinorUnits|money(invoice.currency) }}
                </span>
              </td>
              <td class="col-amount">
                <div class="cell-amount">{{ invoice.totalGrossMinorUnits|money(invoice.currency) }}</div>
              </td>
              <td class="col-actions" style="position:relative">
                <button class="row-actions-btn" type="button" data-row-menu-toggle title="Actions" aria-label="Actions">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                </button>
                <div class="row-menu" data-row-menu>
                  <a class="row-menu-item" data-turbo-frame="_top"
                     href="{{ path('clinic_invoice_details', { invoiceId: invoice.id }) }}">
                    <i data-lucide="external-link"></i> Ouvrir
                  </a>
                  {% if invoice.number %}
                    <a class="row-menu-item" data-turbo-frame="_top" target="_blank" rel="noopener"
                       href="{{ path('clinic_invoice_print', { invoiceId: invoice.id }) }}">
                      <i data-lucide="printer"></i> Imprimer
                    </a>
                  {% endif %}
                  {% if invoice.balanceDueMinorUnits > 0 and invoice.status != 'CANCELLED' %}
                    <div class="row-menu-sep"></div>
                    <a class="row-menu-item" data-turbo-frame="_top"
                       href="{{ path('clinic_invoice_details', { invoiceId: invoice.id }) }}#paiement">
                      <i data-lucide="banknote"></i> Encaisser
                    </a>
                  {% endif %}
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <div class="empty">
        <div class="empty-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2h12a1 1 0 011 1v18l-3.5-2-3.5 2-3.5-2L3 21V3a1 1 0 011-1z"/><path d="M8 7h8M8 11h8M8 15h4"/></svg>
        </div>
        <div class="empty-title">Aucune facture</div>
        <div class="empty-sub">Les factures naissent du Flux du jour, en encaissant une visite terminée.</div>
        <a class="btn btn-primary btn-sm" data-turbo-frame="_top"
           href="{{ path('clinic_admission_queue') }}" style="margin-top:12px">
          <i data-lucide="arrow-right"></i>
          Aller au Flux du jour
        </a>
      </div>
    {% endif %}
  </section>

  {# ── Pagination ── #}
  <footer class="pagination">
    <span class="pag-info">
      {% if pagination.totalItems == 0 %}
        Aucun résultat
      {% else %}
        {{ pagination.firstItem }}–{{ pagination.lastItem }} sur {{ pagination.totalItems }}
      {% endif %}
    </span>
    <div class="pag-spacer"></div>
    <form class="pag-size" method="GET" action="{{ path('clinic_invoices') }}">
      <span>Par page :</span>
      <select name="per_page" data-auto-submit>
        {% for size in pageSizes %}
          <option value="{{ size }}"{{ size == pagination.limit ? ' selected' : '' }}>{{ size }}</option>
        {% endfor %}
      </select>
      {% for key, value in qs %}
        {% if key != 'per_page' %}
          {% if value is iterable %}
            {% for item in value %}<input type="hidden" name="{{ key }}[]" value="{{ item }}">{% endfor %}
          {% else %}
            <input type="hidden" name="{{ key }}" value="{{ value }}">
          {% endif %}
        {% endif %}
      {% endfor %}
    </form>
    {% if pagination.pageCount > 1 %}
      <nav class="pag-nav">
        <a class="pag-btn{{ pagination.page <= 1 ? ' is-disabled' : '' }}"
           href="{{ path('clinic_invoices', qs|merge({ page: pagination.page - 1 })) }}" aria-label="Page précédente">‹</a>
        <span class="pag-current">{{ pagination.page }} / {{ pagination.pageCount }}</span>
        <a class="pag-btn{{ pagination.page >= pagination.pageCount ? ' is-disabled' : '' }}"
           href="{{ path('clinic_invoices', qs|merge({ page: pagination.page + 1 })) }}" aria-label="Page suivante">›</a>
      </nav>
    {% endif %}
  </footer>

  </turbo-frame>
</div>
{% endblock %}
