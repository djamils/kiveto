{#
 # Preferences — the language the clinic works in and the clock it works by.
 #}
{% extends 'clinic/settings/_shell.html.twig' %}

{% set locales = { 'fr-FR': 'Français (France)', 'en-GB': 'English (United Kingdom)', 'en-US': 'English (United States)', 'de-DE': 'Deutsch (Deutschland)', 'es-ES': 'Español (España)' } %}
{% set zones = ['Europe/Paris', 'Europe/Brussels', 'Europe/Zurich', 'Europe/London', 'Europe/Madrid', 'Europe/Berlin', 'America/Montreal', 'UTC'] %}

{% block settings_body %}
<form method="post" action="{{ path('clinic_settings_preferences_save') }}" class="set-form">

  <section class="set-card">
    <header class="set-card-head">
      <h2 class="set-card-title">Langue et fuseau</h2>
      <p class="set-card-sub">Ce que l’application affiche, et l’heure sur laquelle elle compte.</p>
    </header>
    <div class="set-grid">
      <label class="set-field">
        <span class="set-label">Langue</span>
        <select class="form-input" name="locale">
          {% for code, label in locales %}
            <option value="{{ code }}"{{ settings.locale == code ? ' selected' : '' }}>{{ label }}</option>
          {% endfor %}
          {% if settings.locale not in locales|keys %}
            <option value="{{ settings.locale }}" selected>{{ settings.locale }}</option>
          {% endif %}
        </select>
      </label>
      <label class="set-field">
        <span class="set-label">Fuseau horaire</span>
        <select class="form-input" name="timeZone">
          {% for zone in zones %}
            <option value="{{ zone }}"{{ settings.timeZone == zone ? ' selected' : '' }}>{{ zone }}</option>
          {% endfor %}
          {% if settings.timeZone not in zones %}
            <option value="{{ settings.timeZone }}" selected>{{ settings.timeZone }}</option>
          {% endif %}
        </select>
      </label>
      <div class="set-field">
        <span class="set-label">Devise</span>
        <input class="form-input mono" type="text" value="{{ settings.currencyCode }}" disabled>
        <span class="set-hint">La devise engage la comptabilité : elle se change depuis le backoffice.</span>
      </div>
      <div class="set-field">
        <span class="set-label">Pays</span>
        <input class="form-input mono" type="text" value="{{ settings.countryCode }}" disabled>
        <span class="set-hint">Il détermine le régime de TVA appliqué.</span>
      </div>
    </div>
  </section>

  <div class="set-actions">
    <button class="btn btn-primary" type="submit">Enregistrer</button>
  </div>

</form>
{% endblock %}
