{#
 # Billing — where the invoice comes from, how it is numbered, how it is paid.
 #}
{% extends 'clinic/settings/_shell.html.twig' %}

{% set b = settings.billing %}
{% set lh = settings.letterhead %}

{% block settings_body %}
<form method="post" action="{{ path('clinic_settings_billing_save') }}" class="set-form">

  <section class="set-card">
    <header class="set-card-head">
      <h2 class="set-card-title">Adresse de facturation</h2>
      <p class="set-card-sub">
        À remplir seulement si les factures sont émises depuis une autre adresse que la clinique.
        {% if b.streetLine1 is null %}
          <br>Actuellement : {{ lh.streetLine1 ?? 'adresse de la clinique non renseignée' }}{% if lh.city %}, {{ lh.city }}{% endif %}.
        {% endif %}
      </p>
    </header>
    <div class="set-grid">
      <label class="set-field set-field-wide">
        <span class="set-label">Adresse</span>
        <input class="form-input" type="text" name="streetLine1" value="{{ b.streetLine1 }}" maxlength="255">
      </label>
      <label class="set-field set-field-wide">
        <span class="set-label">Complément</span>
        <input class="form-input" type="text" name="streetLine2" value="{{ b.streetLine2 }}" maxlength="255">
      </label>
      <label class="set-field">
        <span class="set-label">Code postal</span>
        <input class="form-input mono" type="text" name="postalCode" value="{{ b.postalCode }}" maxlength="20">
      </label>
      <label class="set-field">
        <span class="set-label">Ville</span>
        <input class="form-input" type="text" name="city" value="{{ b.city }}" maxlength="255">
      </label>
      <label class="set-field">
        <span class="set-label">Pays</span>
        <input class="form-input mono" type="text" name="countryCode" value="{{ b.countryCode }}" maxlength="2" placeholder="FR">
      </label>
    </div>
  </section>

  <section class="set-card">
    <header class="set-card-head">
      <h2 class="set-card-title">Facturation</h2>
      <p class="set-card-sub">Le préfixe précède le numéro de chaque facture émise.</p>
    </header>
    <div class="set-grid">
      <label class="set-field">
        <span class="set-label">Préfixe de numérotation</span>
        <input class="form-input mono" type="text" name="invoiceNumberPrefix" value="{{ b.invoiceNumberPrefix }}" maxlength="12" placeholder="FAC">
      </label>
      <label class="set-field">
        <span class="set-label">Délai de règlement</span>
        <span class="set-inline">
          <input class="form-input mono" type="number" name="paymentTermsDays" value="{{ b.paymentTermsDays }}" min="0" max="365" style="width:96px">
          <span class="set-unit">jours</span>
        </span>
      </label>
      <label class="set-field set-field-wide">
        <span class="set-label">Mention de pied de facture</span>
        <input class="form-input" type="text" name="invoiceFooterNote" value="{{ b.invoiceFooterNote }}" maxlength="255"
               placeholder="Règlement à réception. Pas d’escompte pour paiement anticipé.">
      </label>
    </div>
  </section>

  <section class="set-card">
    <header class="set-card-head">
      <h2 class="set-card-title">Coordonnées bancaires</h2>
      <p class="set-card-sub">Imprimées sur la facture pour le règlement par virement.</p>
    </header>
    <div class="set-grid">
      <label class="set-field set-field-wide">
        <span class="set-label">IBAN</span>
        <input class="form-input mono" type="text" name="iban" value="{{ b.iban }}" maxlength="40" placeholder="FR76 3000 6000 0112 3456 7890 189">
      </label>
      <label class="set-field">
        <span class="set-label">BIC</span>
        <input class="form-input mono" type="text" name="bic" value="{{ b.bic }}" maxlength="11" placeholder="AGRIFRPP">
      </label>
    </div>
  </section>

  <div class="set-actions">
    <button class="btn btn-primary" type="submit">Enregistrer</button>
  </div>

</form>
{% endblock %}
