{#
 # Identity — the name the clinic goes by and what it prints on its documents.
 #}
{% extends 'clinic/settings/_shell.html.twig' %}

{% set lh = settings.letterhead %}

{% block settings_body %}
<form method="post" action="{{ path('clinic_settings_identity_save') }}" class="set-form">

  <section class="set-card">
    <header class="set-card-head">
      <h2 class="set-card-title">Identité</h2>
      <p class="set-card-sub">Le nom sous lequel la clinique apparaît dans l’application.</p>
    </header>
    <div class="set-grid">
      <label class="set-field set-field-wide">
        <span class="set-label">Nom de la clinique</span>
        <input class="form-input" type="text" name="name" value="{{ settings.name }}" required maxlength="255">
      </label>
      <label class="set-field">
        <span class="set-label">Identifiant</span>
        <input class="form-input" type="text" value="{{ settings.slug }}" disabled>
        <span class="set-hint">L’identifiant sert aux adresses ; il se change depuis le backoffice.</span>
      </label>
    </div>
  </section>

  <section class="set-card">
    <header class="set-card-head">
      <h2 class="set-card-title">Mentions légales</h2>
      <p class="set-card-sub">Ce qui figure en pied de facture, d’ordonnance et de compte rendu.</p>
    </header>
    <div class="set-grid">
      <label class="set-field set-field-wide">
        <span class="set-label">Raison sociale</span>
        <input class="form-input" type="text" name="legalName" value="{{ lh.legalName }}" maxlength="255">
      </label>
      <label class="set-field">
        <span class="set-label">Forme juridique</span>
        <input class="form-input" type="text" name="legalForm" value="{{ lh.legalForm }}" maxlength="120" placeholder="SELARL">
      </label>
      <label class="set-field">
        <span class="set-label">Capital social</span>
        <input class="form-input" type="text" name="shareCapital" value="{{ lh.shareCapital }}" maxlength="60" placeholder="10 000 €">
      </label>
      <label class="set-field">
        <span class="set-label">SIRET</span>
        <input class="form-input mono" type="text" name="siret" value="{{ lh.siret }}" maxlength="14" placeholder="12345678901234">
      </label>
      <label class="set-field">
        <span class="set-label">N° de TVA</span>
        <input class="form-input mono" type="text" name="vatNumber" value="{{ lh.vatNumber }}" maxlength="20" placeholder="FR12345678901">
      </label>
      <label class="set-field">
        <span class="set-label">RCS — ville</span>
        <input class="form-input" type="text" name="rcsCity" value="{{ lh.rcsCity }}" maxlength="120">
      </label>
      <label class="set-field">
        <span class="set-label">RCS — numéro</span>
        <input class="form-input mono" type="text" name="rcsNumber" value="{{ lh.rcsNumber }}" maxlength="40">
      </label>
      <label class="set-field">
        <span class="set-label">Code APE</span>
        <input class="form-input mono" type="text" name="apeCode" value="{{ lh.apeCode }}" maxlength="10" placeholder="7500Z">
      </label>
      <label class="set-field">
        <span class="set-label">N° d’ordre</span>
        <input class="form-input mono" type="text" name="ordinalNumber" value="{{ lh.ordinalNumber }}" maxlength="40">
      </label>
    </div>
  </section>

  <section class="set-card">
    <header class="set-card-head">
      <h2 class="set-card-title">Adresse et contacts</h2>
      <p class="set-card-sub">Où se trouve la clinique et comment la joindre.</p>
    </header>
    <div class="set-grid">
      <label class="set-field set-field-wide">
        <span class="set-label">Adresse</span>
        <input class="form-input" type="text" name="streetLine1" value="{{ lh.streetLine1 }}" maxlength="255" placeholder="12 rue des Lilas">
      </label>
      <label class="set-field set-field-wide">
        <span class="set-label">Complément</span>
        <input class="form-input" type="text" name="streetLine2" value="{{ lh.streetLine2 }}" maxlength="255">
      </label>
      <label class="set-field">
        <span class="set-label">Code postal</span>
        <input class="form-input mono" type="text" name="postalCode" value="{{ lh.postalCode }}" maxlength="20">
      </label>
      <label class="set-field">
        <span class="set-label">Ville</span>
        <input class="form-input" type="text" name="city" value="{{ lh.city }}" maxlength="255">
      </label>
      <label class="set-field">
        <span class="set-label">Pays</span>
        <input class="form-input mono" type="text" name="countryCode" value="{{ lh.countryCode ?? settings.countryCode }}" maxlength="2" placeholder="FR">
      </label>
      <label class="set-field">
        <span class="set-label">Téléphone</span>
        <input class="form-input" type="tel" name="phone" value="{{ lh.phone }}" maxlength="20" placeholder="+33 1 42 00 00 00">
      </label>
      <label class="set-field">
        <span class="set-label">E-mail</span>
        <input class="form-input" type="email" name="email" value="{{ lh.email }}" maxlength="255">
      </label>
      <label class="set-field set-field-wide">
        <span class="set-label">Site internet</span>
        <input class="form-input" type="text" name="website" value="{{ lh.website }}" maxlength="255" placeholder="https://">
      </label>
    </div>
  </section>

  <div class="set-actions">
    <button class="btn btn-primary" type="submit">Enregistrer</button>
  </div>

</form>
{% endblock %}
