{#
 # Kiveto — templates/clinic/settings/team.html.twig
 # ────────────────────────────────────────────────
 # Équipe — who works at the clinic, in what capacity, and whether they still
 # do. Ported from docs/frontend-theme/kiveto-theme/equipe-v-topbar_5.html:
 # page header (tabs « Membres » and « Rôles et permissions » with their
 # counters, « Planning de l'équipe », « Inviter un membre »), filter bar, the
 # member table and the member's side sheet, the role map, and the invitation
 # and switch-off windows. It is a page of its own, reached from the clinic
 # card of the shell (« Équipe ») and from the settings' tab bar.
 #
 # Everything below is drawn by the page module from the payload; every change
 # is posted in the background to its single-action controller, then the module
 # asks clinic_settings_team_data again.
 #
 # Variables:
 #   payload  App\Presentation\Clinic\ViewModel\Team\TeamPageBuilder::page()
 #
 # Behaviour: assets/js/pages/team.js — styles: assets/styles/shell/register.css + assets/styles/pages/team.css
 #}
{% extends 'clinic/base.html.twig' %}

{% block page_body_class %}vt{% endblock %}
{% block title %}Équipe{% endblock %}

{% set x_svg = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>' %}

{% block main %}
<div class="reg eqp" data-page="{{ app.request.attributes.get('_route') }}" data-payload="{{ payload|json_encode }}">

  <div class="pagehead">
    <h1>Équipe<small id="phSub">{{ payload.clinic }}</small></h1>
    <div class="ctabs" id="tabs">
      <button type="button" data-t="membres" class="on">Membres <span class="n" id="nMem">0</span></button>
      <button type="button" data-t="roles">Rôles et permissions <span class="n" id="nRol">0</span></button>
    </div>
    <div class="right">
      <a class="btn" href="{{ payload.urls.planning }}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18M8 14h3M8 18h6"/></svg>Planning de l'équipe</a>
      <button type="button" class="btn primaire" id="btnInv"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Inviter un membre</button>
    </div>
  </div>

  <div class="cfil" id="cfil">
    <div class="crech">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" placeholder="Nom, e-mail, rôle…" autocomplete="off" aria-label="Rechercher un membre">
    </div>
    <span class="lblf">Filtres</span>
    <div id="fdd" style="display:flex;gap:8px;align-items:center"></div>
  </div>

  <main class="czone" id="czone">
    <div class="ctw">
      <div class="cscroll scr"><table>
        <thead id="thead"></thead>
        <tbody id="tbody"></tbody>
      </table><div id="cempty"></div></div>
    </div>
    <aside class="fiche" id="fiche"><div class="fi-in">
      <div class="fi-head" id="fiHead"></div>
      <div class="fi-body scr" id="fiBody"></div>
      <div class="fi-foot" id="fiFoot"></div>
    </div></aside>
  </main>
  <main class="rzone scr" id="rzone"></main>

  {# ── Invitation ── #}
  <div class="mveil" id="mInv"><div class="mbox" style="width:min(560px,94vw)">
    <div class="mhead"><div class="mt"><b>Inviter un membre</b><span>Un e-mail l'invite à choisir son mot de passe. Le lien est valable 72 heures.</span></div><button type="button" class="mclose" data-close aria-label="Fermer">{{ x_svg|raw }}</button></div>
    <div class="mbody">
      <div class="g2"><div class="frow"><label class="flbl" for="ivP">Prénom <span class="req">*</span></label><input class="finput" id="ivP" autocomplete="off"></div><div class="frow"><label class="flbl" for="ivN">Nom <span class="req">*</span></label><input class="finput" id="ivN" autocomplete="off"></div></div>
      <div class="frow"><label class="flbl" for="ivE">E-mail <span class="req">*</span></label><input class="finput" id="ivE" type="email" autocomplete="off" placeholder="prenom@clinique.fr"></div>
      <div class="frow"><label class="flbl">Rôle</label><div class="chips" id="ivR"></div><p class="hint" id="ivRh"></p></div>
      <div class="frow" id="ivOrdreRow"><label class="flbl" for="ivO">N° d'inscription à l'Ordre <span class="req">*</span></label><input class="finput" id="ivO" placeholder="Ex. 24871" maxlength="32" autocomplete="off"><p class="hint">Requis pour prescrire : il figure sur chaque ordonnance.</p></div>
      <p class="hint">S'il a déjà un compte Kiveto dans une autre clinique, il rejoint l'équipe aussitôt, sans e-mail : il garde son mot de passe.</p>
      <div class="frow"><div class="swrow" style="border:none;padding:0"><span class="sw" id="ivAdm" role="switch" aria-checked="false" tabindex="0"></span><div><b>Gère la clinique</b><small>Équipe, facturation et paramètres, en plus de son rôle.</small></div></div></div>
      <div class="frow"><div class="swrow" style="border:none;padding:0"><span class="sw" id="ivTmp" role="switch" aria-checked="false" tabindex="0"></span><div><b>Accès temporaire</b><small>Remplacement, stage : l'accès se coupe seul à la date choisie.</small></div></div></div>
      <div class="frow" id="ivFinRow" style="display:none"><label class="flbl" for="ivFin">Fin de l'accès</label><input class="finput" type="date" id="ivFin" style="width:180px"></div>
    </div>
    <div class="mfoot"><button type="button" class="btn" data-close>Annuler</button><button type="button" class="btn primaire" id="ivOk" disabled>Envoyer l'invitation</button></div>
  </div></div>

  {# ── Désactivation ── #}
  <div class="mveil" id="mOff"><div class="mbox">
    <div class="mhead"><div class="mt"><b id="offT">Désactiver l'accès</b><span id="offS">—</span></div><button type="button" class="mclose" data-close aria-label="Fermer">{{ x_svg|raw }}</button></div>
    <div class="mbody"><p style="font-size:.84rem;line-height:1.5">La personne ne peut plus se connecter à cette clinique. <b>Rien n'est supprimé</b> : ses consultations, ordonnances et factures restent signées de son nom, comme la loi l'exige.</p></div>
    <div class="mfoot"><button type="button" class="btn" data-close>Annuler</button><button type="button" class="btn danger" id="offOk">Désactiver l'accès</button></div>
  </div></div>

  <div class="cpop" id="cpop"></div>
</div>
{% endblock %}
