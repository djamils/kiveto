{#
 # Kiveto — templates/clinic/base.html.twig
 # ─────────────────────────────────────────
 # Base template for all authenticated clinic pages: the v-topbar shell
 # (docs/frontend-theme/kiveto-theme/*-v-topbar*.html) — sidebar `nav.sbar`,
 # `header.topbar`, search palette, shortcuts modal and toast — around the page.
 # Inherit: {% extends 'clinic/base.html.twig' %}
 #
 # Shell blocks:
 #   sidebar_mode    — 'mini' (default, collapsed rail as in most mock-ups),
 #                     'full' (expanded, dashboard / répertoire) or
 #                     'none' (no sidebar, « K » square in the topbar — consultation)
 #   page_body_class — extra <body> classes; a page ported to the v-topbar
 #                     design adds `vt` (enables the kit `.btn`) and, if the
 #                     whole page scrolls instead of its widgets, `page-scroll`
 #   topbar_extra    — raw HTML in the topbar's (empty in the mock-ups) `.right`
 #   main            — everything under the topbar. A ported page overrides it
 #                     with its own markup (`.pagehead` + layout) and puts
 #                     data-page="{{ app.request.attributes.get('_route') }}"
 #                     on its root so its page module is loaded.
 #
 # Page blocks (legacy contract, rendered inside the default `main`):
 #   title           — Page <title>
 #   page_title      — Title of the page header (`.pagehead h1`)
 #   page_subtitle   — Line under the title (optional)
 #   page_tabs       — Tabs after the title, usually a `.ctabs` (optional)
 #   topbar_actions  — Page actions, right of the page header
 #   content_header  — Full-width band above the work area (optional)
 #   content         — Main content (required)
 #   rpanel          — Optional right panel
 #   modals / drawers / fab — overlays, rendered after the shell
 #   show_topbar     — 'false': the page draws its own header inside `content`
 #   show_sidebar    — 'false': same as sidebar_mode 'none' (kept for old pages)
 #   stylesheets / javascripts
 #}
{% extends 'base.html.twig' %}

{% block show_sidebar %}true{% endblock %}
{% block show_topbar %}true{% endblock %}
{% block sidebar_mode %}mini{% endblock %}

{% block body_attributes %}
  {%- set _mode = block('show_sidebar')|trim == 'false' ? 'none' : block('sidebar_mode')|trim -%}
  {{- ' ' -}}class="shell{{ _mode == 'mini' ? ' sb-mini' }}{{ _mode == 'none' ? ' no-sb' }} {% block page_body_class %}{% endblock %}"
{%- endblock %}

{% block body %}
{% set _shell = clinic_shell() %}
{% set _route = app.request.attributes.get('_route') %}
{% set _no_sidebar = block('show_sidebar')|trim == 'false' or block('sidebar_mode')|trim == 'none' %}

{% if not _no_sidebar %}
  {{ include('components/layout/sidebar.html.twig', { shell: _shell, active_route: _route }) }}
{% endif %}

<div class="main app-content">
  {{ include('components/layout/topbar.html.twig', {
    shell: _shell,
    brand: _no_sidebar,
    extra: block('topbar_extra') is defined ? block('topbar_extra') : '',
  }) }}

  {% block main %}
    {# Page header — pages that draw their own (show_topbar = false) skip it #}
    {% if block('show_topbar')|trim == 'true' and block('page_title') is defined and block('page_title')|trim %}
      <div class="pagehead">
        <h1>{{ block('page_title') }}{% if block('page_subtitle') is defined and block('page_subtitle')|trim %}<small>{{ block('page_subtitle') }}</small>{% endif %}</h1>
        {% block page_tabs %}{% endblock %}
        {% if block('topbar_actions') is defined and block('topbar_actions')|trim %}
          <div class="right">{{ block('topbar_actions') }}</div>
        {% endif %}
      </div>
    {% endif %}

    {# Full-width band above the work area — a page that needs a banner reaching
       over the right panel puts it here rather than inside the scroll #}
    {% block content_header %}{% endblock %}

    {# Flex row: scroll area + optional right panel #}
    <div class="app-main-wrap">
      <div class="app-scroll">
        <main class="app-body" id="main-content" data-page="{{ _route }}">
          {% block content %}{% endblock %}
        </main>
      </div>
      {% block rpanel %}{% endblock %}
    </div>

    {# Overlay behind rpanel drawer on tablet #}
    <div class="rpanel-overlay" id="rpanelOverlay" onclick="document.getElementById('rpanel')?.classList.remove('open');this.classList.remove('is-open');"></div>
  {% endblock %}
</div>

{# FAB mobile #}
{% block fab %}{% endblock %}

{# Page drawers #}
{% block drawers %}{% endblock %}

{# Search palette (⌘K) and keyboard shortcuts (?) #}
{{ include('components/layout/search_modal.html.twig') }}
{{ include('components/layout/shortcuts_modal.html.twig') }}

{# Page modals #}
{% block modals %}{% endblock %}

{# Shell toast — kiveto/toast and the page modules all speak through it #}
<div class="toast" id="toast" role="status" data-shell-toast><span class="dot"></span><span id="toastMsg"></span></div>
{% endblock %}
