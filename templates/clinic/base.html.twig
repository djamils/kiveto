{#
 # Kiveto — templates/clinic/base.html.twig
 # ─────────────────────────────────────────
 # Base template for all authenticated clinic pages.
 # Inherit: {% extends 'clinic/base.html.twig' %}
 #
 # Available blocks:
 #   title         — Page <title>
 #   page_title    — Title displayed in the topbar (required)
 #   page_subtitle — Topbar subtitle (optional)
 #   topbar_search — bool: show search (default: false)
 #   topbar_actions — Topbar buttons
 #   breadcrumb    — Breadcrumb trail
 #   content       — Main content (required)
 #   rpanel        — Optional right panel
 #   modals        — Page modals
 #   drawers       — Page drawers
 #   fab           — Optional mobile FAB
 #   stylesheets   — Additional CSS
 #   javascripts   — Additional JS
 #}
{% extends 'base.html.twig' %}

{% block show_sidebar %}true{% endblock %}
{% block show_topbar %}true{% endblock %}

{% block body %}
{# ── App Shell ── #}
<div class="app-shell">

  {# Sidebar (desktop: fixed / mobile: drawer) — hidden on scheduling pages #}
  {% if block('show_sidebar')|trim == 'true' %}
  {{ include('components/layout/sidebar.html.twig', {
    clinic: activeClinic|default({ name: 'Ma clinique', type: 'Vétérinaire' }),
    user: app.user,
    active_item: app.request.attributes.get('_route'),
  }) }}

  {# Mobile sidebar overlay #}
  <div class="sidebar-overlay" id="sidebarOverlay" data-action="click->sidebar#close"></div>
  {% endif %}

  {# Main area #}
  <div class="app-content">

    {# Topbar — hidden on pages with their own specialized topbar #}
    {% if block('show_topbar')|trim == 'true' %}
    {% set _raw_actions = block('topbar_actions') is defined ? block('topbar_actions')|trim : '' %}
    {{ include('components/layout/topbar.html.twig', {
      title:    block('page_title') is defined ? block('page_title') : 'Page',
      subtitle: block('page_subtitle') is defined ? block('page_subtitle') : null,
      search:   block('topbar_search') is defined ? block('topbar_search') : false,
      breadcrumb: block('breadcrumb') is defined ? block('breadcrumb') : [],
      burger:   block('show_sidebar')|trim == 'true',
      raw_actions: _raw_actions,
    }) }}
    {% endif %}

    {# Flex row: scroll area + optional right panel #}
    <div class="app-main-wrap">
      <div class="app-scroll">
        <main class="app-body" id="main-content">
          {% block content %}{% endblock %}
        </main>
      </div>
      {% block rpanel %}{% endblock %}
    </div>

    {# Overlay behind rpanel drawer on tablet #}
    <div class="rpanel-overlay" id="rpanelOverlay" onclick="document.getElementById('rpanel')?.classList.remove('open');this.classList.remove('is-open');"></div>

  </div>{# /app-content #}

</div>{# /app-shell #}

{# FAB mobile #}
{% block fab %}{% endblock %}

{# Page drawers #}
{% block drawers %}{% endblock %}

{# Page modals #}
{% block modals %}{% endblock %}
{% endblock %}
