<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="theme-color" content="#4338ca"/>
  <title>{% block title %}Kiveto{% endblock %}</title>
  <meta name="csrf-token" content="{{ csrf_token('ajax') }}">
  {% block head_meta %}{% endblock %}
  {{ importmap('app') }}
  {% block stylesheets %}{% endblock %}
</head>
<body>
  {% block body %}{% endblock %}

  {# Toast container #}
  <div class="toast-container" id="kiveto-toast-container" aria-live="polite"></div>

  {# Flash messages → auto toasts #}
  {% for type, messages in app.flashes %}
    {% for message in messages %}
      <script type="module">
        import('kiveto/toast').then(({ toast }) => {
          toast.{{ type == 'error' ? 'danger' : type }}({{ message|json_encode|raw }});
        });
      </script>
    {% endfor %}
  {% endfor %}

  {% block javascripts %}{% endblock %}
</body>
</html>
