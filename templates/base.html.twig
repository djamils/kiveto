<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="theme-color" content="#4338ca"/>
  <title>{% block title %}Kiveto{% endblock %}</title>
  <meta name="csrf-token" content="{{ csrf_token('ajax') }}">
  <meta name="turbo-cache-control" content="no-preview">
  {% block head_meta %}{% endblock %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.2.3/css/flag-icons.min.css">
  {{ importmap('app') }}
  {% block stylesheets %}{% endblock %}
</head>
<body>
  {% block body %}{% endblock %}

  {# Toast container #}
  <div class="toast-container" id="kiveto-toast-container" aria-live="polite"></div>

  {# Flash messages — rendered as data attributes, consumed by JS on turbo:load #}
  {% for type, messages in app.flashes %}
    {% for message in messages %}
      <div data-flash-toast data-type="{{ type == 'error' ? 'danger' : type }}" data-message="{{ message }}" hidden></div>
    {% endfor %}
  {% endfor %}

  {% block javascripts %}{% endblock %}
</body>
</html>
