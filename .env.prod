# Defaults of every APP_ENV=prod deployment (STAGING, DEMO, production), over
# .env. The variables of the deployment (.env.runtime, from Parameter Store)
# win over both files.

###> kiveto/public-urls ###
# Every prod deployment is served over HTTPS on the hosts of its domain: the
# public URLs follow KIVETO_DOMAIN unless the deployment sets them, so a
# missing one never links to the kiveto.local hosts of .env.
DEFAULT_URI="https://clinic.${KIVETO_DOMAIN}"
KIVETO_PUBLIC_BASE_URL="https://clinic.${KIVETO_DOMAIN}"
PORTAL_PUBLIC_BASE_URL="https://portal.${KIVETO_DOMAIN}"
PORTAL_TERMS_URL="https://portal.${KIVETO_DOMAIN}/cgu"
###< kiveto/public-urls ###

###> lexik/jwt-authentication-bundle ###
# The development passphrase committed in .env never applies here: each
# deployment provides its own, with its own keypair (mounted on config/jwt).
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###
