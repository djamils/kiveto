# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
DATABASE_URL="mysql://root:k!v3t0@127.0.0.1:3306/kiveto?serverVersion=8.4.7&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> kiveto/documents ###
# Gotenberg turns the document templates into PDF. Inside compose the service
# name resolves; from the host the same instance answers on port 3001.
GOTENBERG_URL=http://gotenberg:3000
###< kiveto/documents ###

###> external APIs ###
# User-Agent sent to every external service. The api/vies modes below require
# a contact (e-mail or URL) in it, e.g. "Kiveto/0.5 (+https://kiveto.fr/contact)";
# it is checked when a real adapter is first built, never at boot.
EXTERNAL_API_USER_AGENT="Kiveto/0.5"
# Company registry used to search and verify clients' SIRENs:
#   fixture = in-memory demo data (default: dev, tests, CI), api = API Recherche d'entreprises.
CLIENT_COMPANY_REGISTRY=fixture
# VAT number verifier: fixture = in-memory demo data (default), vies = European VIES service.
CLIENT_VAT_VERIFIER=fixture
###< external APIs ###

# Approved e-invoicing platform: disabled (production default until a real
# adapter exists) | simulator (local, no network; refused in production).
ELECTRONIC_INVOICING_PLATFORM=disabled

###> symfony/brevo-mailer ###
# Production: MAILER_DSN=brevo+api://KEY@default (see src/System/Notification/README.md).
# MAILER_DSN=brevo+api://KEY@default
###< symfony/brevo-mailer ###

###> symfony/brevo-notifier ###
# SMS transport. Production: NOTIFIER_SMS_DSN=brevo://KEY@default?sender=Kiveto
NOTIFIER_SMS_DSN=null://null
###< symfony/brevo-notifier ###

###> kiveto/notification ###
# How outbound messages are delivered:
#   disabled  = nothing leaves the application (production default until configured)
#   simulator = e-mail goes through MAILER_DSN (Mailpit in dev), SMS is only logged and
#               stored; delivery webhooks are faked locally (refused in production)
#   brevo     = real Brevo transports and real Brevo webhooks
NOTIFICATION_DELIVERY=disabled
# Shared secret Brevo sends with its webhooks (bearer header or ?token=).
BREVO_WEBHOOK_TOKEN=change-me
# Dev only, behind a tunnel that hides Brevo's IP: skips the IP check, never the
# secret. Refused when APP_ENV=prod.
NOTIFICATION_WEBHOOK_SKIP_IP_CHECK=0
# Host pattern (regex, added to framework.trusted_hosts) on which Brevo calls
# the webhooks: the public hooks host in production, the tunnel host in dev.
NOTIFICATION_WEBHOOK_HOST='^hooks\.kiveto\.fr$'
# Client e-mails are sent from <clinic-slug>@<this domain>.
NOTIFICATION_EMAIL_DOMAIN=mail.kiveto.fr
# Sender of the staff account e-mails (invitation, password reset).
NOTIFICATION_ACCOUNT_SENDER=no-reply@kiveto.fr
# Base URL of the clinic application, used for the links in e-mails.
KIVETO_PUBLIC_BASE_URL=http://clinic.kiveto.local
###< kiveto/notification ###

###> symfony/framework-bundle (proxies) ###
# Comma-separated IPs / CIDR ranges of the reverse proxies in front of the app
# (e.g. "127.0.0.1,REMOTE_ADDR" or "private_ranges"); empty = trust none.
SYMFONY_TRUSTED_PROXIES=
###< symfony/framework-bundle (proxies) ###
